<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/primary_default">
    <item>
        <selector>
            <item android:state_activated="false">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/primary_default"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary_default"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
