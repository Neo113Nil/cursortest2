<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:tint="@color/surface_2"
            android:shape="rectangle"/>
    </item>
    <item
        android:gravity="top"
        android:id="@+id/layer_frame_top"
        android:drawable="@drawable/ic_sofa_frame_top"/>
    <item
        android:gravity="bottom"
        android:id="@+id/layer_frame_bottom">
        <rotate
            android:drawable="@drawable/ic_sofa_frame_top"
            android:fromDegrees="180"
            android:toDegrees="180"/>
    </item>
</layer-list>
