<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Spinner
            android:id="@+id/stages_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <CheckBox
            android:id="@+id/create_new_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a new SA user"/>
        <CheckBox
            android:id="@+id/debug_panel_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Enable debug panel"/>
        <CheckBox
            android:id="@+id/debug_panel_only_fps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Debug panel: show only FPS"/>
        <CheckBox
            android:id="@+id/debug_logs_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Enable full log output"/>
        <CheckBox
            android:id="@+id/debug_do_not_ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Do not ask me again"/>
        <CheckBox
            android:id="@+id/load_locally_ondemand_feature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable local loading of on-demand feature"/>
        <CheckBox
            android:id="@+id/use_embedded_client_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Use embedded client version"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UiAnrWatcher ms: "/>
            <Spinner
                android:id="@+id/uiAnrWatcherSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="number"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(valid for the next run)"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assets group: "/>
            <Spinner
                android:entries="@array/asset_height_options"
                android:id="@+id/uiAssetsGroupSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
