<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">
        <FrameLayout
            android:id="@+id/home_flag_root"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/home_flag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/guest_flag_root"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentEnd="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/guest_flag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorWhite"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:tag="home_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_centerVertical="true"
            android:fontFamily="@font/arimo_bold"
            android:textAlignment="gravity"
            android:layout_toStartOf="@+id/root_scope"
            android:layout_toEndOf="@+id/home_flag_root"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorWhite"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:tag="guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_centerVertical="true"
            android:fontFamily="@font/arimo_bold"
            android:textAlignment="gravity"
            android:layout_toStartOf="@+id/guest_flag_root"
            android:layout_toEndOf="@+id/root_scope"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/root_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorWhite"
                android:gravity="center"
                android:tag="home_scope"
                android:paddingTop="4dp"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="22dp"
                android:fontFamily="@font/arimo_bold"
                android:textAlignment="gravity"
                android:paddingStart="8dp"
                android:paddingEnd="7dp"
                android:layout_marginStart="4.5dp"
                android:layout_marginEnd="4.5dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorWhite"
                android:gravity="center"
                android:tag="guest_scope"
                android:paddingTop="4dp"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:textAlignment="gravity"
                android:paddingStart="8dp"
                android:paddingEnd="7dp"
                android:layout_marginStart="4.5dp"
                android:layout_marginEnd="4.5dp"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
