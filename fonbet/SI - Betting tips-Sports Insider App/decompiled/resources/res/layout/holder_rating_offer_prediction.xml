<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/today_prediction_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="5dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="0dp"
    app:cardBackgroundColor="#000000"
    app:cardCornerRadius="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/prediction_linear"
            android:background="@drawable/background_prediction_rating"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="start"
                    android:layout_gravity="start"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/arimo_bold"
                    android:layout_marginStart="19dp"/>
                <LinearLayout
                    android:gravity="start"
                    android:layout_gravity="end"
                    android:orientation="vertical"
                    android:id="@+id/time_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="28dp">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/colorWhite"
                        android:id="@+id/match_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:includeFontPadding="false"
                        android:alpha="1"
                        android:fontFamily="@font/arimo_bold"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/colorWhite"
                        android:id="@+id/match_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/arimo_bold"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorWhite"
                        android:id="@+id/total_rate_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="@string/Total_ratio"
                        android:fontFamily="@font/arimo_bold"
                        android:layout_marginStart="19dp"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/colorWhite"
                        android:id="@+id/rate_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:maxLines="2"
                        android:fontFamily="@font/arimo_bold"
                        android:layout_marginStart="19dp"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="17dp"
                android:layout_marginStart="19dp"
                android:layout_marginEnd="18dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/time_left"
                    android:background="@drawable/stroke_rate"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
                <View
                    android:id="@+id/time_left_div_state_info"
                    android:layout_width="7dp"
                    android:layout_height="45dp"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#381559"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/state_info"
                    android:background="@drawable/white_btn_rad"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="@string/get"
                    android:layout_weight="1"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
