<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardCornerRadius="20dp">
    <ImageView
        android:id="@+id/bgnImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.sports.insider.ui.views.NewsGradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="normal"
        android:textColor="@color/colorWhite"
        android:ellipsize="end"
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:maxLines="5"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2sp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="17dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textStyle="normal"
            android:textColor="@color/colorWhite"
            android:layout_gravity="center_vertical"
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp"
            android:lineSpacingExtra="2sp"
            android:layout_marginStart="24dp"/>
        <com.sports.insider.ui.views.IcNextView
            android:layout_gravity="end|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="27dp"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
