<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/today_prediction_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="#000000"
    app:cardCornerRadius="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/match_image"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sports.insider.ui.views.PredictionGradientView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.85"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/logosDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">
                <FrameLayout
                    android:id="@+id/frameLayout"
                    android:layout_width="60dp"
                    android:layout_height="60dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/flag_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/frameLayout2"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="15dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/flag_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="start"
                android:layout_gravity="end"
                android:orientation="vertical"
                android:id="@+id/time_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="15dp">
                <TextView
                    android:textSize="30sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/match_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:alpha="1"/>
                <TextView
                    android:textSize="30sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/match_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/timeNameScopeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logosDateTime">
            <FrameLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/team_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:alpha="1"
                    android:layout_marginEnd="20dp"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/colorWhite"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/team_1_goals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:alpha="0.7"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/team_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:alpha="1"
                    android:layout_marginEnd="20dp"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/colorWhite"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/team_2_goals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="1"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/forecast_layout"
            android:padding="2dp"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="11dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeNameScopeStatus">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="23dp">
                <com.sports.insider.ui.views.WhiteBorderRoundBackgroundHolder
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/forecast_layout_clicked"
                    app:layout_constraintEnd_toEndOf="@+id/forecast_layout_clicked"
                    app:layout_constraintStart_toStartOf="@+id/forecast_layout_clicked"
                    app:layout_constraintTop_toTopOf="@+id/forecast_layout_clicked"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/forecast_layout_clicked"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="130dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorWhite"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/forecast_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorWhite"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/coefficient_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="10dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/colorWhite"
                android:gravity="center"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:id="@+id/own1"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:text="@string/our_forecast"
                android:textAllCaps="false"
                android:textAlignment="gravity"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textColor="@color/colorWhite"
                android:gravity="end|center_vertical"
                android:layout_gravity="end"
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/awaiting"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
