<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/back_screen_football"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/status_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/space_nav"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/dateTimeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_space">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/colorWhite"
            android:id="@+id/tvDate"
            android:background="@drawable/background_tv_date_game"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_black"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="1.5dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/colorWhite"
            android:id="@+id/tvTime"
            android:background="@drawable/background_tv_time_game"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_black"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="1.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dateTimeGroup">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvScoreHome"
            android:background="@drawable/background_tv_game"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:fontFamily="@font/montserrat_black"
            android:layout_marginEnd="1.5dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tvNameHome"
            android:background="@drawable/background_tv_game"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:fontFamily="@font/montserrat_black"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="1.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="86dp"
        android:minHeight="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/space_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvScoreGuest"
            android:background="@drawable/background_tv_game"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:fontFamily="@font/montserrat_black"
            android:layout_marginEnd="1.5dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvNameGuest"
            android:background="@drawable/background_tv_game"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:fontFamily="@font/montserrat_black"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="1.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="89dp"
        app:layout_constraintBottom_toTopOf="@+id/space_nav">
        <FrameLayout
            android:id="@+id/homeBtn"
            android:background="@drawable/background_game_btn_home"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:elevation="5dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_cabin"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="6.5dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ratingBtn"
            android:background="@drawable/background_game_btn_cup"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:elevation="5dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_cup"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="6.5dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/refreshBtn"
            android:background="@drawable/background_game_btn_refresh"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:elevation="5dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_refresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="6.5dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/completeBtn"
            android:background="@drawable/background_game_btn_ok"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:elevation="5dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_ok"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="6.5dp"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/not_found_game"
        android:background="@drawable/bottom_navigation_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="@+id/space_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_space">
        <FrameLayout
            android:id="@+id/closeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ic_close_white_24dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fieldfootballAppCompatImageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="44dp"
            android:layout_marginBottom="35dp"
            android:scaleType="fitCenter"
            android:layout_marginStart="17dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintBottom_toTopOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="26sp"
            android:textColor="#ffffff"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            android:text="На сегодня все события исчерпаны."
            android:includeFontPadding="false"
            android:fontFamily="@font/montserrat_black"
            android:textAlignment="gravity"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/txt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="start"
            android:id="@+id/txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="35dp"
            android:text="Возвращайтесь в игру завтра и продолжайте соревноваться с лучшими прогнозистами!"
            android:includeFontPadding="false"
            android:alpha="0.75"
            android:fontFamily="@font/arimo_regular"
            android:textAlignment="gravity"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/btnFrameRatingGame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/shadow_light_bt_background"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnFrameRatingGame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnFrameRatingGame"/>
        <FrameLayout
            android:id="@+id/btnFrameRatingGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.button.MaterialButton
                android:textSize="20sp"
                android:textColor="#20003f"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btnRatingGame"
                android:background="@drawable/btn_vip"
                android:paddingTop="16dp"
                android:paddingBottom="17dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Рейтинг игроков"
                android:textAllCaps="false"
                android:fontFamily="@font/arimo_bold"
                android:textAlignment="gravity"
                android:paddingStart="27dp"
                android:paddingEnd="25dp"
                android:stateListAnimator="@animator/button_animator"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
