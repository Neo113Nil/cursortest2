<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="0dp">
            <FrameLayout
                android:id="@+id/mouse"
                android:background="@drawable/background_orifice_msg_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                app:layout_constraintBottom_toBottomOf="@+id/cart_data"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/cart_data"
                android:background="@drawable/background_msg_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/colorWhite"
                    android:textColorLink="@color/colorAccent"
                    android:autoLink="all"
                    android:linksClickable="true"
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="9dp"
                    android:minWidth="40dp"
                    android:textIsSelectable="false"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:gravity="end"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:alpha="0.5"
                    android:layout_marginEnd="10dp"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/btn_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="50dp">
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/textsize_18"
            android:textColor="@color/colorWhite"
            android:gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/btn_live_pred"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="45dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/arimo_bold"
            android:textAlignment="gravity"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/button_animator"
            app:backgroundTint="@null"
            app:cornerRadius="10dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_copy"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/ic_copy"/>
    </LinearLayout>
</LinearLayout>
