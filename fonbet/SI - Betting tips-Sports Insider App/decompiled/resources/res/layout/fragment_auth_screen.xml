<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/btn_frame"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_desc"/>
    <com.sports.insider.ui.views.AuthBrMGradientView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/btn_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLogo"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_marginBottom="12dp"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toTopOf="@+id/title_desc"
        app:layout_constraintEnd_toEndOf="@+id/title_desc"
        app:layout_constraintStart_toStartOf="@+id/title_desc"
        app:layout_constraintTop_toBottomOf="@+id/btn_close"/>
    <TextView
        android:textSize="30sp"
        android:textColor="@color/colorWhite"
        android:gravity="center"
        android:id="@+id/title_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/montserrat_black"
        android:textAlignment="gravity"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintBottom_toTopOf="@+id/ivBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/colorWhite"
        android:gravity="center"
        android:id="@+id/sub_title_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/montserrat_black"
        android:textAlignment="gravity"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_desc"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/colorWhite"
        android:gravity="center"
        android:id="@+id/check_spam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/arimo_regular"
        android:textAlignment="gravity"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title_desc"/>
    <FrameLayout
        android:id="@+id/btn_frame"
        android:layout_width="203dp"
        android:layout_height="57dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/title_desc"
        app:layout_constraintStart_toStartOf="@+id/title_desc">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="20sp"
            android:textColor="#20003f"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_auth"
            android:background="@drawable/btn_vip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="45dp"
            android:textAllCaps="false"
            android:fontFamily="@font/arimo_bold"
            android:textAlignment="gravity"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:stateListAnimator="@animator/button_animator"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
