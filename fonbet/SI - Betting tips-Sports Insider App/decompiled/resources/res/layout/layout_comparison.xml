<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root_comparison"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">
    <TextView
        android:textSize="22sp"
        android:textColor="@color/colorWhite"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="25dp"
        android:text="@string/comparison"
        android:textAllCaps="false"
        android:fontFamily="@font/arimo_bold"
        android:textAlignment="gravity"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/root_scope"
            android:layout_width="122dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_centerHorizontal="true">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:id="@+id/win1"
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#b6b6b6"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/win"
                    android:fontFamily="@font/arimo_regular"
                    android:textAlignment="gravity"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:id="@+id/win2"
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:id="@+id/loss1"
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#b6b6b6"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/lose"
                    android:fontFamily="@font/arimo_regular"
                    android:textAlignment="gravity"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:id="@+id/loss2"
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:id="@+id/draw1"
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#b6b6b6"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/draw"
                    android:fontFamily="@font/arimo_regular"
                    android:textAlignment="gravity"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:id="@+id/draw2"
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:fontFamily="@font/arimo_bold"
                    android:textAlignment="gravity"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/root_scope">
            <com.sports.insider.ui.views.DiagramSection
                android:layout_gravity="center_horizontal"
                android:id="@+id/diagram1"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_logoCommandHome_compare"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="30dp"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/root_scope">
            <com.sports.insider.ui.views.DiagramSection
                android:layout_gravity="center_horizontal"
                android:id="@+id/diagram2"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_logoCommandGuest_compare"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="30dp"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </RelativeLayout>
    <com.sports.insider.ui.views.LineDivGradientView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root_showmore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:layout_marginRight="17dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#b6b6b6"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/last_games"
                    android:fontFamily="@font/arimo_regular"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/colorWhite"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_nameCommandHome_compare_tittle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/root_comparison_last_game1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.sports.insider.ui.views.LineDivGradientView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#b6b6b6"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/last_games"
                    android:fontFamily="@font/arimo_regular"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/colorWhite"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_nameCommandGuest_compare_tittle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/root_comparison_last_game2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.sports.insider.ui.views.LineDivGradientView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
