<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/root_scroll"
            android:background="#20003f"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/today_prediction_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/match_image"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                    <com.sports.insider.ui.views.PredictionGradientView
                        android:id="@+id/matchGradientFree"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.7"/>
                    <com.sports.insider.ui.views.PremiumGradientView
                        android:id="@+id/matchGradientPremium"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.7"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/prediction_linear"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.sports.insider.ui.views.PredictionCard
                            android:id="@+id/predictionCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:layout_marginBottom="0dp"
                            android:layout_marginStart="30dp"
                            android:layout_marginEnd="30dp"/>
                        <RelativeLayout
                            android:id="@+id/root_forecast_0"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="66dp"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="16dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp">
                            <LinearLayout
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/foreCast"
                                android:background="@drawable/stroke_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginTop="21dp"
                                android:minWidth="130dp"
                                android:layout_centerHorizontal="true">
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/tv_forecast_0"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.7"
                                    android:fontFamily="@font/arimo_regular"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/tv_coefficient_0"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/arimo_bold"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="10dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/colorWhite"
                                android:gravity="center"
                                android:layout_gravity="top|center_horizontal"
                                android:orientation="horizontal"
                                android:id="@+id/own0"
                                android:background="@drawable/our_forecast"
                                android:layout_width="wrap_content"
                                android:layout_height="21dp"
                                android:text="@string/our_forecast"
                                android:layout_centerHorizontal="true"
                                android:textAllCaps="false"
                                android:fontFamily="@font/arimo_bold"
                                android:textAlignment="gravity"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:layout_marginStart="16dp"
                                android:layout_alignStart="@+id/foreCast"/>
                        </RelativeLayout>
                    </LinearLayout>
                </FrameLayout>
                <com.sports.insider.ui.views.StateGameView
                    android:id="@+id/statusGamePrediction"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"/>
                <com.sports.insider.ui.views.TelegramBannerView
                    android:id="@+id/telegramBannerView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <FrameLayout
                    android:id="@+id/status_banner"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/image_status_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"/>
                    <com.sports.insider.ui.views.FrameGradientWithHead
                        android:id="@+id/frame_status_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:background_color_wh="@android:color/transparent"
                        app:end_color_wh="#ffffff"
                        app:fullGradient_wh="true"
                        app:start_color_wh="#ffffff">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="36sp"
                                android:textColor="#151515"
                                android:gravity="center"
                                android:id="@+id/titleBanner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="4dp"
                                android:text="@string/do50k"
                                android:fontFamily="@font/arimo_bold"
                                android:textAlignment="gravity"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="#151515"
                                android:gravity="center"
                                android:id="@+id/textBanner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="16dp"
                                android:text="@string/DelayStavkaBonus"
                                android:fontFamily="@font/arimo_regular"
                                android:textAlignment="gravity"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"/>
                            <com.google.android.material.button.MaterialButton
                                android:textSize="18sp"
                                android:textColor="#151515"
                                android:gravity="center"
                                android:layout_gravity="bottom|center_horizontal"
                                android:id="@+id/btnBanner"
                                android:background="@drawable/btn_gold_banner"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:text="@string/DelayStavkaBonusBtn"
                                android:textAllCaps="true"
                                android:fontFamily="@font/arimo_bold"
                                android:textAlignment="gravity"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:stateListAnimator="@animator/button_animator"
                                app:backgroundTint="@null"/>
                        </LinearLayout>
                    </com.sports.insider.ui.views.FrameGradientWithHead>
                </FrameLayout>
                <com.sports.insider.ui.views.HeadToHeadLabelView
                    android:id="@+id/headToHeadLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.MeetingGameView
                    android:id="@+id/meetingGameView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.LineDivGradientView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/root_comparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/colorWhite"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="25dp"
                        android:text="@string/comparison"
                        android:textAllCaps="false"
                        android:fontFamily="@font/arimo_bold"
                        android:textAlignment="gravity"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_gravity="center_horizontal"
                            android:orientation="vertical"
                            android:id="@+id/root_scope"
                            android:layout_width="122dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_centerHorizontal="true">
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                android:layout_marginTop="12dp">
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:gravity="center"
                                    android:id="@+id/win1"
                                    android:layout_width="20dp"
                                    android:layout_height="22dp"
                                    android:fontFamily="@font/arimo_bold"
                                    android:textAlignment="gravity"/>
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="#b6b6b6"
                                    android:gravity="center"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="22dp"
                                    android:text="@string/win"
                                    android:fontFamily="@font/arimo_regular"
                                    android:textAlignment="gravity"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:gravity="center"
                                    android:layout_gravity="end"
                                    android:id="@+id/win2"
                                    android:layout_width="20dp"
                                    android:layout_height="22dp"
                                    android:fontFamily="@font/arimo_bold"
                                    android:textAlignment="gravity"/>
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                android:layout_marginTop="2dp">
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:gravity="center"
                                    android:id="@+id/loss1"
                                    android:layout_width="20dp"
                                    android:layout_height="22dp"
                                    android:fontFamily="@font/arimo_bold"
                                    android:textAlignment="gravity"/>
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="#b6b6b6"
                                    android:gravity="center"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="22dp"
                                    android:text="@string/lose"
                                    android:fontFamily="@font/arimo_regular"
                                    android:textAlignment="gravity"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:gravity="center"
                                    android:layout_gravity="end"
                                    android:id="@+id/loss2"
                                    android:layout_width="20dp"
                                    android:layout_height="22dp"
                                    android:fontFamily="@font/arimo_bold"
                                    android:textAlignment="gravity"/>
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                android:layout_marginTop="2dp">
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:gravity="center"
                                    android:id="@+id/draw1"
                                    android:layout_width="20dp"
                                    android:layout_height="22dp"
                                    android:fontFamily="@font/arimo_bold"
                                    android:textAlignment="gravity"/>
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="#b6b6b6"
                                    android:gravity="center"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="22dp"
                                    android:text="@string/draw"
                                    android:fontFamily="@font/arimo_regular"
                                    android:textAlignment="gravity"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/colorWhite"
                                    android:gravity="center"
                                    android:layout_gravity="end"
                                    android:id="@+id/draw2"
                                    android:layout_width="20dp"
                                    android:layout_height="22dp"
                                    android:fontFamily="@font/arimo_bold"
                                    android:textAlignment="gravity"/>
                            </FrameLayout>
                        </LinearLayout>
                        <FrameLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@+id/root_scope">
                            <com.sports.insider.ui.views.DiagramSection
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/diagram1"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/iv_logoCommandHome_compare"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_marginTop="30dp"/>
                        </FrameLayout>
                        <FrameLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toEndOf="@+id/root_scope">
                            <com.sports.insider.ui.views.DiagramSection
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/diagram2"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/iv_logoCommandGuest_compare"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_marginTop="30dp"/>
                        </FrameLayout>
                    </RelativeLayout>
                    <com.sports.insider.ui.views.LineDivGradientView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:layout_marginBottom="18dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                </LinearLayout>
                <com.sports.insider.ui.views.LastGamesNameLabel
                    android:id="@+id/tvNameCommandHomeCompare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.MeetingGameView
                    android:id="@+id/comparisonLastHomeGameView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.LineDivGradientView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="18dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.LastGamesNameLabel
                    android:id="@+id/tvNameCommandGuestCompare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.MeetingGameView
                    android:id="@+id/comparisonLastGuestGameView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.LineDivGradientView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="34dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"/>
                <com.sports.insider.ui.views.AnalyticsBackground
                    android:orientation="vertical"
                    android:id="@+id/rootAnalytics"
                    android:paddingTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.sports.insider.ui.views.PredictionLabelView
                        android:id="@+id/labelPrediction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                    <com.sports.insider.ui.views.ShadowLayoutSimple
                        android:layout_gravity="center"
                        android:id="@+id/shadowLayoutAnalyticsShort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:layout_marginHorizontal="12dp"
                        app:sl_cornerRadius="18dp"
                        app:sl_shadowLimit="8dp"
                        app:sl_shadowOffsetX="0dp"
                        app:sl_shadowOffsetY="3dp">
                        <com.sports.insider.ui.views.AnalyticsShortView
                            android:id="@+id/analyticsShort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:layout_marginBottom="25dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"/>
                    </com.sports.insider.ui.views.ShadowLayoutSimple>
                    <com.sports.insider.ui.views.AnalyticsView
                        android:id="@+id/analytics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                </com.sports.insider.ui.views.AnalyticsBackground>
                <FrameLayout
                    android:id="@+id/analytic_banner"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/image_analytic_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"/>
                </FrameLayout>
                <com.sports.insider.ui.views.ResponsibleGamingBtn
                    android:id="@+id/responsibleGamingBtn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
