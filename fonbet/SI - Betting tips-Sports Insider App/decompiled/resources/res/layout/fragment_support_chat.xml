<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#20003f"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/input_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSupport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:reverseLayout="true"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_panel"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <EditText
            android:scrollbarAlwaysDrawVerticalTrack="false"
            android:scrollbarStyle="insideInset"
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/color48A3C5"
            android:gravity="start"
            android:id="@+id/supportInputField"
            android:background="@null"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="5"
            android:minLines="1"
            android:maxLength="300"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="1sp"
            android:inputType="textMultiLine"
            android:isScrollContainer="true"
            android:fadeScrollbars="true"
            android:overScrollMode="always"
            android:fontFamily="@font/arimo_regular"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:autofillHints="@string/supportHint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/supportOkButton"
            app:layout_constraintStart_toEndOf="@+id/ic_assets"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_assets"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_assets_ok"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/ic_assets"
            app:layout_constraintStart_toStartOf="@+id/ic_assets"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_assets_wait"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/ic_assets"
            app:layout_constraintStart_toStartOf="@+id/ic_assets"/>
        <FrameLayout
            android:id="@+id/supportOkButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:stateListAnimator="@animator/button_animator"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/supportOkButtonIc"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
