<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/colorWhite"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/place"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:lines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/montserrat_black"
        android:textAlignment="gravity"
        app:autoSizeMaxTextSize="22sp"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/backgroundView"
        android:background="@drawable/background_round_rating_user"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="@color/colorWhite"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/nickname"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:maxLength="25"
        android:fontFamily="@font/arimo_regular"
        android:textAlignment="gravity"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundView"
        app:layout_constraintEnd_toStartOf="@+id/coin"
        app:layout_constraintStart_toStartOf="@+id/backgroundView"
        app:layout_constraintTop_toTopOf="@+id/backgroundView"/>
    <View
        android:id="@+id/backgroundViewScore"
        android:background="@drawable/background_round_rating_score"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="-10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/score"
        app:layout_constraintStart_toStartOf="@+id/coin"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorWhite"
        android:gravity="end|center_vertical"
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/arimo_regular"
        android:textAlignment="gravity"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/coin"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/score"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
