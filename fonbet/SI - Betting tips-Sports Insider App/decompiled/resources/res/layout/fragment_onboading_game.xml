<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_training"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/EditTextThemeOverlay"
        android:textColor="@color/colorWhite"
        android:textColorHighlight="@color/colorWhite"
        android:textColorHint="@color/colorWhite"
        android:id="@+id/username_text_input_layout"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:hint="User name"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:boxStrokeColor="@color/colorWhite"
        app:counterEnabled="true"
        app:counterMaxLength="25"
        app:counterTextAppearance="@style/HintTextAppearance"
        app:errorTextAppearance="@style/ErrorTextAppearance"
        app:hintEnabled="true"
        app:hintTextAppearance="@style/HintTextAppearance"
        app:hintTextColor="@color/colorWhite"
        app:layout_constraintBottom_toTopOf="@+id/btn_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/EditTextThemeOverlay">
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="@color/colorWhite"
            android:textColorHighlight="@color/colorWhite"
            android:textColorHint="@color/colorWhite"
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="25"
            android:inputType="textPersonName"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/shadow_light_bt_background"
        android:layout_width="0dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_frame"/>
    <FrameLayout
        android:id="@+id/btn_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toTopOf="@+id/space_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton
            android:textSize="20sp"
            android:textColor="#20003f"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/btn_vip"
            android:paddingTop="16dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next"
            android:textAllCaps="false"
            android:fontFamily="@font/arimo_bold"
            android:textAlignment="gravity"
            android:paddingStart="49dp"
            android:paddingEnd="48dp"
            android:stateListAnimator="@animator/button_animator"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/space_nav"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
