<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/root_scroll"
            android:background="#20003f"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/today_prediction_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/match_image"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                    <com.sports.insider.ui.views.ExpressGradientView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.94"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/prediction_linear_exp"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp">
                        <TextView
                            android:textSize="36sp"
                            android:textColor="@color/colorWhite"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:text="@string/express_prediction_vertical"
                            android:fontFamily="@font/arimo_bold"
                            android:textAlignment="gravity"/>
                        <TextView
                            android:textSize="36sp"
                            android:textColor="@color/colorWhite"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/exp_k"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:fontFamily="@font/arimo_bold"/>
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/status_layout_exp"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorWhite"
                                android:gravity="center"
                                android:id="@+id/timer_title_exp"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/until_beginning"
                                android:fontFamily="@font/arimo_bold"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorWhite"
                                android:gravity="center"
                                android:id="@+id/timer_str_exp"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/arimo_bold"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="28sp"
                            android:textColor="@color/colorWhite"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/exp_match_day"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:fontFamily="@font/arimo_bold"/>
                    </LinearLayout>
                </FrameLayout>
                <com.sports.insider.ui.views.StateGameView
                    android:id="@+id/statusGamePrediction"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/root_game_info"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/express_banner"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/image_express_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"/>
                    <com.sports.insider.ui.views.FrameGradientWithHead
                        android:id="@+id/frame_express_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:background_color_wh="@android:color/transparent"
                        app:end_color_wh="#ffffff"
                        app:fullGradient_wh="true"
                        app:start_color_wh="#ffffff">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="36sp"
                                android:textColor="#151515"
                                android:gravity="center"
                                android:id="@+id/titleBanner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="4dp"
                                android:text="@string/do50k"
                                android:fontFamily="@font/arimo_bold"
                                android:textAlignment="gravity"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="#151515"
                                android:gravity="center"
                                android:id="@+id/textBanner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="16dp"
                                android:text="@string/DelayStavkaBonus"
                                android:fontFamily="@font/arimo_regular"
                                android:textAlignment="gravity"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"/>
                            <com.google.android.material.button.MaterialButton
                                android:textSize="18sp"
                                android:textColor="#151515"
                                android:gravity="center"
                                android:layout_gravity="bottom|center_horizontal"
                                android:id="@+id/btnBanner"
                                android:background="@drawable/btn_gold_banner"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:text="@string/DelayStavkaBonusBtn"
                                android:textAllCaps="true"
                                android:fontFamily="@font/arimo_bold"
                                android:textAlignment="gravity"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:stateListAnimator="@animator/button_animator"
                                app:backgroundTint="@null"/>
                        </LinearLayout>
                    </com.sports.insider.ui.views.FrameGradientWithHead>
                </FrameLayout>
                <com.sports.insider.ui.views.AnalyticsBackground
                    android:orientation="vertical"
                    android:id="@+id/rootAnalytics"
                    android:paddingTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.sports.insider.ui.views.PredictionLabelView
                        android:id="@+id/labelPrediction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                    <com.sports.insider.ui.views.ShadowLayoutSimple
                        android:layout_gravity="center"
                        android:id="@+id/shadowLayoutAnalyticsShort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:layout_marginHorizontal="12dp"
                        app:sl_cornerRadius="18dp"
                        app:sl_shadowLimit="8dp"
                        app:sl_shadowOffsetX="0dp"
                        app:sl_shadowOffsetY="3dp">
                        <com.sports.insider.ui.views.AnalyticsShortView
                            android:id="@+id/analyticsShort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:layout_marginBottom="25dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"/>
                    </com.sports.insider.ui.views.ShadowLayoutSimple>
                    <com.sports.insider.ui.views.AnalyticsView
                        android:id="@+id/analytics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                </com.sports.insider.ui.views.AnalyticsBackground>
                <com.sports.insider.ui.views.ResponsibleGamingBtn
                    android:id="@+id/responsibleGamingBtn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
