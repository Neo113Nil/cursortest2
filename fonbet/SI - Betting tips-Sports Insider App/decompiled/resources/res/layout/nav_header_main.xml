<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/navHeaderMain"
    android:background="@color/colorNavigate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/menuNavViewPage"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="1dp"
                android:scaleType="centerInside"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/ic_monetization"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/gray_cbcbcb"
                android:gravity="center_vertical"
                android:paddingBottom="2dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/personal_bonus"
                android:fontFamily="@font/arimo_regular"
                android:layout_marginStart="85dp"
                android:layout_marginEnd="32dp"/>
            <com.sports.insider.ui.views.LineDivGradientView
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/menuNavKindOfSport"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="1dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/ic_apps"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/arrow_view"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="1dp"
                android:scaleType="centerInside"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/ic_expand_more_white_24dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/gray_cbcbcb"
                android:gravity="center_vertical"
                android:paddingBottom="2dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/KindOfSport"
                android:fontFamily="@font/arimo_regular"
                android:layout_marginStart="85dp"
                android:layout_marginEnd="32dp"/>
            <com.sports.insider.ui.views.LineDivGradientView
                android:layout_gravity="bottom"
                android:id="@+id/menuNavKindOfSportGradient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/category_list_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <com.sports.insider.ui.views.MenuCategory
                android:id="@+id/category_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/menuNavLive"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="1dp"
            android:scaleType="centerInside"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="16dp"
            app:srcCompat="@drawable/ic_live"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray_cbcbcb"
            android:gravity="center_vertical"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/live_dash_predictions"
            android:fontFamily="@font/arimo_regular"
            android:layout_marginStart="85dp"
            android:layout_marginEnd="32dp"/>
        <com.sports.insider.ui.views.LineDivGradientView
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/menuNavAcademy"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="1dp"
            android:scaleType="centerInside"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="16dp"
            app:srcCompat="@drawable/ic_si_academy"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray_cbcbcb"
            android:gravity="center_vertical"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/training00learning"
            android:fontFamily="@font/arimo_regular"
            android:layout_marginStart="85dp"
            android:layout_marginEnd="32dp"/>
        <com.sports.insider.ui.views.LineDivGradientView
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</LinearLayout>
