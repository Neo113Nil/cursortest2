<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="43sp"
        android:textColor="@color/colorWhite"
        android:gravity="center"
        android:id="@+id/title_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textAlignment="gravity"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintBottom_toTopOf="@+id/sub_title_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/colorWhite"
        android:gravity="center"
        android:id="@+id/sub_title_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:includeFontPadding="false"
        android:textAlignment="gravity"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintBottom_toTopOf="@+id/desc"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#f0f0f0"
        android:gravity="center"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textAlignment="gravity"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ic_si_academy_background"
        android:visibility="gone"
        android:layout_width="57dp"
        android:layout_height="55dp"
        app:layout_constraintBottom_toBottomOf="@+id/ic_si_academy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ic_si_academy"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="35.53dp"
        android:layout_marginTop="29dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
