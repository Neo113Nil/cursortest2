<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_forecast"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/match_image"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/backGradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sports.insider.ui.views.PredictionGradientView
        android:id="@+id/backGradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/forecast_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/colorWhite"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/league"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:textAllCaps="false"
        android:fontFamily="@font/arimo_bold"
        android:textAlignment="gravity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/time_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/names">
        <TextView
            android:textSize="30sp"
            android:textColor="@color/colorWhite"
            android:id="@+id/match_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:alpha="1"
            android:fontFamily="@font/arimo_regular"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/colorWhite"
            android:id="@+id/match_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:fontFamily="@font/arimo_bold"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flags"
        android:paddingTop="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/league">
        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/frameLayout2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/flag_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/frameLayout2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frameLayout"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/flag_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/names"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flags">
        <TextView
            android:textSize="22sp"
            android:textColor="@color/colorWhite"
            android:gravity="center"
            android:id="@+id/team_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:fontFamily="@font/arimo_regular"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/team_name_2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/colorWhite"
            android:gravity="center"
            android:id="@+id/team_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:fontFamily="@font/arimo_regular"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/team_name_1"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/forecast_layout"
        android:paddingBottom="16dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:paddingStart="2.5dp"
        android:paddingEnd="2.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/root_analytics"
        app:layout_constraintEnd_toStartOf="@+id/time_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/names">
        <LinearLayout
            android:id="@+id/forecast_layout_clicked"
            android:background="@drawable/stroke_rate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="21dp"
            android:minWidth="150dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorWhite"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/forecast_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:fontFamily="@font/arimo_regular"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorWhite"
                android:layout_gravity="center_vertical"
                android:id="@+id/coefficient_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/arimo_bold"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/colorWhite"
            android:gravity="center"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@+id/own1"
            android:background="@drawable/our_forecast"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:text="@string/our_forecast"
            android:textAllCaps="false"
            android:fontFamily="@font/arimo_bold"
            android:textAlignment="gravity"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="16dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root_analytics"
        android:background="@color/colorWhite"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/div"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backGradient">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/root_analytics_short"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="27sp"
                android:textColor="@color/black"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/prediction"
                android:textAllCaps="false"
                android:fontFamily="@font/arimo_bold"
                android:textAlignment="gravity"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <com.sports.insider.ui.views.ShadowLayoutSimple
                android:layout_gravity="center"
                android:id="@+id/shadowLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginHorizontal="12dp"
                app:sl_cornerRadius="18dp"
                app:sl_shadowColor="#4dfa3636"
                app:sl_shadowLimit="8dp"
                app:sl_shadowOffsetX="0dp"
                app:sl_shadowOffsetY="3dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="25dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:textSize="20sp"
                        android:textColor="#242424"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/analytics_short"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/analytics_and_statistics"
                        android:textAllCaps="false"
                        android:fontFamily="@font/arimo_regular"
                        android:textAlignment="gravity"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="19dp"/>
                </LinearLayout>
            </com.sports.insider.ui.views.ShadowLayoutSimple>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/root_analytics_full"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <TextView
                android:textSize="27sp"
                android:textColor="@color/black"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Analytics"
                android:textAllCaps="false"
                android:fontFamily="@font/arimo_bold"
                android:textAlignment="gravity"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#242424"
                android:layout_gravity="center_vertical"
                android:id="@+id/analytics_full"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/analytics_and_statistics"
                android:textAllCaps="false"
                android:fontFamily="@font/arimo_regular"
                android:textAlignment="gravity"/>
        </LinearLayout>
    </LinearLayout>
    <com.sports.insider.ui.views.LineDivGradientView
        android:id="@+id/div"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/root_analytics"/>
</androidx.constraintlayout.widget.ConstraintLayout>
