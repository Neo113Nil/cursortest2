<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/today_prediction_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="#000000"
    app:cardCornerRadius="20dp">
    <com.sports.insider.ui.views.ExpressGradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/prediction_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="25sp"
                android:textColor="@color/colorWhite"
                android:gravity="start"
                android:layout_gravity="start"
                android:id="@+id/titleType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/Express"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="start"
                android:layout_gravity="end"
                android:orientation="vertical"
                android:id="@+id/time_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="15dp">
                <TextView
                    android:textSize="30sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/match_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:includeFontPadding="false"
                    android:alpha="1"/>
                <TextView
                    android:textSize="30sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/match_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/colorWhite"
                android:id="@+id/total_rate_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/Total_ratio"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="25sp"
                android:textColor="@color/colorWhite"
                android:id="@+id/rate_express_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/total_rate_tv"/>
            <com.sports.insider.ui.views.WhiteRoundBackgroundHolder
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/status"
                app:layout_constraintEnd_toEndOf="@+id/status"
                app:layout_constraintStart_toStartOf="@+id/status"
                app:layout_constraintTop_toTopOf="@+id/status"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#3b3b3b"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/status"
                android:padding="8dp"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:textAlignment="gravity"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="11dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="15dp">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/time_left_fl"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1">
                <com.sports.insider.ui.views.WhiteBorderRoundBackgroundHolder
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"
                    android:id="@+id/time_left"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:textAlignment="gravity"/>
            </FrameLayout>
            <View
                android:id="@+id/time_left_div_state_info"
                android:layout_width="13dp"
                android:layout_height="45dp"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/state_info_fl"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1">
                <com.sports.insider.ui.views.WhiteRoundBackgroundHolder
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="#3b3b3b"
                    android:gravity="center"
                    android:id="@+id/state_info"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:textAlignment="gravity"
                    app:autoSizeMaxTextSize="17sp"
                    app:autoSizeMinTextSize="5sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
