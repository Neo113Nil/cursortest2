<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_main_activity"
    android:background="#20003f"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center_vertical"
                    android:id="@+id/profile_title"
                    android:paddingTop="38dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/account"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/profile_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:layout_marginEnd="16dp">
                <com.sports.insider.ui.views.AvatarView
                    android:id="@+id/avatar"
                    android:layout_width="77dp"
                    android:layout_height="77dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:textSize="17sp"
                        android:textStyle="normal"
                        android:textColor="@color/colorWhite"
                        android:ellipsize="end"
                        android:id="@+id/user_data_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:lineSpacingExtra="8sp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="#cbcbcb"
                        android:id="@+id/user_email_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:lineSpacingExtra="6sp"/>
                </LinearLayout>
                <com.sports.insider.ui.views.IcNextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
            <com.sports.insider.ui.views.LineDivGradientView
                android:id="@+id/div_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_profile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/support"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/supportSendMailFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="13dp"
                android:minHeight="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="14dp">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/colorWhite"
                        android:id="@+id/tvSupport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/technical_support"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#cbcbcb"
                        android:ellipsize="end"
                        android:id="@+id/tvSupportDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/we_are_always_happy_to_help_you"
                        android:maxLines="2"/>
                </LinearLayout>
                <com.sports.insider.ui.views.IcNextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
            <com.sports.insider.ui.views.LineDivGradientView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center_vertical"
                    android:id="@+id/tvLanguageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/language"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lang_linear"
                android:paddingTop="17dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="14dp">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/colorWhite"
                        android:id="@+id/current_lang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/en_lang"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#cbcbcb"
                        android:ellipsize="end"
                        android:id="@+id/current_lang_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/en_lang"
                        android:maxLines="2"/>
                </LinearLayout>
                <com.sports.insider.ui.views.IcNextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/frameAlternativePayment"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.sports.insider.ui.views.LineDivGradientView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/colorWhite"
                        android:gravity="center_vertical"
                        android:id="@+id/tvCP"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Альтернативная оплата"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/elementCloudPaymentPriority"
                    android:paddingTop="17dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="14dp">
                        <TextView
                            android:textSize="17sp"
                            android:textColor="@color/colorWhite"
                            android:id="@+id/titleCloudPaymentPriority"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Оплата банковской картой"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#cbcbcb"
                            android:ellipsize="end"
                            android:id="@+id/textCloudPaymentPriority"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Приоритет оплаты банковской картой"
                            android:maxLines="2"/>
                    </LinearLayout>
                    <com.sports.insider.ui.views.SwitchButton
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/cloudPaymentPrioritySwitch"
                        android:layout_width="45dp"
                        android:layout_height="26dp"
                        app:sb_checked="false"
                        app:sb_show_indicator="false"/>
                </LinearLayout>
            </LinearLayout>
            <com.sports.insider.ui.views.LineDivGradientView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/memoryClearDataFrame"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/colorWhite"
                        android:gravity="center_vertical"
                        android:id="@+id/tvMemory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/memory"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/clearRepoAppFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="13dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="14dp">
                        <TextView
                            android:textSize="17sp"
                            android:textColor="@color/colorWhite"
                            android:id="@+id/tvClear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/clear_the_storage"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#cbcbcb"
                            android:ellipsize="end"
                            android:id="@+id/tvClearDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/deleting_all_application_data"
                            android:maxLines="2"/>
                    </LinearLayout>
                    <com.sports.insider.ui.views.IcNextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
                <com.sports.insider.ui.views.LineDivGradientView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center_vertical"
                    android:id="@+id/tvNotify"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/notifications"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/testPushFrame"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/colorWhite"
                    android:layout_gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Test_the_push_notification"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/colorWhite"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/pushNewPredictionSwitchDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_event_new_prognoz_text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <com.sports.insider.ui.views.SwitchButton
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/pushNewPredictionSwitch"
                    android:layout_width="45dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="16dp"
                    app:sb_checked="true"
                    app:sb_show_indicator="false"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/colorWhite"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/liveStateBtnSwitchDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/push_live_state"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <com.sports.insider.ui.views.SwitchButton
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/liveStateBtnSwitch"
                    android:layout_width="45dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="16dp"
                    app:sb_checked="true"
                    app:sb_show_indicator="false"/>
            </FrameLayout>
            <com.sports.insider.ui.views.LineDivGradientView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="25dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#9effffff"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/version_tv"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="gravity"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
