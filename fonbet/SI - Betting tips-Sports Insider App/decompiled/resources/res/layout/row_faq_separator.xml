<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#1b0035"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorWhite"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/separator_textRight"
            android:background="@drawable/our_forecast"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="23dp"
            android:textAllCaps="false"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/root_separator_text"
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ic_separator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/colorWhite"
                android:layout_gravity="center_vertical"
                android:id="@+id/separator_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/colorWhite"
        android:id="@+id/separator_description"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingBottom="27dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:paddingStart="27dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
