<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    style="@style/Theme.BacDZ">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الوقت المتبقي"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lyticintime"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp">
            <ImageView
                android:id="@+id/imageViewicon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_time_1"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/lytcntnt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/txttime_info"
        android:layout_below="@+id/lyticintime"
        android:isScrollContainer="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/txttime_mouth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عدد الأشهر : 8"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/tajawalbold"
                android:textAlignment="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                style="@style/Theme.BacDZ"/>
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/txttime_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عدد الأيام : 20"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/tajawalbold"
                android:textAlignment="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                style="@style/Theme.BacDZ"/>
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/txttime_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عدد الساعات : 30"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/tajawalbold"
                android:textAlignment="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                style="@style/Theme.BacDZ"/>
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/txttime_minute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عدد الدقائق : 50"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/tajawalbold"
                android:textAlignment="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                style="@style/Theme.BacDZ"/>
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/txttime_second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عدد الثواني : 00"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/tajawalbold"
                android:textAlignment="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                style="@style/Theme.BacDZ"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/orange"
        android:gravity="center"
        android:id="@+id/txttime_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="تاريخ إمتحان شهادة البكالوريا 07-06-2021"
        android:layout_above="@+id/edit_time_btn"
        android:lineSpacingExtra="2dp"
        android:fontFamily="@font/tajawalbold"
        android:textAlignment="center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <Button
        android:textSize="22sp"
        android:textColor="@color/white"
        android:id="@+id/edit_time_btn"
        android:background="@drawable/background_button"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginLeft="80dp"
        android:layout_marginRight="80dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        android:text="تعديل"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/tajawalregular"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
