<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layoutTask"
    android:background="@drawable/background_task"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_6sdp"
    android:foreground="@drawable/ripplenote"
    android:layoutDirection="rtl"
    android:layout_marginStart="@dimen/_6sdp"
    android:layout_marginEnd="@dimen/_6sdp"
    style="@style/Theme.BacDZ">
    <CheckBox
        android:enabled="false"
        android:textSize="15sp"
        android:gravity="center_vertical"
        android:id="@+id/checkboxTask"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:text=""
        android:fontFamily="@font/ubuntubold"
        android:layout_marginEnd="@dimen/_8sdp"
        android:buttonTint="@color/blue"
        style="@style/Theme.BacDZ"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lytReminder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layoutDirection="ltr"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp">
        <ImageView
            android:id="@+id/imgReminder"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_task_reminder"/>
        <TextView
            android:textSize="@dimen/_12ssp"
            android:layout_gravity="center_vertical"
            android:id="@+id/textDateTimeReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:includeFontPadding="false"
            android:fontFamily="@font/ubunturegular"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_8sdp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/_7ssp"
        android:id="@+id/textDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:text=""
        android:includeFontPadding="false"
        android:fontFamily="@font/ubunturegular"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        style="@style/Theme.BacDZ"/>
</LinearLayout>
