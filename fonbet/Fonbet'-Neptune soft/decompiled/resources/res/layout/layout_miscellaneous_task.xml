<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layoutMiscellaneousTask"
    android:background="@drawable/backgroundmiscellaneous"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    app:behavior_peekHeight="@dimen/_40sdp"
    app:layout_behavior="@string/bottom_sheet_behavior">
    <TextView
        android:textSize="@dimen/_13ssp"
        android:gravity="center"
        android:id="@+id/textMiscellaneous"
        android:paddingTop="@dimen/_4sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:text="خصائص"
        android:includeFontPadding="false"
        android:fontFamily="@font/tajawalbold"
        style="@style/Theme.BacDZ"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layoutAddReminder"
        android:background="@drawable/ripple"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35sdp">
        <TextView
            android:textSize="@dimen/_12ssp"
            android:paddingTop="@dimen/_4sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تعيين تذكير"
            android:includeFontPadding="false"
            android:fontFamily="@font/tajawalbold"
            android:layout_marginStart="@dimen/_42sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            style="@style/Theme.BacDZ"/>
        <ImageView
            android:id="@+id/miscellaneousReminder"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_task_reminder"
            android:layout_marginEnd="@dimen/_10sdp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layoutRemoveReminder"
        android:background="@drawable/ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35sdp">
        <TextView
            android:textSize="@dimen/_12ssp"
            android:paddingTop="@dimen/_4sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إلغاء التذكير"
            android:includeFontPadding="false"
            android:fontFamily="@font/tajawalbold"
            android:layout_marginStart="@dimen/_42sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            style="@style/Theme.BacDZ"/>
        <ImageView
            android:id="@+id/miscellaneousRemoveReminder"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_cancel"
            android:layout_marginEnd="@dimen/_10sdp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layoutDeleteTask"
        android:background="@drawable/ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35sdp">
        <TextView
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/tartorange"
            android:paddingTop="@dimen/_4sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حذف المهمة"
            android:includeFontPadding="false"
            android:fontFamily="@font/tajawalbold"
            android:layout_marginStart="@dimen/_42sdp"
            android:layout_marginEnd="@dimen/_10sdp"/>
        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_delete"
            android:layout_marginEnd="@dimen/_10sdp"
            app:tint="@color/tartorange"/>
    </LinearLayout>
</LinearLayout>
