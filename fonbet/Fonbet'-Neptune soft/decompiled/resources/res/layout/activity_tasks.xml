<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مهام"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:id="@+id/layoutSearch"
        android:background="@drawable/background_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ImageView
            android:id="@+id/img_clear"
            android:visibility="gone"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clear_search_content"
            android:layout_marginStart="@dimen/_20sdp"/>
        <EditText
            android:textSize="@dimen/_13ssp"
            android:gravity="center"
            android:id="@+id/edittextSearch"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:hint="بحث"
            android:includeFontPadding="false"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:fontFamily="@font/tajawalregular"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:importantForAutofill="no"
            style="@style/Theme.BacDZ"/>
        <ImageView
            android:id="@+id/img_search"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_search"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tasksRecyclerView"
        android:paddingBottom="@dimen/_6sdp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/lytquickaction"
        app:layout_constraintTop_toBottomOf="@+id/layoutSearch"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lytquickaction"
        android:background="@color/backgroundcomponentprimarylight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_43sdp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="center"
        android:id="@+id/floating_addtask"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add"
        android:layout_marginEnd="@dimen/_30sdp"
        android:backgroundTint="@color/blue"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/lytquickaction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lytquickaction"
        app:maxImageSize="@dimen/_28sdp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
