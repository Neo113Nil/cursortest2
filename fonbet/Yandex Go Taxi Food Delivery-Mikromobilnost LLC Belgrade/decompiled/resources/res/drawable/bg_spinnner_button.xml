    <item
        android:state_enabled="false"
        android:state_pressed="false">
        <shape android:shape="oval">
            <solid android:color="?attr/controlMinor"/>
        </shape>
    </item>
    <item
        android:state_enabled="false"
        android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/controlMinor"/>
        </shape>
