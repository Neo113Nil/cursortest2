    <item
        android:state_enabled="true"
        android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/controlMain"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/controlMain"/>
        </shape>
    </item>
</selector>
