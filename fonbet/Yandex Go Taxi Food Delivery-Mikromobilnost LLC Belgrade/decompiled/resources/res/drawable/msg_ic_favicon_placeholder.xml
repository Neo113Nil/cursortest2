<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:height="@dimen/orb_size_10m"
        android:width="@dimen/orb_size_10m">
        <shape android:shape="oval">
            <solid android:color="?attr/messagingIncomingLinkColor"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/orb_size_10m"
        android:width="@dimen/orb_size_10m">
        <drawable
            android:tint="?attr/messagingCommonAccentFgColor"
            android:drawable="@drawable/link_outline_md_regular"
            app:scaledPadding="4dp"
            class="com.yandex.messaging.base.view.DrawableTint"/>
    </item>
</layer-list>
