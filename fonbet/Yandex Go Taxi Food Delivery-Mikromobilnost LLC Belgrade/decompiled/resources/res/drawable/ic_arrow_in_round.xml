<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="?attr/textMain"/>
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_arrow"
        android:left="@dimen/arrow_navigation_left_offset"
        android:top="@dimen/arrow_navigation_top_offset"
        android:right="@dimen/arrow_navigation_right_offset"
        android:bottom="@dimen/arrow_navigation_bottom_offset"/>
</layer-list>
