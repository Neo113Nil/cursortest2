<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="@color/finsdk_button_primary_pressed">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/finsdk_default_corner_radius"/>
                    <solid android:color="@color/finsdk_button_primary_normal"/>
                </shape>
            </item>
            <item android:id="@android:id/background">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/finsdk_default_corner_radius"/>
                    <solid android:color="@color/finsdk_button_primary_normal"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/finsdk_default_corner_radius"/>
            <solid android:color="@color/finsdk_button_disabled"/>
        </shape>
    </item>
</selector>
