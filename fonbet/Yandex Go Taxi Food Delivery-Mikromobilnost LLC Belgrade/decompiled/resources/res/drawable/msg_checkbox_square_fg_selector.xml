<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="false"
        android:drawable="@android:color/transparent"/>
    <item android:state_checked="true">
        <layer-list>
            <item
                android:top="2dp"
                android:bottom="2dp"
                android:start="2dp"
                android:end="2dp">
                <drawable
                    android:tint="?attr/messagingCommonAccentFgColor"
                    android:drawable="@drawable/tick_outline_sm_regular"
                    class="com.yandex.messaging.base.view.DrawableTint"/>
            </item>
        </layer-list>
    </item>
</selector>
