<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingTop="@dimen/msg_bottomsheet_top_margin">
    <item android:top="@dimen/msg_bottomsheet_top_margin">
        <shape android:shape="rectangle">
            <solid android:color="?attr/messagingCommonBackgroundColor"/>
            <corners
                android:topLeftRadius="@dimen/msg_bottomsheet_corner_radius"
                android:topRightRadius="@dimen/msg_bottomsheet_corner_radius"/>
        </shape>
    </item>
    <item
        android:gravity="top|center_horizontal"
        android:height="4dp"
        android:width="32dp"
        android:top="2dp">
        <shape>
            <corners android:radius="2dp"/>
            <solid android:color="?attr/messagingCommonIconsSecondaryColor"/>
        </shape>
    </item>
</layer-list>
