<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/controlMinor">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="?attr/controlMinor"/>
            <stroke android:width="1dp"/>
            <corners android:radius="100dp"/>
            <padding
                android:left="12dp"
                android:right="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/textMain"/>
            <stroke
                android:width="1dp"
                android:color="?attr/line"/>
            <corners android:radius="100dp"/>
            <padding
                android:left="12dp"
                android:right="12dp"/>
        </shape>
    </item>
</ripple>
