<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <solid android:color="?attr/bgMinor"/>
                </shape>
            </item>
            <item android:drawable="@drawable/scooters_m_rounded_ripple_bg"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <solid android:color="?attr/bgMain"/>
                </shape>
            </item>
            <item android:drawable="@drawable/scooters_m_rounded_ripple_bg"/>
        </layer-list>
    </item>
</selector>
