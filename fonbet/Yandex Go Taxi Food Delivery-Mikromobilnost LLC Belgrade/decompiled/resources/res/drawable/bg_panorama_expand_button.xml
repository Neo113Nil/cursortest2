<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:height="@dimen/panorama_entry_point_height"
        android:width="@dimen/expand_panorama_entry_point_width">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:start="12dp">
        <bitmap
            android:gravity="start|bottom"
            android:src="0x7f081547"
            android:tint="@color/white"/>
    </item>
    <item>
        <ripple android:color="?attr/iconMinor">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/iconMinor"/>
                    <corners android:radius="@dimen/expand_panorama_entry_point_radius"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bgTransparent"/>
                    <corners android:radius="@dimen/expand_panorama_entry_point_radius"/>
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
