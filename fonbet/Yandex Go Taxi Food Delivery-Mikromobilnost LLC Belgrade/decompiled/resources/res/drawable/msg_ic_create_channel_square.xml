<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:height="@dimen/orb_size_18m"
        android:width="@dimen/orb_size_18m">
        <shape android:shape="rectangle">
            <solid android:color="?attr/messagingCommonAccentColor"/>
            <corners android:radius="@dimen/orb_rounding_5m"/>
        </shape>
    </item>
    <item android:gravity="center">
        <drawable
            android:tint="?attr/messagingCommonAccentFgColor"
            android:drawable="@drawable/newspaper_outline_sm_regular"
            app:scaledPadding="10dp"
            class="com.yandex.messaging.base.view.DrawableTint"/>
    </item>
</layer-list>
