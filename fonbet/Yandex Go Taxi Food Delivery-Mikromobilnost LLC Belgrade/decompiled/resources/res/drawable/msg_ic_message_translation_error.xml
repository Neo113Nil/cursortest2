<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:height="@dimen/orb_size_10m"
        android:width="@dimen/orb_size_10m">
        <shape android:shape="oval">
            <solid android:color="?attr/messagingIncomingBackgroundColor"/>
        </shape>
    </item>
    <item
        android:height="@dimen/orb_size_10m"
        android:width="@dimen/orb_size_10m">
        <drawable
            android:layout_width="match_parent"
            android:tint="?attr/messagingIncomingSecondaryColor"
            android:drawable="@drawable/translate_outline_sm_regular"
            app:scaledPadding="6dp"
            class="com.yandex.messaging.base.view.DrawableTint"/>
    </item>
</layer-list>
