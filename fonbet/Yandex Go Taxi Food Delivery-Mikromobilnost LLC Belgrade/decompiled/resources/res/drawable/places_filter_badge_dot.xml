<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/bgFloating"/>
            <size
                android:height="12dp"
                android:width="12dp"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="8dp"
        android:width="8dp">
        <shape android:shape="oval">
            <solid android:color="?attr/bgInvert"/>
        </shape>
    </item>
</layer-list>
