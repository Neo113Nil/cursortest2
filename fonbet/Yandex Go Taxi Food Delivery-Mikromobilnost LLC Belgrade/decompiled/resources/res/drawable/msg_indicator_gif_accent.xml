    <item android:gravity="center">
        <drawable
            android:tint="?attr/messagingChatImageTimeForegroundColor"
            android:drawable="@drawable/gif_outline_sm_regular"
            class="com.yandex.messaging.base.view.DrawableTint"/>
    </item>
</layer-list>
