<?xml version="1.0" encoding="utf-8"?>
<animated-rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:toDegrees="1080"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape
        android:shape="ring"
        android:innerRadiusRatio="3"
        android:thicknessRatio="20"
        android:useLevel="false">
        <size
            android:height="24dp"
            android:width="24dp"/>
        <gradient
            android:startColor="@color/pay_sdk_transparent"
            android:endColor="?attr/pay_sdk_progressColor"
            android:useLevel="false"
            android:angle="0"
            android:type="sweep"
            android:centerY="0.5"
            android:centerColor="@color/pay_sdk_transparent"/>
    </shape>
</animated-rotate>
