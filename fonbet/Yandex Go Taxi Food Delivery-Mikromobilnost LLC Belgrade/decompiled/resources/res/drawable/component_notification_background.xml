<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="300">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/bgMinor"/>
            <corners android:radius="@dimen/notification_component_corner_radius"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/notification_component_corner_radius"/>
            <solid android:color="?attr/bgMain"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/bgMain"/>
            <corners android:radius="@dimen/notification_component_corner_radius"/>
        </shape>
    </item>
</selector>
