<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:height="@dimen/orb_size_20m"
        android:width="@dimen/orb_size_20m">
        <shape android:shape="oval">
            <solid android:color="?attr/messagingIncomingButtonColor"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/orb_size_20m"
        android:width="@dimen/orb_size_20m">
        <drawable
            android:tint="?attr/messagingIncomingSecondaryColor"
            android:drawable="@drawable/pause_solid_md_regular"
            app:scaledPadding="12dp"
            class="com.yandex.messaging.base.view.DrawableTint"/>
    </item>
</layer-list>
