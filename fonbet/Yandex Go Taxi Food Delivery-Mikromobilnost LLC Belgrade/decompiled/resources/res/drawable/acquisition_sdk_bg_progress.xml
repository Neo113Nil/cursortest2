<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:toDegrees="1080"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape
        android:shape="ring"
        android:innerRadiusRatio="3"
        android:thicknessRatio="10"
        android:useLevel="false">
        <size
            android:height="32dp"
            android:width="32dp"/>
        <gradient
            android:startColor="@color/acquisition_sdk_color_transparent"
            android:endColor="@color/acquisition_sdk_color_blue_1200"
            android:useLevel="false"
            android:angle="0"
            android:type="sweep"
            android:centerY="0.5"
            android:centerColor="@color/acquisition_sdk_color_transparent"/>
    </shape>
</rotate>
