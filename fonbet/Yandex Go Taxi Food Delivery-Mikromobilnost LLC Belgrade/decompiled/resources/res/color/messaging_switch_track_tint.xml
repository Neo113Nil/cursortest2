<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:color="?attr/messagingSwitchTintOnEnabled"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:color="?attr/messagingSwitchTintOnDisabled"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:color="?attr/messagingSwitchTintOffEnabled"/>
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:color="?attr/messagingSwitchTintOffDisabled"/>
</selector>
