<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        android:id="@+id/swipeTransition"
        app:constraintSetEnd="@+id/end"
        app:constraintSetStart="@+id/start"
        app:duration="300"
        app:layoutDuringTransition="honorRequest">
        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@+id/recyclerContent"
            app:touchAnchorSide="top"/>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/headerBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerBarrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/backgroundGradient"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_savings_dashboard_v4_background_gradient_height"
            android:alpha="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/toolbarIconsContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_toolbar_height"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/headerTitleImage"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:alpha="1"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerTitle"
            app:layout_constraintEnd_toStartOf="@+id/headerTitle"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerTitle"/>
        <Constraint
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ybsdk_savings_header_content_top_margin"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/headerTitleImage"
            app:layout_constraintTop_toBottomOf="@+id/toolbarIconsContainer"/>
        <Constraint
            android:id="@+id/headerTotalAmountSpoiler"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:alpha="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerTitle"/>
        <Constraint
            android:id="@+id/headerShimmer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/headerDivView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerTotalAmountSpoiler"
            app:layout_goneMarginTop="0dp"/>
        <Constraint
            android:id="@+id/recyclerContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerBarrier"/>
        <Constraint
            android:id="@+id/contentShimmer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ybsdk_savings_shelves_vertical_margins"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recyclerContent"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/headerBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/toolbarIconsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/backgroundGradient"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_savings_dashboard_v4_background_gradient_height"
            android:alpha="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/toolbarIconsContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_toolbar_height"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/headerTitleImage"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:alpha="1"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerTitle"
            app:layout_constraintEnd_toStartOf="@+id/headerTitle"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerTitle"/>
        <Constraint
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/headerTitleImage"
            app:layout_constraintTop_toTopOf="@+id/toolbarIconsContainer"/>
        <Constraint
            android:id="@+id/headerTotalAmountSpoiler"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="-20dp"
            android:alpha="1"
            android:scaleX="0.3"
            android:scaleY="0.3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerTitle"/>
        <Constraint
            android:id="@+id/headerShimmer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ybsdk_savings_header_content_top_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/headerDivView"
            android:layout_width="0dp"
            android:layout_height="94dp"
            android:layout_marginTop="24dp"
            android:alpha="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerTotalAmountSpoiler"/>
        <Constraint
            android:id="@+id/recyclerContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerBackground"/>
        <Constraint
            android:id="@+id/contentShimmer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ybsdk_savings_shelves_vertical_margins"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recyclerContent"/>
    </ConstraintSet>
</MotionScene>
