<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/savingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            motion:layout_constraintBottom_toTopOf="@+id/spoilerSavingsBalanceView"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toEndOf="@+id/savingsTitleImage"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintVertical_bias="1"
            motion:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/savingsTitleImage"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            motion:layout_constraintBottom_toBottomOf="@+id/savingsTitle"
            motion:layout_constraintEnd_toStartOf="@+id/savingsTitle"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="@+id/savingsTitle"/>
        <Constraint
            android:id="@+id/spoilerSavingsBalanceView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHorizontal_bias="0"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/savingsTitle"
            motion:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/noAccountsTitle"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="1"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/savingsTitle"
            motion:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/titleViewsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:barrierDirection="bottom"
            motion:constraint_referenced_ids="spoilerSavingsBalanceView,noAccountsTitle"/>
        <Constraint
            android:id="@+id/savingsDescription"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="1"
            motion:layout_constrainedWidth="true"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toEndOf="@+id/savingsDescriptionBalance"
            motion:layout_constraintTop_toBottomOf="@+id/titleViewsBarrier"/>
        <Constraint
            android:id="@+id/savingsDescriptionBalance"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:layout_marginEnd="4dp"
            motion:layout_constraintBaseline_toBaselineOf="@+id/savingsDescription"
            motion:layout_constraintEnd_toStartOf="@+id/savingsDescription"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="30dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/savingsDescription"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/collapsed"
        motion:deriveConstraintsFrom="@+id/start">
        <Constraint
            android:id="@+id/savingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            motion:layout_constraintBottom_toTopOf="@+id/spoilerSavingsBalanceView"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toEndOf="@+id/savingsTitleImage"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintVertical_bias="1"
            motion:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/savingsTitleImage"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            motion:layout_constraintBottom_toBottomOf="@+id/savingsTitle"
            motion:layout_constraintEnd_toStartOf="@+id/savingsTitle"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="@+id/savingsTitle"/>
        <Constraint
            android:id="@+id/spoilerSavingsBalanceView"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:scaleX="0.3"
            android:scaleY="0.3"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/savingsTitle"
            motion:layout_constraintVertical_bias="1"
            motion:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/savingsDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            motion:layout_constrainedWidth="true"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toEndOf="@+id/savingsDescriptionBalance"
            motion:layout_constraintTop_toBottomOf="@+id/titleViewsBarrier"/>
        <Constraint
            android:id="@+id/savingsDescriptionBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:layout_marginEnd="4dp"
            motion:layout_constraintBaseline_toBaselineOf="@+id/savingsDescription"
            motion:layout_constraintEnd_toStartOf="@+id/savingsDescription"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/noAccountsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:scaleX="0.3"
            android:scaleY="0.3"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/savingsTitle"
            motion:layout_constraintVertical_bias="1"
            motion:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/titleViewsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:barrierDirection="bottom"
            motion:constraint_referenced_ids="spoilerSavingsBalanceView,noAccountsTitle"/>
        <Constraint
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-10dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/spoilerSavingsBalanceView"/>
    </ConstraintSet>
    <Transition
        android:id="@+id/savingsDashboardCollapseTransition"
        motion:constraintSetEnd="@+id/collapsed"
        motion:constraintSetStart="@+id/start"
        motion:layoutDuringTransition="honorRequest"
        motion:motionInterpolator="easeInOut">
        <OnSwipe
            motion:dragDirection="dragUp"
            motion:touchAnchorId="@+id/recycler"
            motion:touchAnchorSide="top"/>
    </Transition>
</MotionScene>
