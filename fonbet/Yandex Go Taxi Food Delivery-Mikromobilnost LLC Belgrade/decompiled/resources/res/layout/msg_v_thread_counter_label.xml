<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonAccentTextColor"
        android:gravity="center_vertical"
        android:id="@+id/counter"
        android:background="@drawable/msg_reactions_shadow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:text="1 ответ"
        android:drawableRight="@drawable/msg_ic_mention_outline"
        android:drawablePadding="4dp"
        android:fontFamily="@font/ya_medium"
        android:paddingStart="10dp"
        android:paddingEnd="2dp"
        android:elevation="2dp"
        android:outlineSpotShadowColor="?attr/messagingCommonElevationShadowColor"
        android:outlineAmbientShadowColor="?attr/messagingCommonElevationShadowColor"
        app:drawableEndCompat="@drawable/msg_ic_mention_outline"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/dot"
        android:background="@drawable/msg_thread_counter_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="-2dp"
        android:layout_marginEnd="-2dp"
        android:elevation="2dp"/>
</FrameLayout>
