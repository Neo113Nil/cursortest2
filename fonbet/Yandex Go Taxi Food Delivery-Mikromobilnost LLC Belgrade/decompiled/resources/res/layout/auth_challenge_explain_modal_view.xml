<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/auth_challenge_explain_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_show_close_button="true"
        app:component_show_navigation_button="false"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/auth_challenge_explain_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_title="@string/auth_challenge_explain_title"
        app:component_title_size="@dimen/component_text_size_toolbar"
        app:component_title_typeface="bold"
        app:layout_constraintTop_toBottomOf="@+id/auth_challenge_explain_toolbar"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/auth_challenge_explain_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_title="@string/auth_challenge_explain_subtitle"
        app:component_title_size="@dimen/component_text_size_body"
        app:layout_constraintTop_toBottomOf="@+id/auth_challenge_explain_title"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080acb"
        app:layout_constraintBottom_toTopOf="@+id/auth_challenge_explain_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/auth_challenge_explain_subtitle"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/auth_challenge_explain_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/auth_challenge_explain_login"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
