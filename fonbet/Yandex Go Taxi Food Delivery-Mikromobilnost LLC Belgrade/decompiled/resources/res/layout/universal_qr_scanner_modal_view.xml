<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.universal_qr_scanner.ui.UniversalQrScannerCameraPreview
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:layout_gravity="top"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="20sp"
            android:textColor="@color/component_white"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/universal_qr_scanner_title_margin_vertical"
            app:robotoFontStyle="medium"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <include
        android:id="@+id/universal_qr_scanner_camera_permission_screen"
        android:visibility="gone"
        layout="@layout/universal_qr_scanner_camera_permission_screen"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_button"
            android:background="@drawable/universal_qr_scanner_bg_rounded_48"
            android:layout_width="@dimen/universal_qr_scanner_camera_control_rounded_button_size"
            android:layout_height="@dimen/universal_qr_scanner_camera_control_rounded_button_size"
            android:src="@drawable/ic_arrow_back_24dp"
            android:scaleType="center"
            android:tint="@color/component_white"
            android:contentDescription="@string/common_back"
            android:layout_marginHorizontal="@dimen/universal_qr_scanner_camera_control_rounded_button_margin_horizontal"
            android:layout_marginVertical="@dimen/universal_qr_scanner_camera_control_rounded_button_margin_vertical"/>
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/torch_button"
            android:background="@drawable/universal_qr_scanner_bg_rounded_48"
            android:layout_width="@dimen/universal_qr_scanner_camera_control_rounded_button_size"
            android:layout_height="@dimen/universal_qr_scanner_camera_control_rounded_button_size"
            android:src="@drawable/universal_qr_scanner_ic_torch"
            android:scaleType="center"
            android:tint="@color/universal_qr_scanner_color_torch"
            android:layout_marginHorizontal="@dimen/universal_qr_scanner_camera_control_rounded_button_margin_horizontal"
            android:layout_marginVertical="@dimen/universal_qr_scanner_camera_control_rounded_button_margin_vertical"/>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoFrameLayout>
