<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/single_tariff_container_view"
    android:background="@drawable/bg_minor_rounded_24dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp"
    android:layout_marginStart="@dimen/section_margin_size"
    android:layout_marginEnd="@dimen/section_margin_size">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/single_tariff_icon"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:scaleType="fitEnd"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="96dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:ellipsize="end"
            android:id="@+id/single_tariff_title_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="@font/ys_text_regular"/>
        <TextView
            android:textSize="11sp"
            android:textColor="?attr/textMinor"
            android:id="@+id/single_tariff_subtitle_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_text_regular"/>
        <FrameLayout
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/single_tariff_price_binding"
                layout="@layout/intercity_dashboard_tariff_price_view"/>
        </FrameLayout>
    </LinearLayout>
</com.yandex.go.design.view.GoFrameLayout>
