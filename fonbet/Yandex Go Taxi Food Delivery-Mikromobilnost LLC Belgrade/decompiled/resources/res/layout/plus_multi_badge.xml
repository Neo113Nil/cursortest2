<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/go_design_m_space"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.plus.badge.CashbackAmountView
        android:id="@+id/plus_badge"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:cashbackTextColor="?attr/textInvert"
        app:cashbackTextSize="@dimen/component_text_size_caption"
        app:gradientOvalHeight="32dp"
        app:ovalHeight="32dp"
        app:shadowColor="@color/transparent"/>
</FrameLayout>
