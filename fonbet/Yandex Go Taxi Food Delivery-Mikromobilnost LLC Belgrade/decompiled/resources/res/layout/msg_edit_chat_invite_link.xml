<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/messaging_edit_chat_access_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/messaging_edit_chat_access_section"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.Settings.Text.Group"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/messaging_edit_chat_public_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="messaging_edit_publicity_divider, messaging_edit_chat_public_switch"/>
    <View
        android:id="@+id/messaging_edit_publicity_divider"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_access_title"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/messaging_edit_chat_public_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/public_channel_subtitle"
        app:drawableStartCompat="@drawable/msg_ic_lock"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_access_title"
        style="@style/Messaging.Settings.Switch"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/messaging_edit_chat_public_denied_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="messaging_edit_publicity_divider, messaging_edit_publicity_denied_message"/>
    <View
        android:id="@+id/messaging_edit_publicity_denied_divider"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_access_title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/messaging_edit_publicity_denied_message"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/messaging_edit_chat_access_denied"
        android:drawablePadding="12dp"
        android:fontFamily="@font/ys_text_regular"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:drawableStartCompat="@drawable/link_outline_md_regular"
        app:drawableTint="?attr/messagingCommonIconsSecondaryColor"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_publicity_denied_divider"/>
    <TextView
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/messaging_edit_channel_publicity_text"
        android:paddingTop="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/public_channel_info"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_public_switch"
        style="@style/Messaging.Settings.Item.Text"/>
    <TextView
        android:id="@+id/messaging_edit_chat_link_group_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/messaging_edit_chat_link_section"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_channel_publicity_text"
        style="@style/Messaging.Settings.Text.Group"/>
    <View
        android:id="@+id/messaging_edit_chat_link_divider"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_link_group_title"/>
    <com.yandex.messaging.views.PrefixEditText
        android:id="@+id/messaging_edit_chat_link"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:inputType="textNoSuggestions"
        android:paddingEnd="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_link_group_title"
        app:prefix="yandex.ru/chat/c/"
        style="@style/Messaging.EditText"/>
    <com.yandex.alicekit.core.views.FixedProgressBar
        android:id="@+id/messaging_edit_chat_link_status_progress"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/msg_anim_spinner"
        android:contentDescription="@string/messaging_edit_chat_link_status_progress_content_desc"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/messaging_edit_chat_link"
        app:layout_constraintRight_toRightOf="@+id/messaging_edit_chat_link"
        app:layout_constraintTop_toTopOf="@+id/messaging_edit_chat_link"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/messaging_edit_chat_link_status"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_link"/>
    <TextView
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/messaging_edit_chat_link_symbols"
        android:paddingTop="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/messaging_edit_chat_link_symbols"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_link_status"
        style="@style/Messaging.Settings.Item.Text"/>
    <TextView
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/messaging_edit_chat_link_stub"
        android:paddingTop="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/messaging_edit_chat_link_stub"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_link_symbols"
        style="@style/Messaging.Settings.Item.Text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/messaging_copy_link_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="messaging_invite_link_divider,                 messaging_copy_invite_link,                 messaging_share_invite_link"/>
    <View
        android:id="@+id/messaging_invite_link_divider"
        android:background="@drawable/msg_divider_settings_items"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_link_stub"/>
    <TextView
        android:id="@+id/messaging_copy_invite_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/copy_invite_link"
        app:drawableLeftCompat="@drawable/msg_ic_copy"
        app:drawableTint="?attr/messagingCommonIconsPrimaryColor"
        app:layout_constraintTop_toBottomOf="@+id/messaging_edit_chat_link_stub"
        style="@style/Messaging.Settings.Item.Text"/>
    <ImageView
        android:id="@+id/messaging_share_invite_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/messaging_share_invite_link_content_desc"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/messaging_copy_invite_link"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/messaging_copy_invite_link"
        app:srcCompat="@drawable/msg_ic_share"
        app:tint="?attr/messagingCommonIconsPrimaryColor"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/messaging_update_link_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="messaging_update_link_divider,                 messaging_update_link"/>
    <View
        android:id="@+id/messaging_update_link_divider"
        android:background="@drawable/msg_divider_settings_items"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/messaging_copy_invite_link"/>
    <TextView
        android:id="@+id/messaging_update_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_revoke_link"
        app:drawableTint="?attr/messagingCommonIconsPrimaryColor"
        app:layout_constraintTop_toBottomOf="@+id/messaging_copy_invite_link"
        style="@style/Messaging.Settings.Item.Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
