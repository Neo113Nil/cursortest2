<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/confirm_card_toolbar_stub"
        android:layout="@layout/confirm_card_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/confirm_card_cvn_explanation"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginBottom="24dp"
        android:text="@string/add_card_cvn_explain"
        android:layout_marginStart="@dimen/menu_entry_text_horizontal_padding"
        android:layout_marginEnd="@dimen/menu_entry_text_horizontal_padding"
        style="@style/RandomAmountExplanationText"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/confirm_card_info"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="margin"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title_size="@dimen/component_text_size_body"
        app:component_title_text_color="?attr/textMain"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:paddingTop="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_credit_card_hint_cvn"
        android:layout_marginStart="16dp"
        style="@style/TextAppearanceCardHint"/>
    <ru.yandex.taxi.widget.RobotoEditText
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/cvn"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/add_credit_card_description_cvn"
        style="@style/menu_entry_regular_padded_text"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>
    <com.yandex.go.payments.cards.ui.CardNumberPadView
        android:id="@+id/number_pad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"/>
</LinearLayout>
