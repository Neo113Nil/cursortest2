<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/success_group"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="title,subtitle,order_info,payment_method,pay"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/order_info"
        android:background="@drawable/bg_main_ripple"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <com.yandex.go.design.divider.CardDivider
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/order_info"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/payment_method"
        android:background="@drawable/bg_main_ripple"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/pay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        app:component_button_accent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/payment_method"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/loading_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="shimmer_1,shimmer_2,shimmer_3,shimmer_4,shimmer_5,shimmer_6,shimmer_7"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_1"
        android:layout_width="250dp"
        android:layout_height="27dp"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_2"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="@+id/subtitle"
        app:layout_constraintStart_toStartOf="@+id/subtitle"
        app:layout_constraintTop_toTopOf="@+id/subtitle"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_3"
        android:layout_width="183dp"
        android:layout_height="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/order_info"
        app:layout_constraintTop_toTopOf="@+id/order_info"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_4"
        android:layout_width="168dp"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/order_info"
        app:layout_constraintTop_toBottomOf="@+id/shimmer_3"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_5"
        android:layout_width="150dp"
        android:layout_height="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/payment_method"
        app:layout_constraintTop_toTopOf="@+id/payment_method"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_6"
        android:layout_width="96dp"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/payment_method"
        app:layout_constraintTop_toBottomOf="@+id/shimmer_5"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barCornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/pay"
        app:layout_constraintEnd_toEndOf="@+id/pay"
        app:layout_constraintStart_toStartOf="@+id/pay"
        app:layout_constraintTop_toTopOf="@+id/pay"/>
</com.yandex.go.design.view.GoConstraintLayout>
