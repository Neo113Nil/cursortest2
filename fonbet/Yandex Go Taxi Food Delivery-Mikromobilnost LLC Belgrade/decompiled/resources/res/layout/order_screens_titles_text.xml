<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/titles_container"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/order_screens_card_title_offset"
    android:layout_marginRight="@dimen/order_screens_card_title_offset">
    <ru.yandex.taxi.widget.accessibility.AccessibilityLiveRegionTextView
        android:textSize="20sp"
        android:textColor="?attr/textMain"
        android:id="@+id/order_screens_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="pnum, lnum"
        style="@style/OrderScreensTitle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/order_screens_subtitle_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="14sp"
            android:textColor="?attr/textMain"
            android:ellipsize="end"
            android:id="@+id/order_screens_subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:fontFeatureSettings="pnum, lnum"
            style="@style/OrderScreensSubtitle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/order_screens_cashback_navigation_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:srcCompat="@drawable/chevron_next"/>
    </LinearLayout>
</LinearLayout>
