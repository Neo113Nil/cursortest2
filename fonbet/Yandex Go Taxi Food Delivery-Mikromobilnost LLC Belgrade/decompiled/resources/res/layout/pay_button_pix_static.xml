<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/pay_button_view"
    android:background="?attr/payButtonGenericBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/pay_button_generic_min_width"
    android:minHeight="@dimen/pay_button_generic_min_height"
    android:filterTouchesWhenObscured="true">
    <ImageView
        android:id="@+id/pay_button_logo"
        android:layout_width="@dimen/pay_image_generic_width"
        android:layout_height="@dimen/pay_image_generic_height"
        android:src="?attr/payButtonGenericLogoImage"
        android:importantForAccessibility="no"/>
    <View
        android:background="?attr/payButtonGenericDividerColor"
        android:layout_width="@dimen/pay_button_generic_divider_width"
        android:layout_height="@dimen/pay_button_generic_divider_height"
        android:layout_margin="@dimen/pay_button_generic_divider_margin"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/pay_button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/direct_pix_payment"
        style="@style/WalletFragmentPayButtonTextStyle"/>
</LinearLayout>
