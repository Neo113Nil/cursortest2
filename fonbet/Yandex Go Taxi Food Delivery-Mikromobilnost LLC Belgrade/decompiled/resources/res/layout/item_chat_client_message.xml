<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">
    <include layout="@layout/item_chat_time"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="17sp"
        android:textColor="?attr/textOnControl"
        android:gravity="end"
        android:id="@+id/message_text"
        android:background="@drawable/chat_client_message_background"
        android:paddingLeft="16dp"
        android:paddingTop="7dp"
        android:paddingRight="16dp"
        android:paddingBottom="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        android:importantForAccessibility="no"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:robotoFontStyle="regular"/>
    <include layout="@layout/item_chat_error"/>
</LinearLayout>
