<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fixed_due_variants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:divider="@drawable/due_selector_divider"/>
    <View
        android:id="@+id/due_divider"
        android:background="@drawable/due_selector_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="30dp"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/time_picker_trigger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/summary_due_date_and_time"
        style="@style/RequirementItemContainer"/>
</merge>
