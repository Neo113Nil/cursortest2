<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/success_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:id="@+id/bus_container"
            android:background="?attr/bgMain"
            android:paddingBottom="11.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/bus_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/ble_divider"
                android:background="?attr/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="16dp"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/starting_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/destination_item"
                android:background="@drawable/bg_main_ripple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_trail_mode="navigation"/>
            <View
                android:id="@+id/stops_divider"
                android:background="?attr/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="16dp"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/counter_container"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/tickets_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ru.yandex.taxi.design.CounterComponent
                    android:id="@+id/tickets_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/div_table_padding_m"
                    android:layout_marginVertical="@dimen/div_table_padding_xs"/>
            </com.yandex.go.design.view.GoLinearLayout>
        </com.yandex.go.design.view.GoLinearLayout>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:id="@+id/payment_container"
            android:background="@drawable/footer_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yandex.go.design.view.GoConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/price_layout"
                android:background="?attr/bgTransparent"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/total_title"
                    android:background="?attr/bgTransparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/total_price_row"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yandex.go.design.view.GoLinearLayout
                    android:gravity="end|bottom"
                    android:orientation="horizontal"
                    android:id="@+id/total_price_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ru.yandex.taxi.design.ListItemComponent
                        android:id="@+id/total_price"
                        android:background="?attr/bgTransparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:component_subtitle_gravity="end"
                        app:component_title_gravity="end"/>
                    <com.yandex.go.design.view.GoLinearLayout
                        android:gravity="end|bottom"
                        android:orientation="horizontal"
                        android:id="@+id/total_price_discount_accessibility_group"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ru.yandex.taxi.widget.RobotoTextView
                            android:textColor="@color/component_green_normal"
                            android:id="@+id/total_price_discount"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:fontFamily="@font/ys_text_medium"/>
                        <com.yandex.go.design.view.GoConstraintLayout
                            android:id="@+id/total_price_original_container"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:layout_marginStart="4dp">
                            <ru.yandex.taxi.widget.RobotoTextView
                                android:textColor="?attr/textMinor"
                                android:id="@+id/total_price_original"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                android:fontFamily="@font/ys_text_medium"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <View
                                android:id="@+id/total_price_original_strikethrough"
                                android:background="@drawable/mt_checkout_price_strikethrough_line"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:rotation="-7.07"
                                android:importantForAccessibility="no"
                                app:layout_constraintBottom_toBottomOf="@+id/total_price_original"
                                app:layout_constraintEnd_toEndOf="@+id/total_price_original"
                                app:layout_constraintStart_toStartOf="@+id/total_price_original"
                                app:layout_constraintTop_toTopOf="@+id/total_price_original"/>
                        </com.yandex.go.design.view.GoConstraintLayout>
                    </com.yandex.go.design.view.GoLinearLayout>
                </com.yandex.go.design.view.GoLinearLayout>
            </com.yandex.go.design.view.GoConstraintLayout>
            <com.yandex.go.design.view.GoConstraintLayout
                android:id="@+id/bottom_payment_container"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yandex.go.design.view.GoFrameLayout
                    android:id="@+id/payment_icon_container"
                    android:visibility="gone"
                    android:layout_width="72dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="@dimen/go_design_s_space"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ru.yandex.taxi.widget.PlaceholderView
                        android:layout_gravity="center"
                        android:id="@+id/card_placeholder"
                        android:visibility="gone"
                        android:layout_width="36dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:placeholder_corner_radius="4dp"
                        app:placeholder_shimmering="true"
                        app:placeholder_type="rectangle"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/undefined_card_view"
                        android:visibility="gone"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_payment_undefined"
                        android:scaleType="center"
                        android:contentDescription="@string/scooters_offer_card_v2_a11y_payment_info_button_add"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.yandex.go.payments.design.composite.CompositePaymentIconsView
                        android:id="@+id/payment_info_view"
                        android:background="@drawable/bg_transparent_ripple"
                        android:visibility="gone"
                        android:layout_width="72dp"
                        android:layout_height="56dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:titleVisible="true"/>
                </com.yandex.go.design.view.GoFrameLayout>
                <ru.yandex.taxi.widget.ButtonsView
                    android:id="@+id/pay_button"
                    android:background="?attr/bgTransparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/payment_icon_container"
                    app:layout_constraintTop_toTopOf="parent"/>
            </com.yandex.go.design.view.GoConstraintLayout>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="11sp"
                android:textColor="?attr/textMinor"
                android:layout_gravity="center_horizontal"
                android:id="@+id/user_agreement"
                android:background="?attr/bgTransparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/go_design_s_space"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/go_design_m_space"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
