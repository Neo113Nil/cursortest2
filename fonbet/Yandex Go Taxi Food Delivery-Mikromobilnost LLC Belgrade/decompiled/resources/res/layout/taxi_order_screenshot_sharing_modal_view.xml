<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@drawable/bg_rounded_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    style="@style/BottomModalContentHolder">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="10dp"/>
    <ru.yandex.taxi.design.ListTitleComponent
        android:id="@+id/title_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="1dp"
        app:component_no_background="true"
        app:component_title_typeface="bold"
        app:component_vertical_padding="6dp"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/text_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/button_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_background_color="?attr/controlMain"
            app:component_button_accent="true"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControl"/>
    </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
</LinearLayout>
