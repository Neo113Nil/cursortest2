<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/solid_tariff_page_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/solid_summary_order_button_block_height"
    android:animateLayoutChanges="false">
    <FrameLayout
        android:id="@+id/tariff_page_source_destination_container"
        android:background="@drawable/round_section_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/summary_tariff_page_divider"
        android:background="?attr/bgMinor"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tariff_info_container"
        android:background="@drawable/round_section_bg"
        android:paddingTop="@dimen/go_design_m_space"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/select_destination_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:id="@+id/solid_tariff_page_name"
            android:layout_width="0dp"
            android:layout_height="@dimen/tariff_page_content_title_height"
            android:layout_marginStart="@dimen/go_design_m_space"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:layout_constraintEnd_toStartOf="@+id/solid_tariff_page_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/select_destination_container"
            style="@style/SummaryTariffPageTitle"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/solid_tariff_page_options_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/solid_tariff_page_car_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/solid_tariff_page_car_image"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/solid_tariff_page_car_image"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/summary_default_car_height"
            android:layout_marginTop="@dimen/go_design_m_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/solid_tariff_page_name"/>
        <ru.yandex.taxi.widget.ShimmeringRobotoTextView
            android:textSize="@dimen/component_text_size_header"
            android:id="@+id/solid_tariff_page_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/go_design_m_space"
            android:fontFeatureSettings="@string/go_default_font_settings"
            app:layout_constraintBaseline_toBaselineOf="@+id/solid_tariff_page_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:robotoFontStyle="light"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:layout_gravity="end"
            android:id="@+id/solid_tariff_page_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationY="@dimen/solid_summary_eta_margin"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/solid_tariff_page_price"
            app:robotoFontStyle="medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/solid_tariff_page_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="84dp"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:layout_constraintBottom_toTopOf="@+id/tariff_page_auction_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/solid_tariff_page_name"
            app:srcCompat="@drawable/ic_chevron_next_circle"/>
        <ru.yandex.taxi.requirements.ui.bubbles.RequirementsBubblesContainer
            android:id="@+id/common_tariff_page_bubbles_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/tariff_page_auction_view"
            app:layout_constraintTop_toBottomOf="@+id/solid_tariff_page_car_image"/>
        <ViewStub
            android:id="@+id/tariff_page_auction_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:layout_marginHorizontal="@dimen/go_design_s_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/common_tariff_page_bubbles_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/common_tariff_rest_content_divider"
        style="@style/SummaryTariffPageDivider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/common_tariff_rest_content"
        android:background="@drawable/round_section_bg_top"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/special_requirements_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/special_requirements_bottom_divider"
            android:visibility="gone"
            style="@style/SummaryTariffPageDivider"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/solid_tariff_page_alt_choice_container"
            android:background="@drawable/round_section_bg_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/solid_tariff_page_alt_choice_bottom_divider"
            android:visibility="gone"
            style="@style/SummaryTariffPageDivider"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/solid_tariff_page_glued_container"
            android:background="@drawable/round_section_bg_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/solid_tariff_page_glued_bottom_divider"
            android:visibility="gone"
            style="@style/SummaryTariffPageDivider"/>
        <ru.yandex.taxi.design.AutoDividerComponentList
            android:orientation="vertical"
            android:id="@+id/badges_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_middle_divider_type="margin"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/requirements_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <ViewStub
            android:id="@+id/solid_summary_delivery_explicit_comment_courier_requirement_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/solid_summary_delivery_explicit_comment_recepient_requirement_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
