<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/go_design_l_space"
    android:paddingBottom="@dimen/go_design_s_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/floating_input_height">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/component_text_size_title"
            android:textColor="?attr/textMain"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/superapp_search_error_description"
            android:fontFamily="@font/ys_text_bold"
            android:textAlignment="center"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/reload_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/superapp_search_error_reload_button"
            android:layout_marginHorizontal="68dp"
            app:component_button_accent="true"
            app:component_button_rounded_corners_radius="100dp"
            app:component_button_size="L"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/order_taxi_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/superapp_search_fallback_taxi_button"
            android:layout_marginHorizontal="68dp"
            android:layout_marginVertical="4dp"
            app:component_button_accent="true"
            app:component_button_rounded_corners_radius="100dp"
            app:component_button_size="L"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoFrameLayout>
