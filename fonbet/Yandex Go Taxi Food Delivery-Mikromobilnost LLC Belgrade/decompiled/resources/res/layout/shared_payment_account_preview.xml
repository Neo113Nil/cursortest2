<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/shared_payment_account_preview_scroll_view"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListTitleComponent
                android:ellipsize="end"
                android:id="@+id/shared_account_preview_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/shared_payment_account_preview_loader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ru.yandex.taxi.design.LoadingComponent
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <ru.yandex.taxi.design.LoadingComponent
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/shared_payment_account_preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ru.yandex.taxi.design.ListItemComponent
                        android:id="@+id/shared_payment_account_preview_members"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:component_divider_position="top"
                        app:component_divider_type="normal"
                        app:component_title="@string/shared_payments_members"
                        app:component_title_text_color="?attr/textMain"
                        app:component_trail_mode="navigation"/>
                    <ru.yandex.taxi.design.ListTextComponent
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:component_text="@string/shared_payments_choose_card_hint"/>
                    <ru.yandex.taxi.design.ButtonComponent
                        android:id="@+id/shared_payment_account_preview_select_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/shared_payments_choose_card"
                        style="@style/BottomEdgeButtonMarginStyle"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
