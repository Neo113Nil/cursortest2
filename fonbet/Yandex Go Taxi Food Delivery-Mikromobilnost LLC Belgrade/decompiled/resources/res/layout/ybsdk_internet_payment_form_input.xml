<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/internetPaymentsFormToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"/>
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/internetPaymentsFormToolbarSkeleton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/internetPaymentsFormToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internetPaymentsFormToolbar">
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="116dp"
            android:layout_height="20dp"/>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <com.ybsdk.widgets.common.SelectedItemFormView
        android:id="@+id/internetPaymentsFormItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/internetPaymentsFormToolbar"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/internetPaymentsFormInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/internetPaymentsFormItem"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/internetPaymentsFormButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/internetPaymentsFormErrorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internetPaymentsFormToolbar"/>
    <include
        android:id="@+id/internetPaymentsFormSkeleton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internetPaymentsFormToolbar"
        layout="@layout/ybsdk_internet_payment_form_input_loading"/>
</androidx.constraintlayout.widget.ConstraintLayout>
