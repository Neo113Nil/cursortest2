<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.fintechsdk.core.ui.impl.api.view.button.back.BackButtonView
        android:id="@+id/finsdkBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginStart="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/finsdkShimmerFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/finsdkBackButton"
        app:shimmer_base_alpha="1"
        app:shimmer_base_color="@color/finsdk_default_50"
        app:shimmer_colored="true"
        app:shimmer_highlight_color="@color/finsdk_shimmer_highlight_skeleton"
        app:shimmer_tilt="0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/finsdkShimmerOrderSum"
                android:background="@drawable/finsdk_bg_radius_12"
                android:layout_width="132sp"
                android:layout_height="34sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/finsdkShimmerCartInfo"
                android:background="@drawable/finsdk_bg_radius_8"
                android:layout_width="116sp"
                android:layout_height="18sp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="@+id/finsdkShimmerOrderSum"
                app:layout_constraintStart_toStartOf="@+id/finsdkShimmerOrderSum"
                app:layout_constraintTop_toBottomOf="@+id/finsdkShimmerOrderSum"/>
            <View
                android:id="@+id/finsdkShimmerPlusCardView"
                android:background="@drawable/finsdk_bg_radius_24"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="30dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/finsdkShimmerCartInfo"/>
            <View
                android:id="@+id/finsdkShimmerCards"
                android:background="@drawable/finsdk_bg_radius_20"
                android:layout_width="match_parent"
                android:layout_height="268dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/finsdkShimmerPlusCardView"/>
            <View
                android:id="@+id/finsdkShimmerAddCard"
                android:background="@drawable/finsdk_bg_radius_24"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/finsdkShimmerCards"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/finsdkBottomBar"
        android:background="@drawable/finsdk_bg_radius_top_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_base_alpha="1"
            app:shimmer_highlight_alpha="0.75"
            app:shimmer_tilt="0">
            <View
                android:background="@drawable/finsdk_bg_radius_16"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_base_alpha="1"
            app:shimmer_base_color="@color/finsdk_default_50"
            app:shimmer_colored="true"
            app:shimmer_highlight_color="@color/finsdk_shimmer_highlight_skeleton"
            app:shimmer_tilt="0">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:background="@drawable/finsdk_bg_radius_12"
                    android:layout_width="206sp"
                    android:layout_height="10sp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@drawable/finsdk_bg_radius_12"
                    android:layout_width="178sp"
                    android:layout_height="10sp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
