<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <ru.yandex.taxi.widget.TooltipView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/promo_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:body="@drawable/main_screen_promo_label_bg"
        app:text_color="@color/black"
        app:tip="@drawable/tooltip_pointer_white"
        app:tip_direction="down"
        app:tooltip_elevation="4dp"
        app:tooltip_max_width="@dimen/main_screen_promo_tooltip_max_width"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="end"
        android:id="@+id/promo_animation_package"
        android:layout_width="@dimen/main_screen_promo_animation_width"
        android:layout_height="@dimen/main_screen_promo_animation_height"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/promo_static_image"
        android:visibility="gone"
        android:layout_width="@dimen/main_screen_promo_animation_width"
        android:layout_height="@dimen/main_screen_promo_animation_height"/>
</LinearLayout>
