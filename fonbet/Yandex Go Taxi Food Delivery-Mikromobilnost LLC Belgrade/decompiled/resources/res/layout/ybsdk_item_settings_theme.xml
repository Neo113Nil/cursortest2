<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ybsdk_settings_item_top_margin"
    android:layout_marginBottom="@dimen/ybsdk_settings_item_bottom_margin">
    <com.ybsdk.feature.settings.internal.view.SettingsThemeView
        android:id="@+id/lightTheme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:ybsdk_theme_preview_image="@drawable/ybsdk_light_theme_preview"
        app:ybsdk_theme_title="@string/ybsdk_settings_theme_light_title"/>
    <com.ybsdk.feature.settings.internal.view.SettingsThemeView
        android:id="@+id/darkTheme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:ybsdk_theme_preview_image="@drawable/ybsdk_dark_theme_preview"
        app:ybsdk_theme_title="@string/ybsdk_settings_theme_dark_title"/>
    <com.ybsdk.feature.settings.internal.view.SettingsThemeView
        android:id="@+id/systemTheme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:ybsdk_theme_preview_image="@drawable/ybsdk_system_theme_preview"
        app:ybsdk_theme_title="@string/ybsdk_settings_theme_system_title"/>
</LinearLayout>
