<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ybsdk_savings_dashboard_header_background"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:backgroundTint="?attr/ybColor_fill_default_0">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/skeletonsContainer"
        android:paddingBottom="132dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/titleSkeleton"
            android:layout_width="80dp"
            android:layout_height="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="8dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/totalAmountSkeleton"
            android:layout_width="186dp"
            android:layout_height="@dimen/ybsdk_lineheight_numbers2"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleSkeleton"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/subtitleSkeleton"
            android:layout_width="120dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/totalAmountSkeleton"
            app:ybsdk_cornerRadius="8dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
