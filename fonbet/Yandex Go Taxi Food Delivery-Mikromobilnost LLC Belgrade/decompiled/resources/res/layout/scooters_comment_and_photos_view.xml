<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoConstraintLayout
        android:id="@+id/comment_frame"
        android:background="?attr/bgMinor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.KeyboardAwareRobotoEditText
            android:textSize="@dimen/component_text_size_body"
            android:textColorHint="?attr/textMinor"
            android:id="@+id/comment_edit_text"
            android:background="@null"
            android:focusable="true"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="@string/comment_hint"
            android:inputType="textMultiLine"
            android:imeOptions="actionDone"
            android:paddingHorizontal="@dimen/go_design_m_space"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toStartOf="@+id/take_photo_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yandex.go.design.view.GoImageButton
            android:id="@+id/take_photo_button"
            android:background="@drawable/scooters_comment_with_photos_camera_button_bg"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_camera_photo"
            android:contentDescription="@string/scooters_take_new_photo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="take_photo_button,comment_edit_text"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photos"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/scooters_photo_list"
            android:paddingHorizontal="12dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_constraintVertical_bias="1"/>
    </com.yandex.go.design.view.GoConstraintLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:textColor="?attr/textMain"
        android:id="@+id/try_again_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/scooters_feedback_try_upload_photos_again"
        app:component_background_color="?attr/bgMinor"/>
</merge>
