<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/imageSkeleton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        app:ybsdk_cornerRadius="12dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/textSkeleton"
        android:layout_width="132dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:ybsdk_cornerRadius="12dp"/>
</LinearLayout>
