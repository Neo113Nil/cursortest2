    android:id="@+id/dragAndDropOnboardingDivCellsContainer"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="2"
    android:elevation="2dp">
    <com.ybsdk.feature.savings.internal.views.SavingsDivCardView
        android:id="@+id/savingsDivCell1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <View
        android:layout_width="8dp"
        android:layout_height="match_parent"/>
    <com.ybsdk.feature.savings.internal.views.SavingsDivCardView
        android:id="@+id/savingsDivCell2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
