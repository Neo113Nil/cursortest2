<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/ultima_card"
        android:background="@drawable/bg_rounded_20_ultima"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space">
        <com.yandex.go.ultima_mode.ui.header.UltimaModeHeaderView
            android:orientation="vertical"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.yandex.go.ultima_mode.ui.progress_bar.UltimaModeProgressBarView
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/go_design_m_space"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
