<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="69dp"
    android:layout_marginHorizontal="@dimen/ybsdk_margin_upgrade_screen_content">
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:background="@drawable/ybsdk_skeleton_background_4"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="18dp"
        android:layout_marginEnd="70dp"
        app:layout_constraintBottom_toTopOf="@+id/underline"
        app:ybsdk_shimmer_auto_start="true"/>
    <View
        android:id="@+id/underline"
        android:background="?attr/ybColor_other_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
