<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/component_gray_550"
    android:paddingBottom="@dimen/universal_qr_scanner_target_frame_bottom_offset"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/universal_qr_scanner_camera_permission_screen_margin_horizontal">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="24sp"
        android:textColor="@color/component_white"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="@color/component_white"
        android:gravity="center"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/universal_qr_scanner_camera_permission_screen_subtitle_margin_top"
        app:robotoFontStyle="regular"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/settings_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/universal_qr_scanner_camera_permission_screen_button_margin_top"
        app:component_background_color="@color/white"
        app:component_button_accent="true"
        app:component_button_rounded_corners_radius="100dp"
        app:component_button_size="M"
        app:component_title_color="@color/component_gray_600"/>
</com.yandex.go.design.view.GoLinearLayout>
