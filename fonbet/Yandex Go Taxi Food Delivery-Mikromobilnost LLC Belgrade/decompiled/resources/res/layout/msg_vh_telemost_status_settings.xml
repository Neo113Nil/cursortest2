<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/msg_ripple_common"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:textSize="13dp"
        android:gravity="center"
        android:id="@+id/telemost_settings_emoji"
        android:background="@drawable/msg_bg_circle_emoji"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="��"
        android:backgroundTint="?attr/messagingUserStatusBgDnd"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/telemost_settings_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/telemost_settings_label"
        android:lines="1"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/telemost_settings_emoji"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.StatusNameText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
