<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.design.AutoDividerComponentList xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/components_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:component_bottom_divider_type="normal"
    app:component_middle_divider_type="margin">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/organization_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/organization_long_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/organization_tin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/organization_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/organization_ogrn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/organization_working_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/organization_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_trail_image="@drawable/ic_call"/>
</ru.yandex.taxi.design.AutoDividerComponentList>
