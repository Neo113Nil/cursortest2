<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:id="@+id/options_subtitle"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minHeight="40dp"
        android:paddingStart="@dimen/component_list_text_horizontal_padding"
        android:paddingEnd="@dimen/component_list_text_horizontal_padding"/>
    <ViewStub
        android:id="@+id/options_selector_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/options_info_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_trail_mode="navigation"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/description_layout"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textColor="?attr/textMinor"
            android:layout_gravity="center"
            android:id="@+id/options_description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/requirement_options_promo_image_top_margin"
            android:layout_marginBottom="@dimen/go_design_m_space"
            android:paddingStart="@dimen/component_list_text_horizontal_padding"
            android:paddingEnd="@dimen/component_list_text_horizontal_padding"/>
    </LinearLayout>
</merge>
