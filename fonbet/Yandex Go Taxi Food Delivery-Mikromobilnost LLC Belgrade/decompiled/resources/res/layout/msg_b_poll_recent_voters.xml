<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.messaging.views.AvatarStackView
        android:id="@+id/voters_portraits"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        app:asvImageBias="20dp"
        app:asvImageSize="24dp"/>
    <TextView
        android:id="@+id/is_anonymous_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/messenger_poll_message_is_anonymous_label"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.PollMessage.RecentVoters.Text"/>
    <View
        android:id="@+id/separator"
        android:background="@drawable/msg_separator_dot"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:layout_marginEnd="4dp"/>
    <TextView
        android:id="@+id/voters_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Messaging.PollMessage.RecentVoters.Text"/>
</LinearLayout>
