<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loadingShimmer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonview1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            app:ybsdk_cornerRadius="12dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonview2"
            android:layout_width="233dp"
            android:layout_height="13dp"
            android:layout_marginTop="7dp"
            app:ybsdk_cornerRadius="7dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonview3"
            android:layout_width="116dp"
            android:layout_height="13dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="23dp"
            app:ybsdk_cornerRadius="7dp"/>
    </LinearLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
