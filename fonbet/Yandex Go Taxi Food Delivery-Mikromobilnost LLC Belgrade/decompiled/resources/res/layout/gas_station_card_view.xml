<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:background="@drawable/bg_main_ripple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/fg_rect_stroke_round_28dp">
        <include
            android:id="@+id/gas_station_slot"
            layout="@layout/gas_station_slot"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="horizontal"
            android:paddingTop="@dimen/go_design_s_space"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp">
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/go_to_button_shimmer"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                app:barCornerRadius="16dp"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/go_via_button_shimmer"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/go_design_s_space"
                app:barCornerRadius="16dp"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/go_to_button"
                android:background="@drawable/bg_round_16dp_minor"
                android:padding="@dimen/go_design_s_space"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.yandex.go.design.view.GoImageView
                    android:id="@+id/go_to_button_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_finish"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_caption"
                    android:textColor="?attr/textMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigator_map_interaction_go_here_button_title"
                    android:fontFamily="@font/ya_bold"
                    app:robotoFontStyle="bold"/>
            </com.yandex.go.design.view.GoLinearLayout>
            <com.yandex.go.design.view.GoLinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/go_via_button"
                android:background="@drawable/bg_round_16dp_minor"
                android:padding="@dimen/go_design_s_space"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/go_design_s_space">
                <com.yandex.go.design.view.GoImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_plus_fill"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_caption"
                    android:textColor="?attr/textMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigator_map_interaction_go_via_button_title"
                    android:fontFamily="@font/ya_bold"
                    app:robotoFontStyle="bold"/>
            </com.yandex.go.design.view.GoLinearLayout>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
