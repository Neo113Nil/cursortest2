<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/safety_center_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="none"
        app:component_no_background="true"
        app:component_subtitle_gravity="center_horizontal"/>
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/safety_center_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListTitleComponent
                android:id="@+id/safety_center_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="margin">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/safety_center_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_no_background="true"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/safety_center_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_no_background="true"
                    app:component_trail_image="@drawable/location_btn"/>
            </ru.yandex.taxi.design.AutoDividerComponentList>
            <com.yandex.go.design.view.GoView
                android:id="@+id/safety_center_big_divider"
                android:background="@color/component_gray_100"
                android:layout_width="wrap_content"
                android:layout_height="12dp"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="margin">
                <ru.yandex.taxi.design.ListItemSwitchComponent
                    android:id="@+id/safety_center_sharing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_switch_track_color="@color/component_red_toxic"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/safety_center_add_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_trail_mode="navigation"/>
            </ru.yandex.taxi.design.AutoDividerComponentList>
        </LinearLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:layout_gravity="bottom"
        android:id="@+id/scroll_indicator_shadow"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="-24dp"
        app:scroll_view_id="@+id/safety_center_scroll_view"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="4dp"
        android:layout_weight="1"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:layout_gravity="bottom"
        android:id="@+id/safety_center_notify_family"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:component_background_color="?attr/controlMinor"
        app:component_title_color="?attr/textOnControlMinor"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:layout_gravity="bottom"
        android:id="@+id/safety_center_call"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:component_background_color="@color/component_red_toxic"
        app:component_button_icon="@drawable/ic_phone"
        app:component_button_icon_tint="true"
        app:component_title_color="@color/component_white"/>
</LinearLayout>
