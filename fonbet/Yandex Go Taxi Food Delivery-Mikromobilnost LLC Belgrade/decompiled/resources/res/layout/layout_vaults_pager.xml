<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="left"
            android:id="@+id/navigate_back"
            android:background="@drawable/background_vault_button"
            android:padding="8dp"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/ic_arrow_left"
            android:tint="@color/white"
            android:contentDescription="@string/common_back"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:layout_gravity="center"
            android:id="@+id/prize_list_button"
            android:paddingTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="@font/ys_text_medium"
            android:textAlignment="gravity"
            android:paddingHorizontal="14dp"
            app:component_background_color="@color/vault_button_background_color"
            app:component_button_rounded_corners_radius="100dp"
            app:component_title_color="@color/white"/>
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="end"
            android:id="@+id/navigate_forward"
            android:background="@drawable/background_vault_button"
            android:padding="8dp"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/white"
            android:contentDescription="@string/common_next"/>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoLinearLayout>
