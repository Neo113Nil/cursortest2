<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.SingleClickScrollView
        android:id="@+id/profile_scroll_view"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/profile_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/phone_item"
                android:background="@drawable/bg_main_ripple"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title="@string/settings_phone"
                app:component_trail_mode="navigation"
                app:component_trail_navigation_color="?attr/textMain"
                style="@style/ProfileListItem"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/name_item"
                android:background="@drawable/bg_main_ripple"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_subtitle_ellipsize_mode="end"
                app:component_subtitle_max_lines="2"
                app:component_trail_mode="navigation"
                app:component_trail_navigation_color="?attr/textMain"
                style="@style/ProfileListItem"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/rating_item"
                android:background="@drawable/bg_main_ripple"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_navigation_icon="@drawable/ic_info"
                app:component_trail_mode="none"
                style="@style/ProfileListItem"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/email_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_subtitle_text_color="?attr/textOnControl"
                app:component_title_text_color="?attr/textOnControl"
                app:component_trail_mode="navigation"
                app:component_trail_navigation_color="?attr/textOnControl"
                style="@style/ProfileListItem"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/yandex_plus_info"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/logout_item"
                android:background="@drawable/bg_main_ripple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/go_design_s_space"
                app:component_title="@string/profile_exit"/>
        </LinearLayout>
    </ru.yandex.taxi.widget.SingleClickScrollView>
    <ru.yandex.taxi.design.FloatingTitleToolbarComponent
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_tracked_view="@+id/profile_scroll_view"/>
</FrameLayout>
