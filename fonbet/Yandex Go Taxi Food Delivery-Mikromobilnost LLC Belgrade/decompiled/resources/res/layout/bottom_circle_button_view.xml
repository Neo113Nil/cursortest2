<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.buttons.LoadingIconCircleButton
        android:id="@+id/driver"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:component_circle_image="@drawable/ic_person"
        app:component_circle_image_tint="?attr/textOnControlMinor"/>
    <ru.yandex.taxi.widget.buttons.IconCircleButton
        android:id="@+id/safety_center"
        android:visibility="gone"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:component_circle_image="@drawable/ic_safety_center_24"
        app:component_circle_image_tint="?attr/textOnControlMinor"
        app:component_circle_title_autofit="true"/>
    <ru.yandex.taxi.widget.buttons.IconCircleButton
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:component_circle_button_badge_color="@color/component_red_normal"
        app:component_circle_button_badge_text_color="@color/component_white"
        app:component_circle_image="@drawable/ic_cross_close"
        app:component_circle_image_tint="?attr/textOnControlMinor"
        app:component_circle_title="@string/order_cancel"/>
    <ru.yandex.taxi.widget.buttons.IconCircleButton
        android:id="@+id/share"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:component_circle_image="@drawable/order_share"
        app:component_circle_image_tint="?attr/textOnControlMinor"
        app:component_circle_title="@string/order_options_share_route"/>
    <ru.yandex.taxi.widget.buttons.IconCircleButton
        android:id="@+id/make_another_order"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:component_circle_image="@drawable/order_make_another_order"
        app:component_circle_image_tint="?attr/textOnControlMinor"
        app:component_circle_title="@string/make_another_order_card_button_text"/>
    <ViewStub
        android:id="@+id/transport_info_button_stub"
        android:layout="@layout/transport_info_button_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
