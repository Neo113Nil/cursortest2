<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_title="@string/ybsdk_card_card_activation"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cardBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:scaleType="center"
        android:layout_marginHorizontal="@dimen/ybsdk_card_activation_horizontal_margin"
        app:layout_constraintBottom_toTopOf="@+id/statusText"
        app:layout_constraintDimensionRatio="@dimen/ybsdk_card_view_ratio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/labelCardNumber"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/ybsdk_card_card_pan_title"
        app:layout_constraintBottom_toTopOf="@+id/cardNumber"
        app:layout_constraintStart_toStartOf="@+id/cardNumber"
        style="@style/Widget.YB.Text.Caption1.Regular.Inverted"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/cardNumber"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="27dp"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        app:autoSizeMaxTextSize="@dimen/ybsdk_textsize_body1"
        app:autoSizeMinTextSize="@dimen/ybsdk_textsize_body3"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/cardBackground"
        app:layout_constraintStart_toStartOf="@+id/cardBackground"
        style="@style/Widget.YB.Text.Body1.Inverted"/>
    <View
        android:orientation="vertical"
        android:id="@+id/cvvGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardBackground"
        app:layout_constraintEnd_toEndOf="@+id/cardBackground"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/activeInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ybsdk_card_activation_input_bottom_margin"
        android:layout_marginHorizontal="@dimen/ybsdk_card_activation_input_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="@+id/cardBackground"
        app:layout_constraintEnd_toEndOf="@+id/cardBackground"
        app:layout_constraintStart_toStartOf="@+id/cardBackground"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:maxLines="3"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardBackground"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/buttonContinue"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_button_with_label_min_height"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/buttonBack"
        app:layout_goneMarginStart="24dp"
        app:ybsdk_buttonTitle="@string/ybsdk_card_button_next"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/buttonBack"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_button_with_label_min_height"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard"
        app:layout_constraintEnd_toStartOf="@+id/buttonContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:ybsdk_buttonTitle="@string/ybsdk_card_button_back"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Secondary.L"/>
    <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/loadingBackground"
        android:background="?attr/ybColor_background_primary"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/cardSkeleton"
            android:layout_width="match_parent"
            android:layout_height="216dp"
            android:layout_marginHorizontal="16dp"
            app:ybsdk_cornerRadius="20dp"/>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <View
        android:id="@+id/progressBackground"
        android:background="?attr/ybColor_background_primary"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="@dimen/ybsdk_size_progress_indicator"
        android:layout_height="@dimen/ybsdk_size_progress_indicator"
        android:layout_marginTop="136dp"
        app:layout_constraintBottom_toTopOf="@+id/progressTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progressBackground"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/YbSdk.Widget.WidgetsCommon.CircularProgressIndicatorLoader"/>
    <TextView
        android:gravity="center"
        android:id="@+id/progressTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ybsdk_card_card_activation_progress_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/progressSubtitle"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:gravity="center"
        android:id="@+id/progressSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ybsdk_card_card_activation_progress_subtitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/progressBackground"
        app:layout_constraintTop_toBottomOf="@+id/progressTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/progressGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="progressBar, progressBackground, progressSubtitle, progressTitle"/>
    <View
        android:id="@+id/successBackground"
        android:background="?attr/ybColor_background_primary"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activationSuccessIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="136dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/successTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/successBackground"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/ybsdk_ic_status_success"/>
    <TextView
        android:gravity="center"
        android:id="@+id/successTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ybsdk_card_card_activation_success_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/successSubtitle"
        app:layout_constraintTop_toBottomOf="@+id/activationSuccessIcon"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:gravity="center"
        android:id="@+id/successSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ybsdk_card_card_activation_success_subtitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/successBackground"
        app:layout_constraintTop_toBottomOf="@+id/successTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/setPinButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/skipPinButton"
        app:ybsdk_buttonTitle="@string/ybsdk_card_card_activation_set_pin"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/skipPinButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:ybsdk_buttonTitle="@string/ybsdk_pin_biometric_skip_button"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Secondary.L"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/successGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="successBackground, activationSuccessIcon, successSubtitle, successTitle, setPinButton, skipPinButton"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/pollingError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/pollingErrorGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="pollingError"/>
</androidx.constraintlayout.widget.ConstraintLayout>
