<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/shimmering_images_slider_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/go_design_m_space">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.widget.PlaceholderView
                android:id="@+id/shimmering_image_stub_first"
                android:layout_width="164dp"
                android:layout_height="164dp"
                app:placeholder_corner_radius="16dp"
                app:placeholder_shimmering="true"
                app:placeholder_type="rectangle"/>
            <View
                android:layout_gravity="start|bottom"
                android:background="@drawable/ic_places_org_preview_bg"
                android:layout_width="@dimen/organizations_preview_image_icon_bg_size"
                android:layout_height="@dimen/organizations_preview_image_icon_bg_size"/>
            <ru.yandex.taxi.widget.PlaceholderView
                android:layout_gravity="start|bottom"
                android:layout_width="@dimen/organizations_preview_image_icon_size"
                android:layout_height="@dimen/organizations_preview_image_icon_size"
                app:placeholder_corner_radius="@dimen/organizations_preview_image_icon_size"
                app:placeholder_shimmering="true"
                app:placeholder_type="rectangle"/>
        </FrameLayout>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/shimmering_image_stub_second"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:layout_marginStart="4dp"
            app:placeholder_corner_radius="16dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/shimmering_image_stub_third"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:layout_marginStart="4dp"
            app:placeholder_corner_radius="16dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </LinearLayout>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/shimmering_title"
        android:visibility="gone"
        android:layout_width="151dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:placeholder_corner_radius="16dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/shimmering_subtitle"
        android:visibility="gone"
        android:layout_width="108dp"
        android:layout_height="18dp"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:placeholder_corner_radius="16dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/shimmering_additional_info"
        android:visibility="gone"
        android:layout_width="124dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:placeholder_corner_radius="16dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/shimmering_tags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/go_design_m_space">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="77dp"
            android:layout_height="18dp"
            app:placeholder_corner_radius="6dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="77dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            app:placeholder_corner_radius="6dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="77dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            app:placeholder_corner_radius="6dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/shimmering_buttons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="@dimen/go_design_m_space">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="180dp"
            android:layout_height="40dp"
            app:placeholder_corner_radius="13dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            app:placeholder_corner_radius="13dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            app:placeholder_corner_radius="13dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            app:placeholder_corner_radius="13dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </LinearLayout>
</merge>
