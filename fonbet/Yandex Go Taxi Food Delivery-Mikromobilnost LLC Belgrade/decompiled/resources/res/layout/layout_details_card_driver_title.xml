<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/main_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFeatureSettings="pnum, lnum"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/rating_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="5dp"
        android:fontFeatureSettings="pnum, lnum"/>
    <com.yandex.go.taxi.order.details.v2.ui.view.item.driver.title.RideCardDriverSectionBadgesView
        android:layout_gravity="center_vertical"
        android:id="@+id/badges"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
    <com.yandex.go.design.view.GoView
        android:id="@+id/end_filler"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</merge>
