<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.design.RatingBarComponent
        android:layout_gravity="center_horizontal"
        android:id="@+id/rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:contentDescriptions="@array/rating_view_titles"
        app:starHeight="@dimen/order_screens_rate_stars_height"
        app:starWidth="@dimen/order_screens_rate_stars_width"
        style="@style/rating_bar"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="14sp"
        android:textColor="?attr/textMinor"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rating_hint_text"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>
</merge>
