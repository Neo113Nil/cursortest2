<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_vault_error"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:layout_marginHorizontal="16dp">
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_vault_fallback"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="24sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strongbox_data_load_failed_title"
            android:fontFamily="@font/ys_text_bold"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:textColor="?attr/textOnControl"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/refresh_button"
        android:background="?attr/controlMain"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:text="@string/strongbox_data_load_failed_button"
        android:fontFamily="@font/ys_text_medium"
        android:layout_marginHorizontal="8dp"/>
</com.yandex.go.design.view.GoFrameLayout>
