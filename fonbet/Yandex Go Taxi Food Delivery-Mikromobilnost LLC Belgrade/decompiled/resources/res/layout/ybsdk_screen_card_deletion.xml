<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewSwitcher
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.OperationProgressOverlayDialog
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.ybsdk.widgets.common.communication.CommunicationFullScreenView
            android:id="@+id/communicationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ViewSwitcher>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ybsdk_closeIconVisible="true"
        app:ybsdk_transparentBackground="true"/>
</FrameLayout>
