<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:divider="@drawable/divider_horizontal_4_dp"
    android:showDividers="middle"
    android:paddingHorizontal="@dimen/ai_bot_action_item_horizontal_padding"
    android:paddingVertical="@dimen/ai_bot_action_item_vertical_padding">
    <ImageView
        android:id="@+id/ai_bot_action_icon"
        android:layout_width="@dimen/ai_bot_action_icon_size"
        android:layout_height="@dimen/ai_bot_action_icon_size"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/ai_bot_action_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/ya_medium"/>
</LinearLayout>
