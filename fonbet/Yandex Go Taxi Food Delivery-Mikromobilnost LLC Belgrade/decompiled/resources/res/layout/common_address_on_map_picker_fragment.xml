<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/map_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item_height"
        app:component_no_background="true"
        app:component_title="@string/route_selector_map_hint"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_body"
        app:component_title_typeface="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/network_message_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/destination_address_title_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.yandex.taxi.widget.RobotoTextView
            android:id="@+id/network_message"
            style="@style/address_name_title"/>
        <include layout="@layout/enable_location_view"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_buttons_layout"
        android:background="@drawable/bg_round_modal_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.yandex.taxi.design.ListTitleComponent
            android:id="@+id/component_route_point_address_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/list_item_height"
            app:component_divider_position="bottom"
            app:component_divider_type="margin"
            app:component_no_background="true"
            app:component_subtitle_text_color="?attr/textMain"/>
        <ru.yandex.taxi.design.AddressInputComponent
            android:id="@+id/address_map_fragment_address_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_address_mode="view"/>
        <ru.yandex.taxi.design.AddressInputComponent
            android:id="@+id/address_map_fragment_address_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_address_mode="view"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/confirm_frame"
            android:background="?attr/bgMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp">
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/common_done"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                style="@style/OrderButtonStyle"/>
            <com.yandex.go.design.view.GoImageButton
                android:id="@+id/save_button"
                android:background="@drawable/bg_round_16dp_minor"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/go_design_m_space"
                android:src="@drawable/ic_bookmark_fill"
                android:tint="?attr/textOnControlMinor"
                android:layout_marginHorizontal="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <ru.yandex.taxi.design.BackButtonIconComponent
        android:id="@+id/back_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_buttons_layout"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.widget.floatbuttonholder.FloatButtonHolderLayout
        android:id="@+id/float_button_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_buttons_layout"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ru.yandex.taxi.widget.floatbuttonholder.RotatableFloatButton
        android:id="@+id/pickup_from_photo_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@+id/float_button_holder"
        app:layout_constraintEnd_toEndOf="parent"/>
    <FrameLayout
        android:id="@+id/modal_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/white_button_resting_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
