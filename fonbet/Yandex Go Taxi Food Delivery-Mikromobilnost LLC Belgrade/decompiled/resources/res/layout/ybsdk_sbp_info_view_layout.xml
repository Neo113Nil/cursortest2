<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/ybsdk_bottom_sheet_inset_height"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/sbpInfoToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_title="@string/ybsdk_deposit_sbp_top_up_instruction_label"/>
    <ImageView
        android:id="@+id/sbpInfoBackButton"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/ybsdk_clickable_icon_size"
        android:layout_height="@dimen/ybsdk_clickable_icon_size"
        android:scaleType="center"
        android:contentDescription="@string/ybsdk_common_accessability_back_title"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/sbpInfoToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sbpInfoToolbar"
        app:srcCompat="@drawable/ybsdk_ic_arrow_short_back"
        app:tint="?attr/ybColor_textIcon_primary"/>
    <com.ybsdk.widgets.common.NumberOptionView
        android:id="@+id/sbpInfoFirstStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/sbpInfoToolbar"
        app:ybsdk_content="@string/ybsdk_deposit_sbp_top_up_instruction_first_step"
        app:ybsdk_number="1"/>
    <com.ybsdk.widgets.common.NumberOptionView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/sbpInfoFirstStep"
        app:ybsdk_content="@string/ybsdk_deposit_sbp_top_up_instruction_second_step"
        app:ybsdk_number="2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
