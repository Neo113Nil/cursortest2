<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/discovery_payments_checkout_buttons_top_padding"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.yandex.go.design.view.GoFrameLayout
        android:background="@drawable/places_payments_checkout_buttons_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/go_design_s_space">
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/placeholder_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/header_placeholder"
                android:layout_width="match_parent"
                android:layout_height="@dimen/discovery_payments_checkout_buttons_header_placeholder_height"
                android:backgroundTint="?attr/controlMinor"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                android:layout_marginVertical="@dimen/discovery_payments_checkout_buttons_header_placeholder_vertical_margin"
                app:barCornerRadius="@dimen/go_design_m_space"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/button_placeholder"
                android:layout_width="match_parent"
                android:layout_height="@dimen/discovery_payments_checkout_buttons_button_placeholder_height"
                android:layout_marginTop="@dimen/discovery_payments_checkout_buttons_container_margin_top"
                android:backgroundTint="?attr/controlMinor"
                android:layout_marginHorizontal="@dimen/go_design_s_space"
                app:barCornerRadius="@dimen/go_design_m_space"/>
        </com.yandex.go.design.view.GoFrameLayout>
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/error_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_body"
                android:textColor="?attr/textMain"
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/discovery_payments_error_title"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                android:lineHeight="@dimen/discovery_payments_checkout_buttons_error_title_line_height"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/retry_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/discovery_payments_checkout_buttons_container_margin_top"
                android:text="@string/webview_error_reload"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/go_design_s_space"
                app:component_background_color="?attr/controlMain"
                app:component_button_size="L"/>
        </com.yandex.go.design.view.GoFrameLayout>
        <com.yandex.go.design.view.GoConstraintLayout
            android:id="@+id/content_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yandex.go.design.view.GoFrameLayout
                android:id="@+id/content_container_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/go_design_s_space"
                android:layout_marginBottom="@dimen/go_design_m_space"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/payment_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_body"
                    android:textColor="?attr/textMain"
                    android:layout_gravity="bottom"
                    android:id="@+id/total_price_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:lineHeight="@dimen/discovery_payments_checkout_buttons_total_price_title_line_height"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_subtitle"
                    android:textColor="?attr/textMain"
                    android:layout_gravity="end"
                    android:id="@+id/total_price_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:lineHeight="@dimen/discovery_payments_checkout_buttons_total_price_value_line_height"
                    app:robotoFontStyle="medium"/>
            </com.yandex.go.design.view.GoFrameLayout>
            <com.yandex.go.design.view.GoLinearLayout
                android:orientation="vertical"
                android:id="@+id/card_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/discovery_payments_checkout_buttons_card_container_horizontal_padding"
                app:layout_constraintBottom_toBottomOf="@+id/payment_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/payment_button">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/card_icon"
                    android:layout_width="@dimen/discovery_payments_checkout_buttons_card_icon_width"
                    android:layout_height="@dimen/discovery_payments_checkout_buttons_card_icon_height"
                    android:scaleType="center"
                    android:layout_marginVertical="@dimen/go_design_s_space"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_caption"
                    android:textColor="?attr/textMain"
                    android:layout_gravity="center"
                    android:id="@+id/card_info"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineHeight="@dimen/discovery_payments_checkout_buttons_card_postfix_line_height"
                    app:robotoFontStyle="medium"/>
            </com.yandex.go.design.view.GoLinearLayout>
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/payment_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/discovery.payments.pay_button"
                android:textAlignment="center"
                android:layout_marginEnd="@dimen/go_design_s_space"
                app:component_background_color="?attr/controlMain"
                app:component_button_size="L"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card_container"/>
        </com.yandex.go.design.view.GoConstraintLayout>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoFrameLayout>
