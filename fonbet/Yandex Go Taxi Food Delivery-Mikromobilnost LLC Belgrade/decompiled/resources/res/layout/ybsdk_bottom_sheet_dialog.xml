<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/bottomSheetDialogContainer"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <com.ybsdk.widgets.common.ScrollableNestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/bottomSheetButtonsGroup"
            app:layout_constraintTop_toBottomOf="@+id/bottomSheetCommonTitle">
            <FrameLayout
                android:id="@+id/bottomSheetContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"/>
        </com.ybsdk.widgets.common.ScrollableNestedScrollView>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bottomSheetCommonTitle"
            android:paddingTop="34dp"
            android:paddingBottom="26dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="center"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.YB.Text.Title1"/>
        <include
            android:id="@+id/grip"
            android:layout_width="@dimen/ybsdk_grip_width"
            android:layout_height="@dimen/ybsdk_grip_height"
            android:layout_marginTop="@dimen/ybsdk_grip_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/ybsdk_grip_view"/>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/grip"/>
        <com.ybsdk.widgets.common.YbButtonViewGroup
            android:id="@+id/bottomSheetButtonsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomSheetNumberKeyboard"
            app:layout_constraintTop_toBottomOf="@+id/scrollContent"/>
        <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
            android:id="@+id/bottomSheetNumberKeyboard"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:ybsdk_additionalButtonType="comma"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
