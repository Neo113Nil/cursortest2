<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sticker_panel"
    android:background="?attr/messagingCommonActionbarColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/sticker_panel_peek_height">
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:id="@+id/sticker_pack_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="16dp"
        android:layout_toLeftOf="@+id/confirm_button"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/confirm_button"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/sticker_pack_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_toLeftOf="@+id/confirm_button"
        android:layout_below="@+id/sticker_pack_name"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/confirm_button"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/confirm_button"
        android:background="@drawable/msg_bg_sticker_pack_button"
        android:padding="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="22dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <com.yandex.messaging.internal.view.stickers.StickersView
        android:id="@+id/stickers_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/confirm_button"/>
</RelativeLayout>
