<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/group_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ya_regular"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonAccentColor"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/group_action"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/global_search_clear_recents"
        android:fontFamily="@font/ya_regular"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</FrameLayout>
