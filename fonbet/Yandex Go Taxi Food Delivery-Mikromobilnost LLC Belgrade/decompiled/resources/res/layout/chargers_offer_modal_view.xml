<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.DialogueComponent
        android:id="@+id/dialogue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_rounded_type="top">
        <com.yandex.go.design.view.GoConstraintLayout
            android:id="@+id/attention_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <ImageView
                android:id="@+id/attention_header_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/attention_header_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/attention_header_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/attention_header_image"
                app:layout_constraintStart_toEndOf="@+id/attention_header_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:robotoFontStyle="medium"/>
            <ImageView
                android:id="@+id/attention_header_image"
                android:layout_width="85dp"
                android:layout_height="55dp"
                android:layout_marginEnd="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/attention_header_text"
                app:layout_wrapBehaviorInParent="skipped"/>
        </com.yandex.go.design.view.GoConstraintLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/container_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yandex.go.design.view.GoConstraintLayout
                android:id="@+id/container_constraint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/loading_group"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="shimmering_bar_1,shimmering_bar_2"/>
                <ru.yandex.taxi.widget.ShimmeringBar
                    android:id="@+id/shimmering_bar_1"
                    android:layout_width="0dp"
                    android:layout_height="202dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:barCornerRadius="16dp"
                    app:gradientWidth="75dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ru.yandex.taxi.widget.ShimmeringBar
                    android:id="@+id/shimmering_bar_2"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:barCornerRadius="16dp"
                    app:gradientWidth="75dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/shimmering_bar_1"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/content_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="company_name,station_number,number_checkout_view,address,banner_background,banner_title,banner_subtitle,banner_badge,banner_coupon,button,tariff_divider,tariff_view"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/new_title_group"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:constraint_referenced_ids="company_name,station_number,title_barrier"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textColor="?attr/textMain"
                    android:id="@+id/company_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/ys_text_bold"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/title_barrier"
                    app:layout_constraintEnd_toStartOf="@+id/station_number"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:robotoFontStyle="bold"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textColor="?attr/textMain"
                    android:id="@+id/station_number"
                    android:background="@drawable/bg_rectangle_round_16dp_minor"
                    android:paddingTop="3dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/ys_text_medium"
                    android:layout_marginEnd="16dp"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="6dp"
                    app:layout_constraintBottom_toTopOf="@+id/title_barrier"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:robotoFontStyle="medium"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/title_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="company_name,station_number"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/old_title_group"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:constraint_referenced_ids="number_checkout_view,address"/>
                <ru.yandex.taxi.design.NumberCheckoutView
                    android:id="@+id/number_checkout_view"
                    android:background="@drawable/bg_rectangle_round_16dp_minor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_barrier"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="-3sp"
                    android:fontFeatureSettings="pnum, lnum"
                    app:component_title_size="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/number_checkout_view"/>
                <com.yandex.go.design.divider.CardDivider
                    android:id="@+id/tariff_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/tariff_view"/>
                <com.yandex.go.chargers.tariff_item_info.api.ChargersTariffsView
                    android:id="@+id/tariff_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/address"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/banner_group"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:constraint_referenced_ids="banner_background,banner_title,banner_subtitle,banner_image,banner_badge,banner_coupon"/>
                <com.yandex.go.design.view.GoView
                    android:id="@+id/banner_background"
                    android:background="@drawable/bg_rounded_24"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/go_design_s_space"
                    android:layout_marginHorizontal="@dimen/go_design_m_space"
                    app:layout_constraintBottom_toTopOf="@+id/badges"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_min="72dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tariff_view"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_body"
                    android:textColor="?attr/textMain"
                    android:ellipsize="end"
                    android:id="@+id/banner_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/banner_subtitle"
                    app:layout_constraintEnd_toStartOf="@+id/banner_badge"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="@+id/banner_background"
                    app:layout_constraintTop_toTopOf="@+id/banner_background"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintWidth_max="wrap"
                    app:layout_goneMarginEnd="16dp"
                    app:robotoFontStyle="medium"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:id="@+id/banner_badge"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/banner_title"
                    app:layout_constraintEnd_toStartOf="@+id/banner_image"
                    app:layout_constraintStart_toEndOf="@+id/banner_title"
                    app:layout_constraintTop_toTopOf="@+id/banner_title"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_caption"
                    android:textColor="?attr/textMain"
                    android:ellipsize="end"
                    android:id="@+id/banner_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="3"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/banner_background"
                    app:layout_constraintEnd_toStartOf="@+id/banner_image"
                    app:layout_constraintStart_toStartOf="@+id/banner_background"
                    app:layout_constraintTop_toBottomOf="@+id/banner_title"
                    app:layout_goneMarginEnd="16dp"
                    app:layout_goneMarginTop="0dp"
                    app:robotoFontStyle="regular"/>
                <com.yandex.go.design.view.GoImageView
                    android:id="@+id/banner_image"
                    android:layout_width="90dp"
                    android:layout_height="82dp"
                    app:layout_constraintBottom_toBottomOf="@+id/banner_background"
                    app:layout_constraintEnd_toEndOf="@+id/banner_background"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/banner_coupon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:rotation="-7.5"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/banner_background"
                    app:layout_constraintTop_toTopOf="@+id/banner_background"/>
                <com.yandex.go.chargers.design.components.badges.ChargersBadgesView
                    android:id="@+id/badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/space"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/banner_background"/>
                <Space
                    android:id="@+id/space"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/badges"/>
                <ru.yandex.taxi.widget.ShimmeringBar
                    android:id="@+id/full_screen_shimmer"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:gradientWidth="75dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </com.yandex.go.design.view.GoConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </ru.yandex.taxi.design.DialogueComponent>
</FrameLayout>
