<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:text="@string/alternative_destination_for_another_title"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:text="@string/alternative_destination_for_another_text"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:baselineAligned="false"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space">
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="16sp"
            android:id="@+id/secondary_button_with_confirm_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alternative_destination_for_another_confirm"
            app:component_background_color="?attr/controlMinor"
            app:component_button_rounded_corners="true"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="16sp"
            android:id="@+id/primary_button_with_decline_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/alternative_destination_for_another_decline"
            app:component_background_color="?attr/controlMain"
            app:component_button_rounded_corners="true"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControl"/>
    </LinearLayout>
</LinearLayout>
