<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="256dp"
            android:layout_height="16dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </LinearLayout>
    <View
        android:background="?attr/cardDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="256dp"
            android:layout_height="16dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </LinearLayout>
    <com.yandex.go.design.divider.CardDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:divider_type="both"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="176dp">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="208dp"
            android:layout_height="16dp"
            android:layout_marginTop="38dp"
            android:layout_marginHorizontal="16dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </FrameLayout>
    <com.yandex.go.design.divider.CardDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:divider_type="both"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="280dp"
            android:layout_height="16dp"
            android:layout_marginVertical="20dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <View
        android:background="?attr/cardDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="280dp"
            android:layout_height="16dp"
            android:layout_marginVertical="20dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <View
        android:background="?attr/cardDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="280dp"
            android:layout_height="16dp"
            android:layout_marginVertical="20dp"
            app:placeholder_corner_radius="12dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:importantForAccessibility="no"/>
    </LinearLayout>
</LinearLayout>
