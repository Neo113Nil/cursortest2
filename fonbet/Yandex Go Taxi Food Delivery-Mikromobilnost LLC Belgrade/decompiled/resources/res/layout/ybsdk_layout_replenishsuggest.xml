<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/ybsdk_textsize_replenishsuggest_value"
        android:gravity="center"
        android:id="@+id/text_replenishsuggest_value"
        android:background="@drawable/ybsdk_background_ripple_replenish_suggest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_margin_replenishsuggest_valuetop"
        android:minWidth="@dimen/ybsdk_width_replenishsuggest_valuemin"
        android:minHeight="@dimen/ybsdk_height_replenishsuggest_valuemin"
        android:paddingStart="@dimen/ybsdk_padding_replenishsuggest_valuestart"
        android:paddingEnd="@dimen/ybsdk_padding_replenishsuggest_valueend"
        android:layout_marginEnd="@dimen/ybsdk_margin_replenishsuggest_valueend"
        android:paddingVertical="@dimen/ybsdk_padding_replenishsuggest_valuevertical"
        app:layout_constraintEnd_toEndOf="@+id/view_replenishsuggest_badge"
        app:layout_constraintTop_toTopOf="@+id/view_replenishsuggest_badge"
        style="@style/Widget.YB.Text.Body1"/>
    <com.ybsdk.widgets.common.BadgeView
        android:id="@+id/view_replenishsuggest_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_margin_replanishsuggest_top"
        android:layout_marginEnd="@dimen/ybsdk_margin_replanishsuggest_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_text="100500"/>
</merge>
