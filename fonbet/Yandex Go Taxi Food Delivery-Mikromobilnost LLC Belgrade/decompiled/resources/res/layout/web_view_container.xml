<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/default_web_view_wrapper_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title_size="18sp"
        app:component_title_text_color="?attr/textMain"
        app:component_title_typeface="bold"
        app:component_toolbar_background_color="?attr/bgMain"
        app:component_toolbar_navigation_icon_color="?attr/textMain"
        app:layout_constraintBottom_toTopOf="@+id/default_web_view_wrapper_web_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/error_view_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/default_web_view_wrapper_toolbar"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/progress_view_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/default_web_view_wrapper_toolbar"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/infoText"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/address_name_title"/>
    <ru.yandex.taxi.web.WebContentView
        android:id="@+id/default_web_view_wrapper_web_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/default_web_view_wrapper_toolbar_share"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/default_web_view_wrapper_toolbar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/default_web_view_wrapper_toolbar_share_shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="0x7f081870"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/default_web_view_wrapper_web_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/default_web_view_wrapper_toolbar_share"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/referral_share_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/default_web_view_wrapper_web_view"
        style="@style/BottomEdgeButtonMarginStyle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/default_web_view_wrapper_toolbar_share_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="default_web_view_wrapper_toolbar_share,default_web_view_wrapper_toolbar_share_shadow"/>
</merge>
