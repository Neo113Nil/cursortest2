<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.design.DialogueComponent xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:component_rounded_type="full">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/dialogue_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:component_title_gravity="center_horizontal"
        app:component_title_max_lines="2"
        app:component_title_size="13sp"
        app:component_vertical_padding="5dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/order_list_item_root"
        android:background="@drawable/bg_order_item_round_rect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/header_and_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/order_list_item_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/order_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/order_list_item_header"/>
            <ru.yandex.taxi.order.view.TopCircleButtonsView
                android:id="@+id/order_list_item_buttons_panel"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:fit_horizontal_offset="@dimen/go_design_m_space"/>
        </LinearLayout>
        <ru.yandex.taxi.design.DividerWithColorView
            android:id="@+id/order_list_item_divider"
            android:background="?attr/line"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toTopOf="@+id/check_in_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_and_buttons_container"/>
        <include
            android:id="@+id/check_in_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/order_list_item_rating_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/order_list_item_divider"
            layout="@layout/check_in_container"/>
        <ru.yandex.taxi.design.RatingBarComponent
            android:id="@+id/order_list_item_rating_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:contentDescriptions="@array/rating_view_titles"
            app:layout_constraintBottom_toTopOf="@+id/communications_recycler_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/check_in_container"
            app:layout_constraintWidth="true"
            app:starHeight="56dp"
            app:starPadding="@dimen/go_design_s_space"
            app:starWidth="56dp"
            style="@style/rating_bar"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/communications_recycler_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintBottom_toTopOf="@+id/travel_companion_status_view_stub"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/order_list_item_rating_bar"/>
        <ru.yandex.taxi.design.DividerWithColorView
            android:id="@+id/order_companion_divider"
            android:background="?attr/line"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toTopOf="@+id/travel_companion_status_view_stub"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/communications_recycler_view"/>
        <ViewStub
            android:id="@+id/travel_companion_status_view_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/order_companion_divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ru.yandex.taxi.design.DialogueComponent>
