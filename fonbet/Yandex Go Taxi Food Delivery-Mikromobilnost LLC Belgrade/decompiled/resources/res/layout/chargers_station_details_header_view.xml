<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/details_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:component_no_background="true"
        app:component_subtitle_size="@dimen/chargers_station_details_header_subtitle_text_size"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title_size="@dimen/chargers_station_details_header_title_text_size"
        app:component_title_text_color="?attr/textMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/title_shimmering_bar"
        android:layout_width="208sp"
        android:layout_height="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle_shimmering_bar"
        app:layout_constraintStart_toStartOf="@+id/details_header"
        app:layout_constraintTop_toTopOf="@+id/details_header"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/subtitle_shimmering_bar"
        android:layout_width="108sp"
        android:layout_height="13sp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/details_header"
        app:layout_constraintStart_toStartOf="@+id/details_header"
        app:layout_constraintTop_toBottomOf="@+id/title_shimmering_bar"/>
</merge>
