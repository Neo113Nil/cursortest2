<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.design.RatingBarComponent
        android:layout_gravity="center_horizontal"
        android:id="@+id/rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:contentDescriptions="@array/rating_view_titles"
        app:starHeight="@dimen/order_screens_rate_stars_height"
        app:starWidth="@dimen/order_screens_rate_stars_width"
        style="@style/rating_bar"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="14sp"
        android:textColor="?attr/textMinor"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rating_hint_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>
    <com.yandex.go.taxi.order.feedback.ui.FeedbackQuestionView
        android:id="@+id/feedback_question"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/feedback_question_padding"
        android:layout_marginEnd="@dimen/feedback_question_padding"
        android:accessibilityTraversalAfter="@+id/rating_bar"
        app:component_title_max_lines="2"/>
    <com.yandex.go.taxi.order.feedback.ui.FeedbackSelectorQuestionView
        android:id="@+id/feedback_selector_question"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/feedback_question_padding"
        android:layout_marginEnd="@dimen/feedback_question_padding"
        android:accessibilityTraversalAfter="@+id/rating_bar"
        app:component_title_max_lines="2"/>
    <com.yandex.go.tips.ui.TipsView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tips_rating"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/rating_title_above_reasons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_title="@string/rate_comment_title"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/order_screens_all_rating_reasons_title_text_size"
        app:component_title_text_color="?attr/textMain"
        app:component_title_typeface="medium"
        app:component_vertical_padding="4dp"/>
    <ru.yandex.taxi.widget.accessibility.AccessibilityButtonLinearLayout
        android:orientation="vertical"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/order_screens_all_rating_reasons_title_text_size"
            android:textColor="?attr/textMinor"
            android:gravity="center_horizontal"
            android:id="@+id/rating_title_above_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/low_rating_reasons_inset"
            android:layout_marginTop="12dp"
            android:layout_marginRight="@dimen/low_rating_reasons_inset"
            android:layout_marginBottom="12dp"
            android:text="@string/rate_comment_title"
            android:accessibilityTraversalBefore="@+id/comment"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/order_screens_cancel_button_text_size"
            android:textColorHint="?attr/textMinor"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/comment"
            android:background="@drawable/bg_button_rounded"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="50dp"
            android:hint="@string/comment_hint"
            android:maxLines="3"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginHorizontal="8dp"/>
    </ru.yandex.taxi.widget.accessibility.AccessibilityButtonLinearLayout>
</merge>
