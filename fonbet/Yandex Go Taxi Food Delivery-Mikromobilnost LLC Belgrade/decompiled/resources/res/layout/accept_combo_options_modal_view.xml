<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/combo_content"
        android:background="@drawable/bg_rounded_top"
        style="@style/BottomModalContentHolder">
        <ImageView
            android:id="@+id/combo_options_icon"
            android:layout_width="wrap_content"
            android:layout_height="84dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:scaleType="fitStart"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/combo_options_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/combo_options_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_auto_min_height="true"
            app:component_title_size="@dimen/component_text_size_title"
            app:component_title_typeface="bold"
            app:layout_constraintBottom_toTopOf="@+id/combo_options_main_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/combo_options_icon"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/combo_options_main_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/combo_options_lower_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/combo_options_title"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/combo_options_lower_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_auto_min_height="true"
            app:component_divider_position="top"
            app:component_divider_type="margin"
            app:component_vertical_padding="16dp"
            app:layout_constraintBottom_toTopOf="@+id/combo_options_passengers_number_picker"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/combo_options_main_text"/>
        <ru.yandex.taxi.design.SegmentedComponent
            android:id="@+id/combo_options_passengers_number_picker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/error_too_many_passengers_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/combo_options_lower_text"
            style="@style/YandexTaxiDesignComponents.Button.Outline"/>
        <TextView
            android:textSize="@dimen/component_text_size_caption"
            android:id="@+id/error_too_many_passengers_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/combo_options_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/combo_options_passengers_number_picker"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/combo_options_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            app:component_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textOnControlMinor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/combo_options_next"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_too_many_passengers_text"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/combo_options_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            app:component_button_accent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/combo_options_cancel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
