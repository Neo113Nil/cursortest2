<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/ultima_card"
        android:background="@drawable/bg_rounded_20_ultima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yandex.go.ultima_mode.ui.header.UltimaModeHeaderView
            android:orientation="vertical"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.yandex.go.ultima_mode.ui.progress_bar.UltimaModeProgressBarView
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/go_design_m_space"/>
        <ru.yandex.taxi.design.AutoDividerComponentList
            android:id="@+id/ultima_card_slot_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_middle_divider_type="icon_margin"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
