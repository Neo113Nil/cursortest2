<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="104dp"
    android:layout_height="match_parent"
    android:layout_marginTop="8dp"
    android:minHeight="130dp">
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:fontFeatureSettings="@string/go_default_font_settings"
        android:layout_marginHorizontal="8dp"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption_secondary"
        android:textColor="?attr/error"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/not_available"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/requirements_carousel_unavailable_for_tariff"
        android:maxLines="2"
        android:fontFeatureSettings="@string/go_default_font_settings"
        android:layout_marginHorizontal="8dp"/>
    <Space
        android:id="@+id/compensation_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ru.yandex.taxi.summary.requirements.list.carousel.view.CarouselButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="6dp"/>
</com.yandex.go.design.view.GoLinearLayout>
