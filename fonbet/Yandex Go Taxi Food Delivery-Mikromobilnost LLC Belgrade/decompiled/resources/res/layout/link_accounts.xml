<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background_content"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_cross_close"
            android:scaleType="center"
            android:contentDescription="@string/common_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/description"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:component_no_background="true"
            app:component_subtitle="@string/link_welcome_description"
            app:component_subtitle_size="16dp"
            app:component_title="@string/link_welcome_title"
            app:component_title_gravity="center_horizontal"
            app:component_title_typeface="medium"
            app:layout_constraintTop_toBottomOf="@+id/close"/>
        <ru.yandex.taxi.zalogin.RoundedOutLineImageView
            android:id="@+id/account_avatar"
            android:layout_width="@dimen/link_accounts_avatar_size"
            android:layout_height="@dimen/link_accounts_avatar_size"
            android:elevation="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/account_item"
            android:background="@null"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:component_no_background="true"
            app:component_subtitle_gravity="center_horizontal"
            app:component_title_gravity="center_horizontal"
            app:component_title_typeface="medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/account_avatar"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/buttons_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/link_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/link_welcome_link_button"
                app:component_button_accent="true"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/link_other_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/link_welcome_another_account"
                app:component_background_color="?attr/controlMinor"
                app:component_title_color="?attr/textOnControlMinor"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
