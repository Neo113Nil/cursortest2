<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/toolbar_modal_view_content"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/toolbar_modal_view_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="normal"
        app:component_subtitle_gravity="center_horizontal"
        app:component_title_gravity="center_horizontal"
        app:component_toolbar_background_accent_enabled="true"/>
</LinearLayout>
