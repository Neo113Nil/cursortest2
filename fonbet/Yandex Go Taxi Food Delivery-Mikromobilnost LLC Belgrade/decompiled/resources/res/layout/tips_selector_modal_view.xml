<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/BottomModalContentHolder">
        <ru.yandex.taxi.design.ToolbarComponent
            android:id="@+id/tips_selector_toolbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:component_divider_position="bottom"
            app:component_divider_type="normal"
            app:component_show_navigation_button="false"
            app:component_subtitle_gravity="center_horizontal"
            app:component_title="@string/tips_view_title"
            app:component_title_gravity="center_horizontal"
            app:component_toolbar_background_accent_enabled="true"/>
        <com.yandex.go.tips.ui.TipsView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tips"
            android:paddingTop="@dimen/go_design_s_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/list_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_title="@string/settings_tips_explain"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
