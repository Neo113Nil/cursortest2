<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/splitDepositAutoTopupStatusToolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:ybsdk_closeIconVisible="true"/>
    <com.ybsdk.feature.split.deposit.internal.ui.StatusScreenView
        android:id="@+id/autoTopupStatusView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
