<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RoundedCornersImageView
        android:id="@+id/bullets_order_popup_header_big_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:cornerRadius="@dimen/bottom_sheet_corner_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bullets_order_popup_header_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bullets_order_popup_header_big_image"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/driver_avatar_container"
        android:visibility="gone"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bullets_order_popup_header_image">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/driver_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:scaleType="centerCrop"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/driver_avatar_badge"
            android:background="@drawable/bg_circle_surface"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_header"
        android:textColor="?attr/textMain"
        android:id="@+id/bullets_order_popup_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        android:lineHeight="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/driver_avatar_container"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.design.DividerAwareComponent
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bullets_order_popup_header_title">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textColor="?attr/textMain"
            android:id="@+id/bullets_order_popup_header_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
    </ru.yandex.taxi.design.DividerAwareComponent>
</androidx.constraintlayout.widget.ConstraintLayout>
