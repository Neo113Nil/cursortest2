<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <ru.yandex.taxi.widget.RoundedCornersFrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="zoom"
            app:surface_type="texture_view"/>
    </ru.yandex.taxi.widget.RoundedCornersFrameLayout>
    <ru.yandex.taxi.widget.RoundedCornersImageView
        android:id="@+id/snapshot_secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:cornerRadius="@dimen/story_corner_radius"/>
    <ru.yandex.taxi.widget.RoundedCornersImageView
        android:id="@+id/snapshot_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:cornerRadius="@dimen/story_corner_radius"/>
    <ru.yandex.taxi.widget.RoundedCornersFrameLayout
        android:id="@+id/story_animation_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/story_animation_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/story_animation_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </ru.yandex.taxi.widget.RoundedCornersFrameLayout>
    <FrameLayout
        android:id="@+id/loading_indicator_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:theme="@style/TaxiCommunicationsStoryProgressBarOverlay"
            android:layout_gravity="center"
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ru.yandex.taxi.stories.presentation.story.StoryContentView
        android:id="@+id/content_view_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.yandex.taxi.stories.presentation.story.StoryContentView
        android:id="@+id/content_view_secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/story_loading_container"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.yandex.taxi.widget.progress.CircularProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ru.yandex.taxi.stories.presentation.story.StoryTopView
        android:id="@+id/story_top_view_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.yandex.taxi.stories.presentation.story.StoryTopView
        android:id="@+id/story_top_view_secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/retry_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/taxi_communications_stories_ic_story_retry"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/notification"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_notification_height"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <FrameLayout
        android:id="@+id/overlapping_modal_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
