<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.stories.presentation.preview.StoryPreviewView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="@dimen/story_card_width"
    android:layout_height="@dimen/story_card_height"
    android:importantForAccessibility="no"
    android:layout_marginEnd="8dp"
    app:cornerRadius="8dp">
    <ImageView
        android:id="@+id/story_preview_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <View
        android:id="@+id/story_preview_placeholder"
        android:background="@color/taxi_communications_story_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/story_preview_text_stub"
        android:layout="@layout/taxi_communications_story_preview_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/story_preview_repeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/taxi_communications_stories_ic_repeat"/>
</ru.yandex.taxi.stories.presentation.preview.StoryPreviewView>
