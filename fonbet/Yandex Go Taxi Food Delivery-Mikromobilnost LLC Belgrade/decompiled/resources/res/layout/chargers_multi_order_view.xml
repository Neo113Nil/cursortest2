<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="24sp"
            android:textColor="?attr/textMain"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textFontWeight="700"
            app:robotoFontStyle="bold"/>
        <com.yandex.go.chargers.multiorder.ui.components.ChargersMultiOrderTakeMoreButton
            android:textSize="13sp"
            android:id="@+id/header_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textFontWeight="400"
            app:component_background_color="?attr/controlMinor"
            app:component_button_rounded_corners_radius="100dp"
            app:component_button_size="XS"
            app:component_title_color="?attr/textMain"
            app:robotoFontStyle="regular"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textColor="?attr/textMain"
            android:layout_gravity="center_vertical"
            android:id="@+id/header_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="19dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="6dp"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</com.yandex.go.design.view.GoLinearLayout>
