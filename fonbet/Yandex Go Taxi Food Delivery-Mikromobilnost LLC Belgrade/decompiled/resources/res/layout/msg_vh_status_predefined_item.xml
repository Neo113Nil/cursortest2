<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/msg_ripple_common"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <ImageView
        android:id="@+id/statuses_indicator_image_view"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="6dp"
        android:layout_marginVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/statuses_title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:text="@string/statuses_default_title"
        android:maxLines="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/statuses_indicator_image_view"
        app:layout_constraintEnd_toStartOf="@+id/custom_status_deadline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/statuses_indicator_image_view"
        app:layout_constraintTop_toTopOf="@+id/statuses_indicator_image_view"
        style="@style/Messaging.StatusNameText"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:ellipsize="end"
        android:id="@+id/custom_status_deadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/statuses_title_text_view"
        app:layout_constraintEnd_toStartOf="@+id/statuses_is_chosen_image_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/statuses_title_text_view"
        app:layout_constraintTop_toTopOf="@+id/statuses_title_text_view"/>
    <ImageView
        android:id="@+id/statuses_is_chosen_image_view"
        android:visibility="invisible"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/msg_ic_status_chosen"
        android:contentDescription="@string/status_is_chosen_content_des__res_0x7f1517fb"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
