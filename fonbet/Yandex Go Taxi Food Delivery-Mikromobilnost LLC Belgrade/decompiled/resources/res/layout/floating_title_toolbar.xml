<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/toolbar_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/title_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:component_no_background="true"
        app:component_title_size="@dimen/component_text_size_toolbar"
        app:component_title_typeface="bold"/>
</merge>
