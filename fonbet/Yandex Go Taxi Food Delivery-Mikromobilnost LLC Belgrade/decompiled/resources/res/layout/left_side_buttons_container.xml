<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:layout_gravity="center_vertical"
        android:id="@+id/incidents_Button"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/map_controls_height"
        app:component_circle_icon_padding="16dp"
        app:component_circle_image="@drawable/ic_incident"
        app:component_frame_height="@dimen/map_controls_height"/>
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:layout_gravity="bottom"
        android:id="@+id/back_button"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/map_controls_height"
        app:component_circle_icon_padding="16dp"
        app:component_circle_image="@drawable/ic_back"
        app:component_frame_height="@dimen/map_controls_height"/>
</com.yandex.go.design.view.GoFrameLayout>
