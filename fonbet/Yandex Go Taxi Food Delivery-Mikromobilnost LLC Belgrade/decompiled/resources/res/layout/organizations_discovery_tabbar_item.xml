<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_transparent_ripple"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_bubble"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/badge"
        android:background="@drawable/bg_notification_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginBottom="-16dp"
        android:minWidth="@dimen/go_design_m_space"
        android:maxLines="1"
        android:layout_marginStart="-8dp"
        android:elevation="1dp"
        android:backgroundTint="@color/component_cinnaban_toxic"
        app:layout_constraintBottom_toTopOf="@+id/icon"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:robotoFontStyle="bold"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/go_design_l_space"
        android:layout_height="@dimen/go_design_l_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption_secondary"
        android:textColor="?attr/textMain"
        android:layout_gravity="center"
        android:id="@+id/tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
</com.yandex.go.design.view.GoConstraintLayout>
