<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/option_number"
        android:background="@drawable/ybsdk_background_number_option_text"
        android:layout_width="@dimen/ybsdk_number_option_icon_view_width"
        android:layout_height="@dimen/ybsdk_number_option_icon_view_height"
        android:layout_marginTop="@dimen/ybsdk_number_option_icon_margin_top"
        android:layout_marginBottom="@dimen/ybsdk_number_option_icon_margin_bottom"
        android:layout_marginStart="@dimen/ybsdk_number_option_icon_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body1"/>
    <TextView
        android:id="@+id/option_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_number_option_content_margin_top"
        android:layout_marginBottom="@dimen/ybsdk_number_option_content_margin_bottom"
        android:layout_marginStart="@dimen/ybsdk_number_option_content_margin_start"
        android:layout_marginEnd="@dimen/ybsdk_number_option_content_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/option_number"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body2"/>
</merge>
