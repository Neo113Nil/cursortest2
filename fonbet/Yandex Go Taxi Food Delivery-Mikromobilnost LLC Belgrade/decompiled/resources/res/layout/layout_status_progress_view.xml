<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/status_title_container"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/trail_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.yandex.taxi.widget.RobotoTextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:ellipsize="end"
            android:id="@+id/tv_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <ru.yandex.taxi.widget.ShimmeringFrameLayout
        android:id="@+id/shimmering_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/status_title_container"
        app:layout_constraintEnd_toEndOf="@+id/status_title_container"
        app:layout_constraintStart_toStartOf="@+id/status_title_container"
        app:layout_constraintTop_toTopOf="@+id/status_title_container"
        app:shimmeringWidth="512dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="status_title_container, trail_container"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:gravity="center_vertical"
        android:id="@+id/trail_container"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:maxWidth="124dp"
        android:foregroundGravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.taxi.order.details.v2.ui.view.item.progress_bar.ProgressBarView
        android:id="@+id/progress_bar"
        android:background="@drawable/bg_ride_status_progress_line_rounded"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginTop="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_barrier"/>
    <Space
        android:id="@+id/space_bottom"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar"/>
</merge>
