<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#5f000000"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/vsidLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/vsid_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/vsid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/contentLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/content_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/videoTrackLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/video_track_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/videoTrack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/audioTrackLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/audio_track_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/audioTrack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/subtitlesTrackLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/subtitles_track_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/subtitlesTrack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/viewPortSizeLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/viewport_size_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/viewportSize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/videoDecoderLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/video_decoder_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/videoDecoder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/audioDecoderLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/audio_decoder_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/audioDecoder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/data_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:constraint_referenced_ids="vsidLabel,vsid,contentLabel,content,videoTrackLabel,videoTrack,audioTrackLabel,audioTrack,subtitlesTrackLabel,subtitlesTrack,viewPortSizeLabel,viewportSize,videoDecoderLabel,videoDecoder,audioDecoderLabel,audioDecoder"
        app:flow_horizontalGap="4dp"
        app:flow_maxElementsWrap="2"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/bandwidthEstimationLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/bandwidth_estimation_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/bandwidthEstimation"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <ru.yandex.video.m3.player.ui.debug.view.graph.LineGraphView
        android:id="@+id/bandwidthEstimationGraph"
        android:layout_width="0dp"
        style="@style/graph"/>
    <TextView
        android:id="@+id/bytesLoadedLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/bytes_loaded_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/totalBytesLoaded"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <ru.yandex.video.m3.player.ui.debug.view.graph.LoadedChunkGraphView
        android:layout_gravity="center"
        android:id="@+id/chunksGraph"
        android:layout_width="0dp"
        style="@style/graph"/>
    <TextView
        android:id="@+id/bufferSizeLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/buffer_size_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/bufferSize"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <ru.yandex.video.m3.player.ui.debug.view.graph.LineGraphView
        android:id="@+id/bufferSizeGraph"
        android:layout_width="0dp"
        style="@style/graph"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/graphs_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:constraint_referenced_ids="bandwidthEstimationLabel,bandwidthEstimation,bandwidthEstimationGraph,bytesLoadedLabel,totalBytesLoaded,chunksGraph,bufferSizeLabel,bufferSize,bufferSizeGraph,"
        app:flow_horizontalGap="4dp"
        app:flow_maxElementsWrap="3"
        app:flow_verticalGap="0dp"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toStartOf="@+id/qrCode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_block"/>
    <TextView
        android:id="@+id/latencyLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/latency_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/latency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <TextView
        android:id="@+id/additionalLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/extra_info_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/additional"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/latency_and_additional_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:constraint_referenced_ids="latencyLabel,latency,additionalLabel,additional"
        app:flow_horizontalGap="4dp"
        app:flow_maxElementsWrap="2"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toStartOf="@+id/qrCode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/graphs_block"/>
    <TextView
        android:id="@+id/lastErrorLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:text="@string/last_error_label"
        style="@style/data_field_text"/>
    <TextView
        android:id="@+id/lastError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/data_text"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/error_block"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:constraint_referenced_ids="lastErrorLabel,lastError"
        app:flow_horizontalGap="4dp"
        app:flow_maxElementsWrap="2"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toStartOf="@+id/qrCode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/latency_and_additional_block"/>
    <ImageView
        android:id="@+id/qrCode"
        android:visibility="visible"
        android:contentDescription="@string/qr_code"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/qr_code_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
