<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.DialogueComponent
        android:id="@+id/dialogue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:component_rounded_type="top">
        <com.yandex.go.design.view.GoConstraintLayout
            android:id="@+id/attention_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <ImageView
                android:id="@+id/attention_header_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/attention_header_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/attention_header_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/attention_header_image"
                app:layout_constraintStart_toEndOf="@+id/attention_header_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:robotoFontStyle="regular"/>
            <ImageView
                android:id="@+id/attention_header_image"
                android:layout_width="85dp"
                android:layout_height="55dp"
                android:layout_marginEnd="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/attention_header_text"
                app:layout_wrapBehaviorInParent="skipped"/>
        </com.yandex.go.design.view.GoConstraintLayout>
    </ru.yandex.taxi.design.DialogueComponent>
</com.yandex.go.design.view.GoFrameLayout>
