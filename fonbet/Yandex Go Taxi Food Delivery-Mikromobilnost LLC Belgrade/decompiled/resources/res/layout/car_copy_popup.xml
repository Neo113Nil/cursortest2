<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_popup"
    android:paddingBottom="1dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/accessibility_exit"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/common_back"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/car_mark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="normal"
        app:component_no_background="true"
        app:component_trail_image="@drawable/ic_copy"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/car_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="normal"
        app:component_no_background="true"
        app:component_trail_image="@drawable/ic_copy"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/car_number_and_mark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:component_trail_image="@drawable/ic_copy"/>
</LinearLayout>
