<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardSingleCardItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/backdrop"
        android:background="@drawable/ybsdk_bottom_part_card_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="@color/yb_light_fill_default_500"
        android:layout_marginHorizontal="@dimen/ybsdk_product_card_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="@+id/backdropLinearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dashboardSingleCard"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/backdropLinearLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginHorizontal="@dimen/ybsdk_product_card_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashboardSingleCard">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/leftImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/amountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            style="@style/Widget.YB.Text.Title3"/>
        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.YB.Text.Body3"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <Space
        android:id="@+id/divkitBackdropSpace"
        android:layout_width="0dp"
        android:layout_height="30dp"
        app:layout_constraintEnd_toEndOf="@+id/dashboardSingleCard"
        app:layout_constraintStart_toStartOf="@+id/dashboardSingleCard"
        app:layout_constraintTop_toBottomOf="@+id/dashboardSingleCard"/>
    <com.ybsdk.feature.divkit.api.ui.YbDivView
        android:id="@+id/divkitBackdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/divkitBackdropSpace"
        app:layout_constraintEnd_toEndOf="@+id/dashboardSingleCard"
        app:layout_constraintStart_toStartOf="@+id/dashboardSingleCard"
        app:layout_constraintTop_toTopOf="@+id/dashboardSingleCard"/>
    <include
        android:id="@+id/dashboardV3CardsSkeleton"
        layout="@layout/ybsdk_screen_dashboard_v3_loading_product_cards"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dashboardProductSkinSelectionImageFake"
        android:focusable="false"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/dashboardSingleCard"
        app:layout_constraintEnd_toEndOf="@+id/dashboardSingleCard"/>
    <com.ybsdk.feature.dashboard.internal.ui.dashboard3.view.DashboardCardView
        android:id="@+id/dashboardSingleCard"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/ybsdk_product_card_horizontal_margin"
        app:layout_constraintDimensionRatio="@dimen/ybsdk_product_card_view_ratio"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dashboardProductSkinSelectionImage"
        android:layout_width="142dp"
        android:layout_height="142dp"
        android:translationX="@dimen/ybsdk_dashboard_wallet_skin_selection_image_translation"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/dashboardSingleCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dashboardSingleCard"/>
</androidx.constraintlayout.widget.ConstraintLayout>
