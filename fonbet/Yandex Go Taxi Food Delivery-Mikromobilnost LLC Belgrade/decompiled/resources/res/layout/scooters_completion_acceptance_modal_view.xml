<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="top"
        android:id="@+id/rv"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_buttons_container"
        android:background="@drawable/scooters_top_rounded_floating_background"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/open_lock"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/scooters_open_lock"
            android:layout_marginStart="@dimen/go_design_s_space"
            android:layout_marginEnd="@dimen/go_design_s_space"
            app:component_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/go_design_m_space"
            android:text="@string/scooters_complete_trip_dialog_take_photo"
            android:layout_marginStart="@dimen/go_design_s_space"
            android:layout_marginEnd="@dimen/go_design_s_space"
            app:component_button_accent="true"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoFrameLayout>
