<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="56dp">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="@color/component_black"
        android:layout_gravity="center_vertical"
        android:id="@+id/button_trail_button_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/component_image_holder_size"
        android:includeFontPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"/>
    <ru.yandex.taxi.design.CheckBoxComponent
        android:layout_gravity="center_vertical"
        android:id="@+id/button_trail_check_box"
        android:layout_width="@dimen/component_image_holder_size"
        android:layout_height="@dimen/component_image_holder_size"/>
</merge>
