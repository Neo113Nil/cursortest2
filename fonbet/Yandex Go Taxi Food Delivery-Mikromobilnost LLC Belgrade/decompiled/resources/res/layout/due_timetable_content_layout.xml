<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/day_selector_card"
        android:background="@drawable/round_section_bg_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">
        <com.yandex.go.due_timetable.presentation.widget.day_selector.DaySelectorView
            android:layout_gravity="top"
            android:id="@+id/day_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/cardDivider"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/due_timetable_card"
        android:background="@drawable/round_section_bg_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/price_content"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginHorizontal="@dimen/go_design_m_space">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="?attr/textMinor"
                android:id="@+id/price_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_subtitle"
                android:textColor="?attr/textMain"
                android:id="@+id/price_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                app:robotoFontStyle="medium"/>
        </LinearLayout>
        <ru.yandex.taxi.widget.due_timetable.DueTimetableView
            android:id="@+id/due_timetable"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginVertical="@dimen/go_design_s_space"/>
    </LinearLayout>
</LinearLayout>
