<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_24dp_modal_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/comment_suggests_modal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.widget.FlowLayout
        android:orientation="vertical"
        android:id="@+id/comment_suggests_modal_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:itemSpacing="8dp"
        app:lineSpacing="8dp"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/comment_suggests_modal_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/common_done"
        app:component_background_color="?attr/controlMain"
        app:component_button_accent="true"
        app:component_button_size="L"
        style="@style/BottomEdgeButtonMarginStyle"/>
</LinearLayout>
