<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ybsdk_toolbar_height">
    <ImageView
        android:id="@+id/imageToolbarLeftImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageToolbarTitleImage"
        android:layout_width="@dimen/ybsdk_qr_payments_yb_logo_width"
        android:layout_height="@dimen/ybsdk_qr_payments_yb_logo_height"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/toolbarTitleLeftImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:alpha="0"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageToolbarTitleText"
        app:layout_constraintEnd_toStartOf="@+id/imageToolbarTitleText"
        app:layout_constraintStart_toStartOf="@+id/ybSdkGuideline"
        app:layout_constraintTop_toTopOf="@+id/imageToolbarTitleText"/>
    <com.ybsdk.core.design.spoiler.SpoilerTextView
        android:textColor="?attr/ybColor_textIcon_primary"
        android:gravity="center"
        android:id="@+id/imageToolbarTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="@+id/ybSdkGuideline"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/toolbarTitleLeftImage"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Title1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/imageToolbarSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageToolbarTitleText"
        app:layout_constraintStart_toStartOf="@+id/toolbarTitleLeftImage"
        app:layout_constraintTop_toBottomOf="@+id/imageToolbarTitleText"
        style="@style/Widget.YB.Text.Caption1.Regular"/>
    <com.ybsdk.widgets.common.CloseButtonView
        android:id="@+id/imageToolbarCloseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ybSdkGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
</merge>
