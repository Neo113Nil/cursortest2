<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.scooters.presentation.feedback.newbie.ScootersFeedbackCardNewbieHeader
        android:id="@+id/newbie_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/title_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/go_design_s_space"
        app:component_divider_position="bottom"
        app:component_divider_type="normal"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_subtitle_typeface="regular"
        app:component_title_size="@dimen/component_text_size_subtitle"
        app:component_title_typeface="medium"
        app:component_vertical_padding="18dp"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMinor"
        android:id="@+id/rating_bar_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scooters_feedback_card_rating_header"
        android:textAlignment="center"
        android:paddingVertical="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.RatingBarComponent
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rating_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="64dp"
        android:minHeight="64dp"
        android:paddingHorizontal="44dp"
        app:contentDescriptions="@array/rating_view_titles"
        app:starHeight="36dp"
        style="@style/rating_bar"/>
    <ru.yandex.taxi.scooters.presentation.feedback.ScootersFeedbackItemsSelectionComponent
        android:id="@+id/items_selection_component"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="22dp"
        android:paddingVertical="4dp"/>
    <ru.yandex.taxi.scooters.presentation.feedback.comment.ScootersCommentAndPhotosView
        android:id="@+id/comment_with_photos"
        android:paddingBottom="@dimen/go_design_m_space"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/support_list_item_component"
        android:background="@drawable/bg_transparent_ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_lead_image="@drawable/ic_scooters_support"
        app:component_title="Обратиться в поддержку"
        app:component_trail_mode="navigation"/>
</merge>
