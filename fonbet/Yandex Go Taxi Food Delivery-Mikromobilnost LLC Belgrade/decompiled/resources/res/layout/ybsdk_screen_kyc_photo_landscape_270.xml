<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_internal_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gradient"
        android:background="@drawable/ybsdk_kyc_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
        android:gravity="center"
        android:id="@+id/photoPreviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/photoPreviewButtons"
        style="@style/Widget.YB.Text.Body3"/>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/photoPreviewButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="@+id/navigationBarSpace"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/photoPreviewGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="photoPreviewText, photoPreviewButtons"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/captionBlockFrameContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:layout_marginStart="122dp"
        android:layout_marginEnd="122dp"
        android:layout_marginVertical="62dp"
        app:layout_constraintBottom_toBottomOf="@+id/captionBlockPrompt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_kyc_photo_frame_1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
        android:gravity="center"
        android:id="@+id/captionBlockPrompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxWidth="295dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.YB.Text.Body3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/buttonCaption"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/ybsdk_kyc_accessibility_caption_button"
        android:layout_marginStart="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_caption_button"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/captionGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="buttonCaption, captionBlockPrompt, captionBlockFrameContainer"/>
    <Space
        android:id="@+id/navigationBarSpace"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"
        app:ybsdk_transparentBackground="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
