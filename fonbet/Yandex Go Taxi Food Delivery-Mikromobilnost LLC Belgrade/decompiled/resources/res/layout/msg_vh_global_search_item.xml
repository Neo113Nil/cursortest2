<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:id="@+id/global_search_item_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        app:avatarPadding="0dp"
        app:avatarTextSize="16sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:onlineIndicatorSize="@dimen/online_indicator_height_and_width_small"
        app:placeholderBackground="@drawable/msg_bg_search_item_avatar_placeholder"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/global_search_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:lineSpacingExtra="2sp"
        android:fontFamily="@font/ya_regular"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/global_search_item_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/global_search_item_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/global_search_item_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/global_search_item_badge"
        app:layout_constraintLeft_toRightOf="@+id/global_search_item_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/global_search_item_title"
        style="@style/Messaging.Subtitle"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/global_search_item_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/global_search_item_title"
        app:layout_constraintTop_toBottomOf="@+id/global_search_item_subtitle"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/global_search_item_badge2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/global_search_item_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/global_search_item_badge"
        app:layout_constraintTop_toTopOf="@+id/global_search_item_badge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
