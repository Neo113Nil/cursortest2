<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_gray_550"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="@color/component_white"
        android:gravity="center_horizontal"
        android:id="@+id/permissions_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:lineHeight="27sp"
        app:layout_constraintBottom_toTopOf="@+id/permissions_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="@color/component_white"
        android:gravity="center_horizontal"
        android:id="@+id/permissions_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/go_to_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permissions_title"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/go_to_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/scooters_go_to_settings"
        android:layout_marginHorizontal="16dp"
        app:component_background_color="@color/component_white"
        app:component_button_rounded_corners_radius="100dp"
        app:component_button_size="M"
        app:component_title_color="@color/component_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permissions_subtitle"
        app:robotoFontStyle="medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
