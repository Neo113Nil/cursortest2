<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:orientation="vertical"
        android:id="@+id/delivery_address_correction_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/delivery_address_correction_buttons_shadow"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/delivery_address_correction_view_top_container"
                android:background="@drawable/round_section_bg_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/delivery_address_correction_view_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_no_background="true"
                    app:component_title_ellipsize_mode="end"
                    app:component_title_max_lines="1"
                    app:component_title_size="@dimen/component_text_size_title"
                    app:component_title_typeface="medium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread_inside"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/delivery_address_correction_info_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_divider_position="bottom"
                    app:component_divider_type="icon_margin"
                    app:component_lead_image="@drawable/ic_summary_destination_point"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_view_header"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/delivery_address_correction_apartment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    app:component_divider_focused_state_margin_right="0dp"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="0dp"
                    app:component_type_input="text"
                    app:layout_constraintEnd_toStartOf="@+id/delivery_address_correction_porch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_info_destination"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/delivery_address_correction_porch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_type_input="numberDecimal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/delivery_address_correction_apartment"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_info_destination"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/delivery_address_correction_floor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:component_divider_focused_state_margin_right="0dp"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="0dp"
                    app:component_type_input="numberDecimal"
                    app:layout_constraintEnd_toStartOf="@+id/delivery_address_correction_doorphone"
                    app:layout_constraintStart_toStartOf="@+id/delivery_address_correction_apartment"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_apartment"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/delivery_address_correction_doorphone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_type_input="text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/delivery_address_correction_floor"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_apartment"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/delivery_address_correction_comment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/go_design_m_space"
                    app:component_input_divider="false"
                    app:component_input_focused_divider_color="@color/transparent"
                    app:component_input_max_lines="3"
                    app:component_input_unfocused_divider_color="@color/transparent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/delivery_address_correction_apartment"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_doorphone"/>
                <View
                    android:id="@+id/divider_comment"
                    android:background="?attr/line"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="@dimen/go_design_m_space"
                    android:layout_marginEnd="@dimen/go_design_m_space"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_comment"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/delivery_address_correction_contact"
                    android:background="@drawable/round_section_bg_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_lead_image="@drawable/ic_logistics_contact_phone"
                    app:component_trail_companion_text="123123123123"
                    app:layout_constraintTop_toBottomOf="@+id/divider_comment"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/delivery_address_correction_view_content_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_view_top_container"
                style="@style/DeliveryComponentPageDivider"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/delivery_address_correction_view_bottom_container"
                android:background="@drawable/round_section_bg_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_view_content_divider">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/delivery_address_correction_original_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_lead_image="@drawable/ic_list_search"
                    app:component_lead_image_tint="?attr/iconMinor"
                    app:component_no_background="true"
                    app:component_subtitle_above_title="true"
                    app:component_subtitle_ellipsize_mode="end"
                    app:component_subtitle_max_lines="1"
                    app:component_title_ellipsize_mode="end"
                    app:component_title_max_lines="3"
                    app:component_trail_image="@drawable/chevron_next"
                    app:component_trail_image_tint="?attr/textMain"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:id="@+id/delivery_address_correction_buttons_shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/delivery_address_correction_scroll"
        app:layout_constraintEnd_toEndOf="@+id/delivery_address_correction_scroll"
        app:layout_constraintStart_toStartOf="@+id/delivery_address_correction_scroll"
        app:scroll_view_id="@+id/delivery_address_correction_scroll"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/delivery_address_correction_cancel_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/common_cancel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        app:component_background_color="?attr/controlMinor"
        app:component_button_accent="true"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/delivery_address_correction_done_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_buttons_shadow"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/delivery_address_correction_done_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/common_done"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp"
        app:component_button_accent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/delivery_address_correction_cancel_button"
        app:layout_constraintTop_toBottomOf="@+id/delivery_address_correction_buttons_shadow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
