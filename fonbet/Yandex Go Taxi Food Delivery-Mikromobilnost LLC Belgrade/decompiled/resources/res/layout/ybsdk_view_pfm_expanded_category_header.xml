<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/ybsdk_pfm_expanded_category_header_padding_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/ybsdk_pfm_expanded_category_header_padding_horizontal">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pfmExpandedCategoryHeaderTitleHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/pfmExpandedCategoryHeaderExpansionButton"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ybsdk_ic_pfm_category_expansion_button"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/ybsdk_pfm_expanded_category_header_before_close_button_margin"
            app:layout_constraintBottom_toBottomOf="@+id/pfmExpandedCategoryHeaderCloseButton"
            app:layout_constraintEnd_toStartOf="@+id/pfmExpandedCategoryHeaderCloseButton"
            app:layout_constraintTop_toTopOf="@+id/pfmExpandedCategoryHeaderCloseButton"/>
        <ImageView
            android:id="@+id/pfmExpandedCategoryHeaderCloseButton"
            android:background="@drawable/ybsdk_pfm_expanded_category_header_close_button_background"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/ybsdk_pfm_expanded_category_header_close_button_background_size"
            android:layout_height="@dimen/ybsdk_pfm_expanded_category_header_close_button_background_size"
            android:src="@drawable/ybsdk_ic_cross"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="?attr/ybColor_textIcon_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/pfmExpandedCategoryHeaderTitlePlain"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_marginEnd="@dimen/ybsdk_pfm_expanded_category_header_before_expansion_button_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/pfmExpandedCategoryHeaderExpansionButton"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.YB.Text.Numbers3"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/pfmExpandedCategoryHeaderAmountContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ybsdk_pfm_expanded_category_header_before_expansion_button_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/pfmExpandedCategoryHeaderExpansionButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.ybsdk.core.design.spoiler.SpoilerTextView
                android:textColor="?attr/ybColor_textIcon_primary"
                android:gravity="center_vertical"
                android:id="@+id/pfmExpandedCategoryHeaderTitleAmount"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                style="@style/Widget.YB.Text.Numbers3"/>
            <ImageView
                android:id="@+id/pfmExpandedCategoryHeaderCurrencyIcon"
                android:visibility="gone"
                android:layout_width="@dimen/ybsdk_pfm_expanded_category_header_title_currency_icon_size"
                android:layout_height="@dimen/ybsdk_pfm_expanded_category_header_title_currency_icon_size"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/ybsdk_pfm_expanded_category_header_title_currency_icon_margin_start"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/pfmHeaderTitleShimmer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/pfmExpandedCategoryHeaderTitleHolder"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/pfmExpandedCategoryHeaderTitleHolder"
        app:layout_constraintTop_toTopOf="@+id/pfmExpandedCategoryHeaderTitleHolder"
        app:layout_constraintWidth_default="wrap">
        <include
            android:layout_gravity="center"
            android:layout_width="@dimen/ybsdk_pfm_expanded_category_header_title_skeleton_width"
            android:layout_height="wrap_content"
            layout="@layout/ybsdk_pfm_category_skeleton"/>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:ellipsize="end"
        android:id="@+id/pfmExpandedCategoryHeaderNote"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_pfm_expanded_category_header_note_margin_top"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pfmExpandedCategoryHeaderTitleHolder"
        style="@style/Widget.YB.Text.Body3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
