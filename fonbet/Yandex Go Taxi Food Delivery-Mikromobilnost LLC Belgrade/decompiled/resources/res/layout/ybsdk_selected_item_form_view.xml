<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/selectedItemFormViewIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_max="@dimen/ybsdk_clickable_icon_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/ybsdk_clickable_icon_size"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/selectedItemFormViewLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/selectedItemFormViewTitle"
        app:layout_constraintEnd_toStartOf="@+id/selectedItemFormViewRightIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/selectedItemFormViewIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/selectedItemFormViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selectedItemFormViewSubtitle"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/selectedItemFormViewIcon"
        app:layout_constraintTop_toBottomOf="@+id/selectedItemFormViewLabel"
        app:layout_goneMarginTop="0dp"
        style="@style/Widget.YB.Text.Body1"/>
    <com.ybsdk.core.design.spoiler.SpoilerTextView
        android:ellipsize="none"
        android:id="@+id/selectedItemFormViewSubtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/selectedItemFormViewTitle"
        app:layout_constraintEnd_toStartOf="@+id/selectedItemFormViewRightIcon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/selectedItemFormViewTitle"
        app:layout_constraintTop_toTopOf="@+id/selectedItemFormViewTitle"
        style="@style/Widget.YB.Text.Body1.Secondary"/>
    <ImageView
        android:id="@+id/selectedItemFormViewRightIcon"
        android:layout_width="@dimen/ybsdk_size_paymentmethod_arrow"
        android:layout_height="@dimen/ybsdk_size_paymentmethod_arrow"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/ybsdk_margin_paymentmethod_arrowhorizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_navigation_arrowdown"/>
</merge>
