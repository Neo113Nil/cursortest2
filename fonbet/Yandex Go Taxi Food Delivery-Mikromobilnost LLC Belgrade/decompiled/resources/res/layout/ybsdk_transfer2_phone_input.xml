<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/transferPhoneInputToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/transferPhoneInputFilter"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/transferPhoneInputFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ybsdk_loadable_input_height"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/transferPhoneInputRecycler"
        app:layout_constraintTop_toBottomOf="@+id/transferPhoneInputToolbar"
        app:ybsdk_inputLabel="@string/ybsdk_transfer_transfer_destination_title"
        app:ybsdk_placeholder="@string/ybsdk_transfer_transfer_name_or_phone_placeholder"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithoutBackground"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transferPhoneInputRecycler"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferPhoneInputFilter"/>
    <com.ybsdk.widgets.common.FullscreenStatusView
        android:id="@+id/transferPhoneInputFullscreenView"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/transferPhoneInputErrorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferPhoneInputToolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
