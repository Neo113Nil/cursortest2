<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/user_photo_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/user_photo_uploading_content_view"/>
    <include
        android:id="@+id/user_photo_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/user_photo_uploading_loading_view"/>
    <include
        android:id="@+id/user_photo_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/user_photo_uploading_error_view"/>
</FrameLayout>
