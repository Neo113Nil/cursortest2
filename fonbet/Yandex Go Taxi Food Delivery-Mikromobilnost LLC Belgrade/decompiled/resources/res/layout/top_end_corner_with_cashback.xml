<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.widget.ShiftLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:id="@+id/top_end_corner_shift_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/btn_cashback"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:transitionName="@string/plaque_scene_root_transition_name"/>
</ru.yandex.taxi.widget.ShiftLayout>
