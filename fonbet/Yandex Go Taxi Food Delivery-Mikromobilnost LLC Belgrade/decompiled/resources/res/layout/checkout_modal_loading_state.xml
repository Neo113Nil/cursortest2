<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/loading_state_container"
        android:padding="@dimen/div_button_text_vertical_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/first_placeholder"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="26dp"
            android:layout_marginStart="@dimen/title_tab_title_margin_horizontal"
            android:layout_marginEnd="72dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rounded_line"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/second_placeholder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mt_placeholder_height"
            android:layout_marginHorizontal="@dimen/title_tab_title_margin_horizontal"
            android:layout_marginVertical="@dimen/mt_placeholder_margin_vertical"
            app:placeholder_shimmering="true"
            app:placeholder_type="rounded_line"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/third_placeholder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mt_placeholder_height"
            android:layout_marginHorizontal="@dimen/title_tab_title_margin_horizontal"
            android:layout_marginVertical="@dimen/mt_placeholder_margin_vertical"
            app:placeholder_shimmering="true"
            app:placeholder_type="rounded_line"/>
        <com.yandex.go.design.view.GoConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yandex.go.design.view.GoFrameLayout
                android:id="@+id/loading_payment_icon_container"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/go_design_s_space"
                android:layout_marginBottom="@dimen/go_design_s_space"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/loading_undefined_card_view"
                    android:visibility="gone"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_payment_undefined"
                    android:scaleType="center"
                    android:contentDescription="@string/scooters_offer_card_v2_a11y_payment_info_button_add"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yandex.go.payments.design.composite.CompositePaymentIconsView
                    android:id="@+id/loading_payment_info_view"
                    android:background="@drawable/bg_transparent_ripple"
                    android:visibility="gone"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:titleVisible="true"/>
            </com.yandex.go.design.view.GoFrameLayout>
            <Space
                android:id="@+id/loading_bottom_spacer"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintStart_toEndOf="@+id/loading_payment_icon_container"/>
            <Space
                android:id="@+id/initial_loading_additional_bottom_spacer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:layout_constraintStart_toEndOf="@+id/loading_bottom_spacer"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:enabled="false"
                android:id="@+id/shimmering_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/common_loading"
                app:component_background_color="@color/component_accent_color"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/loading_bottom_spacer"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.yandex.go.design.view.GoConstraintLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
