<?xml version="1.0" encoding="utf-8"?>
<com.yandex.alicekit.core.views.BackHandlingLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/msg_bg_selection_menu"
    android:paddingTop="1dp"
    android:layout_width="match_parent"
    android:layout_height="53dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:gravity="start|center_vertical"
        android:id="@+id/text_counter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="20"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_pin"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="?attr/messagingCommonIconsPrimaryColor"
        android:contentDescription="@string/pin_button_in_chat_window_content_des__res_0x7f151451"
        android:paddingStart="@dimen/selected_messages_panel_item_padding"
        android:paddingEnd="@dimen/selected_messages_panel_item_padding"
        app:srcCompat="@drawable/msg_ic_pin"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_reply"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="?attr/messagingCommonIconsPrimaryColor"
        android:contentDescription="@string/reply_button_in_chat_window_content_des__res_0x7f151565"
        android:paddingStart="@dimen/selected_messages_panel_item_padding"
        android:paddingEnd="@dimen/selected_messages_panel_item_padding"
        app:srcCompat="@drawable/msg_ic_reply"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_forward"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="?attr/messagingCommonIconsPrimaryColor"
        android:contentDescription="@string/forward_button_in_chat_window_content_des__res_0x7f15084f"
        android:paddingStart="@dimen/selected_messages_panel_item_padding"
        android:paddingEnd="@dimen/selected_messages_panel_item_padding"
        app:srcCompat="@drawable/msg_ic_arrow_to_forward"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_copy"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="?attr/messagingCommonIconsPrimaryColor"
        android:contentDescription="@string/copy_button_in_chat_window_content_des__res_0x7f15059a"
        android:paddingStart="@dimen/selected_messages_panel_item_padding"
        android:paddingEnd="@dimen/selected_messages_panel_item_padding"
        app:srcCompat="@drawable/msg_ic_copy"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_share"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="?attr/messagingCommonIconsPrimaryColor"
        android:contentDescription="@string/share_button_in_chat_window_content_des__res_0x7f151748"
        android:paddingStart="@dimen/selected_messages_panel_item_padding"
        android:paddingEnd="@dimen/selected_messages_panel_item_padding"
        app:srcCompat="@drawable/msg_ic_share"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_delete"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:contentDescription="@string/delete_button_in_chat_window_content_des__res_0x7f150632"
        android:paddingStart="@dimen/selected_messages_panel_item_padding"
        android:paddingEnd="@dimen/selected_messages_panel_item_padding"
        app:srcCompat="@drawable/msg_ic_delete"
        app:tint="?attr/messagingCommonDestructiveIconsColor"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_close"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="?attr/messagingCommonIconsPrimaryColor"
        android:contentDescription="@string/close_button_in_chat_window_content_des__res_0x7f15051b"
        android:paddingStart="@dimen/selected_messages_panel_item_padding"
        android:paddingEnd="12dp"
        app:srcCompat="@drawable/msg_ic_close"/>
</com.yandex.alicekit.core.views.BackHandlingLinearLayout>
