<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/bgMain"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.flex.common.api.ui.theme.DivKitThemedFrameLayout
        android:id="@+id/flexContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topViewsBarrier"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/topViewsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="@dimen/go_design_s_space"
        app:constraint_referenced_ids="currentAddress, searchInput"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/shadowView"
        android:background="@drawable/round_corners_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/topViewsBarrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/roundedTopBackground"
        android:background="@drawable/round_corners_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/topViewsBarrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/roundedTopBackgroundDarkGlow"
        android:background="@drawable/round_corners_section_dark_glow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/topViewsBarrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/currentAddress"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:component_lead_image="@drawable/ic_arrow_back_24dp"
        app:component_lead_image_tint="?attr/textMain"
        app:component_navigation_icon="@drawable/ic_chevron_next_circle_16dp"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_max_lines="1"
        app:component_subtitle_size="16sp"
        app:component_subtitle_text_color="?attr/textMain"
        app:component_subtitle_typeface="medium"
        app:component_subtitle_with_navigation="true"
        app:component_subtitle_with_navigation_icon_height="16dp"
        app:component_tint_navigation_icon="false"
        app:component_title="@string/superapp_search_current_address_title"
        app:component_title_gravity="center_horizontal"
        app:component_title_max_lines="1"
        app:component_title_size="13sp"
        app:component_title_text_color="?attr/textMain"
        app:component_trail_companion_text_color="?attr/textMain"
        app:component_vertical_padding="0dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.AddressInputComponent
        android:id="@+id/searchInput"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:minHeight="48dp"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_address_mode="input"
        app:layout_constraintTop_toBottomOf="@+id/currentAddress"
        app:lead_image_placeholder="@drawable/ic_superapp_suggest_search"
        app:lead_image_placeholder_tint="?attr/textMain"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/cartsButtonContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toTopOf="@+id/floatingInputContainer"
        app:layout_constraintEnd_toEndOf="parent">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/cartsButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cart_button_height"
            app:component_background_color="@color/component_accent_color"
            app:component_button_icon_padding="@dimen/go_design_s_space"
            app:component_button_rounded_corners_radius="100dp"
            app:component_title_color="@color/black"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/inputFieldPrimaryShadow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/input_field_primary_shadow_blur_minus_offset_margin"
        android:layout_marginBottom="@dimen/input_field_primary_shadow_blur_plus_offset_margin"
        android:layout_marginStart="@dimen/input_field_primary_shadow_blur_margin"
        android:layout_marginEnd="@dimen/input_field_primary_shadow_blur_margin"
        app:layout_constraintBottom_toBottomOf="@+id/floatingInputContainer"
        app:layout_constraintEnd_toEndOf="@+id/floatingInputContainer"
        app:layout_constraintStart_toStartOf="@+id/floatingInputContainer"
        app:layout_constraintTop_toTopOf="@+id/floatingInputContainer"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/floatingInputContainer"
        android:background="@drawable/floating_input_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.yandex.taxi.design.ListItemInputComponent
            android:layout_gravity="end|center_vertical"
            android:id="@+id/floatingInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="40dp"
            app:component_input_hint="@string/superapp_search_input_hint"
            app:component_input_type="text"
            app:component_max_lines="2"
            app:component_show_underline="false"
            app:component_title_input="@string/favorite_address_title_field"
            app:component_type_input="textCapSentences"
            app:imeOptions="actionSearch"/>
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/mapButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/floating_input_map_fill_icon"
            android:contentDescription="@string/show_map_action"/>
        <com.yandex.go.design.view.GoFrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/trailButton"
            android:background="@drawable/oval_shape"
            android:padding="@dimen/go_design_s_space"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <com.yandex.go.design.view.GoImageView
                android:id="@+id/trailButtonSendImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.yandex.go.design.view.GoImageView
                android:id="@+id/trailButtonLoadingImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"/>
        </com.yandex.go.design.view.GoFrameLayout>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoConstraintLayout>
