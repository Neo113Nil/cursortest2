<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/above_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/go_design_s_space"
        app:layout_constraintBottom_toTopOf="@+id/above_button_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/above_button_barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="payment_layout_container, button, offer_details_view"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/payment_layout_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button"
        layout="@layout/scooters_payment_icon_layout"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:gravity="center"
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/legal_terms_agreement"
        app:layout_constraintEnd_toStartOf="@+id/offer_details_view"
        app:layout_constraintStart_toEndOf="@+id/payment_layout_container"
        app:layout_goneMarginEnd="@dimen/go_design_s_space"
        app:layout_goneMarginStart="@dimen/go_design_s_space"/>
    <ru.yandex.taxi.plus.badge.CashbackHorizontalView
        android:id="@+id/cashback_view"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:accessibilityTraversalAfter="@+id/payment_layout_container"
        app:layout_constraintEnd_toEndOf="@+id/button"
        app:layout_constraintTop_toTopOf="@+id/button"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/offer_details_view"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_scooters_info_circle"
        android:scaleType="center"
        android:accessibilityTraversalAfter="@+id/button"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption_secondary"
        android:textColorLink="?attr/textMinor"
        android:gravity="center"
        android:id="@+id/legal_terms_agreement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/go_design_s_space"
        android:color="?attr/textMinor"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
