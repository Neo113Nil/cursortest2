<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/btn_back"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/btn_back_media_browser_content_desc"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_back"/>
    <ImageView
        android:id="@+id/btn_search"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/btn_search_media_browser_content_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_search"
        app:tint="?attr/messagingCommonIconsPrimaryColor"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/btn_search"
        app:layout_constraintStart_toEndOf="@+id/btn_back"
        app:layout_constraintTop_toTopOf="parent"
        app:tabGravity="center"
        app:tabIndicatorColor="?attr/messagingCommonAccentColor"
        app:tabIndicatorHeight="1dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/messagingCommonTextPrimaryColor"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabTextColor="?attr/messagingCommonTextSecondaryColor"/>
    <com.yandex.messaging.views.SearchEditText
        android:id="@+id/search_input"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32sp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_back"
        app:layout_constraintTop_toTopOf="@+id/btn_back"
        style="@style/Messaging.SearchInput"/>
    <ImageView
        android:id="@+id/btn_clear_input"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/btn_clear_input_media_browser_content_desc"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_input"
        app:layout_constraintEnd_toEndOf="@+id/search_input"
        app:layout_constraintTop_toTopOf="@+id/search_input"
        app:srcCompat="@drawable/msg_ic_search_input_clean"/>
    <View
        android:id="@+id/divider"
        android:background="@drawable/msg_divider_toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/messaging_bottom_divider_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/media_browser_tabs_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
