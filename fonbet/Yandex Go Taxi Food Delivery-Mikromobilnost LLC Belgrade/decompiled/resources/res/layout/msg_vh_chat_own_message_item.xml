<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messaging.internal.view.chat.ChatItemLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end|center_vertical"
    android:layout_gravity="end"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        layout="@layout/msg_chat_error_icon_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/timeline_message_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/reply"
            android:layout="@layout/msg_reply_layout"
            android:inflatedId="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"/>
        <ViewStub
            android:textColor="?attr/messagingCommonTextSecondaryColor"
            android:id="@+id/forwarded_message"
            android:layout="@layout/msg_forwarded_message"
            android:inflatedId="@+id/forwarded_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yandex.messaging.views.AppCompatEmojiTextView
                android:textSize="@dimen/timeline_message_text_size"
                android:textColor="?attr/messagingOutgoingPrimaryColor"
                android:layout_gravity="bottom"
                android:id="@+id/chat_message_text"
                android:paddingTop="6dp"
                android:paddingBottom="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0sp"
                android:lineSpacingMultiplier="1"
                android:fontFamily="@font/ya_regular"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <include layout="@layout/msg_message_status_and_time"/>
        </FrameLayout>
        <ViewStub
            android:id="@+id/default_url_preview_container_stub"
            android:inflatedId="@+id/url_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/video_url_preview_container_stub"
            android:inflatedId="@+id/video_url_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/chat_url_preview_container_stub"
            android:inflatedId="@+id/chat_url_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/message_url_preview_container_stub"
            android:inflatedId="@+id/message_url_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/user_url_preview_container_stub"
            android:inflatedId="@+id/user_url_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/small_default_url_preview_container_stub"
            android:inflatedId="@+id/small_url_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.yandex.messaging.internal.view.chat.ChatItemLinearLayout>
