<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.ultima_mode.ui.progress_bar.SimpleProgressBarView
        android:id="@+id/progress_bar_view"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:id="@+id/progress_bar_text"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="@dimen/go_design_s_space"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:id="@+id/progress_bar_trail"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBaseline_toBaselineOf="@+id/progress_bar_text"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_helper"
        android:paddingTop="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="progress_bar_text,progress_bar_trail"
        app:flow_horizontalAlign="start"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="0dp"
        app:flow_horizontalStyle="spread_inside"
        app:flow_verticalAlign="baseline"
        app:flow_verticalGap="4dp"
        app:flow_wrapMode="chain"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar_view"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottom_text_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="progress_bar_text,progress_bar_trail"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:id="@+id/progress_bar_bottom_text"
        android:paddingTop="@dimen/go_design_s_space"
        android:paddingBottom="@dimen/go_design_m_space"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_text_barrier"/>
</merge>
