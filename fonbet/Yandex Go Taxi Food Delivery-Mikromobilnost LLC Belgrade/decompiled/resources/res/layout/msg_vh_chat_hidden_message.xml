<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messaging.internal.view.chat.ChatItemFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.yandex.messaging.views.TightTextView
        android:textSize="@dimen/timeline_message_text_size"
        android:textColor="?attr/messagingIncomingLinkColor"
        android:id="@+id/timeline_message_container"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/messaging_moderation_action_hide_text"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0sp"
        android:lineSpacingMultiplier="1"
        android:textIsSelectable="true"/>
</com.yandex.messaging.internal.view.chat.ChatItemFrameLayout>
