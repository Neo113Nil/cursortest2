<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="32sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/vault_title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:fontFamily="@font/ys_text_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/vault_title"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/shadow"
        android:paddingTop="100dp"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginBottom="-48dp"
        android:src="@drawable/ic_vault_shadow"
        android:scaleType="fitXY"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_frame"/>
    <ru.yandex.taxi.design.ClickableImageView
        android:id="@+id/first_frame"
        android:layout_width="280dp"
        android:layout_height="280dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer"
        android:clickable="true"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:importantForAccessibility="no"
        android:translationZ="2dp"
        app:barCornerRadius="50dp"
        app:centerColor="@color/vault_shimmer_center_color"
        app:edgeColor="@color/vault_shimmer_edge_color"
        app:gradientWidth="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"
        app:scrolledHorizontally="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_top_container"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/first_frame"
        app:layout_constraintEnd_toEndOf="@+id/first_frame"
        app:layout_constraintStart_toStartOf="@+id/first_frame"
        app:layout_constraintTop_toTopOf="@+id/first_frame"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_main_container"
        android:visibility="invisible"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <com.yandex.go.vault.flexsdk.descriptors.widget.animation.LockOverlayView
        android:id="@+id/lock_overlay"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_frame"
        app:layout_constraintEnd_toEndOf="@+id/first_frame"
        app:layout_constraintStart_toStartOf="@+id/first_frame"
        app:layout_constraintTop_toTopOf="@+id/first_frame"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/shadow_top"
        android:paddingBottom="150dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_vault_top_shadow"
        android:scaleType="fitXY"
        android:translationZ="-1dp"
        android:paddingHorizontal="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
