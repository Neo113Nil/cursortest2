<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gray_separator_view"
        android:background="?attr/cardDivider"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:layout_alignBottom="@+id/source_header"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"/>
    <View
        android:id="@+id/bottom_shadow"
        android:background="@drawable/round_corners_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="48dp"
        android:layout_alignTop="@+id/source_header"
        android:layout_alignBottom="@+id/bottom_space"/>
    <View
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/address_input_stub"/>
    <ViewStub
        android:id="@+id/top_sticky_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/source_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@+id/top_sticky_view_container"
        app:component_lead_image="@drawable/ic_arrow_back_24dp"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_size="@dimen/subtitle_text_size"
        app:component_subtitle_text_color="?attr/textMain"
        app:component_subtitle_typeface="medium"
        app:component_subtitle_with_navigation="true"
        app:component_subtitle_with_navigation_icon_height="@dimen/go_design_s_space"
        app:component_title="@string/pickup"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="13sp"
        app:component_title_text_color="?attr/textMain"
        app:component_trail_companion_text_color="?attr/textMain"/>
    <View
        android:id="@+id/address_input_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignTop="@+id/address_input"
        android:layout_alignBottom="@+id/address_input"
        android:importantForAccessibility="no"/>
    <ru.yandex.taxi.design.AddressInputComponent
        android:id="@+id/address_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/source_header"
        android:layout_marginEnd="@dimen/go_design_s_space"/>
    <View
        android:id="@+id/address_input_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/source_header"/>
    <ru.yandex.taxi.preorder.suggested.selection.SuggestsView
        android:id="@+id/suggests_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/address_input"
        android:layout_alignParentBottom="true"
        android:translationZ="-1dp"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/suggests_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/address_input"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        layout="@layout/search_address_shimmering"/>
    <ViewStub
        android:id="@+id/empty_message_stub"
        android:layout="@layout/text_message"
        android:inflatedId="@+id/message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_below="@+id/address_input"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
