<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="end|bottom"
    android:id="@+id/message_status_and_time_group"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <TextView
        android:textSize="12sp"
        android:id="@+id/channel_message_forwards_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="true"
        android:drawablePadding="2dp"
        android:layout_marginEnd="8dp"
        app:drawableStartCompat="@drawable/msg_ic_arrow_to_forward_small"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/channel_message_views_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="true"
        android:drawablePadding="2dp"
        android:layout_marginEnd="8dp"
        app:drawableStartCompat="@drawable/msg_ic_message_channel_views"
        app:drawableTint="?attr/messagingCommonIconsPrimaryColor"/>
    <ImageView
        android:id="@+id/message_edited_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/msg_ic_message_edit"/>
    <ImageView
        android:id="@+id/message_sending_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/msg_message_status_sent_content_desc"/>
    <TextView
        android:textSize="@dimen/timeline_message_time_font_size"
        android:gravity="end"
        android:id="@+id/message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="true"
        android:fontFamily="@font/ya_regular"/>
</LinearLayout>
