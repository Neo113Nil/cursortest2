<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="36dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp">
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_auto_topup_bottom_sheet_choose_day_of_month"
        style="@style/Widget.YB.Text.Headline1"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/personListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="7"/>
    <include
        android:id="@+id/last_day_checkbox_block"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/ybsdk_item_with_text_and_checkbox"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/ybsdk_auto_topup_bottom_sheet_choose_date_february_hint"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:ybsdk_buttonTitle="@string/ybsdk_auto_topup_bottom_sheet_choose_date_save_button"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
</LinearLayout>
