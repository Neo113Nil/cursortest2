<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pinEnterElements"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.ybsdk.widgets.common.ToolbarView
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_title="@string/ybsdk_pin_first_pin_set_title"/>
        <ViewSwitcher
            android:id="@+id/codeInputSwitcher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/keyboard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:layout_constraintVertical_bias="@dimen/ybsdk_pin_indicators_vertical_bias"
            app:layout_constraintVertical_chainStyle="packed">
            <com.ybsdk.widgets.common.PinCodeDotsView
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/dotsFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ybsdk_useAsEditText="false"/>
            <com.ybsdk.widgets.common.PinCodeDotsView
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/dotsSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ybsdk_useAsEditText="false"/>
        </ViewSwitcher>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/pinHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ybsdk_pin_weak_pin_hint"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/codeInputSwitcher"
            style="@style/Widget.YB.Text.Body2"/>
        <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:visibility="gone"
        android:layout_width="@dimen/ybsdk_size_progress_indicator"
        android:layout_height="@dimen/ybsdk_size_progress_indicator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/YbSdk.Widget.WidgetsCommon.CircularProgressIndicatorLoader"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.widgets.common.communication.CommunicationFullScreenView
        android:id="@+id/fullScreenView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
