<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/cardDivider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.AutoDividerComponentList
        android:id="@+id/route_block"
        android:background="@drawable/round_section_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_middle_divider_type="icon">
        <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
            android:id="@+id/source"
            android:background="@drawable/bg_transparent_ripple"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_lead_image="@drawable/ic_order_card_source"/>
        <ru.yandex.taxi.design.DividerAwareComponent
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:id="@+id/route_points_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="icon">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/route_point"
                    android:background="@drawable/bg_main_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_lead_image="@drawable/ic_point_middle"
                    app:component_trail_mode="navigation"/>
            </ru.yandex.taxi.design.AutoDividerComponentList>
        </ru.yandex.taxi.design.DividerAwareComponent>
        <ru.yandex.taxi.design.DividerAwareComponent
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:id="@+id/travel_companion_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="icon"/>
        </ru.yandex.taxi.design.DividerAwareComponent>
        <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
            android:id="@+id/destination"
            android:background="@drawable/bg_transparent_ripple"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_lead_image="@drawable/ic_order_card_destination"/>
        <ru.yandex.taxi.design.DividerAwareComponent
            android:id="@+id/toll_road_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ru.yandex.taxi.design.AutoDividerComponentList>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_requirements"
        android:background="@drawable/round_section_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <ru.yandex.taxi.design.AutoDividerComponentList
        android:orientation="vertical"
        android:id="@+id/options_block"
        android:background="@drawable/round_section_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:component_middle_divider_type="icon">
        <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
            android:id="@+id/ride_support"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_no_background="true"/>
        <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
            android:id="@+id/payment_method"
            android:background="@drawable/bg_transparent_ripple"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_lead_image="@drawable/ic_order_card_destination"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/freightage_ride_block"
            android:background="@drawable/bg_main_ripple"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.yandex.taxi.costcenters.ride.OpenCostCenterListItem
            android:id="@+id/cost_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.yandex.taxi.design.ListItemSwitchComponent
            android:id="@+id/live_location"
            android:background="@drawable/bg_main_ripple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_lead_image="@drawable/ic_location_fill_24"
            app:component_switch_track_color="@color/component_blue_toxic"
            app:component_title="@string/location_sharing_control_button"/>
        <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
            android:id="@+id/details"
            android:background="@drawable/bg_main_ripple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ru.yandex.taxi.design.AutoDividerComponentList>
</merge>
