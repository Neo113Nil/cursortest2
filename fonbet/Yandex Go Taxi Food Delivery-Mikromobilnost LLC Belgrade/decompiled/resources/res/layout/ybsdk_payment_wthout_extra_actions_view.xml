<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/ybsdk_subscription_bottom_sheet_circle_size"
            android:layout_height="@dimen/ybsdk_subscription_bottom_sheet_circle_size"
            android:layout_marginLeft="74dp"
            android:layout_marginTop="44dp"
            app:srcCompat="@drawable/ybsdk_ic_transfers_sbp_with_background"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginLeft="19dp"
                android:layout_marginTop="39dp"
                app:srcCompat="@drawable/ybsdk_ic_circle"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/qrPaymentSubscriptionLogo"
                android:layout_width="@dimen/ybsdk_subscription_bottom_sheet_circle_size"
                android:layout_height="@dimen/ybsdk_subscription_bottom_sheet_circle_size"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="44dp"
                app:srcCompat="@drawable/ybsdk_ic_circle_gray"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/qrPaymentSubscriptionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        style="@style/Widget.YB.Text.Headline1"/>
    <TextView
        android:id="@+id/qrPaymentSubscriptionDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        style="@style/Widget.YB.Text.Body2"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/qrPaymentSubscriptionAgreementsTitle"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        style="@style/Widget.YB.Text.Title1"/>
    <com.ybsdk.widgets.common.paymentmethod.SelectPaymentMethodView
        android:id="@+id/qrPaymentSubscriptionAgreements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
