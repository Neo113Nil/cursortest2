<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/superapp_main_screen_toolbar_height">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/address_logo_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/superapp_main_screen_toolbar_height"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/cashback_view_holder"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ViewStub
            android:layout_gravity="start|center_vertical"
            android:id="@+id/logo_view"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/superapp_main_screen_logo_height"
            android:src="@drawable/ic_default_logo"
            android:scaleType="centerCrop"
            android:minHeight="32dp"/>
        <ru.yandex.taxi.widget.OptimizedShimmeringRobotoTextView
            android:textSize="13sp"
            android:textColor="?attr/textMain"
            android:ellipsize="middle"
            android:gravity="start|center_vertical"
            android:id="@+id/current_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="4dp"
            app:robotoFontStyle="medium"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clarify_address_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/address_logo_container">
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/clarify_address_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="5dp"
            app:component_lead_image="@drawable/ic_address_picker"
            app:component_subtitle_max_lines="1"
            app:component_title_max_lines="2"
            app:component_title_typeface="medium"
            app:component_trail_mode="navigation"
            app:layout_constraintBottom_toTopOf="@+id/clarify_address_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/clarify_address_actions"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clarify_address_hint">
            <ru.yandex.taxi.design.ButtonComponent
                android:layout_gravity="center_vertical"
                android:id="@+id/clarify_address_minor_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:component_background_color="?attr/controlMinor"
                app:component_title_color="?attr/textOnControlMinor"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:layout_gravity="center_vertical"
                android:id="@+id/clarify_address_major_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:component_button_accent="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/cashback_view_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/menu_button"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/top_end_corner_with_cashback"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <ru.yandex.taxi.settings.MainMenuButton
        android:id="@+id/menu_button"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/superapp_main_screen_toolbar_height"
        android:importantForAccessibility="yes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
