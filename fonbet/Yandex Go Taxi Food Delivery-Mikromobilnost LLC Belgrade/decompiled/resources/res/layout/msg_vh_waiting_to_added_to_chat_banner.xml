<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/msg_bg_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/banner_waiting_to_added_to_chat_pic"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="37dp"
        android:src="0x7f081489"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/banner_waiting_to_added_to_chat_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="33dp"
        android:layout_marginBottom="30dp"
        android:text="@string/banner_waiting_to_added_to_chat"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/banner_waiting_to_added_to_chat_pic"
        style="@style/Messaging.BannerTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
