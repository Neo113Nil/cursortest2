<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/delivery_united_summary_scroll"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/delivery_united_summary_bottom_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/delivery_points_recycler"
            android:background="?attr/everBack"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:id="@+id/delivery_united_summary_shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/delivery_united_summary_scroll"
        app:layout_constraintEnd_toEndOf="@+id/delivery_united_summary_scroll"
        app:layout_constraintStart_toStartOf="@+id/delivery_united_summary_scroll"
        app:scroll_view_id="@+id/delivery_united_summary_scroll"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/delivery_form_bottom_shadow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/delivery_united_summary_bottom_background"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/delivery_united_summary_bottom_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/delivery_united_summary_requirement"/>
    <FrameLayout
        android:id="@+id/delivery_united_summary_requirement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/go_design_s_space"
        app:layout_constraintBottom_toTopOf="@+id/delivery_united_summary_order_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_united_summary_order_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_rounded_background="?attr/controlMain"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_text_color="?attr/textOnControl"
        app:component_title="@string/summary_confirm"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/textOnControl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
