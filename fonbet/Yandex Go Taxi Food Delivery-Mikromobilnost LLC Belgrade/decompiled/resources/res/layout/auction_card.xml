<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.buttons.IconCircleButton
        android:id="@+id/start_control"
        android:layout_width="@dimen/control_button_size"
        android:layout_height="@dimen/control_button_size"
        android:layout_marginTop="@dimen/control_button_margin_top"
        android:contentDescription="@string/auction_accessibility_decrease_price"
        android:layout_marginStart="@dimen/go_design_s_space"
        app:component_circle_image="@drawable/ic_minus"
        app:component_shadow_enable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmering_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/shimmering_bar_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_control"
        app:layout_constraintStart_toEndOf="@+id/start_control"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_no_background="true"
        app:component_vertical_padding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_control"
        app:layout_constraintStart_toEndOf="@+id/start_control"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.buttons.IconCircleButton
        android:id="@+id/end_control"
        android:layout_width="@dimen/control_button_size"
        android:layout_height="@dimen/control_button_size"
        android:layout_marginTop="@dimen/control_button_margin_top"
        android:contentDescription="@string/auction_accessibility_increase_price"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_circle_image="@drawable/ic_plus"
        app:component_shadow_enable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
