<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messaging.internal.view.chat.ChatItemLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/timeline_message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/reply"
            android:layout="@layout/msg_reply_layout"
            android:inflatedId="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"/>
        <ViewStub
            android:textColor="?attr/messagingIncomingSecondaryColor"
            android:id="@+id/forwarded_message"
            android:layout="@layout/msg_forwarded_message"
            android:inflatedId="@+id/forwarded_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/message_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:paddingHorizontal="12dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/poll_message_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Messaging.PollMessage.Title"/>
                <com.yandex.bricks.BrickSlotView
                    android:id="@+id/poll_message_votes_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/poll_message_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <include layout="@layout/msg_poll_vote_btn"/>
            </LinearLayout>
            <include
                android:layout_gravity="end|bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                android:layout_marginEnd="12dp"
                layout="@layout/msg_message_status_and_time"/>
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/msg_chat_error_icon_layout"/>
</com.yandex.messaging.internal.view.chat.ChatItemLinearLayout>
