<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/bgMain"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/bgMinor"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="20sp"
            android:textColor="?attr/textMain"
            android:id="@+id/primary_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textFontWeight="700"
            app:robotoFontStyle="bold"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:id="@+id/secondary_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="500"
            app:robotoFontStyle="medium"/>
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/powerbank_type"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"/>
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/chevron_next"
            android:scaleType="center"/>
    </com.yandex.go.design.view.GoLinearLayout>
</androidx.cardview.widget.CardView>
