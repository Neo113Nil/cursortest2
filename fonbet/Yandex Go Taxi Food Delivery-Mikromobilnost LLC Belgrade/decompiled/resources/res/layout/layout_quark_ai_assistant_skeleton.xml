<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgMain"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/keyboard_skeleton"
        android:layout_width="match_parent"
        android:layout_height="97dp"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:barCornerRadius="24dp"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/keyboard_hint_skeleton"
        android:layout_width="271dp"
        android:layout_height="8dp"
        android:layout_marginBottom="12dp"
        app:barCornerRadius="4dp"/>
</com.yandex.go.design.view.GoFrameLayout>
