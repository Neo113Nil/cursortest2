<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout
        android:id="@+id/swipeRefreshContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/merchantOffersBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinatorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBarLayout"
                android:background="?attr/ybColor_internal_transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collapsingToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                    <FrameLayout
                        android:id="@+id/storiesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ybsdk_merchant_offers_banner_height"
                        app:layout_collapseMode="none">
                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/bannersPager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:orientation="horizontal"
                            android:id="@+id/appBar"
                            android:layout_width="match_parent"
                            android:layout_height="48dp">
                            <com.ybsdk.widgets.common.storybar.YbSdkStoryProgressBar
                                android:id="@+id/storyProgressBar"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/ybsdk_stories_progress_top_margin"
                                android:layout_marginHorizontal="127dp"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:ybsdk_indicator_color="?attr/ybColor_textIcon_primary"
                                app:ybsdk_track_color="?attr/ybColor_textIcon_quaternary"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </FrameLayout>
                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/toolbar"
                        android:background="?attr/ybColor_background_primary"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:alpha="0"
                        app:layout_collapseMode="pin"/>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <com.ybsdk.widgets.common.recycler.OrientationAwareRecyclerView
                android:id="@+id/screenItemsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout>
    <com.ybsdk.widgets.common.bottombar.BottomBarNavigation
        android:id="@+id/merchantOffersBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/merchantOffersBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ybsdk_shimmer_merchant_offers"/>
    <com.ybsdk.feature.divkit.api.ui.skeletons.DivSkeletonsView
        android:id="@+id/divkitShimmerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/merchantOffersBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/merchantOffersBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.feature.merchant.offers.internal.view.MerchantOffersFloatingActionButtonView
        android:id="@+id/merchantOffersFloatingActionButton"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:foreground="@drawable/ybsdk_ic_arrow_long_top"
        android:foregroundGravity="center"
        android:layout_marginEnd="22dp"
        android:backgroundTint="?attr/ybColor_button_disabled"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/merchantOffersBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@color/yb_light_internal_transparent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
