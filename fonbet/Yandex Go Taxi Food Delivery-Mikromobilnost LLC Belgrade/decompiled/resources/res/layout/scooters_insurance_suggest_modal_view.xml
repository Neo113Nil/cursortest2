<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:text="@string/scooters_insurance_screen_title"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_lead_image="@drawable/ic_coins_vector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/conditions"
        android:background="@drawable/scooters_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="margin"
        app:component_lead_image="@drawable/ic_content"
        app:component_title="@string/scooters_insurance_conditions"
        app:component_trail_mode="navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/price"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/details_item_component"
        android:background="@drawable/scooters_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="margin"
        app:component_lead_image="@drawable/ic_scooters_info_circle"
        app:component_title="@string/scooters_insurance_details_item_title"
        app:component_trail_mode="navigation"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/minor_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/scooters_refuse_insurance_button"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMinor"
        app:component_title_color="?attr/textOnControlMinor"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/main_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:text="@string/scooters_turn_on_insurance_button"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMain"/>
</com.yandex.go.design.view.GoLinearLayout>
