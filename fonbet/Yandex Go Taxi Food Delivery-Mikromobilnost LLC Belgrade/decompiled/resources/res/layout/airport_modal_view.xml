<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/multi_exit_modal_view_content"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListTitleComponent
        android:id="@+id/multi_exit_modal_view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_title="@string/address_search_modal_view_from"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/multi_exit_modal_view_subtitle"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="margin"/>
    <ru.yandex.taxi.widget.wheel.PickerView
        android:id="@+id/multi_exit_modal_view_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/multi_exit_modal_view_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_m_space"
            android:text="@string/multiexit_picker_done"
            android:layout_marginStart="@dimen/go_design_m_space"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:component_title_typeface="medium"/>
    </FrameLayout>
</LinearLayout>
