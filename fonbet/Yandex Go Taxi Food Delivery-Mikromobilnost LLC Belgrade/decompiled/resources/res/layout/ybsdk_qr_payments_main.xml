<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.BlendingGradientView
        android:id="@+id/qrPaymentsMerchantGradient"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/qrPaymentsMainKeyboard"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/qrPaymentsMerchantGradientOverlap"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/qrPaymentsMainButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/nestedScrollView"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toTopOf="@+id/qrPaymentsMainButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qrPaymentsMainToolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ybsdk.feature.qr.payments.internal.screens.presentation.view.OperationStatusView
                android:id="@+id/qrPaymentsMainMerchantIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
                android:id="@+id/qrPaymentsMerchantIconShimmer"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/qrPaymentsMainMerchantIcon"
                app:layout_constraintEnd_toEndOf="@+id/qrPaymentsMainMerchantIcon"
                app:layout_constraintStart_toStartOf="@+id/qrPaymentsMainMerchantIcon"
                app:layout_constraintTop_toTopOf="@+id/qrPaymentsMainMerchantIcon">
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_gravity="center"
                    android:id="@+id/qrPaymentsMerchantIconSkeleton"
                    android:layout_width="@dimen/ybsdk_qr_payments_merchant_icon_size"
                    android:layout_height="@dimen/ybsdk_qr_payments_merchant_icon_size"
                    android:shape="oval"/>
            </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
            <com.ybsdk.feature.qr.payments.internal.screens.presentation.view.MessageAnimatedView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/qrPaymentsMainMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsMainMerchantIcon"
                style="@style/Widget.YB.Text.Title2"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/qrPaymentsMainPurpose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsMainMessage"
                style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/qrPaymentsResultInfoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsMainAmount"
                style="@style/Widget.YB.Text.Body2"/>
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/qrPaymentsResultInfoDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsResultInfoTitle"
                style="@style/Widget.YB.Text.Body2"/>
            <View
                android:id="@+id/qrPaymentsMainTooltipAnchor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/qrPaymentsMainAmount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/qrPaymentsMainAmount"/>
            <com.ybsdk.widgets.common.MoneyInputEditView
                android:theme="@style/YbSdk.Widget.WidgetsCommon.NumbersInput"
                android:id="@+id/qrPaymentsMainAmount"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_qr_payments_amount_top_margin"
                android:text="@string/ybsdk_qr_payments_hint"
                android:singleLine="true"
                android:digits="0123456789.,"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                app:layout_constraintEnd_toStartOf="@+id/qrPaymentsMainCurrency"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsMainPurpose"
                app:ybsdk_is_cursor_fixed="true"
                style="@style/Widget.YB.Text.Numbers2"/>
            <TextView
                android:id="@+id/qrPaymentsMainCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:contentDescription="@string/ybsdk_common_accessibility_amount_description"
                android:labelFor="@+id/qrPaymentsMainAmount"
                app:layout_constraintBaseline_toBaselineOf="@+id/qrPaymentsMainAmount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/qrPaymentsMainAmount"
                style="@style/Widget.YB.Text.Numbers2"/>
            <com.ybsdk.feature.divkit.api.ui.YbDivView
                android:id="@+id/qrPaymentsMainDivWidget"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_qr_payments_div_widgets_top_margin"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsMainAmount"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/qrPaymentsWidgetsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsMainDivWidget"
                app:layout_constraintVertical_bias="1"
                app:reverseLayout="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
        android:id="@+id/qrPaymentsMainKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/qrPaymentsMainButton"
        app:ybsdk_additionalButtonType="comma"/>
    <com.ybsdk.feature.divkit.api.ui.YbDivView
        android:id="@+id/qrPaymentsMainDivAgreements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/qrPaymentsMainButton"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/qrPaymentsMainButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ybsdk_qr_payments_yb_button_bottom_margin"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <com.ybsdk.widgets.common.OperationProgressOverlayDialog
        android:id="@+id/qrPaymentsMainOverlayDialog"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/qrPaymentsMainTapBlockOverlay"
        android:background="?attr/ybColor_internal_transparent"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <com.ybsdk.feature.qr.payments.internal.screens.presentation.view.ImageToolbarView
        android:id="@+id/qrPaymentsMainToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/qrPaymentsMainSkeletons"
        layout="@layout/ybsdk_qr_payments_main_skeleton"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/qrPaymentsMainErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
