<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ybsdk_widget_view_big_margin"
    android:paddingVertical="12dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cashbackItemImage"
        android:layout_width="@dimen/ybsdk_item_image_size"
        android:layout_height="@dimen/ybsdk_item_image_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_cashback_item_placeholder"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/infoIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/cashbackItemImage"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/infoIcon"
        android:padding="2dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:alpha="0.2"
        android:layout_marginEnd="12dp"
        android:tintMode="src_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/percent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_info_filled"/>
    <TextView
        android:id="@+id/percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
