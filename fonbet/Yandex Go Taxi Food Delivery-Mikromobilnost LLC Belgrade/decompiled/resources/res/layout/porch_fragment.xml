<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.widget.InsetsAwareLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RelativeLayout
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.widget.RobotoTextView
                android:id="@+id/porch_hint"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/summary_porch_hint"
                android:layout_alignBaseline="@+id/porch"
                android:paddingEnd="8sp"
                app:robotoFontStyle="light"
                style="@style/text_input.left"/>
            <ru.yandex.taxi.widget.RobotoEditText
                android:id="@+id/porch"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:inputType="number"
                android:layout_toEndOf="@+id/porch_hint"
                app:robotoFontStyle="light"
                style="@style/text_input.left"/>
            <View
                android:id="@+id/porch_line"
                android:background="@drawable/edittext_underlined"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_below="@+id/porch"/>
            <ru.yandex.taxi.widget.RobotoEditText
                android:textColorHint="?attr/textMinor"
                android:id="@+id/comment"
                android:paddingTop="40dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/summary_comment_hint"
                android:layout_below="@+id/porch_line"
                app:robotoFontStyle="light"
                style="@style/text_input.left"/>
            <View
                android:id="@+id/comment_line"
                android:background="@drawable/edittext_underlined"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="-4dp"
                android:layout_below="@+id/comment"/>
        </RelativeLayout>
    </ScrollView>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/done"
        android:text="@string/promocode_confirm"
        style="@style/settings_modal_view_confirm_button"/>
</ru.yandex.taxi.widget.InsetsAwareLinearLayout>
