<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/service_logo_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/eats_collapsed_height"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/service_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="13dp"
        android:scaleType="fitXY"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20dp"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/service_name"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:fontFamily="@font/ya_medium"
        android:layout_marginStart="4dp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/service_close"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/common_close"
        app:srcCompat="@drawable/ic_cross_filled"/>
</com.yandex.go.design.view.GoLinearLayout>
