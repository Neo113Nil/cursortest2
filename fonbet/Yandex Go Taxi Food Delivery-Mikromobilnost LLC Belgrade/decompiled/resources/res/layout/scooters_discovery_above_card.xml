<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.BackButtonIconComponent
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="-12dp"
        app:component_circle_button_badge_color="?attr/controlMain"
        app:component_circle_button_badge_text_color="?attr/textOnControl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yandex.go.scooters.discovery.ScootersDiscoveryActiveOrdersButton
        android:id="@+id/active_orders_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="10dp"
        android:elevation="20dp"
        android:layout_marginHorizontal="40dp"
        app:component_title="@string/scooters_discovery_active_orders"
        app:component_trail_mode="navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/geo_control"
        app:layout_constraintStart_toEndOf="@+id/back_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/geo_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="-12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ru.yandex.taxi.scooters.utils.ScootersGeoButtonIconComponent
            android:id="@+id/geo_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoConstraintLayout>
