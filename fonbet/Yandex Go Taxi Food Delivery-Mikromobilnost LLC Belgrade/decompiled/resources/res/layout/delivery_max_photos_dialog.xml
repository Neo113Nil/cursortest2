<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.buttons.CircleButtonImageView
        android:id="@+id/delivery_max_photos_dialog_image"
        android:background="@drawable/ic_delivery_error_image_background"
        android:padding="@dimen/go_design_s_space"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_delivery_gallery"
        android:scaleType="center"
        android:tint="@color/white"
        android:layout_marginStart="12dp"
        style="@style/CircleButtonImage"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/delivery_max_photos_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/delivery_max_photos_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_max_photos_dialog_ok_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_rounded_background="?attr/controlMain"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/textOnControl"
        app:component_title_typeface="medium"/>
</LinearLayout>
