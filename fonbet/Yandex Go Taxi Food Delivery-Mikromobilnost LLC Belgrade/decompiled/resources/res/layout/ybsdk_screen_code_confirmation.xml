<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.SignOutButton
        android:id="@+id/pinSignOut"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_title="@string/ybsdk_authorization_screen_title"/>
    <ImageView
        android:id="@+id/ybLogo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_pay_logo"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/toolbar_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintGuide_begin="@dimen/ybsdk_toolbar_height"/>
    <TextView
        android:id="@+id/headerTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ybsdk_common_enter_code_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:labelFor="@+id/codeInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pinSignOut"
        style="@style/Widget.YB.Text.Headline1"/>
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/headerTextView"
        app:layout_constraintTop_toBottomOf="@+id/headerTextView"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:background="@drawable/ybsdk_background_edit_text"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minWidth="168dp"
        android:minHeight="68dp"
        app:layout_constraintStart_toStartOf="@+id/titleTextView"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView"
        app:ybsdk_shimmer_auto_start="false">
        <com.ybsdk.widgets.common.SmsCodeEditText
            android:typeface="monospace"
            android:textColor="?attr/ybColor_textIcon_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/codeInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:autofillHints="postalCode"
            style="@style/YbSdk.Widget.WidgetsCommon.CodesInputBox"/>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:gravity="start"
        android:id="@+id/infoMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textsContainer"
        style="@style/Widget.YB.Text.Body2"/>
    <FrameLayout
        android:id="@+id/textsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerLayout">
        <TextView
            android:textColor="?attr/ybColor_textIcon_secondary"
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.YB.Text.Body2"/>
        <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayoutForRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ybsdk_shimmer_auto_start="false">
            <TextView
                android:id="@+id/getNewCodeButton"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ybsdk_common_request_another_otp_sms"
                android:contentDescription="@string/ybsdk_common_request_another_otp_sms"
                style="@style/Widget.YB.Text.Body2"/>
        </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    </FrameLayout>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/errorOptionsButton"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ybsdk_buttonTitle="@string/ybsdk_sms_code_confirmation_support_chat_button_title"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_linkNormal"
        android:id="@+id/ybsdk_change_account_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ybsdk_common_enter_code_change_account_link_title"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/infoMessage"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/codeConfirmationErrorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
