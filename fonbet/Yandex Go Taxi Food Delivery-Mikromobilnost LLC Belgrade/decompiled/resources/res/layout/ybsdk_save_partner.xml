<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.FullscreenStatusView
        android:id="@+id/partnerSaveFullscreenView"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/partnerSaveToolbar"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/partnerSaveErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/partnerSaveToolbar"/>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/partnerSaveToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
