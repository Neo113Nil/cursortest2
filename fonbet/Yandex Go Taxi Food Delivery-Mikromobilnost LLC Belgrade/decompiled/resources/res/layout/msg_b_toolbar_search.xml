<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/messagingCommonActionbarColor"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:textColorHint="?attr/messagingCommonTextSecondaryColor"
        android:gravity="start|center_vertical"
        android:id="@+id/messenger_chat_search_input"
        android:background="@drawable/msg_bg_colored_rounded_input"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:hint="@string/chatlist_search_hint"
        android:lineSpacingExtra="1sp"
        android:contentDescription="@string/content_desc_toolbar_search_button"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
