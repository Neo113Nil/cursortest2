<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bubble_background"
        android:background="@drawable/bubble_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/bubble_arrow_height">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yandex.alicekit.core.views.TightTextView
                android:id="@+id/bubble_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/bubble_close_icon_size"
                android:maxWidth="328dp"
                android:includeFontPadding="false"
                style="@style/Bubble.Widget.TextView.Message"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/bubble_close"
                android:padding="8dp"
                android:layout_width="@dimen/bubble_close_icon_size"
                android:layout_height="@dimen/bubble_close_icon_size"
                app:srcCompat="@drawable/bubbles_close"/>
        </FrameLayout>
        <View
            android:id="@+id/bubble_divider"
            android:background="@color/bubble_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/bubble_layout_buttons"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/bubble_negative"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                style="@style/Bubble.Widget.Button.Negative"/>
            <Button
                android:id="@+id/bubble_positive"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                style="@style/Bubble.Widget.Button"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="start|top"
        android:id="@+id/bubble_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/bubble_arrow"/>
</FrameLayout>
