<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/background"
    android:background="?attr/bgMain"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="false">
    <com.yandex.go.mainscreen.superapp.impl.foundation.presentation.sidepager.MainSidePager
        android:enabled="false"
        android:id="@+id/main_side_pager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yandex.go.design.view.GoFrameLayout
                android:id="@+id/flex_sdk_container"
                android:background="?attr/bgMain"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.yandex.go.design.view.GoFrameLayout
                android:id="@+id/superapp_overlay_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ViewStub
                android:layout_gravity="bottom"
                android:id="@+id/popup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.yandex.go.design.view.GoFrameLayout>
    </com.yandex.go.mainscreen.superapp.impl.foundation.presentation.sidepager.MainSidePager>
</com.yandex.go.design.view.GoFrameLayout>
