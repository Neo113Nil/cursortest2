<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/list_item_component_min_height">
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/compound_option_select_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/compound_option_select_cancel_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListTitleComponent
                android:id="@+id/compound_option_select_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListTextComponent
                android:id="@+id/compound_option_select_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:id="@+id/compound_option_select_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="margin"/>
        </LinearLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:id="@+id/requirements_shadow_indicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/compound_option_select_scroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:scroll_view_id="@+id/compound_option_select_scroll"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/compound_option_select_cancel_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:component_background_color="?attr/controlMinor"
        app:component_button_accent="true"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/compound_option_select_scroll"/>
</androidx.constraintlayout.widget.ConstraintLayout>
