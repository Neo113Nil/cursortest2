<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ybsdk_ad_label_height">
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:gravity="center_vertical"
        android:id="@+id/adLabelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/adLabelIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="4dp"
        style="@style/Widget.YB.Text.Caption3.Medium"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/adLabelIcon"
        android:layout_width="@dimen/ybsdk_ad_label_icon_size"
        android:layout_height="@dimen/ybsdk_ad_label_icon_size"
        android:scaleType="fitCenter"
        android:tint="?attr/ybColor_textIcon_secondary"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/adLabelText"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
