<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/due_constraint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.due_selector.impl.presentation.ui.picker.dayspicker.DaysTimePicker
        android:gravity="center"
        android:id="@+id/due_time_picker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoView
        android:id="@+id/instruction_divider"
        android:background="?attr/cardDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/round_section_divider_height"
        app:layout_constraintTop_toBottomOf="@+id/due_time_picker"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/instructions_view_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="instruction_scroll_container,instruction_divider,instruction_scroll_shadow"/>
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/instruction_scroll_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/instruction_divider">
        <ru.yandex.taxi.widget.InstructionsView
            android:id="@+id/instructions_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:id="@+id/instruction_scroll_shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/instruction_scroll_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:scroll_view_id="@+id/instruction_scroll_container"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:layout_gravity="center"
        android:id="@+id/due_picker_error_message"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/textMinor"
        app:component_title_typeface="regular"
        app:layout_constraintBottom_toBottomOf="@+id/due_time_picker"
        app:layout_constraintTop_toTopOf="@+id/due_time_picker"/>
    <ru.yandex.taxi.design.LoadingComponent
        android:id="@+id/due_picker_progress"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_loading_mode="double_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/due_time_picker"/>
</merge>
