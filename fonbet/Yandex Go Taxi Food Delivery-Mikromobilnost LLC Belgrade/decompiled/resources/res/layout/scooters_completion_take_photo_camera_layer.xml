<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/completion_info"
        android:background="@color/component_fog_light"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="@color/white"
        app:component_trail_image="@drawable/ic_cross_close_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.widget.qr.QrTargetView
        android:id="@+id/target_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/completion_info"/>
    <View
        android:id="@+id/detection_badge_reserved_space"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/target_view"
        app:layout_constraintEnd_toEndOf="@+id/target_view"
        app:layout_constraintStart_toStartOf="@+id/target_view"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/target_bottom_fog"
        android:background="@color/component_fog_light"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/target_view"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/outline_hint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_bike_full_outline"
        android:layout_marginHorizontal="64dp"
        app:layout_constraintBottom_toTopOf="@+id/detection_badge_reserved_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/target_view"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/detection_badge"
        android:background="@drawable/bg_scooters_completion_photo_vehicle_detection_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="28dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/target_view"
        app:layout_constraintEnd_toEndOf="@+id/target_view"
        app:layout_constraintStart_toStartOf="@+id/target_view">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/detection_badge_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_scooters_completion_photo_vehicle_detection_badge_success"
            android:layout_marginEnd="4dp"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/detection_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/bottom_container"
        android:background="@drawable/scooters_rounded_rect_fog_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="144dp"
        android:layout_marginBottom="20dp"
        android:foreground="@drawable/bg_transparent_ripple"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/take_photo_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.widget.progress.CircularProgressBar
        android:id="@+id/panorama_loading"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:component_stroke_color="@color/white"
        app:component_stroke_width="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/bottom_container"
        app:layout_constraintTop_toTopOf="@+id/bottom_container"/>
    <com.yandex.go.design.view.GoImageButton
        android:id="@+id/flash_light_btn"
        android:background="@drawable/scooters_flash_light"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationZ="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/take_photo_btn"
        app:layout_constraintEnd_toStartOf="@+id/take_photo_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/take_photo_btn"/>
    <com.yandex.go.design.view.GoImageButton
        android:id="@+id/take_photo_btn"
        android:background="@drawable/scooters_take_photo_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/scooters_take_photo"
        android:translationZ="1dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_offset_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_offset_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
</com.yandex.go.design.view.GoConstraintLayout>
