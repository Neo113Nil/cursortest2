<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/ybsdk_pfm_filter_bottom_sheet_items_padding_vertical">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/itemIcon"
        android:layout_width="@dimen/ybsdk_pfm_filter_bottom_sheet_items_icon_size"
        android:layout_height="@dimen/ybsdk_pfm_filter_bottom_sheet_items_icon_size"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/Widget.YB.Text.Body1"
        android:textColor="?attr/ybColor_textIcon_primary"
        android:ellipsize="end"
        android:id="@+id/itemTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/ybsdk_pfm_filter_bottom_sheet_items_text_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/itemSubtitleHolder"
        app:layout_constraintEnd_toStartOf="@+id/itemCheckbox"
        app:layout_constraintStart_toEndOf="@+id/itemIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/itemSubtitleHolder"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/itemTitle"
        app:layout_constraintStart_toStartOf="@+id/itemTitle"
        app:layout_constraintTop_toBottomOf="@+id/itemTitle">
        <TextView
            android:textAppearance="@style/Widget.YB.Text.Caption1.Regular"
            android:textColor="?attr/ybColor_textIcon_secondary"
            android:ellipsize="end"
            android:id="@+id/itemSubtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <com.ybsdk.core.design.spoiler.SpoilerTextView
            android:textAppearance="@style/Widget.YB.Text.Caption1.Regular"
            android:textColor="?attr/ybColor_textIcon_secondary"
            android:ellipsize="end"
            android:id="@+id/itemSubtitleAmount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:ybsdk_spoiler_height="@dimen/ybsdk_pfm_spoiler_height_small"
            app:ybsdk_spoiler_horizontal_gravity="left"
            app:ybsdk_spoiler_width="@dimen/ybsdk_pfm_spoiler_width_large"/>
    </FrameLayout>
    <com.ybsdk.widgets.common.checkbox.CheckBoxView
        android:id="@+id/itemCheckbox"
        android:visibility="visible"
        android:layout_width="@dimen/ybsdk_pfm_filter_bottom_sheet_items_checkbox_size"
        android:layout_height="@dimen/ybsdk_pfm_filter_bottom_sheet_items_checkbox_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_colorType="dark"/>
</androidx.constraintlayout.widget.ConstraintLayout>
