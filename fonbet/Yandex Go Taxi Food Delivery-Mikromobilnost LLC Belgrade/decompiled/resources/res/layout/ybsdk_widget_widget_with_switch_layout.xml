<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ybsdk_shimmer_auto_start="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitEnd"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ybsdk_widget_view_margin"
                android:layout_marginTop="@dimen/ybsdk_widget_view_margin"
                android:layout_marginRight="108dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/YbSdk.WidgetWithSwitchTitleStyle"/>
            <TextView
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ybsdk_widget_view_margin"
                android:layout_marginTop="@dimen/ybsdk_widget_view_space_between_texts"
                android:layout_marginRight="108dp"
                android:layout_marginBottom="@dimen/ybsdk_widget_view_big_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                app:layout_constraintVertical_bias="0"
                style="@style/YbSdk.WidgetWithSwitchDescriptionStyle"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/enableSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_widget_view_big_margin"
                android:layout_marginRight="@dimen/ybsdk_widget_view_big_margin"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="?attr/ybColor_fill_default_0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
</merge>
