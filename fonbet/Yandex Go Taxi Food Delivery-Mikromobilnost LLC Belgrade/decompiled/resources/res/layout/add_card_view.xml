<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_top_margin"
        android:layout_marginStart="@dimen/card_horizontal_margin"
        android:layout_marginEnd="@dimen/card_horizontal_margin"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:contentPaddingBottom="@dimen/card_bottom_padding"
        app:layout_constraintBottom_toBottomOf="@+id/cvn_input"
        app:layout_constraintEnd_toEndOf="@+id/card_number_input"
        app:layout_constraintStart_toStartOf="@+id/card_number_input"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/yb_logo"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="2dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/card_number_input"
                app:layout_constraintStart_toStartOf="@+id/card_number_input"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_yb_logo"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textColor="?attr/textMain"
                android:id="@+id/top_trailing_info"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:textAlignment="textEnd"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/yb_logo"
                app:layout_constraintEnd_toEndOf="@+id/card_number_input"
                app:layout_constraintStart_toEndOf="@+id/yb_logo"
                app:layout_constraintTop_toTopOf="@+id/yb_logo"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/horizontal_center_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"
                app:layout_constraintStart_toStartOf="parent"/>
            <ru.yandex.taxi.design.AnimatedListItemInputComponent
                android:id="@+id/card_number_input"
                android:layout_width="0dp"
                android:layout_height="@dimen/menu_edit_text_height"
                android:layout_marginTop="18dp"
                app:component_divider_margin_left="16dp"
                app:component_divider_margin_right="16dp"
                app:component_input_focused_divider_color="?attr/textMain"
                app:component_input_unfocused_divider_color="?attr/textMinor"
                app:component_title_input="@string/payment_card_number_hint"
                app:layout_constraintBottom_toTopOf="@+id/cvn_input"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/yb_logo"/>
            <ru.yandex.taxi.design.AnimatedListItemInputComponent
                android:id="@+id/expiry_date_input"
                android:layout_width="0dp"
                android:layout_height="@dimen/menu_edit_text_height"
                android:contentDescription="@string/add_card_valid_till_description"
                app:component_divider_margin_left="16dp"
                app:component_divider_margin_right="16dp"
                app:component_input_focused_divider_color="?attr/textMain"
                app:component_input_unfocused_divider_color="?attr/textMinor"
                app:component_title_input="@string/add_card_valid_till"
                app:layout_constraintEnd_toEndOf="@+id/horizontal_center_guide"
                app:layout_constraintStart_toStartOf="@+id/card_number_input"
                app:layout_constraintTop_toBottomOf="@+id/card_number_input"/>
            <ru.yandex.taxi.design.AnimatedListItemInputComponent
                android:id="@+id/cvn_input"
                android:layout_width="0dp"
                android:layout_height="@dimen/menu_edit_text_height"
                android:contentDescription="@string/add_credit_card_description_cvn"
                app:component_divider_margin_left="16dp"
                app:component_divider_margin_right="16dp"
                app:component_input_focused_divider_color="?attr/textMain"
                app:component_input_unfocused_divider_color="?attr/textMinor"
                app:component_title_input="@string/add_credit_card_hint_cvn"
                app:layout_constraintEnd_toEndOf="@+id/card_number_input"
                app:layout_constraintStart_toEndOf="@+id/horizontal_center_guide"
                app:layout_constraintTop_toBottomOf="@+id/card_number_input"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ic_cvn_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:importantForAccessibility="no"
                android:layout_marginEnd="17dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cvn_input"
                app:srcCompat="@drawable/ic_question_outline_grayish"
                app:tint="?attr/textMinor"/>
            <ru.yandex.taxi.design.bubble.BubbleTextComponent
                android:id="@+id/bubble_cvn_help"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:layout_marginEnd="10dp"
                android:translationZ="1dp"
                app:component_text="@string/add_card_cvn_explain"
                app:layout_constraintBottom_toBottomOf="@+id/ic_cvn_help"
                app:layout_constraintEnd_toEndOf="@+id/ic_cvn_help"
                app:layout_constraintStart_toStartOf="@+id/cvn_bubble_start_constraint"/>
            <ImageView
                android:id="@+id/card_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_scan"
                app:layout_constraintEnd_toStartOf="@+id/nfc_card_scan_icon"
                app:layout_constraintTop_toTopOf="@+id/card_scan"/>
            <ImageView
                android:id="@+id/nfc_card_scan_icon"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_nfc_card_scan"
                android:importantForAccessibility="yes"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_number_input"
                app:layout_constraintEnd_toStartOf="@+id/card_scan"
                app:layout_constraintTop_toTopOf="@+id/card_number_input"/>
            <ImageView
                android:id="@+id/card_scan"
                android:background="@drawable/bg_button"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_card_scan"
                android:contentDescription="@string/add_credit_card_scan_button_description"
                android:layout_marginEnd="13dp"
                app:hintTextAppearance="@style/TextAppearanceCardHint"
                app:layout_constraintBottom_toBottomOf="@+id/card_number_input"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/card_number_input"
                app:tint="?attr/textMain"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/cvn_bubble_start_constraint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.3"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <ru.yandex.taxi.design.bubble.BubbleTextComponent
        android:id="@+id/nfc_card_scan_icon_bubble"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAlignment="center"
        android:translationZ="@dimen/nfc_scan_tooltip_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <Space
        android:id="@+id/space_above_num_pad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/number_pad"
        app:layout_constraintTop_toBottomOf="@+id/card_container"
        app:layout_constraintVertical_weight="@integer/space_above_num_pad_weight"/>
    <com.yandex.go.payments.cards.ui.CardNumberPadView
        android:id="@+id/number_pad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="@dimen/num_keyboard_min_height"
        app:layout_constraintTop_toBottomOf="@+id/space_above_num_pad"
        app:layout_constraintVertical_weight="@integer/num_pad_weight"/>
</merge>
