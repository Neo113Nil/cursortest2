<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>
    <ImageView
        android:id="@+id/titleIcon"
        android:layout_width="@dimen/ybsdk_product_card_icon_size"
        android:layout_height="@dimen/ybsdk_product_card_icon_size"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/ybsdk_product_card_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_product_card_title_top_margin"
        android:lines="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/ybsdk_product_card_title_start_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/titleIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Title2"/>
    <ImageView
        android:id="@+id/iconAfterTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ybsdk_product_card_icon_size"
        android:layout_marginLeft="@dimen/ybsdk_product_card_title_to_badge_margin"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.ybsdk.core.design.spoiler.SpoilerFrameLayout
        android:id="@+id/balanceSpoiler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/ybsdk_product_card_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconAfterTitle"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:ybsdk_spoiler_horizontal_gravity="right"
        app:ybsdk_spoiler_width="@dimen/ybsdk_product_card_balance_spoiler_width">
        <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
            android:layout_gravity="right"
            android:id="@+id/balanceShimmer"
            android:paddingLeft="@dimen/ybsdk_product_card_title_to_balance_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:ybsdk_shimmer_auto_start="false"
            app:ybsdk_shimmer_duration="@integer/ybsdk_cache_update_shimmer_duration"
            app:ybsdk_shimmer_repeat_delay="@integer/ybsdk_cache_update_shimmer_repeat_delay">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.ybsdk.widgets.common.RadialGradientTextView
                    android:gravity="right"
                    android:id="@+id/balanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:importantForAccessibility="no"
                    app:autoSizeMaxTextSize="28sp"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Widget.YB.Text.Numbers7"/>
                <ImageView
                    android:id="@+id/balanceIcon"
                    android:visibility="gone"
                    android:layout_width="@dimen/ybsdk_product_card_subtitle_icon_size"
                    android:layout_height="@dimen/ybsdk_product_card_subtitle_icon_size"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="@+id/balanceText"
                    app:layout_constraintEnd_toStartOf="@+id/balanceText"
                    app:layout_constraintTop_toTopOf="@+id/balanceText"/>
                <com.ybsdk.widgets.common.RadialGradientTextView
                    android:id="@+id/additionalBalanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/balanceText"
                    style="@style/Widget.YB.Text.Title2"/>
                <ImageView
                    android:id="@+id/additionalBalanceIcon"
                    android:visibility="gone"
                    android:layout_width="@dimen/ybsdk_product_card_subtitle_mini_icon_size"
                    android:layout_height="@dimen/ybsdk_product_card_subtitle_mini_icon_size"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="@+id/additionalBalanceText"
                    app:layout_constraintEnd_toStartOf="@+id/additionalBalanceText"
                    app:layout_constraintTop_toTopOf="@+id/additionalBalanceText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    </com.ybsdk.core.design.spoiler.SpoilerFrameLayout>
    <com.ybsdk.feature.divkit.api.ui.YbDivView
        android:id="@+id/divkitOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
