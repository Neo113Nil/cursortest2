<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="24dp"
    android:paddingRight="16dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/chat_avatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@null"
        app:avatarPadding="7dp"
        app:borderMargin="2dp"
        app:borderThickness="2dp"
        app:placeholderBackground="@drawable/msg_bg_toolbar_logo_placeholder"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.yandex.messaging.ui.badges.MarkedBadgeImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/chat_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <com.yandex.messaging.ui.badges.MarkedBadgeImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/chat_badge2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:gravity="center_horizontal"
        android:id="@+id/chat_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Messaging.Title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:gravity="center_horizontal"
        android:id="@+id/chat_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/ya_regular"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/chat_participant_count"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/Messaging.Description"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/chat_online_status"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Messaging.Subtitle"/>
</LinearLayout>
