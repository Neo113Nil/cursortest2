<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/transparent"
        style="@style/BottomModalContentHolder">
        <androidx.core.widget.NestedScrollView
            android:background="@drawable/bg_rounded_top"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/paid_options_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="88dp"
                    app:component_lead_image_padding="@dimen/go_design_m_space"
                    app:component_lead_image_size="80dp"
                    app:component_no_background="true"
                    app:component_title_size="@dimen/component_text_size_title"
                    app:component_title_typeface="medium"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/paid_options_description"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="1dp"
                    app:component_title_size="@dimen/component_text_size_body"
                    app:component_title_typeface="bold"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/paid_options_reason"
                    android:paddingBottom="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_no_background="true"
                    app:component_title_size="@dimen/component_text_size_body"
                    app:component_vertical_padding="0dp"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/paid_options_comment"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_divider_position="top"
                    app:component_subtitle_gravity="center_horizontal"
                    app:component_title_gravity="center_horizontal"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/buttons_holder"
            android:background="?attr/bgMain"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/paid_options_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/common_back"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                app:component_background_color="?attr/controlMinor"
                app:component_title_color="?attr/textOnControlMinor"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/paid_options_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                app:component_button_accent="true"/>
        </LinearLayout>
    </LinearLayout>
</merge>
