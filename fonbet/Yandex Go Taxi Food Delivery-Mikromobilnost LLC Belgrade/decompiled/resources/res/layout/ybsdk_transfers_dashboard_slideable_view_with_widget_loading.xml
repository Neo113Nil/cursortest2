<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonWidgetPart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="20dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonHeadlingPart"
            android:layout_width="108dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonWidgetPart"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonTransferCard1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/skeletonTransferCard2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonHeadlingPart"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonTransferCard2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/skeletonTransferCard3"
            app:layout_constraintStart_toEndOf="@+id/skeletonTransferCard1"
            app:layout_constraintTop_toBottomOf="@+id/skeletonHeadlingPart"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonTransferCard3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/skeletonTransferCard2"
            app:layout_constraintTop_toBottomOf="@+id/skeletonHeadlingPart"
            app:ybsdk_cornerRadius="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
