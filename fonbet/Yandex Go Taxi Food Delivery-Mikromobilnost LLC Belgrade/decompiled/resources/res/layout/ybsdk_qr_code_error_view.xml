<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/errorLayoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/ybsdk_qr_error_view_icon_size"
        android:layout_height="@dimen/ybsdk_qr_error_view_icon_size"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/ybsdk_qr_error_view_vertical_bias"
        app:srcCompat="@drawable/ybsdk_ic_permission_warning"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ybsdk_transfer_permission_access_required_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        style="@style/YbSdk.Qr.Error.View.Title"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ybsdk_qr_payment_camera_permission_warning_description"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/YbSdk.Qr.Error.View.Description"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/openSettingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:ybsdk_buttonTitle="@string/ybsdk_qr_payment_open_settings_button"
        style="@style/YbSdk.Qr.Error.View.ButtonView"/>
</merge>
