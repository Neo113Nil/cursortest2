<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_subtitle_size="@dimen/component_text_size_body"
        app:component_subtitle_typeface="bold"
        app:component_title_size="@dimen/component_text_size_title"
        app:component_title_typeface="bold"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/points_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:importantForAccessibility="no"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="@dimen/go_design_s_space"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/common_close"
        android:layout_marginHorizontal="8dp"
        app:component_background_color="?attr/controlMinor"
        app:component_title_color="?attr/textOnControlMinor"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/disable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scooters_pass_renew_disable_button"
        android:layout_marginHorizontal="8dp"
        app:component_button_accent="true"/>
</com.yandex.go.design.view.GoLinearLayout>
