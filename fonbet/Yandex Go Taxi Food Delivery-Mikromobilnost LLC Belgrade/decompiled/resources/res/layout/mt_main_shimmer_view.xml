<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholder_shimmering="true"
        app:placeholder_type="oval"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/first_bar"
        android:layout_width="180dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"
        app:placeholder_shimmering="true"
        app:placeholder_type="rounded_line"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/where_to"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:backgroundTint="?attr/controlMinor"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:barCornerRadius="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
</com.yandex.go.design.view.GoConstraintLayout>
