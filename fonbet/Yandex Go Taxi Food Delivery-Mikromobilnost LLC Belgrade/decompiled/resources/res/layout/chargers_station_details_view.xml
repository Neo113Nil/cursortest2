<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/container_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:id="@+id/container"
            android:paddingBottom="80dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yandex.go.chargers.station.presentation.details.components.ChargersStationHeaderView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.yandex.go.chargers.design.components.badges.ChargersBadgesView
                android:id="@+id/badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>
            <com.yandex.go.chargers.station.presentation.details.components.ChargersStationAboutLocationView
                android:id="@+id/about_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/divider_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.yandex.go.chargers.tariff_item_info.api.ChargersTariffsView
                android:id="@+id/tariffs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/divider_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.yandex.go.chargers.station.presentation.details.components.ChargersStationUsageInstructionView
                android:id="@+id/usage_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/divider_3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/partner_information"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_trail_mode="navigation"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
