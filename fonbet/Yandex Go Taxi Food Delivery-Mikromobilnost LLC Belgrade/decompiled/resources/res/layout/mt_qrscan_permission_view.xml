<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/permission_text_layout"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_subtitle"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scooters_permission_grant_title"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/permission_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/scooters_permission_grant_subtitle"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_body"
            android:layout_gravity="center"
            android:id="@+id/go_to_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scooters_go_to_settings"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            app:component_background_color="@color/component_fog_dark"
            app:component_button_rounded_corners_radius="100dp"
            app:component_title_color="@color/white"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoConstraintLayout>
