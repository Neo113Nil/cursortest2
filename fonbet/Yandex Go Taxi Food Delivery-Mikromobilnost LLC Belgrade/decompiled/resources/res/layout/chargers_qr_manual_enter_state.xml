<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/manual_enter_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="manual_enter_back_ground,       back_to_camera,       manual_enter_done,       number_edit_text,       error_title,       manual_enter_text_hint,       close_button,       "/>
    <View
        android:id="@+id/manual_enter_back_ground"
        android:background="@color/component_fog_dark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/close_button"
        android:background="@drawable/ic_cross"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="@+id/manual_enter_text_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/manual_enter_text_hint"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/manual_enter_text_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/chargers_manual_enter_top_hint"
        android:layout_marginHorizontal="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.KeyboardAwareRobotoEditText
        android:textSize="48sp"
        android:gravity="center"
        android:id="@+id/number_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/back_to_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="heavy"
        app:textColor="?attr/everFront"
        style="@style/ChargersNumberInputField"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="?attr/error"
        android:gravity="center"
        android:id="@+id/error_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/number_edit_text"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/back_to_camera"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="@string/scooters_qr_back_to_camera"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="4dp"
        app:component_background_color="@color/component_fog_dark"
        app:component_button_rounded_corners_radius="100dp"
        app:component_title_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/offer_card_offset_guideline"
        app:layout_constraintEnd_toStartOf="@+id/manual_enter_done"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:enabled="false"
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/manual_enter_done"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="@string/scooters_done"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_background_color="@color/component_fog_dark"
        app:component_button_rounded_corners_radius="100dp"
        app:component_title_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/offer_card_offset_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_to_camera"/>
</merge>
