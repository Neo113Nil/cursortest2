<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.banners.CardBannerContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/banner_content_container"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
            android:id="@+id/banner_scroll_view"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <ru.yandex.taxi.widget.ComponentLinearLayout
                android:orientation="vertical"
                android:id="@+id/banner_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ru.yandex.taxi.design.BadgeView
                    android:id="@+id/banner_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"/>
                <ru.yandex.taxi.design.ListHeaderComponent
                    android:id="@+id/banner_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    android:layout_marginStart="@dimen/go_design_m_space"
                    android:layout_marginEnd="@dimen/go_design_m_space"
                    app:component_no_background="true"
                    app:component_title_gravity="text_start"
                    app:component_title_size="32sp"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/banner_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="@dimen/go_design_m_space"
                    android:layout_marginEnd="@dimen/go_design_m_space"
                    app:component_title_gravity="text_start"
                    app:component_title_size="24sp"/>
                <ru.yandex.taxi.design.ListTextComponent
                    android:id="@+id/banner_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_text_background="@color/transparent"
                    app:component_text_gravity="text_start"
                    app:component_text_size="16sp"/>
                <ru.yandex.taxi.widget.ComponentLinearLayout
                    android:orientation="vertical"
                    android:id="@+id/banner_bottom_container_in_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/banner_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/banner_animation_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/go_design_s_space"
                        android:scaleType="centerInside"/>
                </ru.yandex.taxi.widget.ComponentLinearLayout>
            </ru.yandex.taxi.widget.ComponentLinearLayout>
        </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
        <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
            android:layout_gravity="bottom"
            android:id="@+id/banner_bottom_scroll_indicator_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:scroll_view_id="@+id/banner_scroll_view"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/banner_bottom_container"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</ru.yandex.taxi.banners.CardBannerContainer>
