<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.payment.sdk.ui.view.ProgressResultView
        android:id="@+id/progress_result_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.payment.sdk.ui.view.HeaderView
        android:id="@+id/header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">
            <ImageView
                android:id="@+id/personal_info_back_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/personal_info_title"
                app:layout_constraintEnd_toStartOf="@+id/personal_info_title"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/personal_info_title"
                app:srcCompat="@drawable/paymentsdk_ic_back"/>
            <TextView
                android:textAppearance="@style/PaymentsdkTextAppearance.Title"
                android:id="@+id/personal_info_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/personal_info_back_button"
                app:layout_constraintTop_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yandex.payment.sdk.ui.view.PersonalInfoView
                android:id="@+id/personal_info_view"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/personal_info_title"/>
            <TextView
                android:textAppearance="@style/PaymentsdkTextAppearance.Title"
                android:id="@+id/paymethod_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/paymethod_back_button"
                app:layout_constraintTop_toBottomOf="@+id/personal_info_view"/>
            <ImageView
                android:id="@+id/paymethod_back_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/paymentsdk_prebuilt_back_button_content_description"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/paymethod_title"
                app:layout_constraintEnd_toStartOf="@+id/paymethod_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/paymethod_title"
                app:srcCompat="@drawable/paymentsdk_ic_back"/>
            <com.yandex.payment.sdk.ui.view.CardNumberView
                android:id="@+id/card_number_view"
                android:paddingTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/paymethod_title"/>
            <com.yandex.payment.sdk.ui.view.ExpirationDateView
                android:id="@+id/expiration_date_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_number_view"/>
            <com.yandex.payment.sdk.ui.view.CvnView
                android:id="@+id/cvn_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toEndOf="@+id/expiration_date_view"
                app:layout_constraintTop_toBottomOf="@+id/card_number_view"/>
            <CheckBox
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/save_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/paymentsdk_remember_card_title"
                app:layout_constraintTop_toBottomOf="@+id/expiration_date_view"
                style="@style/PaymentsdkCheckBox"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center_vertical"
                android:id="@+id/charity_label"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/paymentsdk_charity_label"
                android:drawablePadding="6dp"
                android:layout_marginStart="6dp"
                app:drawableStartCompat="@drawable/paymentsdk_ic_charity_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/save_checkbox"
                app:layout_constraintTop_toBottomOf="@+id/save_checkbox"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
