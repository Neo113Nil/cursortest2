<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="bottom"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/chat_input_button_height"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/input_button"
        android:background="?attr/messagingCommonActionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chat_input_button_height"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/share_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/share_button_in_channel_window_content_des__res_0x7f151747"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_arrow_to_forward"
            app:tint="?attr/messagingCommonAccentTextColor"
            style="@style/Messaging.IconButton"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/messagingCommonAccentTextColor"
            android:layout_gravity="bottom"
            android:id="@+id/share_text"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/share_channel"
            android:textAllCaps="false"
            android:fontFamily="@font/ya_medium"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/notification_button"
            app:layout_constraintStart_toEndOf="@+id/share_button"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/messagingCommonAccentTextColor"
            android:gravity="center"
            android:id="@+id/subscribe_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/subscribe_on_channel"
            android:textAllCaps="false"
            android:fontFamily="@font/ya_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/notification_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/notification_button_in_channel_window_content_des__res_0x7f150f80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_notification_on"
            app:tint="?attr/messagingCommonIconsSecondaryColor"
            style="@style/Messaging.IconButton"/>
        <com.yandex.bricks.BrickSlotView
            android:layout_gravity="bottom"
            android:id="@+id/messaging_input_slot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
