<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsEditRoot"
    android:background="@drawable/ybsdk_background_settings_edit"
    android:padding="@dimen/ybsdk_settings_item_edit_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ybsdk_settings_item_bottom_margin">
    <TextView
        android:textColor="@color/ybsdk_settings_title_text_color"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/endIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/endIcon"
        android:layout_width="@dimen/ybsdk_icon_size"
        android:layout_height="@dimen/ybsdk_icon_size"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_edit_filled"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_transfer_settings_item_edit_subtitle_margin_top"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
