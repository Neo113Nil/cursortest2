<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/ybsdk_stadium_button_widget_with_toggle_background"
    android:paddingBottom="@dimen/ybsdk_stadium_button_height"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/autoTopupWidgetText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_weight="1"
        android:paddingStart="22dp"
        android:paddingVertical="20dp"
        style="@style/Widget.YB.Text.Caption1.Regular"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_gravity="center"
        android:id="@+id/autoTopupWidgetSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:paddingStart="8dp"
        android:paddingEnd="22dp"
        android:paddingVertical="20dp"/>
</LinearLayout>
