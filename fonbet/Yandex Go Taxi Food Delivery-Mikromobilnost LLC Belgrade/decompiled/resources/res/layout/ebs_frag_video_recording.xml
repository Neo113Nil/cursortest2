<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ebssdk_col_verification_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/ebs_frag_video_camera_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize">
        <ru.rt.ebs.cryptosdk.presentation.customView.CameraPreview
            android:layout_gravity="top"
            android:id="@+id/ebs_frag_video_recording_texture_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/ebs_frag_video_recording_camera_preview_bitmap_view"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ebs_frag_video_recording_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="top"
            android:id="@+id/ebs_frag_video_recording_header_background_view"
            android:background="@color/semitransparent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ebs_frag_video_recording_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ebs_frag_video_recording_header"/>
        <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableHeader
            android:id="@+id/ebs_frag_video_recording_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:headerType="biometryCapturing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <WebView
            android:id="@+id/ebs_frag_video_recording_web_view"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/ebssdk_margin_12"
            app:layout_constraintBottom_toTopOf="@+id/ebs_frag_video_recording_timer_indicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ebs_frag_video_recording_header"/>
        <ru.rt.ebs.cryptosdk.presentation.customView.TimerIndicatorView
            android:id="@+id/ebs_frag_video_recording_timer_indicator"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ebssdk_margin_24"
            android:layout_marginHorizontal="@dimen/ebssdk_margin_64"
            app:layout_constraintBottom_toTopOf="@+id/ebs_frag_video_recording_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableButton
            android:id="@+id/ebs_frag_video_recording_btn"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ebssdk_margin_20"
            android:layout_marginHorizontal="@dimen/ebssdk_margin_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ru.rt.ebs.cryptosdk.presentation.customView.ProcessingWidget
        android:id="@+id/ebs_frag_video_recording_processing_widget"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.rt.ebs.cryptosdk.presentation.customView.SuccessfulVerificationWidget
        android:id="@+id/ebs_frag_video_recording_successful_verification_widget"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
