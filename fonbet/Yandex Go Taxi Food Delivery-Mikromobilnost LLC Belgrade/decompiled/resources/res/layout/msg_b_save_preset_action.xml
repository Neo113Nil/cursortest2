<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/statuses_duration_recycler_view"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/dont_change_status_label"
        app:layout_constraintTop_toBottomOf="@+id/top_container"/>
    <View
        android:id="@+id/dont_change_status_label"
        android:background="@drawable/msg_ripple_common"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="2dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/dont_change_status_label"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/dont_change_status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/dont_change_status_label"
        android:lines="1"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/dont_change_status_label"
        app:layout_constraintEnd_toEndOf="@+id/dont_change_status_label"
        app:layout_constraintStart_toStartOf="@+id/dont_change_status_label"
        app:layout_constraintTop_toTopOf="@+id/dont_change_status_label"
        style="@style/Messaging.StatusNameText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
