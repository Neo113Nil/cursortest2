<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.BackButtonIconComponent
            android:layout_gravity="start|top"
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-12dp"/>
        <ru.yandex.taxi.widget.floatbuttonholder.FloatButtonHolderLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/float_button_holder_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <com.yandex.go.design.view.GoConstraintLayout
        android:id="@+id/modal_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/list_item_component_size_L"
            android:layout_marginVertical="@dimen/go_design_s_space"
            app:component_subtitle_size="@dimen/component_text_size_caption"
            app:component_subtitle_text_color="?attr/textMain"
            app:component_title_size="@dimen/component_text_size_subtitle"
            app:component_title_typeface="medium"
            app:layout_constraintBottom_toTopOf="@+id/thread_items"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/thread_items"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"/>
    </com.yandex.go.design.view.GoConstraintLayout>
</com.yandex.go.design.view.GoLinearLayout>
