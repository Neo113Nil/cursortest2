<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_summary_onboarding_bubble"
    android:padding="@dimen/go_design_s_space"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="48dp"
    android:minHeight="24dp">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_bubble"
        android:textColor="?attr/textMain"
        android:gravity="center"
        android:id="@+id/surge_bubble_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:robotoFontStyle="medium"
        app:useMinimumWidth="true"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_bubble"
        android:textColor="?attr/textMain"
        android:gravity="center"
        android:id="@+id/surge_bubble_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:useMinimumWidth="true"/>
</LinearLayout>
