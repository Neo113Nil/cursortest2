<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/msg_ripple_common"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:id="@+id/statuses_duration_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.TextSwitchLabel"/>
    <TextView
        android:id="@+id/statuses_deadline_textview"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/statuses_duration_textview"
        app:layout_constraintStart_toEndOf="@+id/statuses_duration_textview"
        app:layout_constraintTop_toTopOf="@+id/statuses_duration_textview"
        style="@style/Messaging.TextSwitchDescription"/>
</androidx.constraintlayout.widget.ConstraintLayout>
