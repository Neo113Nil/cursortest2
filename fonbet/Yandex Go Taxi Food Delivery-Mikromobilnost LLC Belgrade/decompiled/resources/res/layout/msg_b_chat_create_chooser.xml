<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/messagingCommonBackgroundColor"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/chat_create_chooser_toolbar_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/border"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/user_carousel_slot"
        android:layout_width="match_parent"
        android:layout_height="100dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yandex.bricks.BrickSlotView
            android:id="@+id/user_list_slot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/chat_create_chooser_bottom_margin"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/user_list_bottom_gradient"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="@dimen/chat_create_chooser_bottom_margin"/>
        <Button
            android:textSize="14sp"
            android:textColor="?attr/messagingCommonAccentFgColor"
            android:layout_gravity="bottom"
            android:id="@+id/create_group_chat_button"
            android:background="@drawable/msg_bg_accent_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_create_info_ready"
            android:textAllCaps="false"
            android:fontFamily="@font/ya_medium"
            android:translationZ="1dp"
            android:elevation="3dp"/>
    </FrameLayout>
</LinearLayout>
