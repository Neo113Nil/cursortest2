<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/status_bar_view"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/searchbar_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/map_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.yandex.go.places.common.ui.ControlButtonView
            android:id="@+id/compass_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:src="@drawable/ic_super_app_discovery_map_compass"
            android:contentDescription="@string/discovery_accessibility_restore_map_rotation"/>
        <com.yandex.go.places.common.ui.ControlButtonView
            android:id="@+id/location_focusing_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:src="@drawable/ic_location_fill_24"
            android:contentDescription="@string/select_current_geolocation_description"/>
        <com.yandex.go.places.common.ui.FilterButtonView
            android:id="@+id/filter_button_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:component_circle_image="@drawable/ic_superapp_discovery_layers"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <View
        android:id="@+id/flex_loading_gradient"
        android:background="@drawable/super_app_discovery_map_vertical_gradient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/super_app_main_screen_flex_container_loading_background_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_view"/>
    <ViewStub
        android:id="@+id/inner_flex_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_view"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/header_view"
        android:background="?attr/bgMain"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/super_app_main_screen_header_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_view">
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/close_filter_button_view"
            android:visibility="gone"
            android:layout_width="@dimen/go_design_l_space"
            android:layout_height="@dimen/go_design_l_space"
            android:tint="?attr/textMain"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:srcCompat="0x7f080b48"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <com.yandex.go.superapp.discovery.map.impl.ui.main.explorer.ExplorerButtonView
        android:id="@+id/gamification_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="@+id/map_buttons_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yandex.go.superapp.discovery.map.impl.ui.main.explorer.ExplorerOutlineRobotoTextView
        android:textSize="28sp"
        android:textColor="?attr/textMain"
        android:gravity="center"
        android:id="@+id/gamification_district_name"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:lineHeight="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.superapp.discovery.map.impl.ui.main.explorer.ExplorerDistrictCoverageProgressView
        android:id="@+id/gamification_district_coverage"
        android:visibility="invisible"
        android:layout_width="224dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/go_design_s_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gamification_district_name"/>
</com.yandex.go.design.view.GoConstraintLayout>
