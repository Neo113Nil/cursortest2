<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/go_design_m_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/dynamic_feature_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/dynamic_feature_loading"/>
    <include
        android:id="@+id/dynamic_feature_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/dynamic_feature_error"/>
</FrameLayout>
