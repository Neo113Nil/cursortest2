<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.ShimmeringFrameLayout
        android:id="@+id/shimmering_bar"
        android:background="@drawable/bg_rounded_24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:minHeight="170dp"
        android:backgroundTint="?attr/controlMinor"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/driver_card"
        android:background="@drawable/bg_rounded_24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="?attr/controlMinor"
        android:layout_marginHorizontal="@dimen/go_design_m_space">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/textMain"
            android:id="@+id/tv_eta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="@dimen/go_design_m_space"
            android:layout_marginVertical="18dp"/>
        <ru.yandex.taxi.design.DividerWithColorView
            android:background="?attr/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="@dimen/go_design_m_space"/>
        <com.yandex.go.taxi.order.details.v1.ui.DriverSectionView
            android:id="@+id/driver_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <ImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="?attr/textMain"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="?attr/textMain"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="22dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:robotoFontStyle="regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_buttons"
        android:paddingBottom="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        style="@style/BottomEdgeButtonMarginStyle"/>
</com.yandex.go.design.view.GoLinearLayout>
