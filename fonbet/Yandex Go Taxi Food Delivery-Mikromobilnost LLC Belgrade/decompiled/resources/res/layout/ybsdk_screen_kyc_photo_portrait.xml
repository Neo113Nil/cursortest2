<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_internal_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gradient"
        android:background="@drawable/ybsdk_kyc_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"/>
    <View
        android:id="@+id/photoPreviewBackground"
        android:background="?attr/ybColor_fill_default_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/photoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"/>
    <com.ybsdk.feature.kyc.internal.screens.photo.views.PunchHoleView
        android:id="@+id/photoPreviewFrame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/ybColor_textIcon_primary"
        android:gravity="center"
        android:id="@+id/photoPreviewText"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/photoPreviewButtons"
        style="@style/Widget.YB.Text.Body3"/>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/photoPreviewButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/navigationBarSpace"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/photoPreviewGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="photoPreviewButtons, photoPreviewBackground"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/captionBlockFrameContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginHorizontal="24dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/captionBlockGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:srcCompat="@drawable/ybsdk_kyc_photo_frame_1"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/captionBlockGuideline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintGuide_end="@dimen/ybsdk_caption_block_height"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
        android:gravity="center"
        android:id="@+id/captionBlockPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonCaption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/captionBlockFrameContainer"
        app:layout_constraintVertical_bias="1"
        style="@style/Widget.YB.Text.Body3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/buttonCaption"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/ybsdk_kyc_accessibility_caption_button"
        app:layout_constraintBottom_toTopOf="@+id/navigationBarSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/captionBlockGuideline"
        app:srcCompat="@drawable/ybsdk_ic_caption_button"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/captionGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="buttonCaption, captionBlockPrompt, captionBlockFrameContainer"/>
    <Space
        android:id="@+id/navigationBarSpace"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"
        app:ybsdk_transparentBackground="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
