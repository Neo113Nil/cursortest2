<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/messagingCommonBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_browser_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <include
        android:id="@+id/media_browser_no_data_screen"
        layout="@layout/msg_v_media_browser_empty_screen"/>
    <include
        android:id="@+id/media_browser_search_empty_screen"
        layout="@layout/msg_v_media_browser_search_no_result"/>
    <com.yandex.messaging.views.ShineView
        android:id="@+id/media_browser_skeleton_shine"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="-64dp"/>
    <FrameLayout
        android:id="@+id/media_browser_skeleton_fading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/Messaging.MediaBrowser.SkeletonFading"/>
</FrameLayout>
