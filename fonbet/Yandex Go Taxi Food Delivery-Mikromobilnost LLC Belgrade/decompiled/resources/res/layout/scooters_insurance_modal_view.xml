<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:component_divider_position="none"
        app:component_show_close_button="true"
        app:component_show_navigation_button="false"
        app:component_toolbar_background_color="?attr/bgMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:id="@+id/title"
        android:background="?attr/bgMain"
        android:paddingTop="@dimen/go_design_m_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/scooters_insurance_screen_title"
        android:paddingStart="@dimen/go_design_m_space"
        android:paddingEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:id="@+id/subtitle"
        android:background="?attr/bgMain"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:paddingStart="@dimen/go_design_m_space"
        android:paddingEnd="@dimen/go_design_m_space"
        app:autoSizeMaxTextSize="@dimen/component_text_size_title"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:robotoFontStyle="regular"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_lead_image="@drawable/ic_coins_vector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/conditions"
        android:background="@drawable/scooters_item_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="margin"
        app:component_lead_image="@drawable/ic_content"
        app:component_title="@string/scooters_insurance_conditions"
        app:component_trail_mode="navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/price"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/details_item_component"
        android:background="@drawable/scooters_item_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="margin"
        app:component_lead_image="@drawable/ic_scooters_info_circle"
        app:component_title="@string/scooters_insurance_details_item_title"
        app:component_trail_mode="navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/conditions"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/toggle_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="insurance_toggle,close_button"/>
    <ru.yandex.taxi.design.ListItemSwitchComponent
        android:id="@+id/insurance_toggle"
        android:background="@drawable/bg_main_ripple"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:component_switch_enabled="true"
        app:component_title="@string/scooters_insurance_toggle_title"
        app:layout_constraintBottom_toTopOf="@+id/close_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/close_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:text="@string/common_close"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMinor"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/button_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="minor_button,main_button"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/minor_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/scooters_refuse_insurance_button"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMinor"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintBottom_toTopOf="@+id/main_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/main_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:text="@string/scooters_turn_on_insurance_button"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
