<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"/>
    <ImageView
        android:id="@+id/ybIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="124dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/progressBar"
        android:background="@drawable/ybsdk_circle_button_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ybIcon"
        app:layout_constraintEnd_toEndOf="@+id/ybIcon"
        app:layout_constraintStart_toStartOf="@+id/ybIcon"
        app:layout_constraintTop_toTopOf="@+id/ybIcon"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressView.Large"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/operationIcon"
        android:background="@drawable/ybsdk_circle_button_background"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="56dp"
        app:layout_constraintStart_toStartOf="@+id/ybIcon"
        app:layout_constraintTop_toTopOf="@+id/ybIcon"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressViewStyleSmall"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/autoTopupSuccessBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="autoTopupSuccessTitle, autoTopupSuccessAmount"/>
    <TextView
        android:gravity="center"
        android:id="@+id/autoTopupSuccessTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ybIcon"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:gravity="center"
        android:id="@+id/autoTopupSuccessAmount"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ybIcon"
        style="@style/Widget.YB.Text.Numbers2"/>
    <include
        android:id="@+id/autotopupResultSeketons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ybsdk_auto_topup_result_skeletons"/>
    <TextView
        android:gravity="center"
        android:id="@+id/autoTopupSuccessDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="202dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/autoTopupSuccessBlock"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/primaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/secondaryButton"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/secondaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Secondary.L"/>
</androidx.constraintlayout.widget.ConstraintLayout>
