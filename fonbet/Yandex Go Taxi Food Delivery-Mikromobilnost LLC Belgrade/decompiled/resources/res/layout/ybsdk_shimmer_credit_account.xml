<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/creditAccountShimmer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/horizontalLineBalance">
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_width="160dp"
                android:layout_height="16dp"
                app:ybsdk_cornerRadius="8dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                app:ybsdk_cornerRadius="8dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_width="290dp"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                app:ybsdk_cornerRadius="8dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.Constraints
            android:id="@+id/horizontalLineBalance"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/recyclerItem2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_credit_account_shimmer_recycler_item_height"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/recyclerItem1"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/recyclerItem3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_credit_account_shimmer_recycler_item_height"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/recyclerItem2"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/recyclerItem1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_credit_account_shimmer_recycler_item_height"
            android:layout_marginTop="34dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toTopOf="@+id/recyclerItem2"
            app:layout_constraintTop_toBottomOf="@+id/horizontalLineBalance"
            app:ybsdk_cornerRadius="24dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
