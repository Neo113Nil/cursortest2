<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/files_browser_item_image"
        android:layout_marginStart="10dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.MediaBrowser.FilesBrowser.Image"/>
    <TextView
        android:id="@+id/files_browser_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toTopOf="@+id/files_browser_item_size"
        app:layout_constraintEnd_toStartOf="@+id/files_browser_item_menu_button"
        app:layout_constraintStart_toEndOf="@+id/files_browser_item_image"
        app:layout_constraintTop_toTopOf="@+id/files_browser_item_image"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Messaging.MediaBrowser.FilesBrowser.Text.Title"/>
    <TextView
        android:id="@+id/files_browser_item_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/files_browser_item_image"
        app:layout_constraintStart_toEndOf="@+id/files_browser_item_image"
        app:layout_constraintTop_toBottomOf="@+id/files_browser_item_title"
        style="@style/Messaging.MediaBrowser.FilesBrowser.Text.Info"/>
    <TextView
        android:id="@+id/files_browser_item_author_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/messenger_files_browser_author_separator"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/files_browser_item_size"
        app:layout_constraintStart_toEndOf="@+id/files_browser_item_size"
        style="@style/Messaging.MediaBrowser.FilesBrowser.Text"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/files_browser_item_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/files_browser_item_size"
        app:layout_constraintEnd_toEndOf="@+id/files_browser_item_title"
        app:layout_constraintStart_toEndOf="@+id/files_browser_item_author_separator"
        style="@style/Messaging.MediaBrowser.FilesBrowser.Text"/>
    <ImageButton
        android:id="@+id/files_browser_item_menu_button"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="64dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.MediaBrowser.MenuButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
