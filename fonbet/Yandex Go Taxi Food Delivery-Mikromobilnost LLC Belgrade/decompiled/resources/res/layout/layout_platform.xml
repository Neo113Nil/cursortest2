<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/layout_web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.go.platform.ui.components.LottieSplashView
        android:id="@+id/custom_splash_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.go.platform.ui.components.SpinnerProgressView
        android:id="@+id/progress_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.go.platform.ui.components.AnimationProgressView
        android:orientation="vertical"
        android:id="@+id/animation_progress_view"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
