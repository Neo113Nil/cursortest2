<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/toolbar"
            android:layout_width="151dp"
            android:layout_height="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="4dp"/>
        <com.ybsdk.widgets.common.MoneyInputEditView
            android:theme="@style/YbSdk.Widget.WidgetsCommon.NumbersInput"
            android:enabled="false"
            android:textColor="?attr/ybColor_fill_default_200"
            android:id="@+id/transferMainLoadingAmountInput"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ybsdk_transfer_amount_hint"
            android:singleLine="true"
            app:layout_constraintBottom_toTopOf="@+id/transferMainLoadingSuggests"
            app:layout_constraintEnd_toStartOf="@+id/transferMainLoadingAmountCurrency"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Widget.YB.Text.Numbers2"/>
        <TextView
            android:textColor="?attr/ybColor_fill_default_200"
            android:id="@+id/transferMainLoadingAmountCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/ybsdk_transfer_currency_hint"
            android:contentDescription="@string/ybsdk_common_accessibility_amount_description"
            android:labelFor="@+id/transferMainLoadingAmountInput"
            app:layout_constraintBaseline_toBaselineOf="@+id/transferMainLoadingAmountInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/transferMainLoadingAmountInput"
            style="@style/Widget.YB.Text.Numbers2"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/transferMainLoadingSuggests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toTopOf="@+id/transferMainLoadingButtons"
            app:layout_constraintTop_toBottomOf="@+id/transferMainLoadingAmountInput">
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/transferMainLoadingSuggest1"
                android:layout_width="88dp"
                android:layout_height="40dp"
                app:ybsdk_cornerRadius="56dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/transferMainLoadingSuggest2"
                android:layout_width="88dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                app:ybsdk_cornerRadius="56dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/transferMainLoadingSuggest3"
                android:layout_width="88dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                app:ybsdk_cornerRadius="56dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/transferMainLoadingButtons"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toTopOf="@+id/transferMainLoadingPill">
            <include
                android:id="@+id/circleButton1"
                android:layout_width="@dimen/ybsdk_circle_buttons_list_button_size"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginHorizontal="16dp"
                layout="@layout/ybsdk_transfer_main_skeleton_view_part"/>
            <include
                android:id="@+id/circleButton2"
                android:layout_width="@dimen/ybsdk_circle_buttons_list_button_size"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                layout="@layout/ybsdk_transfer_main_skeleton_view_part"/>
            <include
                android:id="@+id/circleButton3"
                android:layout_width="@dimen/ybsdk_circle_buttons_list_button_size"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                layout="@layout/ybsdk_transfer_main_skeleton_view_part"/>
            <include
                android:id="@+id/circleButton4"
                android:layout_width="@dimen/ybsdk_circle_buttons_list_button_size"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                layout="@layout/ybsdk_transfer_main_skeleton_view_part"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/transferMainLoadingPill"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintBottom_toTopOf="@+id/keyboard">
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                app:ybsdk_cornerRadius="100dp"/>
        </FrameLayout>
        <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            app:layout_constraintBottom_toTopOf="@+id/confirmButton"
            app:ybsdk_additionalButtonType="comma"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/confirmButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:ybsdk_additionalButtonType="comma"
            app:ybsdk_cornerRadius="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
