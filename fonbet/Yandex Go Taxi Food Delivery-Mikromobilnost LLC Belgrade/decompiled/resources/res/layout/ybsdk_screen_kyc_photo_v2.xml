<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kycPhotoContentContainer"
    android:background="#ff000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/ybsdk_margin_bottom_camera_preview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/frame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="@dimen/ybsdk_frame_margin_vertical"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/cameraPreview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview"
        app:srcCompat="@drawable/ybsdk_kyc_photo_frame_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/photoPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/cameraPreview"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tipContainer"
        android:background="@drawable/ybsdk_background_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ybsdk_margin_bottom_tip"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tipIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
            android:gravity="start|center_vertical"
            android:id="@+id/tipText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:maxLines="2"
            android:paddingEnd="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:paddingVertical="12dp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            style="@style/Widget.YB.Text.Title2"/>
    </LinearLayout>
    <com.ybsdk.feature.kyc.internal.screens.photo.views.CaptionButtonView
        android:id="@+id/buttonCaption"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginBottom="@dimen/ybsdk_margin_bottom_caption"
        android:contentDescription="@string/ybsdk_kyc_accessibility_caption_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_caption_button"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/buttonFlash"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/buttonCaption"
        app:layout_constraintEnd_toStartOf="@+id/buttonCaption"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttonCaption"
        app:srcCompat="@drawable/ybsdk_flash_on"/>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/buttons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.ybsdk.widgets.common.FullscreenStatusView
        android:id="@+id/statusView"
        android:background="?attr/ybColor_background_primary"
        android:paddingTop="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:paddingTop="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/frontLight"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
</androidx.constraintlayout.widget.ConstraintLayout>
