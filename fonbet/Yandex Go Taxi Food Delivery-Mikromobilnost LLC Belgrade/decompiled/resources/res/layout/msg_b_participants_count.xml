<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/participants_count_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/channel_info_participants_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_info_participants"
        app:drawableTint="?attr/messagingCommonIconsPrimaryColor"
        style="@style/Messaging.Settings.Item.Text"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:gravity="center_vertical"
        android:layout_gravity="right"
        android:id="@+id/channel_info_participants_count"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/chat_info_default_item_height"
        android:layout_marginRight="15dp"
        android:text="@string/chat_info_participants"/>
</FrameLayout>
