<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@+id/autotopupFrequencyList">
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/autotopupFirstAmount"
        android:background="@drawable/ybsdk_autotopup_saver_source_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="@dimen/ybsdk_loadable_input_height"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/autotopupFirstDateBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_should_restore_saved_instance_state="false"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    <View
        android:id="@+id/autotopupFirstDateBackground"
        android:background="@drawable/ybsdk_autotopup_saver_source_background"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupFirstAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/autotopupFirstAmount"
        app:layout_constraintTop_toTopOf="@+id/autotopupFirstAmount"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/autotopupFirstDateArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ybsdk_ic_navigation_arrowdown"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupFirstDateBackground"
        app:layout_constraintEnd_toEndOf="@+id/autotopupFirstDateBackground"
        app:layout_constraintTop_toTopOf="@+id/autotopupFirstDateBackground"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/autotopupFirstDateHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/autotopupFirstDateTitle"
        app:layout_constraintEnd_toStartOf="@+id/autotopupFirstDateArrow"
        app:layout_constraintStart_toStartOf="@+id/autotopupFirstDateBackground"
        app:layout_constraintTop_toTopOf="@+id/autotopupFirstDateBackground"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/autotopupFirstDateTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupFirstDateBackground"
        app:layout_constraintEnd_toStartOf="@+id/autotopupFirstDateArrow"
        app:layout_constraintStart_toStartOf="@+id/autotopupFirstDateBackground"
        app:layout_constraintTop_toBottomOf="@+id/autotopupFirstDateHint"
        style="@style/Widget.YB.Text.Body1"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/autotopupSecondAmount"
        android:background="@drawable/ybsdk_autotopup_saver_source_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="@dimen/ybsdk_loadable_input_height"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/autotopupSecondDateBackground"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/autotopupFirstAmount"
        app:ybsdk_should_restore_saved_instance_state="false"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    <View
        android:id="@+id/autotopupSecondDateBackground"
        android:background="@drawable/ybsdk_autotopup_saver_source_background"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupSecondAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/autotopupSecondAmount"
        app:layout_constraintTop_toTopOf="@+id/autotopupSecondAmount"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/autotopupSecondDateArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ybsdk_ic_navigation_arrowdown"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupSecondDateBackground"
        app:layout_constraintEnd_toEndOf="@+id/autotopupSecondDateBackground"
        app:layout_constraintTop_toTopOf="@+id/autotopupSecondDateBackground"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/autotopupSecondDateHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/autotopupSecondDateTitle"
        app:layout_constraintEnd_toStartOf="@+id/autotopupSecondDateArrow"
        app:layout_constraintStart_toStartOf="@+id/autotopupSecondDateBackground"
        app:layout_constraintTop_toTopOf="@+id/autotopupSecondDateBackground"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/autotopupSecondDateTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"
        app:autoSizeMaxTextSize="@dimen/ybsdk_textsize_body1"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupSecondDateBackground"
        app:layout_constraintEnd_toStartOf="@+id/autotopupSecondDateArrow"
        app:layout_constraintStart_toStartOf="@+id/autotopupSecondDateBackground"
        app:layout_constraintTop_toBottomOf="@+id/autotopupSecondDateHint"
        style="@style/Widget.YB.Text.Body1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
