<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/shimmer_root"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_m_space">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="@dimen/discovery_organization_cards_slider_shimmer_logo_size"
            android:layout_height="@dimen/discovery_organization_cards_slider_shimmer_logo_size"
            app:placeholder_color="?attr/bgMinor"
            app:placeholder_shimmering="true"
            app:placeholder_type="oval"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/discovery_organization_cards_slider_shimmer_logo_size"
            android:layout_marginStart="@dimen/go_design_s_space">
            <ru.yandex.taxi.widget.PlaceholderView
                android:layout_width="@dimen/discovery_organization_cards_slider_shimmer_title_width"
                android:layout_height="@dimen/discovery_organization_cards_slider_shimmer_text_height"
                app:placeholder_color="?attr/bgMinor"
                app:placeholder_corner_radius="@dimen/discovery_organization_cards_slider_shimmer_text_corner_radius"
                app:placeholder_shimmering="true"
                app:placeholder_type="rectangle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ru.yandex.taxi.widget.PlaceholderView
                android:layout_width="@dimen/discovery_organization_cards_slider_shimmer_subtitle_width"
                android:layout_height="@dimen/discovery_organization_cards_slider_shimmer_text_height"
                app:placeholder_color="?attr/bgMinor"
                app:placeholder_corner_radius="@dimen/discovery_organization_cards_slider_shimmer_text_corner_radius"
                app:placeholder_shimmering="true"
                app:placeholder_type="rectangle"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_m_space">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="@dimen/discovery_organization_cards_slider_shimmer_chip_width"
            android:layout_height="@dimen/discovery_organization_cards_slider_shimmer_chip_height"
            app:placeholder_color="?attr/bgMinor"
            app:placeholder_corner_radius="@dimen/discovery_organization_cards_slider_shimmer_chip_corner_radius"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="@dimen/discovery_organization_cards_slider_shimmer_chip_width"
            android:layout_height="@dimen/discovery_organization_cards_slider_shimmer_chip_height"
            android:layout_marginStart="@dimen/go_design_s_space"
            app:placeholder_color="?attr/bgMinor"
            app:placeholder_corner_radius="@dimen/discovery_organization_cards_slider_shimmer_chip_corner_radius"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="@dimen/discovery_organization_cards_slider_shimmer_chip_width"
            android:layout_height="@dimen/discovery_organization_cards_slider_shimmer_chip_height"
            android:layout_marginStart="@dimen/go_design_s_space"
            app:placeholder_color="?attr/bgMinor"
            app:placeholder_corner_radius="@dimen/discovery_organization_cards_slider_shimmer_chip_corner_radius"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/go_design_m_space">
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/go_design_s_space"
            app:placeholder_color="?attr/bgMinor"
            app:placeholder_corner_radius="@dimen/discovery_organizations_card_image_slider_corner_round_size"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:placeholder_color="?attr/bgMinor"
            app:placeholder_corner_radius="@dimen/discovery_organizations_card_image_slider_corner_round_size"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoLinearLayout>
