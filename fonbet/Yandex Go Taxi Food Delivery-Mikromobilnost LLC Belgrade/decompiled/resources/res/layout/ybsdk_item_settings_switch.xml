<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ybsdk_shimmer_auto_start="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_settings_item_top_margin"
        android:layout_marginBottom="@dimen/ybsdk_settings_item_bottom_margin">
        <TextView
            android:textColor="@color/ybsdk_settings_title_text_color"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ybsdk_transfer_settings_item_title_margin_end"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintEnd_toStartOf="@+id/switchButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchButton"
            android:layout_width="@dimen/ybsdk_transfer_settings_item_switch_width"
            android:layout_height="@dimen/ybsdk_transfer_settings_item_switch_height"
            android:checked="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title"/>
        <TextView
            android:textColor="?attr/ybColor_textIcon_secondary"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ybsdk_transfer_settings_item_subtitle_margin_top"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/title"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Widget.YB.Text.Body3"/>
        <ImageView
            android:id="@+id/subtitleEndIcon"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/subtitle"
            app:layout_constraintStart_toEndOf="@+id/subtitle"
            app:layout_constraintTop_toTopOf="@+id/subtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
