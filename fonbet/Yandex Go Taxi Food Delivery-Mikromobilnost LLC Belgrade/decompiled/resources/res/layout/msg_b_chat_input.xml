<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/chat_input_background"
        android:background="?attr/messagingCommonActionbarColor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/suggest_mentions_view_barrier"/>
    <FrameLayout
        android:id="@+id/panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ViewStub
            android:id="@+id/chat_emoji_panel"
            android:layout="@layout/msg_emoji_panel"
            android:inflatedId="@+id/chat_emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/suggest_mentions_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_input_attach_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_weight="1">
        <com.yandex.bricks.BrickSlotView
            android:layout_gravity="bottom"
            android:id="@+id/messaging_suggest_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/suggest_mentions_view_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="chat_input_attach_container"/>
    <View
        android:id="@+id/chat_input_shadow"
        android:background="?attr/messagingCommonDividerColor"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_input_attach_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ViewStub
        android:id="@+id/chat_input_attach_container"
        android:layout="@layout/msg_chat_input_panel_container"
        android:inflatedId="@+id/chat_input_attach_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_quote_attach_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/suggest_mentions_view_container"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ViewStub
        android:id="@+id/chat_quote_attach_container"
        android:layout="@layout/msg_chat_input_panel_container"
        android:inflatedId="@+id/chat_quote_attach_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_preview_attach_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chat_input_attach_container"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ViewStub
        android:id="@+id/chat_preview_attach_container"
        android:layout="@layout/msg_chat_input_panel_container"
        android:inflatedId="@+id/chat_preview_attach_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_text_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chat_quote_attach_container"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/attacment_button_fiction_margin"
        android:layout_width="12dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/panel_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/chat_content_ui_attach_file_button"
        android:background="@android:color/transparent"
        android:layout_width="42dp"
        android:layout_height="@dimen/chat_input_height"
        android:contentDescription="@string/attach_button_chat_window_content_des__res_0x7f150318"
        android:paddingStart="7dp"
        app:layout_constraintBottom_toTopOf="@+id/panel_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"
        app:srcCompat="@drawable/msg_ic_attach"
        app:tint="?attr/messagingCommonIconsSecondaryColor"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/attachment_button_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="end"
        app:constraint_referenced_ids="attacment_button_fiction_margin,chat_content_ui_attach_file_button"/>
    <com.yandex.messaging.input.ChatInputEditText
        android:layout_gravity="start|center_vertical"
        android:id="@+id/chat_text_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/chat_input_margin_vertical"
        android:layout_marginBottom="@dimen/chat_input_margin_vertical"
        app:layout_constraintBottom_toTopOf="@+id/panel_container"
        app:layout_constraintEnd_toEndOf="@+id/chat_input_right_guideline"
        app:layout_constraintStart_toStartOf="@+id/attachment_button_barrier"
        app:layout_constraintTop_toBottomOf="@+id/chat_preview_attach_container"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Messaging.ChatInput"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/char_input_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/chat_text_input"
        app:layout_constraintEnd_toEndOf="@+id/chat_text_input"
        app:layout_constraintTop_toTopOf="@+id/chat_text_input"
        app:srcCompat="@drawable/msg_ic_clear"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/chat_input_emoji_button"
        android:background="@drawable/msg_ripple_circle"
        android:layout_width="@dimen/chat_input_small_button_size"
        android:layout_height="@dimen/chat_input_small_button_size"
        android:layout_marginBottom="14dp"
        android:tint="?attr/messagingCommonIconsSecondaryColor"
        android:contentDescription="@string/chat_input_emoji_button_content_desc"
        android:layout_marginEnd="@dimen/chat_input_small_button_margin"
        app:layout_constraintBottom_toTopOf="@+id/panel_container"
        app:layout_constraintEnd_toEndOf="@+id/chat_text_input"/>
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/chat_input_star_button"
        android:layout_width="@dimen/chat_input_small_button_size"
        android:layout_height="@dimen/chat_input_small_button_size"
        android:layout_marginBottom="14dp"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/chat_input_small_button_margin"
        app:layout_constraintBottom_toTopOf="@+id/panel_container"
        app:layout_constraintEnd_toStartOf="@+id/chat_input_emoji_button"/>
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/chat_mesix_slot"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toTopOf="@+id/panel_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/messaging_voice_messages_control_slot"
        android:layout_width="0dp"
        android:layout_height="144dp"
        app:layout_constraintBottom_toTopOf="@+id/panel_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/chat_input_right_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="50dp"/>
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/dialog_input_selection_panel_slot"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
