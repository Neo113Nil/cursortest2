<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_notification"
    style="@style/BottomModalContentHolder">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yandex.go.design.view.GoImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/go_design_m_space"
                    android:scaleType="centerInside"
                    android:importantForAccessibility="no"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_header"
                    android:textColor="?attr/textMain"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:layout_marginHorizontal="@dimen/go_design_m_space"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="@dimen/component_text_size_body"
                    android:textColor="?attr/textMain"
                    android:textColorLink="?attr/textMain"
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/go_design_m_space"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:orientation="vertical"
        android:id="@+id/buttons_container"
        android:padding="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
