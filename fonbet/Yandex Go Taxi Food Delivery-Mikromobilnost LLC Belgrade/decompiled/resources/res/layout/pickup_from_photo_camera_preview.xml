<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.camera.CameraPreview
        android:id="@+id/camera_preview"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/photo_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.yandex.go.pickup_from_photo.ui.CameraTargetView
        android:id="@+id/targetView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/hint_animation"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="120dp"
        android:layout_marginBottom="120dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/hint_item_container"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <View
        android:background="@drawable/pickup_from_photo_header_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/header"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:component_title_typeface="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16dp"
            android:textColor="?attr/everFront"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/headerHint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:lineHeight="17dp"/>
    </FrameLayout>
    <View
        android:background="@drawable/pickup_from_photo_footer_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/camera_controls_container"
        app:layout_constraintTop_toTopOf="@+id/hint_item_container"/>
    <FrameLayout
        android:id="@+id/hint_item_container"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/camera_controls_container"
        app:layout_constraintHeight_min="112dp">
        <ru.yandex.taxi.design.ListItemComponent
            android:layout_gravity="top"
            android:id="@+id/hint_item"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            app:component_no_background="true"
            app:component_subtitle_ellipsize_mode="end"
            app:component_subtitle_max_lines="2"
            app:component_subtitle_size="@dimen/component_text_size_body"
            app:component_subtitle_text_color="@color/component_white"
            app:component_title_ellipsize_mode="end"
            app:component_title_max_lines="1"
            app:component_title_size="@dimen/component_text_size_title"
            app:component_title_text_color="@color/component_white"
            app:component_title_typeface="heavy"
            app:component_titles_gravity="top"
            app:component_trail_vertical_gravity="top"/>
    </FrameLayout>
    <include
        android:id="@+id/permissions_view"
        android:visibility="gone"
        layout="@layout/pickup_from_photo_permissions_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/camera_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.yandex.go.design.view.GoImageButton
            android:id="@+id/back_button"
            android:background="@drawable/fab_component_light"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:src="@drawable/ic_arrow_left"
            android:tint="?attr/everFront"
            android:backgroundTint="@color/component_fog_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yandex.go.design.view.GoImageButton
            android:id="@+id/photo_button"
            android:background="@null"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yandex.go.design.view.GoImageButton
            android:id="@+id/flash_button"
            android:background="@drawable/fab_component_light"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:tint="?attr/everFront"
            android:backgroundTint="@color/component_fog_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
