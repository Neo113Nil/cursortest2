<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/header_start_title_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:maxLines="2"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintEnd_toStartOf="@+id/header_end_title_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="heavy"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/header_end_title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="@+id/header_start_title_text_view"
        app:layout_constraintEnd_toStartOf="@+id/header_icon"
        app:layout_constraintStart_toEndOf="@+id/header_start_title_text_view"
        app:layout_constraintTop_toTopOf="@+id/header_start_title_text_view"
        app:robotoFontStyle="medium"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/header_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/header_end_title_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_end_title_text_view"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/header_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="header_start_title_text_view, header_start_title_text_view, header_icon"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/items_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_bottom_barrier"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
