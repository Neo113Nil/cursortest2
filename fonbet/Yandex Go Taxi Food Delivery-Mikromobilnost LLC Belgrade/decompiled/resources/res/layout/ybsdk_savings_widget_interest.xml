<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/savingsAccountWidgetInterest"
    android:background="@drawable/ybsdk_savings_widget_background"
    android:paddingTop="24dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ybsdk_savings_account_widget_margin_horizontal">
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/titleBalance"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Headline3"/>
    <com.ybsdk.core.design.spoiler.SpoilerTextView
        android:id="@+id/titleBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2.5dp"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBaseline_toBaselineOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:ybsdk_spoiler_height="28dp"
        app:ybsdk_spoiler_width="88dp"
        style="@style/Widget.YB.Text.Headline3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/details"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="@dimen/ybsdk_savings_account_interest_month_height"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <View
        android:id="@+id/detailsFadingEdge"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="12dp"
        android:layout_height="0dp"
        android:alpha="0.1"
        app:layout_constraintBottom_toBottomOf="@+id/details"
        app:layout_constraintStart_toStartOf="@+id/details"
        app:layout_constraintTop_toTopOf="@+id/details"/>
</androidx.constraintlayout.widget.ConstraintLayout>
