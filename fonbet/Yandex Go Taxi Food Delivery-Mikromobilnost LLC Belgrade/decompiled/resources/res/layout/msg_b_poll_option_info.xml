<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/messagingCommonBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/btn_back"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_back"/>
    <TextView
        android:id="@+id/screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_back"
        style="@style/MessagingToolbar.Text"/>
    <View
        android:id="@+id/border"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"/>
    <com.yandex.messaging.views.AnimatedProgressView
        android:id="@+id/poll_option_progress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="-12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:apvBackgroundColor="?attr/messagingPollsResultOptionBackgroundColor"
        app:apvCornerRadius="10dp"
        app:apvProgressColor="?attr/messagingPollsResultOptionProgressColor"
        app:layout_constraintBottom_toBottomOf="@+id/poll_option_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/border"/>
    <View
        android:id="@+id/progress_border"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@+id/poll_option_progress"/>
    <TextView
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:id="@+id/poll_option_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toStartOf="@+id/poll_vote_barrier"
        app:layout_constraintStart_toStartOf="@+id/poll_option_progress"
        app:layout_constraintTop_toTopOf="@+id/poll_option_progress"
        style="@style/Messaging.PollMessage.Answer.OptionText"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/poll_vote_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="poll_vote_stat_percent,poll_vote_stat_amount"/>
    <TextView
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:id="@+id/poll_vote_stat_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/poll_vote_stat_amount"
        app:layout_constraintEnd_toEndOf="@+id/poll_option_progress"
        app:layout_constraintTop_toTopOf="@+id/poll_option_progress"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Messaging.PollMessage.Answer.VoteStatPercents"/>
    <TextView
        android:id="@+id/poll_vote_stat_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/poll_option_progress"
        app:layout_constraintEnd_toEndOf="@+id/poll_option_progress"
        app:layout_constraintTop_toBottomOf="@+id/poll_vote_stat_percent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Messaging.PollMessage.Answer.VoteStatAmount"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/poll_option_voters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_border"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
