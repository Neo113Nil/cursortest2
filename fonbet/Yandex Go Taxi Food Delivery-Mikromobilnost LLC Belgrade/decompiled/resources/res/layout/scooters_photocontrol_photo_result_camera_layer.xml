<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/taken_pic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/mask_placeholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/taken_pic"
        app:layout_constraintEnd_toEndOf="@+id/taken_pic"
        app:layout_constraintStart_toStartOf="@+id/taken_pic"
        app:layout_constraintTop_toTopOf="@+id/taken_pic"/>
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_close_button_position="end"
        app:component_show_close_button="true"
        app:component_show_navigation_button="false"
        app:component_title="@string/scooters_photocontrol_title"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_body"
        app:component_title_text_color="@color/white"
        app:component_toolbar_background_color="@color/transparent"
        app:component_toolbar_close_icon_color="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_border"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/check_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="take_new_pic_btn,check_btn,photo_result_buttons_bg,       legal_approve_title,legal_approve_text,take_new_pic_btn,check_btn"/>
    <View
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/photo_result_buttons_bg"
        android:background="?attr/bgMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/legal_approve_title"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/legal_approve_title"
        android:paddingTop="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/scooters_photocontrol_verification_user_legal_approve_title"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/legal_approve_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/legal_approve_text"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/scooters_photocontrol_verification_user_legal_approve"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/take_new_pic_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/take_new_pic_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/scooters_take_new_photo"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:component_background_color="?attr/controlMinor"
        app:layout_constraintBottom_toTopOf="@+id/check_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/check_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/scooters_photocontrol_start_check"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:component_button_accent="true"
        app:layout_constraintBottom_toTopOf="@+id/legal_link"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColorLink="?attr/textMinor"
        android:gravity="center"
        android:id="@+id/legal_link"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/go_design_s_space"
        android:color="?attr/textMinor"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/bottom_offset_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/progress_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="progress_fog_dark,progress_bar"/>
    <View
        android:id="@+id/progress_fog_dark"
        android:background="@color/component_fog_dark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.progress.CircularProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_offset_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
