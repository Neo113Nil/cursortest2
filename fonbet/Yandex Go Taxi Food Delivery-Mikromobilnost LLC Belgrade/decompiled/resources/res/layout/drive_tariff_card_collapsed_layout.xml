<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/top_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.address.design.SourceDestinationComponent
            android:id="@+id/addresses"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/button_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f081870"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"/>
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/button_container"
            android:paddingTop="@dimen/go_design_s_space"
            android:paddingBottom="@dimen/go_design_m_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/go_design_s_space">
            <ru.yandex.taxi.design.button.OrderButtonComponent
                android:id="@+id/button"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title="collapsed_button"/>
        </com.yandex.go.design.view.GoFrameLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
