<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/grip"
        android:layout_width="@dimen/ybsdk_grip_width"
        android:layout_height="@dimen/ybsdk_grip_height"
        android:layout_marginTop="@dimen/ybsdk_grip_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ybsdk_grip_view"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/transferCommentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="@string/ybsdk_transfer_comment_title"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/grip"
        style="@style/Widget.YB.Text.Body3"/>
    <View
        android:id="@+id/transferCommentTooltipAnchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferCommentInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/transferCommentInput"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:gravity="center_horizontal"
        android:id="@+id/transferCommentInput"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionNone"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferCommentTitle"
        style="@style/Widget.YB.Text.Headline2"/>
    <View
        android:id="@+id/transferCommentDelimiter"
        android:background="?attr/ybColor_textIcon_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:alpha="0.08"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/transferCommentInput"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/transferCommentViewButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/transferCommentDelimiter"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <Space
        android:id="@+id/transferCommentViewSpaceBottom"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferCommentViewButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
