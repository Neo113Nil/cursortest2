<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/headlingPart"
            android:layout_width="108dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/transferCard1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/transferCard2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headlingPart"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/transferCard2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="12dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/transferCard3"
            app:layout_constraintStart_toEndOf="@+id/transferCard1"
            app:layout_constraintTop_toBottomOf="@+id/headlingPart"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/transferCard3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/transferCard2"
            app:layout_constraintTop_toBottomOf="@+id/headlingPart"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/headlingPart2"
            android:layout_width="216dp"
            android:layout_height="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/transferCard3"
            app:ybsdk_cornerRadius="6dp"/>
        <include
            android:id="@+id/promoRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/headlingPart2"
            layout="@layout/ybsdk_transfers_dashboard_slideable_view_loading_promo_row"/>
        <include
            android:id="@+id/promoRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/promoRow1"
            layout="@layout/ybsdk_transfers_dashboard_slideable_view_loading_promo_row"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/promoRow2"
            layout="@layout/ybsdk_transfers_dashboard_slideable_view_loading_promo_row"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
