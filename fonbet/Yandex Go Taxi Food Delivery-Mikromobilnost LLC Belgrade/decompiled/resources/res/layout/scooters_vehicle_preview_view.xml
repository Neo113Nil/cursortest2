<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="21sp"
        android:textColor="?attr/textMain"
        android:gravity="start|bottom"
        android:id="@+id/title"
        android:paddingTop="7.5dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="heavy"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image"
        android:layout_width="79dp"
        android:layout_height="79dp"
        android:layout_marginBottom="16dp"
        android:adjustViewBounds="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="24dp"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier_for_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/success_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="add,charge_view,plate,price,swap,plus,offer_button"/>
    <FrameLayout
        android:id="@+id/charge_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minWidth="39dp"
        android:minHeight="18dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="?attr/textMinor"
        android:gravity="center"
        android:id="@+id/plate"
        android:background="@drawable/scooters_rounded_background_minor"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:minWidth="56dp"
        android:minHeight="18dp"
        android:layout_marginStart="4dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/charge_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/charge_view"
        app:layout_constraintTop_toTopOf="@+id/charge_view"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="@color/component_green_toxic"
        android:gravity="center"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/charge_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/charge_view"
        app:layout_constraintTop_toTopOf="@+id/charge_view"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/add"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:component_background_color="?attr/controlMinor"
        app:component_button_size="M"
        app:layout_constraintBottom_toBottomOf="@+id/swap"
        app:layout_constraintEnd_toStartOf="@+id/swap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/swap"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/add"
        app:layout_constraintStart_toStartOf="@+id/add"
        app:layout_constraintTop_toTopOf="@+id/add"
        app:srcCompat="@drawable/ic_add_plus"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:gravity="center"
        android:id="@+id/swap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:minWidth="164dp"
        app:component_button_size="M"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/add"
        app:layout_constraintTop_toBottomOf="@+id/charge_view"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/offer_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:minHeight="48dp"
        app:component_rounded_background="?attr/controlMinor"
        app:component_subtitle_gravity="center_horizontal"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_body"
        app:component_trail_companion_mode="image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/loading_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="shimmer_of_battery, shimmer_of_plate"/>
    <ru.yandex.taxi.widget.MaskedShimmeringBar
        android:id="@+id/shimmer_of_battery"
        android:layout_width="39dp"
        android:layout_height="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/shimmer_of_plate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/shimmer_of_plate"
        app:mask="@drawable/ic_battery_v2_mask"
        style="@style/ScootersCardV2MaskedShimmeringBar"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmer_of_plate"
        android:layout_width="70dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/shimmer_of_battery"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_bias="0"
        style="@style/ScootersStandartShimmeringBar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/error_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="error_text,nearest_scooter"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/error"
        android:gravity="start"
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minWidth="107dp"
        android:minHeight="20dp"
        android:includeFontPadding="false"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/nearest_scooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:component_no_background="true"
        app:component_title_size="@dimen/component_text_size_caption"
        app:component_trail_mode="navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_for_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="title,shimmer_of_plate,plate,price,error_text"/>
</merge>
