<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ybsdk.widgets.common.ImageViewWithCustomScaleTypes
            android:id="@+id/savingsCardImageBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/savingsItemWidgetContainer"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:foreground="?attr/selectableItemBackground"
            android:importantForAccessibility="yes"
            android:paddingHorizontal="12dp"
            app:layout_constraintDimensionRatio="1:1.4"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="?attr/ybColor_textIcon_secondary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.YB.Text.Caption1.Medium"/>
            <com.ybsdk.core.design.spoiler.SpoilerTextView
                android:textColor="?attr/ybColor_textIcon_primary"
                android:id="@+id/textBadgeBubble"
                android:background="@drawable/ybsdk_rounded_rectangle_background_no_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="10dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                app:layout_constraintBottom_toTopOf="@+id/spoilerBalance"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:ybsdk_spoiler_color_attr="?attr/ybColor_textIcon_primaryStaticInverted"
                app:ybsdk_spoiler_height="12dp"
                app:ybsdk_spoiler_horizontal_gravity="center"
                app:ybsdk_spoiler_vertical_gravity="bottom"
                app:ybsdk_spoiler_width="37dp"
                style="@style/Widget.YB.Text.Caption1.Medium"/>
            <com.ybsdk.core.design.spoiler.SpoilerFrameLayout
                android:id="@+id/spoilerBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="68dp"
                app:layout_constraintTop_toBottomOf="@+id/label"
                app:ybsdk_spoiler_height="28dp"
                app:ybsdk_spoiler_horizontal_gravity="center"
                app:ybsdk_spoiler_width="88dp">
                <com.ybsdk.widgets.common.YbSdkScalableTextView
                    android:textColor="?attr/ybColor_textIcon_primary"
                    android:gravity="center"
                    android:id="@+id/balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:ybsdk_bigTextStyle="@style/Widget.YB.Text.Numbers5"
                    app:ybsdk_smallTextStyle="@style/Widget.YB.Text.Numbers6"/>
            </com.ybsdk.core.design.spoiler.SpoilerFrameLayout>
            <TextView
                android:textColor="?attr/ybColor_textIcon_primary"
                android:gravity="center"
                android:id="@+id/balanceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/spoilerBalance"
                style="@style/Widget.YB.Text.Caption1.Medium"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/savingsCellImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="36dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label"/>
            <TextView
                android:gravity="center"
                android:id="@+id/savingsImageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/savingsCellImage"
                style="@style/Widget.YB.Text.Title2"/>
            <TextView
                android:textColor="?attr/ybColor_textIcon_secondary"
                android:gravity="center"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/Widget.YB.Text.Caption1.Medium"/>
            <com.ybsdk.feature.divkit.api.ui.YbDivView
                android:id="@+id/divSubtitleView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
