<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/error_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RoundedCornersImageView
            android:background="?attr/error"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_alert"
            android:tint="@color/white"
            android:layout_marginStart="8dp"
            app:cornerRadius="100dp"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="24sp"
            android:textColor="?attr/textMain"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="@string/chargers_something_wrong"
            android:layout_marginHorizontal="16dp"
            app:robotoFontStyle="bold"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/mt_error_subtitle"
            android:layout_marginHorizontal="16dp"
            app:robotoFontStyle="regular"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <ru.yandex.taxi.widget.ButtonsView
            android:id="@+id/retry_button"
            android:background="?attr/bgTransparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
