<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/safety_center_content"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
            android:id="@+id/safety_center_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/image"
                    android:paddingTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:paddingStart="10dp"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textColor="?attr/textMain"
                    android:id="@+id/title"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/go_design_m_space"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/safety_center_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
        <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
            android:layout_gravity="bottom"
            android:id="@+id/scroll_indicator_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:scroll_view_id="@+id/safety_center_scroll_view"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttons_container"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.yandex.go.design.view.GoLinearLayout>
