<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ybsdk_shimmer_auto_start="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ybCardContent"
        android:background="@drawable/ybsdk_bg_card_requisites_field"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/textHint"
            android:layout_width="wrap_content"
            android:layout_height="0x7f071465"
            android:maxLines="1"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="5sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@+id/textValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
        <TextView
            android:textColor="?attr/ybColor_textIcon_primary"
            android:id="@+id/textValue"
            android:layout_width="match_parent"
            android:layout_height="0x7f071466"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="36dp"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeMinTextSize="5sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textHint"
            style="@style/Widget.YB.Text.Body1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/copyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ybsdk_card_accessibility_click_to_copy_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ybsdk_ic_copy_outline"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
