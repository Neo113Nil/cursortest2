<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/tail_view"
        android:layout_width="@dimen/timeline_banner_tail_width"
        android:layout_height="8dp"
        android:src="@drawable/ic_timeline_bubble_tail"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_timeline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/timeline_banner_margin">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/banner_section"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <com.yandex.go.superapp.plate_number.PlateNumberDividerView
            android:id="@+id/divider_view"
            android:background="?attr/line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:scaleType="fitXY"
            android:layout_marginHorizontal="16dp"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:id="@+id/timeline_options_section"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
