<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:id="@+id/progressview_guidance"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="12dp">
    <com.yandex.go.design.view.GoView
        android:layout_gravity="center_vertical"
        android:background="@drawable/contextprogress_background"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="6dp"/>
    <com.yandex.go.design.view.GoView
        android:layout_gravity="center_vertical"
        android:id="@+id/view_progress_jams"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="6dp"/>
    <com.yandex.go.design.view.GoView
        android:layout_gravity="center_vertical"
        android:id="@+id/view_progress_shade"
        android:background="@drawable/contextprogress_background"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginHorizontal="6dp"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center"
        android:id="@+id/dot_at_end"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_progress_end_point"
        android:importantForAccessibility="no"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/imageview_progress_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_navigator_route_arrow_small"
        android:importantForAccessibility="no"/>
</com.yandex.go.design.view.GoFrameLayout>
