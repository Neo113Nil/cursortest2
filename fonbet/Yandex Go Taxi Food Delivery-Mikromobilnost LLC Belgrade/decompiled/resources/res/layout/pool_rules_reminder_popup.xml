<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:background="@drawable/bg_bottom_notification"
        style="@style/BottomModalContentHolder">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f08177d"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:paddingBottom="61dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="29sp"
                android:textColor="@color/black"
                android:id="@+id/reminder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="122dp"
                app:robotoFontStyle="medium"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/waiting_time_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textStyle="bold"
                android:text="@string/dialog_common_ok"
                style="@style/ModalErrorButton.Confirm"/>
        </FrameLayout>
    </FrameLayout>
</merge>
