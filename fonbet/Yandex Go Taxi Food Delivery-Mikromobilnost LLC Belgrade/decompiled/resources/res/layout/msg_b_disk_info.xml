<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/disk_info_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/disk_info_section_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.Settings.Text.Group"/>
    <View
        android:id="@+id/disk_info_divider"
        android:background="@drawable/msg_divider_settings_group"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disk_info_section_title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/disk_label_end_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="disk_info_available_space, disk_info_loading_label"/>
    <TextView
        android:textAppearance="@style/Messaging.Settings.TextAppearance"
        android:id="@+id/disk_info_available_space"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/ya_regular"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disk_info_divider"/>
    <com.yandex.messaging.views.AnimatedProgressView
        android:id="@+id/disk_info_available_space_progress"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:apvBackgroundColor="?attr/messagingCommonDividerColor"
        app:apvCornerRadius="4dp"
        app:apvProgressCornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/disk_info_loading_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/disk_label_end_barrier"
        app:layout_constraintTop_toTopOf="@+id/disk_info_loading_label"/>
    <TextView
        android:textAppearance="@style/Messaging.Settings.TextAppearance.Secondary"
        android:textSize="16sp"
        android:id="@+id/disk_info_loading_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/disk_info_loading_label"
        android:fontFamily="@font/ya_regular"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disk_info_divider"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/ready_state_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="disk_info_available_space"/>
    <TextView
        android:textColor="?attr/messagingCommonAccentTextColor"
        android:id="@+id/disk_info_control_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/disk_control_space_button"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disk_info_loading_label"
        style="@style/Messaging.Settings.Action.Button.Big"/>
</androidx.constraintlayout.widget.ConstraintLayout>
