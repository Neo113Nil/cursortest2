<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.yandex.go.design.view.GoConstraintLayout
            android:orientation="vertical"
            android:id="@+id/scroll_child"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Group
                android:id="@+id/shimmers"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="title_shimmer, subtitle_shimmer, map_shimmer, center_title_shimmer, center_subtitle_shimmer, shimmer_icon_1, shimmer_icon_2"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/title_shimmer"
                android:layout_width="0dp"
                android:layout_height="@dimen/shimmering_bar_height"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/subtitle_shimmer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/subtitle_shimmer"
                android:layout_width="0dp"
                android:layout_height="@dimen/shimmering_bar_height"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/map_shimmer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title_shimmer"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/map_shimmer"
                android:layout_width="match_parent"
                android:layout_height="216dp"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/center_title_shimmer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle_shimmer"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/center_title_shimmer"
                android:layout_width="0dp"
                android:layout_height="@dimen/shimmering_bar_height"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/center_subtitle_shimmer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/map_shimmer"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/center_subtitle_shimmer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/shimmering_bar_height"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/shimmer_icon_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/center_title_shimmer"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/shimmer_icon_1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="@dimen/go_design_m_space"
                app:barCornerRadius="100dp"
                app:layout_constraintBottom_toTopOf="@+id/icons_container_barrier"
                app:layout_constraintEnd_toStartOf="@+id/shimmer_icon_2"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/center_subtitle_shimmer"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/shimmer_icon_2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="@dimen/go_design_m_space"
                app:barCornerRadius="100dp"
                app:layout_constraintBottom_toTopOf="@+id/icons_container_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/shimmer_icon_1"
                app:layout_constraintTop_toBottomOf="@+id/center_subtitle_shimmer"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="rate_title_text, rating_subtitle_text, center_title, center_subtitle"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="20sp"
                android:textColor="?attr/textMain"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/rate_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/rating_subtitle_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:robotoFontStyle="bold"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:textColor="?attr/textMain"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/rating_subtitle_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/rating_subtitle_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rate_title_text"/>
            <com.yandex.go.design.view.GoConstraintLayout
                android:orientation="vertical"
                android:id="@+id/map_view_container"
                android:background="@drawable/rounded_border_16"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/center_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rating_subtitle_text">
                <ru.yandex.taxi.widget.RoundedCornersFrameLayout
                    android:id="@+id/map_view"
                    android:padding="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    app:allCornerRadius="17dp"
                    app:layout_constraintBottom_toTopOf="@+id/map_barrier"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/map_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="top"
                    app:constraint_referenced_ids="route_title, time_title, average_speed_title"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="13sp"
                    android:textColor="?attr/textMinor"
                    android:layout_gravity="center"
                    android:id="@+id/route_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigator_rate_route_route"
                    app:layout_constraintBottom_toTopOf="@+id/route_value"
                    app:layout_constraintEnd_toEndOf="@+id/route_value"
                    app:layout_constraintStart_toStartOf="@+id/route_value"
                    app:layout_constraintTop_toBottomOf="@+id/map_barrier"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="16sp"
                    android:textColor="?attr/textMain"
                    android:layout_gravity="center"
                    android:id="@+id/route_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/time_value"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/route_title"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="13sp"
                    android:textColor="?attr/textMinor"
                    android:layout_gravity="center"
                    android:id="@+id/time_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigator_rate_route_time"
                    app:layout_constraintBottom_toTopOf="@+id/time_value"
                    app:layout_constraintEnd_toEndOf="@+id/time_value"
                    app:layout_constraintStart_toStartOf="@+id/time_value"
                    app:layout_constraintTop_toBottomOf="@+id/map_barrier"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="16sp"
                    android:textColor="?attr/textMain"
                    android:layout_gravity="center"
                    android:id="@+id/time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/average_speed_value"
                    app:layout_constraintStart_toEndOf="@+id/route_value"
                    app:layout_constraintTop_toBottomOf="@+id/time_title"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="13sp"
                    android:textColor="?attr/textMinor"
                    android:layout_gravity="center"
                    android:id="@+id/average_speed_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigator_rate_route_avg_speed"
                    app:layout_constraintBottom_toTopOf="@+id/average_speed_value"
                    app:layout_constraintEnd_toEndOf="@+id/average_speed_value"
                    app:layout_constraintStart_toStartOf="@+id/average_speed_value"
                    app:layout_constraintTop_toBottomOf="@+id/map_barrier"/>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="16sp"
                    android:textColor="?attr/textMain"
                    android:layout_gravity="center"
                    android:id="@+id/average_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/time_value"
                    app:layout_constraintTop_toBottomOf="@+id/average_speed_title"/>
            </com.yandex.go.design.view.GoConstraintLayout>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="30sp"
                android:textColor="?attr/textMain"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/center_title"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintBottom_toTopOf="@+id/center_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/map_view_container"
                app:robotoFontStyle="bold"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:textColor="?attr/textMain"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/center_subtitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/go_design_m_space"
                app:layout_constraintBottom_toTopOf="@+id/icons_container_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/center_title"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/icons_container_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="top"
                app:constraint_referenced_ids="icons_container"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/icons_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/rating_reason"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icons_container_barrier"/>
            <com.yandex.go.navigator.rate_route.RatingReasonsView
                android:id="@+id/rating_reason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/comment_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icons_container"/>
            <ru.yandex.taxi.design.ListItemInputComponent
                android:id="@+id/comment_view"
                android:background="@drawable/bg_round_16dp_minor"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginBottom="12dp"
                android:imeOptions="actionDone"
                android:layout_marginHorizontal="@dimen/go_design_m_space"
                android:paddingVertical="10dp"
                app:component_input_clear_enable="false"
                app:component_input_hint="@string/navigator_rate_route_screen_input_hint"
                app:component_input_max_length="50"
                app:component_input_max_lines="3"
                app:component_show_underline="false"
                app:component_type_input="textNoSuggestions"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rating_reason"/>
        </com.yandex.go.design.view.GoConstraintLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <com.yandex.go.design.view.GoFrameLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:text="@string/common_done"
            app:component_background_color="?attr/controlMain"
            app:component_button_accent="true"
            app:component_disabled_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textOnControl"/>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoLinearLayout>
