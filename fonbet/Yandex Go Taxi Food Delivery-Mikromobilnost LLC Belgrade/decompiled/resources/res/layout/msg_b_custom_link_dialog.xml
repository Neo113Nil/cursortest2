<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/messagingCommonAccentTextColor"
        android:gravity="start"
        android:id="@+id/link_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_link_dialog_header"
        style="@style/Messaging.TextAppearance.H1"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/link_dialog_text_input_layout"
        android:paddingTop="@dimen/edit_text_dialog_paddings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/messenger_url_hint"
        app:hintTextAppearance="@style/Messaging.Hint">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/link_dialog_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/link_dialog_hint"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            style="@style/Messaging.EditTextMaterial"/>
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <Button
            android:id="@+id/link_dialog_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_confirm_cancel"
            style="@style/Messaging.TextAppearance.H3_Dialog"/>
        <Button
            android:id="@+id/link_dialog_add_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_confirm"
            style="@style/Messaging.TextAppearance.H3_Dialog"/>
    </LinearLayout>
</LinearLayout>
