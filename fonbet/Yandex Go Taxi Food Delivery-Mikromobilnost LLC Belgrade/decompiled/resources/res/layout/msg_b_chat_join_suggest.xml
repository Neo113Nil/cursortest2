<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="gone"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <RelativeLayout
        android:id="@+id/join_suggest"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Button
            android:textSize="14dp"
            android:id="@+id/join_suggest_button"
            android:background="@drawable/msg_bg_chat_join_suggest_button"
            android:layout_width="118dp"
            android:layout_height="40dp"
            android:layout_marginRight="12dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/chat_site_comments_join_suggest_button_enabled"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            style="?android:attr/borderlessButtonStyle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/messagingCommonTextPrimaryColor"
            android:id="@+id/join_suggest_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="20dp"
            android:text="@string/chat_site_comments_join_suggest_text"
            android:layout_toLeftOf="@+id/join_suggest_button"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/join_suggest_button"/>
        <View
            android:background="?attr/messagingCommonDividerColor"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</FrameLayout>
