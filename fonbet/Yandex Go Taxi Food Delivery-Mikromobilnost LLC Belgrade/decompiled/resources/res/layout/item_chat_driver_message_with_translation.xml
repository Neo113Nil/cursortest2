<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">
    <include layout="@layout/item_chat_time"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@drawable/chat_driver_message_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:gravity="start"
            android:id="@+id/translated_message_text"
            android:paddingLeft="16dp"
            android:paddingTop="7dp"
            android:paddingRight="16dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:robotoFontStyle="regular"/>
        <View
            android:background="?attr/line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="?attr/textMinor"
            android:gravity="start"
            android:id="@+id/original_message_text"
            android:paddingLeft="16dp"
            android:paddingTop="7dp"
            android:paddingRight="16dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:robotoFontStyle="regular"/>
    </LinearLayout>
</LinearLayout>
