<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/messagingCommonBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/miniapp_offset_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/miniapp_progress_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/messagingCommonAccentColor"/>
    <WebView
        android:id="@+id/miniapp_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
