<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/progressShimmer1"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="@dimen/ybsdk_stories_progress_top_margin"
        android:layout_marginStart="127dp"
        app:layout_constraintEnd_toStartOf="@+id/progressShimmer2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_cornerRadius="6dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/progressShimmer2"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="2dp"
        app:layout_constraintEnd_toStartOf="@+id/progressShimmer3"
        app:layout_constraintStart_toEndOf="@+id/progressShimmer1"
        app:layout_constraintTop_toTopOf="@+id/progressShimmer1"
        app:ybsdk_cornerRadius="6dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/progressShimmer3"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="127dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/progressShimmer2"
        app:layout_constraintTop_toTopOf="@+id/progressShimmer1"
        app:ybsdk_cornerRadius="6dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
