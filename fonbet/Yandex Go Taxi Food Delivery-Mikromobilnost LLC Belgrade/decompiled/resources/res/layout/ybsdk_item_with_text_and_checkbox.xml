<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/last_day_checkbox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/checkbox_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_auto_topup_bottom_sheet_choose_date_last_day"
        android:layout_weight="1"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.checkbox.CheckBoxView
        android:layout_gravity="center_vertical"
        android:id="@+id/checkbox"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        app:ybsdk_colorType="dark"/>
</LinearLayout>
