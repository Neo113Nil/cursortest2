<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <ru.yandex.taxi.widget.floatbuttonholder.RotatableFloatButton
        android:layout_gravity="end"
        android:id="@+id/return_to_init_point"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:layout_gravity="center_horizontal"
        android:id="@+id/description_pickup_point_item_component"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"
        app:component_background_corner_radius="16dp"
        app:component_rounded_background="#77000000"
        app:component_title_text_color="@color/white"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/accept_pickup_point_frame_layout"
        android:background="@drawable/bg_round_modal_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/accept_pickup_point"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp"/>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoLinearLayout>
