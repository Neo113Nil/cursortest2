<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/error_layout"
    android:background="?attr/bgMain"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ListTitleComponent
        android:id="@+id/error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_subtitle="@string/webview_error_description"
        app:component_subtitle_size="@dimen/component_text_size_subtitle"
        app:component_title="@string/webview_error_title"
        app:component_title_size="@dimen/component_text_size_title"
        app:component_title_typeface="bold"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/error_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:src="0x7f081b11"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/reload_button"
        android:background="@drawable/bg_main_ripple"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:component_title="@string/webview_error_reload"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_subtitle"/>
</FrameLayout>
