<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/plus_badge"
        layout="@layout/top_end_corner_with_cashback"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ru.yandex.taxi.design.BackButtonIconComponent
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        app:component_circle_button_badge_color="?attr/controlMain"
        app:component_circle_button_badge_text_color="?attr/textOnControl"/>
    <com.yandex.go.superapp.orders.card.OrderCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:elevation="24dp"
        android:layout_marginHorizontal="@dimen/go_design_s_space"/>
</LinearLayout>
