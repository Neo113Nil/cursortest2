<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/chat_list_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/chat_list_meeting_indication_slot"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chat_list_toolbar"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/chat_list_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chat_list_meeting_indication_slot"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create_chat"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/msg_ic_create_chat"
        android:contentDescription="@string/toolbar_btn_create_chat_content_des__res_0x7f151926"
        android:layout_marginEnd="12dp"
        app:backgroundTint="?attr/messagingChatListCreateChatColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="?attr/messagingCommonAccentFgColor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
