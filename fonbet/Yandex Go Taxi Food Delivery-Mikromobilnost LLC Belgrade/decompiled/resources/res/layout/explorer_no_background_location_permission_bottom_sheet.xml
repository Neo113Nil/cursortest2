<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/top_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/go_design_m_space">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_title"
            android:textStyle="bold"
            android:textColor="?attr/textMain"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineHeight="27sp"
            app:robotoFontStyle="bold"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textColor="?attr/textMain"
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineHeight="19sp"
            app:robotoFontStyle="regular"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/open_settings_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/go_design_l_space"
            app:component_background_color="?attr/controlMain"
            app:component_button_accent="true"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControl"
            app:component_title_typeface="medium"/>
    </LinearLayout>
</com.yandex.go.design.view.GoLinearLayout>
