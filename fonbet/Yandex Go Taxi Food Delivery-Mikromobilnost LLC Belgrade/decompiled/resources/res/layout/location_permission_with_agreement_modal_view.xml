<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/location_permission_with_agreement_modal_view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/scroll_view"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/logo_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/logo_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/top_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.3"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_title"
                android:textColor="?attr/textMain"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                android:letterSpacing="-0.01"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_guideline"
                app:layout_constraintVertical_bias="1"
                app:robotoFontStyle="bold"/>
            <ImageView
                android:id="@+id/location_icon"
                android:background="@drawable/location_icon_background"
                android:visibility="invisible"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/go_design_m_space"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="?attr/textMinor"
                android:id="@+id/location_icon_name"
                android:paddingTop="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/go_design_s_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/location_icon"
                app:layout_constraintTop_toTopOf="@+id/location_icon"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_body"
                android:textColor="?attr/textMain"
                android:id="@+id/location_icon_text"
                android:padding="0dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/go_design_s_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/location_icon"
                app:layout_constraintTop_toBottomOf="@+id/location_icon_name"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="?attr/textMinor"
                android:textColorLink="?attr/textMain"
                android:id="@+id/agreement_content"
                android:paddingTop="40dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/go_design_s_space"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                android:lineHeight="@dimen/component_text_line_height_caption"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/location_icon"
                app:layout_constraintVertical_bias="1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ImageView
        android:id="@+id/shadow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_container"/>
    <FrameLayout
        android:id="@+id/bottom_container"
        android:background="@drawable/bottom_buttons_section_background"
        android:padding="@dimen/go_design_s_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_body"
            android:textColor="?attr/textMain"
            android:gravity="center"
            android:id="@+id/continue_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.005"
            app:component_button_size="L"
            app:robotoFontStyle="bold"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
