<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMinor"
        android:id="@+id/permission_error_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/phone_outer_image"
        app:layout_constraintEnd_toEndOf="@+id/phone_outer_image"
        app:layout_constraintStart_toStartOf="@+id/phone_outer_image"/>
    <ImageView
        android:id="@+id/phone_outer_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/phone_outer_frame"
        app:layout_constraintBottom_toTopOf="@+id/go_to_settings_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/phone_inner_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/phone_inner_frame"
        app:layout_constraintBottom_toBottomOf="@+id/phone_outer_image"
        app:layout_constraintEnd_toEndOf="@+id/phone_outer_image"
        app:layout_constraintStart_toStartOf="@+id/phone_outer_image"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/settings_placeholder_linear_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/phone_inner_image"
        app:layout_constraintEnd_toEndOf="@+id/phone_inner_image"
        app:layout_constraintStart_toStartOf="@+id/phone_inner_image"
        app:layout_constraintTop_toTopOf="@+id/phone_inner_image">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <View
                android:id="@+id/avatar_placeholder"
                android:background="@drawable/settings_placeholder_background"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/settings_placeholder_background"
                android:layout_width="66dp"
                android:layout_height="15dp"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="@+id/avatar_placeholder"
                app:layout_constraintStart_toEndOf="@+id/avatar_placeholder"
                app:layout_constraintTop_toTopOf="@+id/avatar_placeholder"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/contact_avatar_placeholder"
                android:background="@drawable/settings_placeholder_background"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/contact"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="14sp"
                android:textColor="?attr/textMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_contacts_select_from_contacts"
                android:importantForAccessibility="no"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="@+id/contact_avatar_placeholder"
                app:layout_constraintStart_toEndOf="@+id/contact_avatar_placeholder"
                app:layout_constraintTop_toTopOf="@+id/contact_avatar_placeholder"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/radio_checked"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <View
                android:id="@+id/avatar_placeholder_2"
                android:background="@drawable/settings_placeholder_background"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/settings_placeholder_background"
                android:layout_width="99dp"
                android:layout_height="15dp"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="@+id/avatar_placeholder_2"
                app:layout_constraintStart_toEndOf="@+id/avatar_placeholder_2"
                app:layout_constraintTop_toTopOf="@+id/avatar_placeholder_2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/go_to_settings_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/contacts_go_to_settings_button_text"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
