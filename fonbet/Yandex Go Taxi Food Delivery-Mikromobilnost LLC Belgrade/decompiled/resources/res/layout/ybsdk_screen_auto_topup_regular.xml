<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ScrollableNestedScrollView
        android:id="@+id/autotopupScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ybsdk_toolbar_height"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ybsdk.widgets.common.SelectedItemFormView
                android:id="@+id/autoTopupPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/ybColor_textIcon_negative"
                android:id="@+id/autotopupSourceErrorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginStart="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/autotopupSourceErrorImage"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/autoTopupPaymentMethod"
                app:layout_constraintTop_toBottomOf="@+id/autoTopupPaymentMethod"
                style="@style/Widget.YB.Text.Caption1.Regular"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/autotopupSourceErrorImage"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/autotopupSourceErrorText"
                app:layout_constraintEnd_toEndOf="@+id/autoTopupPaymentMethod"
                app:layout_constraintStart_toEndOf="@+id/autotopupSourceErrorText"
                app:layout_constraintTop_toTopOf="@+id/autotopupSourceErrorText"/>
            <View
                android:id="@+id/autotopupSourceErrorButton"
                android:layout_width="0dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="@+id/autotopupSourceErrorText"
                app:layout_constraintEnd_toEndOf="@+id/autotopupSourceErrorImage"
                app:layout_constraintStart_toStartOf="@+id/autotopupSourceErrorText"
                app:layout_constraintTop_toTopOf="@+id/autotopupSourceErrorText"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/autotopupFrequencyList"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/autotopupSourceErrorText"
                app:layout_goneMarginTop="16dp"/>
            <include
                android:id="@+id/autotopupOnce"
                layout="@layout/ybsdk_item_auto_topup_regular_frequency_once"/>
            <include
                android:id="@+id/autotopupTwicePerMonth"
                layout="@layout/ybsdk_item_auto_topup_regular_frequency_twice_per_month"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/autotopupDateBarrier"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="                 autotopupOnce,                 autotopupTwicePerMonth"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/ybColor_textIcon_linkNormal"
                android:id="@+id/autotopupTriviaLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@+id/autotopupDateBarrier"
                style="@style/Widget.YB.Text.Body2"/>
            <com.ybsdk.feature.divkit.api.ui.YbDivView
                android:id="@+id/autotopupDivView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="2dp"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintBottom_toTopOf="@+id/autotopupButtonGroup"
                app:layout_constraintTop_toBottomOf="@+id/autotopupTriviaLink"
                app:layout_constraintVertical_bias="1"/>
            <com.ybsdk.feature.autotopup.internal.presentation.view.AutoTopupSummaryView
                android:id="@+id/autotopupSummaryView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="2dp"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintBottom_toTopOf="@+id/autotopupButtonGroup"
                app:layout_constraintTop_toBottomOf="@+id/autotopupTriviaLink"
                app:layout_constraintVertical_bias="1"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/autotopupWidgetBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="autotopupDivView, autotopupSummaryView"/>
            <com.ybsdk.widgets.common.YbButtonViewGroup
                android:id="@+id/autotopupButtonGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/autotopupWidgetBarrier"
                app:layout_constraintVertical_bias="1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.ybsdk.widgets.common.ScrollableNestedScrollView>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/autotopupSkeletons"
        layout="@layout/ybsdk_screen_auto_topup_regular_skeletons"/>
    <com.ybsdk.widgets.common.communication.CommunicationFullScreenView
        android:id="@+id/communicationFullScreen"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
