<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/ybsdk_drag_and_drop_onboarding_dialog_background"
    android:padding="16dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="3dp"
    android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space">
    <TextView
        android:textSize="18sp"
        android:textColor="?attr/ybColor_textIcon_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_savings_drag_and_drop_onboarding_dialog_title"
        style="@style/Widget.YB.Text.Title1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/ybColor_textIcon_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ybsdk_savings_drag_and_drop_onboarding_dialog_description"
        style="@style/Widget.YB.Text.Body3"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/primaryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:ybsdk_buttonTitle="@string/ybsdk_savings_drag_and_drop_onboarding_dialog_button_text"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.InvertedStatic.S"/>
</LinearLayout>
