<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/error_icon"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toTopOf="@+id/error_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/places_icon_error"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/error_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/discovery_organizations_chat_error_occured"
        app:layout_constraintBottom_toTopOf="@+id/error_button_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMinor"
        android:id="@+id/error_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/discovery_organizations_chat_error_reload_later"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_title"/>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:orientation="vertical"
        android:id="@+id/error_button_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_body"
            android:id="@+id/close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_close"
            android:fontFamily="@font/ys_text_medium"
            app:component_background_color="?attr/controlMinor"
            app:component_button_size="L"
            app:component_title_color="?attr/textMain"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/reload_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/discovery_organizations_chat_reload"
            app:component_background_color="?attr/controlMain"
            app:component_button_accent="true"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControl"/>
    </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
