<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skeleton"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/go_design_m_space">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/title_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_width="0dp"
        android:layout_height="@dimen/order_card_skeleton_title_height"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="@+id/title_guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/subtitle_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_width="0dp"
        android:layout_height="@dimen/order_card_skeleton_subtitle_height"
        android:layout_marginTop="@dimen/order_card_skeleton_subtitle_margin_top"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="@+id/subtitle_guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
