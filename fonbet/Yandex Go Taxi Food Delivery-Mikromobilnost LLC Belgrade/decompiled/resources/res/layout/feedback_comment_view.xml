<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/header"
        android:paddingTop="@dimen/go_design_m_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_title_font_feature_settings="pnum, lnum"
        app:component_title_gravity="start"
        app:component_title_lineSpacingExtra="-1sp"
        app:component_title_typeface="bold"
        style="@style/ListTitleComponent"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/comment_view"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_weight="1"
        app:component_divider_margin_left="@dimen/go_design_m_space"
        app:component_divider_margin_right="@dimen/go_design_m_space"
        app:component_hint_input="@string/rate_comment_hint"
        app:component_input_focused_divider_color="?attr/textMain"
        app:component_input_max_lines="10"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/go_design_s_space">
        <ru.yandex.taxi.design.ButtonComponent
            android:layout_gravity="center_vertical"
            android:id="@+id/support_button"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            app:component_background_color="?attr/controlMinor"
            app:component_button_icon="@drawable/ic_support_chat"
            app:component_button_icon_padding="2dp"
            app:component_button_icon_tint="?attr/textOnControlMinor"
            app:component_title_color="?attr/textOnControlMinor"
            style="@style/OrderButtonStyle"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_done_button"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:text="@string/common_done"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            style="@style/OrderButtonStyle"/>
    </LinearLayout>
</LinearLayout>
