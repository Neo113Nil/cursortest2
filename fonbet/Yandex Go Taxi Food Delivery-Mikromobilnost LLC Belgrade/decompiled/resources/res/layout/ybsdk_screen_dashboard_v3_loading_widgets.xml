<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardV3WidgetsSkeleton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/round_button_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="59dp"
            app:layout_constraintEnd_toStartOf="@+id/round_button_2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/ybsdk_screen_dashboard_v3_loading_widgets_button"/>
        <include
            android:id="@+id/round_button_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/round_button_1"
            app:layout_constraintEnd_toStartOf="@+id/round_button_3"
            app:layout_constraintStart_toEndOf="@+id/round_button_1"
            app:layout_constraintTop_toTopOf="@+id/round_button_1"
            layout="@layout/ybsdk_screen_dashboard_v3_loading_widgets_button"/>
        <include
            android:id="@+id/round_button_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="59dp"
            app:layout_constraintBottom_toBottomOf="@+id/round_button_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/round_button_2"
            app:layout_constraintTop_toTopOf="@+id/round_button_1"
            layout="@layout/ybsdk_screen_dashboard_v3_loading_widgets_button"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/round_button_1"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/cards_title"
            android:layout_width="151dp"
            android:layout_height="20dp"
            android:layout_marginTop="34dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/banner"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/card_1"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/card_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cards_title"
            app:ybsdk_cornerRadius="20dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/card_2"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintBottom_toBottomOf="@+id/card_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/card_1"
            app:layout_constraintTop_toTopOf="@+id/card_1"
            app:ybsdk_cornerRadius="20dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/recent_transactions_title"
            android:layout_width="151dp"
            android:layout_height="20dp"
            android:layout_marginTop="34dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_1"
            app:ybsdk_cornerRadius="6dp"/>
        <include
            android:id="@+id/trans_item_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recent_transactions_title"
            layout="@layout/ybsdk_screen_dashboard_v3_loading_widgets_recent_transaction"/>
        <include
            android:id="@+id/trans_item_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trans_item_1"
            layout="@layout/ybsdk_screen_dashboard_v3_loading_widgets_recent_transaction"/>
        <include
            android:id="@+id/trans_item_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trans_item_2"
            layout="@layout/ybsdk_screen_dashboard_v3_loading_widgets_recent_transaction"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/autotopup_title"
            android:layout_width="167dp"
            android:layout_height="20dp"
            android:layout_marginTop="42dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trans_item_3"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/autotopup"
            android:layout_width="match_parent"
            android:layout_height="203dp"
            android:layout_marginTop="18dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/autotopup_title"
            app:ybsdk_cornerRadius="24dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
