<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ybsdk_settings_item_top_margin"
    android:layout_marginBottom="@dimen/ybsdk_settings_item_bottom_margin">
    <TextView
        android:textColor="?attr/ybColor_textIcon_tertiary"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ybsdk_transfer_settings_item_title_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/soonBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Title1"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_tertiary"
        android:id="@+id/soonBadge"
        android:background="@drawable/ybsdk_soon_badge_background"
        android:paddingTop="5dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_settings_soon_badge"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Title1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
