<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/ybColor_background_secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbarSkeleton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        android:paddingStart="@dimen/ybsdk_screen_horizontal_space"
        android:paddingEnd="@dimen/ybsdk_screen_horizontal_space">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/skeletonLogo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ybsdk_toolbar_icon_size_small"
            android:contentDescription="@null"
            android:alpha="0.7"
            app:srcCompat="@drawable/ybsdk_ic_pay_logo"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ybsdk_toolbar_view_margin_between_icons">
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_gravity="right"
                android:layout_width="70dp"
                android:layout_height="14dp"
                app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"
                app:ybsdk_cornerRadius="40dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_gravity="right"
                android:layout_width="57dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"
                app:ybsdk_cornerRadius="40dp"/>
        </LinearLayout>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/ybsdk_toolbar_icon_size_small"
            android:layout_height="@dimen/ybsdk_toolbar_icon_size_small"
            android:shape="oval"
            android:layout_marginStart="8dp"
            app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/productsSkeleton"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"
        app:ybsdk_cornerRadius="26dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recyclerSkeleton"
        android:background="@drawable/ybsdk_bg_products_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="32dp">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/ybNotificationsSkeleton"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="26dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/ybOffersSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@+id/ybNotificationsSkeleton">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:ybsdk_cornerRadius="16dp"/>
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="64dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    app:ybsdk_cornerRadius="24dp"/>
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="36dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    app:ybsdk_cornerRadius="24dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:ybsdk_cornerRadius="16dp"/>
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="64dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    app:ybsdk_cornerRadius="24dp"/>
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="36dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    app:ybsdk_cornerRadius="24dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:ybsdk_cornerRadius="16dp"/>
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="64dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    app:ybsdk_cornerRadius="24dp"/>
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="36dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    app:ybsdk_cornerRadius="24dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <include
            android:id="@+id/skeletonNonPaymentProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ybOffersSkeleton"
            layout="@layout/ybsdk_item_skeleton_non_payment_products"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonMerchantsWidgetTitle"
            android:layout_width="167dp"
            android:layout_height="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonNonPaymentProducts"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonMerchantsWidgetOffer1"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonMerchantsWidgetTitle"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonMerchantsWidgetOffer2"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginStart="18dp"
            app:layout_constraintStart_toEndOf="@+id/skeletonMerchantsWidgetOffer1"
            app:layout_constraintTop_toTopOf="@+id/skeletonMerchantsWidgetOffer1"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonMerchantsWidgetOffer3"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginStart="18dp"
            app:layout_constraintStart_toEndOf="@+id/skeletonMerchantsWidgetOffer2"
            app:layout_constraintTop_toTopOf="@+id/skeletonMerchantsWidgetOffer2"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonMerchantsWidgetOffer4"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginStart="18dp"
            app:layout_constraintStart_toEndOf="@+id/skeletonMerchantsWidgetOffer3"
            app:layout_constraintTop_toTopOf="@+id/skeletonMerchantsWidgetOffer3"
            app:ybsdk_cornerRadius="24dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
