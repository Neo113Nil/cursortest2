<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.bottombar.BottomBarNavigation
        android:id="@+id/pfmTransactionsBottomBar"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout
        android:id="@+id/pfmSwipeRefresh"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/pfmTransactionsBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/pfmContentContainer"
            android:background="?attr/ybColor_background_secondary"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/pfmAppBarLayout"
                android:background="?attr/ybColor_internal_transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <com.ybsdk.feature.pfm.internal.ui.widgets.PfmFunFactView
                    android:id="@+id/pfmFunFact"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll"/>
                <com.ybsdk.feature.pfm.internal.ui.widgets.PfmFiltersView
                    android:orientation="horizontal"
                    android:id="@+id/pfmFiltersRecyclerView"
                    android:background="@drawable/ybsdk_pfm_header_background_top_corners"
                    android:paddingBottom="@dimen/ybsdk_pfm_filters_padding_bottom"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/ybsdk_pfm_padding_horizontal_header_recyclers_common"/>
                <FrameLayout
                    android:id="@+id/pfmCategoriesWrapper"
                    android:background="@drawable/ybsdk_pfm_header_background_bottom_corners"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.ybsdk.feature.pfm.internal.ui.widgets.PfmCategoriesView
                        android:layout_gravity="top"
                        android:id="@+id/pfmCategoriesRecyclerView"
                        android:paddingBottom="@dimen/ybsdk_pfm_header_padding_bottom"
                        android:visibility="gone"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/ybsdk_pfm_padding_horizontal_header_recyclers_common"/>
                    <com.ybsdk.feature.pfm.internal.ui.widgets.PfmExpandedCategoryHeaderView
                        android:layout_gravity="top"
                        android:id="@+id/pfmExpandedCategoryHeader"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ybsdk_pfm_second_content_container_margin"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pfmFeedViewItems"
                    android:background="@drawable/ybsdk_pfm_header_background_top_corners"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/ybsdk_pfm_margin_top_transactions_feed"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/pfmExpandedCategoriesAppBarLayout"
                    android:background="@drawable/ybsdk_pfm_header_background_bottom_corners"
                    android:paddingTop="@dimen/ybsdk_pfm_second_app_bar_margin"
                    android:visibility="invisible"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:elevation="0dp">
                    <FrameLayout
                        android:id="@+id/pfmExpandedCategoriesWrapper"
                        android:visibility="gone"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_scrollFlags="enterAlways|scroll">
                        <com.ybsdk.feature.pfm.internal.ui.widgets.PfmCategoriesView
                            android:id="@+id/pfmExpandedCategoriesRecyclerView"
                            android:paddingBottom="@dimen/ybsdk_pfm_header_padding_bottom"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/ybsdk_pfm_padding_horizontal_header_recyclers_common"/>
                    </FrameLayout>
                </com.google.android.material.appbar.AppBarLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/pfmError"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/pfmTransactionsBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
