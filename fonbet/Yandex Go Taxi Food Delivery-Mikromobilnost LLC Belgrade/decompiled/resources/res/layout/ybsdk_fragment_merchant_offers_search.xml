<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/merchantOffersSearchQueryInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toStartOf="@+id/merchantOffersSearchCancelButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatEditText
            android:textColorHint="?attr/ybColor_textIcon_secondary"
            android:ellipsize="end"
            android:id="@+id/merchantOffersSearchQueryInput"
            android:background="@drawable/ybsdk_search_edit_text_background"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/ybsdk_merchant_offers_merchant_search_bar_text_placeholder"
            android:maxLines="1"
            android:drawablePadding="4dp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:drawableStart="@drawable/ybsdk_search_logo_foreground"
            android:paddingStart="12dp"
            android:paddingEnd="32dp"
            android:importantForAutofill="no"
            style="@style/Widget.YB.Text.Body3"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/merchantOffersSearchClearButton"
            android:background="@drawable/ybsdk_action_close_filled"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ybsdk_merchant_offers_accessibility_search_clear_button"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <TextView
        android:id="@+id/merchantOffersSearchCancelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_merchant_offers_merchant_search_bar_cancel_button"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/merchantOffersSearchQueryInputLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/merchantOffersSearchQueryInputLayout"
        app:layout_constraintTop_toTopOf="@+id/merchantOffersSearchQueryInputLayout"
        style="@style/Widget.YB.Text.Title2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/merchantOffersSearchResultRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/merchantOffersSearchQueryInputLayout"/>
    <com.ybsdk.feature.divkit.api.ui.skeletons.DivSkeletonsView
        android:id="@+id/merchantOffersSearchDivkitShimmerView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/merchantOffersSearchQueryInputLayout"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/merchantOffersSearchErrorView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
