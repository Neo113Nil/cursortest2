<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/firstPageShimmer"
        android:background="@drawable/ybsdk_vertical_stories_shimmer_top_card_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:ybsdk_shimmer_color_attr="?attr/ybColor_fill_default_300">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/backButton"
                android:padding="8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scaleType="center"
                android:contentDescription="@string/ybsdk_common_accessability_back_title"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ybsdk_ic_arrow_short_back"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/shimmerItem1"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/backButton"
                app:layout_constraintWidth_max="218dp"
                app:ybsdk_backgroundColor="?attr/ybColor_fill_default_300"
                app:ybsdk_cornerRadius="8dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/shimmerItem2"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shimmerItem1"
                app:layout_constraintWidth_max="273dp"
                app:ybsdk_backgroundColor="?attr/ybColor_fill_default_300"
                app:ybsdk_cornerRadius="6dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/shimmerItem3"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shimmerItem2"
                app:layout_constraintWidth_max="164dp"
                app:ybsdk_backgroundColor="?attr/ybColor_fill_default_300"
                app:ybsdk_cornerRadius="6dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/skeletonItemButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginBottom="42dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:ybsdk_backgroundColor="?attr/ybColor_fill_default_300"
                app:ybsdk_cornerRadius="16dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <View
        android:id="@+id/secondPageShimmer"
        android:background="@drawable/ybsdk_vertical_stories_shimmer_bottom_card_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_next_story_preview_height"
        android:layout_marginTop="8dp"/>
</LinearLayout>
