<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="12dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/iv_background_ripple"
        android:background="@drawable/bg_ai_bubble_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"
        android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="?attr/bgMinor"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_spacer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_title_image"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/iv_title_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="24dp"
        android:minHeight="24dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_title_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_title_image"
        app:layout_constraintTop_toTopOf="@+id/iv_title_image"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/iv_chevron_image"
        android:background="@drawable/float_circle_button"
        android:clickable="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="8dp"
        android:scaleType="centerInside"
        android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:backgroundTint="?attr/bgFloating"
        app:layout_constraintBottom_toBottomOf="@+id/iv_background_ripple"
        app:layout_constraintEnd_toEndOf="@+id/iv_background_ripple"
        app:srcCompat="@drawable/ic_chevron"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_content_text"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:importantForAccessibility="yes"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_chevron_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_background_ripple"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_buttons"
        android:background="@drawable/bg_ai_bubble_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content_text"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/iv_end_buttons_gradient"
        android:clickable="false"
        android:layout_width="28dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
        android:importantForAccessibility="no"
        android:backgroundTint="?attr/bgFloating"
        app:layout_constraintBottom_toBottomOf="@+id/rv_buttons"
        app:layout_constraintEnd_toEndOf="@+id/iv_background_ripple"
        app:layout_constraintTop_toTopOf="@+id/rv_buttons"
        app:srcCompat="@drawable/ai_bubble_end_gradient"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/iv_start_buttons_gradient"
        android:clickable="false"
        android:layout_width="28dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
        android:importantForAccessibility="no"
        android:backgroundTint="?attr/bgFloating"
        app:layout_constraintBottom_toBottomOf="@+id/rv_buttons"
        app:layout_constraintStart_toStartOf="@+id/iv_background_ripple"
        app:layout_constraintTop_toTopOf="@+id/rv_buttons"
        app:srcCompat="@drawable/ai_bubble_start_gradient"/>
    <Space
        android:id="@+id/bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_buttons"/>
</merge>
