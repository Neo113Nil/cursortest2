<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.widget.accessibility.AccessibilityButtonLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RequirementItemContainer">
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/RequirementItemTitle"/>
    <ImageView
        android:id="@+id/check_mark"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_due_variant_check"
        app:tint="?attr/textMain"/>
</ru.yandex.taxi.widget.accessibility.AccessibilityButtonLinearLayout>
