<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/delivery_point_content"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMinor"
        android:id="@+id/delivery_point_title"
        android:background="@drawable/logistics_point_title_background"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DeliveryUnitedPointTitle"/>
    <FrameLayout
        android:id="@+id/contact_group"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:importantForAccessibility="yes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delivery_point_title"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/call_icon"
        android:padding="21dp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_logistics_contact_phone"
        app:layout_constraintStart_toStartOf="@+id/contact_group"
        app:layout_constraintTop_toTopOf="@+id/contact_group"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMinor"
        android:id="@+id/delivery_phone_subtitle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/delivery_phone_select"
        app:layout_constraintStart_toEndOf="@+id/call_icon"
        app:layout_constraintTop_toTopOf="@+id/contact_group"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="?attr/textMain"
        android:id="@+id/delivery_phone_select"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/contact_group"
        app:layout_constraintEnd_toEndOf="@+id/contact_group"
        app:layout_constraintStart_toEndOf="@+id/call_icon"
        app:layout_constraintTop_toBottomOf="@+id/delivery_phone_subtitle_text"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:src="@drawable/chevron_next"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/contact_group"
        app:layout_constraintEnd_toEndOf="@+id/contact_group"
        app:layout_constraintTop_toTopOf="@+id/contact_group"/>
    <View
        android:background="?attr/line"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/contact_group"
        app:layout_constraintEnd_toEndOf="@+id/contact_group"
        app:layout_constraintStart_toStartOf="@+id/contact_group"/>
    <ru.yandex.taxi.design.bubble.BubbleTextComponent
        android:id="@+id/delivery_contact_autofill_bubble"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationZ="1dp"
        app:bubble_component_text="@string/delivery_contact_autofill_bubble_text"
        app:layout_constraintBottom_toBottomOf="@+id/delivery_phone_subtitle_text"
        app:layout_constraintStart_toEndOf="@+id/delivery_phone_subtitle_text"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_point_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_divider_type="none"
        app:component_lead_image="@drawable/ic_summary_destination_point"
        app:component_no_background="true"
        app:component_title_max_lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contact_group"/>
</androidx.constraintlayout.widget.ConstraintLayout>
