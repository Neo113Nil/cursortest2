<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:importantForAccessibility="no"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <ru.yandex.taxi.stories.presentation.preview.StoryPreviewView
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cornerRadius="8dp"
        app:layout_constraintDimensionRatio="16:10"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/story_preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <View
            android:id="@+id/story_preview_placeholder"
            android:background="@color/taxi_communications_story_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/story_preview_text_stub"
            android:layout="@layout/taxi_communications_story_landscape_preview_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/story_preview_repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/taxi_communications_stories_ic_repeat"/>
    </ru.yandex.taxi.stories.presentation.preview.StoryPreviewView>
</androidx.constraintlayout.widget.ConstraintLayout>
