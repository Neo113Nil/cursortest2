<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/tariff_page_order_button_container"
    android:background="?attr/bgFloating"
    android:paddingTop="@dimen/go_design_s_space"
    android:paddingBottom="@dimen/go_design_m_space"
    android:focusable="false"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.yandex.go.payments.design.composite.CompositePaymentIconsView
        android:id="@+id/tariff_page_payment_icon"
        android:background="@drawable/bg_transparent_ripple"
        android:layout_width="72dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleVisible="true"/>
    <ru.yandex.taxi.design.button.OrderButtonComponent
        android:id="@+id/tariff_page_order_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tariff_page_close_icon"
        app:layout_constraintStart_toEndOf="@+id/tariff_page_payment_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp"
        app:layout_goneMarginStart="8dp"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center"
        android:id="@+id/tariff_page_close_icon"
        android:background="@drawable/bg_transparent_ripple"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_chevron_down"
        android:scaleType="center"
        android:contentDescription="@string/summary_order_button_collapse_content_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
