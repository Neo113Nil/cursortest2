<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="112dp"
    android:layout_height="112dp">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/scooters_photo"
        android:layout_marginEnd="6dp"/>
    <com.yandex.go.design.view.GoImageButton
        android:layout_gravity="end|top"
        android:id="@+id/remove"
        android:background="@null"
        android:visibility="invisible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/list_cross_close"
        android:contentDescription="@string/scooters_remove"/>
</com.yandex.go.design.view.GoFrameLayout>
