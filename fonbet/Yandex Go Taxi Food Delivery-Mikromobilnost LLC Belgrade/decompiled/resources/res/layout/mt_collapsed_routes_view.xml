<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.address.design.SourceDestinationComponent
        android:id="@+id/addresses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/verticals_stub"
        android:paddingTop="@dimen/go_design_s_space"
        android:paddingBottom="@dimen/go_design_s_space"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/go_design_m_space"
        android:paddingEnd="@dimen/go_design_m_space"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tariffPager"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include
        android:id="@+id/error_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        layout="@layout/mt_routes_error_view"/>
    <FrameLayout
        android:id="@+id/walking_duration_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textColor="?attr/textMinor"
            android:gravity="center"
            android:id="@+id/walking_duration"
            android:paddingTop="@dimen/go_design_s_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/go_design_m_space"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/walking_duration_placeholder"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="56dp"
            android:layout_marginVertical="12dp"
            app:placeholder_corner_radius="16dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
    </FrameLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_container_with_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mt_summary_order_button_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f081870"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:translationZ="1dp"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottom_container"
            android:background="?attr/bgFloating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yandex.go.design.view.GoLinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yandex.go.design.view.GoConstraintLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/transport_card_placeholder"
                    android:paddingTop="18dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="18dp"
                    android:paddingEnd="6dp">
                    <ru.yandex.taxi.widget.PlaceholderView
                        android:id="@+id/transport_card_image_placeholder"
                        android:padding="6dp"
                        android:layout_width="36dp"
                        android:layout_height="24dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:placeholder_corner_radius="4dp"
                        app:placeholder_type="rectangle"/>
                    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
                        android:textSize="13sp"
                        android:textColor="?attr/textMain"
                        android:id="@+id/transport_card_text_placeholder"
                        android:paddingTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/ys_text_medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/transport_card_image_placeholder"/>
                </com.yandex.go.design.view.GoConstraintLayout>
                <com.yandex.go.design.view.GoConstraintLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/transport_card_layout"
                    android:paddingTop="10dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp">
                    <com.yandex.go.design.view.GoImageButton
                        android:id="@+id/transport_card_image"
                        android:background="@null"
                        android:padding="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <com.yandex.go.design.view.GoImageButton
                        android:id="@+id/transport_card_status_image"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="13sp"
                        android:textColor="?attr/textMain"
                        android:id="@+id/transport_card_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ys_text_medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/transport_card_image"/>
                </com.yandex.go.design.view.GoConstraintLayout>
                <ru.yandex.taxi.design.ButtonComponent
                    android:textSize="@dimen/component_text_size_body"
                    android:id="@+id/button"
                    android:background="?attr/bgFloating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_marginBottom="@dimen/go_design_s_space"
                    android:text="@string/mt_routes_button_show_route"
                    app:component_background_color="?attr/controlMain"
                    app:component_button_disabled_alpha="0.5"
                    app:component_button_size="L"
                    app:component_title_color="?attr/textOnControl"
                    app:robotoFontStyle="medium"/>
            </com.yandex.go.design.view.GoLinearLayout>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
