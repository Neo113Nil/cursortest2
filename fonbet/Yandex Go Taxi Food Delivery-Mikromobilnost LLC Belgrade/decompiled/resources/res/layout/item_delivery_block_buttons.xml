<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.design.AutoDividerComponentList xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/delivery_control_block_container"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:component_middle_divider_type="margin">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_add_address_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:component_trail_mode="none"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_change_order_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:component_trail_mode="none"/>
</ru.yandex.taxi.design.AutoDividerComponentList>
