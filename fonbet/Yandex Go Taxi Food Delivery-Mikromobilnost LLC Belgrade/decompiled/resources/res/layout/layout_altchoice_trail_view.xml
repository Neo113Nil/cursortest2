<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="56dp">
    <LinearLayout
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textColor="?attr/textMain"
            android:id="@+id/trail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="?attr/textMinor"
            android:ellipsize="end"
            android:id="@+id/trail_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/trail_image"
        android:layout_width="56dp"
        android:layout_height="32dp"
        android:scaleType="centerInside"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <ru.yandex.taxi.design.CheckBoxComponent
        android:layout_gravity="center_vertical"
        android:id="@+id/trail_checkbox"
        android:layout_width="@dimen/component_image_holder_size"
        android:layout_height="@dimen/component_image_holder_size"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/trail_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/chevron_next"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"/>
</merge>
