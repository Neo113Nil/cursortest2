<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes">
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:component_title_size="24sp"
            app:component_title_typeface="bold"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_body"
            android:id="@+id/back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/common_back"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            app:component_background_color="?attr/controlMinor"
            app:component_button_size="M"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_body"
            android:id="@+id/next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/common_next"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            app:component_background_color="?attr/controlMain"
            app:component_button_size="M"
            app:component_title_color="?attr/textOnControl"/>
    </LinearLayout>
</LinearLayout>
