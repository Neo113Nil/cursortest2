<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/title"
            android:layout_width="157dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="4dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="30dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/frequency1"
            android:layout_width="127dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/source"
            app:ybsdk_cornerRadius="@dimen/ybsdk_auto_topup_regular_frequency_corners_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/frequency2"
            android:layout_width="118dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/frequency1"
            app:layout_constraintTop_toBottomOf="@+id/source"
            app:ybsdk_cornerRadius="@dimen/ybsdk_auto_topup_regular_frequency_corners_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/frequency3"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/frequency2"
            app:layout_constraintTop_toBottomOf="@+id/source"
            app:ybsdk_cornerRadius="@dimen/ybsdk_auto_topup_regular_frequency_corners_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/triviaLink"
            android:layout_width="127dp"
            android:layout_height="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frequency1"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:ybsdk_cornerRadius="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
