<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_coins_circle"
        android:importantForAccessibility="no"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textStyle="bold"
        android:textColor="?attr/textMain"
        android:id="@+id/title_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/description_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/ok_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        android:layout_marginVertical="@dimen/go_design_m_space"
        app:component_rounded_background="?attr/controlMain"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="16sp"
        app:component_title_text_color="?attr/textOnControl"
        app:component_title_typeface="medium"/>
</LinearLayout>
