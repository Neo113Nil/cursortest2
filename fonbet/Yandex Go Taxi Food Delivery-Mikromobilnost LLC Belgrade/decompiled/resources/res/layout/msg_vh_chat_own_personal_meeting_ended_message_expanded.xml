<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:id="@+id/personal_meeting_message_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingVertical="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/personal_meeting_message_failed_call"
            app:layout_constraintEnd_toStartOf="@+id/personal_meeting_message_title"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_failed_call"
            style="@style/Messaging.MeetingMessageIconStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/personal_meeting_message_successful_call"
            app:layout_constraintEnd_toStartOf="@+id/personal_meeting_message_title"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_successful_outgoing"
            style="@style/Messaging.MeetingMessageIconStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/personal_meeting_message_failed_video_call"
            android:visibility="invisible"
            app:layout_constraintEnd_toStartOf="@+id/personal_meeting_message_title"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_failed_call_video"
            style="@style/Messaging.MeetingMessageIconStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/personal_meeting_message_successful_video_call"
            android:visibility="invisible"
            app:layout_constraintEnd_toStartOf="@+id/personal_meeting_message_title"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_successful_outgoing_video"
            style="@style/Messaging.MeetingMessageIconStyle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/personal_meeting_message_title"
            app:layout_constraintStart_toEndOf="@+id/personal_meeting_message_successful_call"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Messaging.MeetingMessageTitleStyle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="?attr/messagingOutgoingSecondaryColor"
            android:id="@+id/personal_meeting_message_call_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_text_regular"
            app:layout_constraintStart_toStartOf="@+id/personal_meeting_message_title"
            app:layout_constraintTop_toBottomOf="@+id/personal_meeting_message_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="?attr/messagingOutgoingLinkColor"
            android:id="@+id/personal_meeting_rate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/meeting_rate_button_text"
            android:fontFamily="@font/ys_text_regular"
            app:layout_constraintStart_toStartOf="@+id/personal_meeting_message_call_details"
            app:layout_constraintTop_toBottomOf="@+id/personal_meeting_message_call_details"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
