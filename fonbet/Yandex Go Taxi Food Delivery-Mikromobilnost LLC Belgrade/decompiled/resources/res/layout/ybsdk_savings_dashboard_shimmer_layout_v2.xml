<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/skeleton1"
        android:layout_width="80dp"
        android:layout_height="20dp"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_cornerRadius="8dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/skeleton2"
        android:layout_width="186dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeleton1"
        app:ybsdk_cornerRadius="16dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/skeleton3"
        android:layout_width="120dp"
        android:layout_height="20dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeleton2"
        app:ybsdk_cornerRadius="8dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/skeleton4"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_savings_account_cell_height"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/skeleton5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeleton3"
        app:ybsdk_cornerRadius="24dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/skeleton5"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_savings_account_cell_height"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/skeleton4"
        app:layout_constraintTop_toTopOf="@+id/skeleton4"
        app:ybsdk_cornerRadius="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
