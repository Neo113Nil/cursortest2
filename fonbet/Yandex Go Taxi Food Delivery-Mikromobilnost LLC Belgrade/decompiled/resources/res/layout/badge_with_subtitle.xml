<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoView
        android:id="@+id/lead"
        android:layout_width="56dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:id="@+id/badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_text_medium"
            android:textDirection="locale"
            android:paddingVertical="@dimen/component_dots_indicator_small_item_size"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="?attr/textMinor"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_text_medium"
            android:textDirection="locale"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/go_design_m_space"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoLinearLayout>
