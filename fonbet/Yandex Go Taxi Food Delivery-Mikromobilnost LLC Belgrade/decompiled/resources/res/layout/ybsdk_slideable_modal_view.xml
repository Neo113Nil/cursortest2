<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:importantForAccessibility="no">
    <com.ybsdk.core.design.widget.SlidableCoordinatorLayout
        android:id="@+id/ybsdk_slideable_modal_view_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">
        <FrameLayout
            android:id="@+id/ybsdk_slideable_background_click_receiver"
            android:background="@color/yb_light_internal_transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/ybsdk_slideable_modal_view_bottom_sheet_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_anchorGravity="bottom"/>
        <FrameLayout
            android:id="@+id/ybsdk_slideable_modal_view_bottom_sheet"
            android:background="@drawable/ybsdk_bg_round_modal_view"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_behavior="com.ybsdk.core.design.coordinator.AnchorBottomSheetBehavior">
            <FrameLayout
                android:id="@+id/ybsdk_slideable_modal_view_card_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </com.ybsdk.core.design.widget.SlidableCoordinatorLayout>
</merge>
