<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/sharing_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        style="@style/ReferralScreenToolbar"/>
    <ru.yandex.taxi.design.LoadingComponent
        android:id="@+id/loading_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/share_view_pic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:layout_weight="1"/>
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/instruction_items_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/copy_promocode"
        android:background="@drawable/bg_copy_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:component_subtitle_above_title="true"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title_typeface="medium"
        app:component_trail_companion_text_color="?attr/textMain"
        app:component_vertical_padding="0dp"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/share_promocode"
        android:background="@drawable/bg_share_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_text_color="?attr/textOnControl"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/textOnControl"
        app:component_title_typeface="medium"
        app:component_vertical_padding="0dp"/>
</LinearLayout>
