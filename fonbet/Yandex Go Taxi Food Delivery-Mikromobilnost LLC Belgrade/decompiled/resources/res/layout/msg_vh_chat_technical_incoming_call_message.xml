<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/incoming_call_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/border"
            android:background="@drawable/msg_bg_call_message_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="?attr/messagingIncomingButtonColor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/failed_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/border"
            app:layout_constraintEnd_toEndOf="@+id/border"
            app:layout_constraintStart_toStartOf="@+id/border"
            app:layout_constraintTop_toTopOf="@+id/border"
            app:srcCompat="@drawable/msg_ic_incoming"
            app:tint="?attr/messagingCommonDestructiveIconsColor"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/successful_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/border"
            app:layout_constraintEnd_toEndOf="@+id/border"
            app:layout_constraintStart_toStartOf="@+id/border"
            app:layout_constraintTop_toTopOf="@+id/border"
            app:srcCompat="@drawable/msg_ic_incoming"
            app:tint="?attr/messagingIncomingSecondaryColor"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/timeline_message_text_size"
            android:textColor="?attr/messagingIncomingPrimaryColor"
            android:id="@+id/incoming_call_writing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/incoming_call_text_bubble"
            android:paddingEnd="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/border"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/timeline_message_text_size"
            android:textColor="?attr/messagingIncomingSecondaryColor"
            android:id="@+id/additional_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/incoming_call_writing"
            app:layout_constraintTop_toBottomOf="@+id/incoming_call_writing"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/timeline_message_time_font_size"
            android:textColor="?attr/messagingIncomingSecondaryColor"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:25"
            android:paddingEnd="12dp"
            android:layout_marginStart="@dimen/timeline_text_status_and_time_padding"
            app:layout_constraintBottom_toBottomOf="@+id/additional_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/additional_info"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
