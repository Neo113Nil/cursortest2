<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/chat_create_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/chat_create_info_toolbar_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:background="?attr/messagingCommonBackgroundColor"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/border"
                android:background="?attr/messagingCommonDividerColor"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/chat_create_input_avatar"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/msg_chat_create_avatar_content_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/msg_ic_empty_profile"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/messagingCommonAccentTextColor"
                android:id="@+id/chat_create_input_avatar_upload_tv"
                android:paddingTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_avatar"
                android:fontFamily="@font/ya_medium"
                app:layout_constraintEnd_toEndOf="@+id/chat_create_input_avatar"
                app:layout_constraintStart_toStartOf="@+id/chat_create_input_avatar"
                app:layout_constraintTop_toBottomOf="@+id/chat_create_input_avatar"/>
            <EditText
                android:id="@+id/chat_create_input_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:maxWidth="480dp"
                android:hint="@string/chat_create_hint_necessary_name"
                android:maxLines="2"
                android:nextFocusForward="@+id/chat_create_input_description"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chat_create_input_avatar_upload_tv"
                app:layout_constraintVertical_bias="0"
                style="@style/Messaging.EditText"/>
            <EditText
                android:id="@+id/chat_create_input_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="24dp"
                android:hint="@string/chat_create_hint_description"
                android:inputType="textMultiLine"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chat_create_input_name"
                app:layout_constraintVertical_bias="0"
                style="@style/Messaging.EditText"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/chat_create_public_channel_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="chat_create_public_channel_subtitle,chat_create_public_channel_switch,chat_create_public_channel_info"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/messagingCommonTextPrimaryColor"
                android:id="@+id/chat_create_public_channel_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="36dp"
                android:text="@string/public_channel_subtitle"
                android:fontFamily="@font/ya_regular"
                app:layout_constraintBottom_toTopOf="@+id/chat_create_public_channel_info"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintLeft_toLeftOf="@+id/chat_create_input_description"
                app:layout_constraintRight_toLeftOf="@+id/chat_create_public_channel_switch"
                app:layout_constraintTop_toBottomOf="@+id/chat_create_input_description"/>
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/Messaging.Switch"
                android:id="@+id/chat_create_public_channel_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/chat_create_public_channel_subtitle"
                app:layout_constraintLeft_toRightOf="@+id/chat_create_public_channel_subtitle"
                app:layout_constraintRight_toRightOf="@+id/chat_create_input_description"
                app:layout_constraintTop_toTopOf="@+id/chat_create_public_channel_subtitle"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/messagingCommonTextSecondaryColor"
                android:id="@+id/chat_create_public_channel_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="12dp"
                android:text="@string/public_channel_info"
                android:lineSpacingExtra="1sp"
                android:fontFamily="@font/ya_regular"
                app:layout_constraintLeft_toLeftOf="@+id/chat_create_input_description"
                app:layout_constraintRight_toRightOf="@+id/chat_create_input_description"
                app:layout_constraintTop_toBottomOf="@+id/chat_create_public_channel_subtitle"/>
            <Button
                android:textSize="14sp"
                android:textColor="?attr/messagingCommonAccentFgColor"
                android:id="@+id/chat_create_btn"
                android:background="@drawable/msg_bg_accent_btn"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_margin="24dp"
                android:text="@string/add_participants"
                android:textAllCaps="false"
                android:fontFamily="@font/ya_medium"
                android:elevation="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/chat_create_input_description"
                app:layout_constraintRight_toRightOf="@+id/chat_create_input_description"
                app:layout_constraintTop_toBottomOf="@+id/chat_create_public_channel_info"
                app:layout_constraintVertical_bias="0"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/messagingCommonTextSecondaryColor"
                android:gravity="center"
                android:id="@+id/chat_create_error_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="36dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="24dp"
                android:text="@string/chat_create_name_is_necessary_error"
                android:fontFamily="@font/ya_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/chat_create_input_description"
                app:layout_constraintRight_toRightOf="@+id/chat_create_input_description"
                app:layout_constraintTop_toBottomOf="@+id/chat_create_public_channel_info"
                app:layout_constraintVertical_bias="0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
