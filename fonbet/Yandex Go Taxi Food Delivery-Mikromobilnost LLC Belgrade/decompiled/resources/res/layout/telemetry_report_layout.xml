<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/bgMain"
    android:padding="@dimen/go_design_s_space"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ListTitleComponent
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/list_item_height"
        app:component_divider_position="bottom"
        app:component_divider_type="margin"
        app:component_no_background="true"
        app:component_title="@string/telemetry_report"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/btn_collect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:text="@string/telemetry_report_collect"
        app:component_button_size="L"/>
    <FrameLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space">
        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:layout_gravity="center_vertical"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"/>
    </FrameLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/btn_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:text="@string/telemetry_report_share"
        app:component_button_size="L"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="?attr/textMain"
        android:id="@+id/content_text"
        android:background="@color/component_gray_100"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/go_design_l_space"
        android:layout_marginHorizontal="@dimen/go_design_s_space"/>
</LinearLayout>
