<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:paddingVertical="13dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/copy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toStartOf="@+id/copy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"
        style="@style/Widget.YB.Text.Body1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/copy"
        android:layout_width="@dimen/ybsdk_icon_size"
        android:layout_height="@dimen/ybsdk_icon_size"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_copy_outline"
        app:tint="?attr/ybColor_textIcon_secondary"
        app:tintMode="src_atop"/>
    <View
        android:id="@+id/tooltipGuide"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginEnd="7.5dp"
        app:layout_constraintBottom_toTopOf="@+id/copy"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
