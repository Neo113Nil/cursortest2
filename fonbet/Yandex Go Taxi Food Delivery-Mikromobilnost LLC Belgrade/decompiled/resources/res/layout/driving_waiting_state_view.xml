<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/order_state_scroll_view"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">
        <com.yandex.go.taxi.order.details.v1.elements.upsell.UpsellView
            android:id="@+id/upsell"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:elevation="@dimen/order_screens_card_elevation"
            android:layout_marginHorizontal="@dimen/go_design_s_space"/>
        <FrameLayout
            android:id="@+id/bottom_sheet_card"
            android:background="@drawable/bg_rounded_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/order_screens_card_elevation">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_container"
                android:background="?attr/cardDivider"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/top_container"
                    android:background="?attr/bgMain"
                    android:paddingTop="@dimen/order_state_view_top_padding"
                    android:paddingBottom="@dimen/go_design_s_space"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/order_titles"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/header_divider"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/order_screens_titles_car_info"/>
                    <View
                        android:id="@+id/header_divider"
                        android:background="?attr/line"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="@dimen/go_design_m_space"
                        app:layout_constraintBottom_toTopOf="@+id/promo_plaque_top_section"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/order_titles"/>
                    <com.yandex.go.taxi.order.communications.FramedRecyclerView
                        android:id="@+id/promo_plaque_top_section"
                        android:background="@drawable/rounded_border"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="@dimen/go_design_m_space"
                        android:layout_marginHorizontal="@dimen/go_design_s_space"
                        app:layout_constraintBottom_toTopOf="@+id/driver_section"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/header_divider"/>
                    <com.yandex.go.taxi.order.details.v1.ui.DriverSectionView
                        android:id="@+id/driver_section"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/top_horizontal_buttons"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/promo_plaque_top_section"/>
                    <com.yandex.go.taxi.order.details.v1.ui.DetailsCardHorizontalButtons
                        android:id="@+id/top_horizontal_buttons"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/top_circle_buttons_view"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/driver_section"/>
                    <ru.yandex.taxi.order.view.TopCircleButtonsView
                        android:id="@+id/top_circle_buttons_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/top_horizontal_buttons"/>
                    <View
                        android:id="@+id/anchor_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/top_circle_buttons_view"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/promo_plaque_bottom_section"
                    android:background="@drawable/round_section_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToOutline="true"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <ru.yandex.taxi.combo.ui.TravelCompanionDetailView
                    android:id="@+id/travel_companion_detail_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ru.yandex.taxi.order.view.HorizontalButtonsView
                    android:id="@+id/horizontal_buttons_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/bottom_container"
                    android:background="?attr/bgMain"
                    android:paddingTop="@dimen/go_design_s_space"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.yandex.go.taxi.order.details.v1.ui.DetailsCardHorizontalButtons
                        android:id="@+id/bottom_horizontal_buttons"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <ru.yandex.taxi.order.BottomCircleButtonsView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/bottom_circle_buttons_view"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/go_design_m_space"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
