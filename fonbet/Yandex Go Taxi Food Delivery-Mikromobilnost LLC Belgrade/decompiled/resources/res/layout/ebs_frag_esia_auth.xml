<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ebssdk_col_esia_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/ebs_frag_esia_auth_webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ebs_frag_esia_auth_header"/>
    <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableLinearLayout
        android:orientation="vertical"
        android:id="@+id/ebs_frag_esia_auth_progress_container"
        android:background="@drawable/ebssdk_bg_widget_processing"
        android:padding="@dimen/ebssdk_margin_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/ebssdk_processing_widget_min_width"
        android:minHeight="@dimen/ebssdk_processing_widget_min_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:linearLayoutType="processing">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableProgressBar
                android:layout_gravity="center"
                android:id="@+id/ebs_frag_esia_auth_progress"
                android:layout_width="@dimen/ebssdk_common_icon_size"
                android:layout_height="@dimen/ebssdk_common_icon_size"
                app:progressBarType="processingScreen"/>
            <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableTextView
                android:textAppearance="@style/Ebssdk.Text.Weight400"
                android:textSize="@dimen/ebssdk_text_14"
                android:gravity="center_horizontal"
                android:id="@+id/ebs_frag_esia_auth_progress_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ebssdk_margin_10"
                app:textViewType="processing"/>
        </LinearLayout>
    </ru.rt.ebs.cryptosdk.presentation.customView.CustomizableLinearLayout>
    <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableHeader
        android:id="@+id/ebs_frag_esia_auth_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:headerType="defaultType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
