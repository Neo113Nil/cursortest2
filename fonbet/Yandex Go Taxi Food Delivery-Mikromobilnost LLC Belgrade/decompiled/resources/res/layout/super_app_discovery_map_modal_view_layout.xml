<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:id="@+id/back_button"
        android:layout_marginTop="@dimen/component_float_button_icon_shadow_compensation"
        android:layout_marginStart="@dimen/component_float_button_icon_shadow_compensation"
        app:component_circle_image="@drawable/ic_arrow_back_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FloatButtonIconStyle"/>
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:id="@+id/search_button"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="@dimen/component_float_button_icon_shadow_compensation"
        app:component_circle_image="@drawable/ic_search_24dp"
        app:layout_constraintBottom_toBottomOf="@+id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/FloatButtonIconStyle"/>
    <com.yandex.go.superapp.discovery.map.impl.ui.main.explorer.ExplorerOutlineRobotoTextView
        android:textSize="28sp"
        android:textColor="?attr/textMain"
        android:gravity="center"
        android:id="@+id/district_name_text"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textAlignment="center"
        android:lineHeight="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/back_button"
        app:layout_constraintEnd_toStartOf="@+id/search_button"
        app:layout_constraintStart_toEndOf="@+id/back_button"
        app:layout_constraintTop_toTopOf="@+id/back_button"/>
    <com.yandex.go.superapp.discovery.map.impl.ui.main.explorer.ExplorerDistrictCoverageProgressView
        android:id="@+id/district_coverage_progress_view"
        android:visibility="invisible"
        android:layout_width="224dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/district_name_text"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/center_horizontal_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:id="@+id/plus_button"
        android:layout_marginBottom="@dimen/component_float_button_icon_shadow_compensation"
        android:layout_marginEnd="@dimen/component_float_button_icon_shadow_compensation"
        app:component_circle_image="@drawable/ic_superapp_discovery_map_plus_24"
        app:layout_constraintBottom_toTopOf="@+id/center_horizontal_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/FloatButtonIconStyle"/>
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:id="@+id/minus_button"
        android:layout_marginTop="@dimen/component_float_button_icon_shadow_compensation"
        android:layout_marginEnd="@dimen/component_float_button_icon_shadow_compensation"
        app:component_circle_image="@drawable/ic_minus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_horizontal_guideline"
        style="@style/FloatButtonIconStyle"/>
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:id="@+id/compass_button"
        android:visibility="gone"
        android:layout_marginEnd="-32dp"
        app:component_circle_image="@drawable/ic_super_app_discovery_map_compass"
        app:layout_constraintBottom_toBottomOf="@+id/location_focusing_button"
        app:layout_constraintEnd_toStartOf="@+id/location_focusing_button"
        style="@style/FloatButtonIconStyle"/>
    <ru.yandex.taxi.design.FloatButtonIconComponent
        android:id="@+id/location_focusing_button"
        android:layout_marginEnd="@dimen/component_float_button_icon_shadow_compensation"
        app:component_circle_image="@drawable/ic_location_fill_24"
        app:layout_constraintBottom_toTopOf="@+id/map_category_filters"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/FloatButtonIconStyle"/>
    <com.yandex.go.superapp.discovery.map.impl.ui.main.explorer.ExplorerButtonView
        android:id="@+id/explorer_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/map_category_filters"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/map_category_filters"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/searchbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/searchbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
