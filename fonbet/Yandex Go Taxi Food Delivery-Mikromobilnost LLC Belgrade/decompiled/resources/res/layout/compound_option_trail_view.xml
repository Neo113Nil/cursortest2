<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.design.BadgeView
        android:layout_gravity="center_vertical"
        android:id="@+id/badge_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="10dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/option_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:srcCompat="@drawable/chevron_next"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/option_remove"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:contentDescription="@string/common_remove"
        android:paddingStart="13dp"
        android:paddingEnd="@dimen/go_design_m_space"
        app:srcCompat="@drawable/ic_cross_14dp"/>
</merge>
