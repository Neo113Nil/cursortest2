<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/titles_holder"
    android:tag="@string/bottom_sheet_peek_tag"
    android:paddingTop="12dp"
    android:paddingBottom="18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/order_screens_card_title_offset">
    <ru.yandex.taxi.widget.accessibility.AccessibilityLiveRegionTextView
        android:textSize="20sp"
        android:id="@+id/order_screens_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="pnum, lnum"
        style="@style/OrderScreensTitle"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="14sp"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:id="@+id/order_screens_subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:fontFeatureSettings="pnum, lnum"
        style="@style/OrderScreensSubtitle"/>
    <ViewStub
        android:gravity="center"
        android:id="@+id/car_description_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
