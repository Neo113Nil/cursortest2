<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/direction_selection_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/direction_bus_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="?attr/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="16dp"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textColor="?attr/textMain"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="11.5dp"
            android:paddingHorizontal="16dp"
            app:robotoFontStyle="bold"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/first_direction"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_trail_mode="navigation"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/second_direction"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_trail_mode="navigation"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
