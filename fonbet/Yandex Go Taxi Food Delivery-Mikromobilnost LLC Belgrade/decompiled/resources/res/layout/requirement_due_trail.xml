<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/option_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/chevron_next"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/go_design_m_space"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/option_remove"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_cross_14dp"
        android:contentDescription="@string/common_remove"
        android:paddingStart="13dp"
        android:paddingEnd="@dimen/go_design_m_space"/>
</merge>
