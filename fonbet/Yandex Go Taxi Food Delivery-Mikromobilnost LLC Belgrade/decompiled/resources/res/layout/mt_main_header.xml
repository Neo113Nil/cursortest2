<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:layoutDirection="locale">
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/header_gradient"
        android:background="@drawable/bg_header_linear_gradient"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:importantForAccessibility="no"
        android:layoutDirection="locale"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layoutDirection="locale"
        android:layout_marginStart="@dimen/mt_main_header_left_padding"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/icon"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layoutDirection="locale"
            app:layout_constraintStart_toStartOf="parent"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_toolbar"
            android:textColor="?attr/textMain"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            android:fontFamily="@font/ys_logotype_regular"
            android:layoutDirection="locale"
            android:layout_marginStart="8dp"
            android:accessibilityLiveRegion="polite"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:robotoFontStyle="bold"/>
        <com.yandex.go.design.view.GoConstraintLayout
            android:id="@+id/subtitle_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layoutDirection="locale"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="?attr/textMain"
                android:ellipsize="middle"
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:importantForAccessibility="no"
                android:fontFamily="@font/ys_text_regular"
                android:textDirection="locale"
                android:layoutDirection="locale"
                app:layout_constraintEnd_toStartOf="@+id/chevron_icon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap"
                app:robotoFontStyle="regular"/>
            <com.yandex.go.design.view.GoImageView
                android:id="@+id/chevron_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right_fill_m"
                android:tint="?attr/textMain"
                android:importantForAccessibility="no"
                android:layoutDirection="locale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/subtitle"
                app:layout_constraintTop_toTopOf="@+id/subtitle"/>
        </com.yandex.go.design.view.GoConstraintLayout>
    </com.yandex.go.design.view.GoConstraintLayout>
    <Space
        android:id="@+id/space"
        android:layout_width="56dp"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
