<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoView
        android:id="@+id/driver_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/driver_info_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.taxi.order.details.v2.ui.view.item.driver.title.RideCardDriverSectionTitleView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="@+id/avatar_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="14sp"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:paddingBottom="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:importantForAccessibility="no"
        android:textAlignment="viewStart"
        android:fontFeatureSettings="pnum, lnum"
        app:layout_constraintEnd_toEndOf="@+id/avatar_barrier"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/avatar_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="avatar_image, car_image"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/car_image"
        android:visibility="gone"
        android:layout_width="@dimen/driver_section_car_image_width"
        android:layout_height="@dimen/driver_section_car_image_height"
        android:alpha="0"
        android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <com.yandex.go.design.view.GoView
        android:id="@+id/avatar_background"
        android:background="@drawable/driver_avatar_round_corners"
        android:layout_width="@dimen/driver_avatar_border_size"
        android:layout_height="@dimen/driver_avatar_border_size"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintStart_toStartOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <ru.yandex.taxi.widget.ShimmeringImageView
        android:id="@+id/avatar_image"
        android:layout_width="@dimen/driver_avatar_size"
        android:layout_height="@dimen/driver_avatar_size"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/avatar_overlay"
        android:background="@drawable/ic_avatar_overlay_ok"
        android:visibility="gone"
        android:layout_width="@dimen/driver_avatar_size"
        android:layout_height="@dimen/driver_avatar_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintStart_toStartOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/driver_info_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="subtitle, title"/>
    <com.yandex.go.taxi.order.details.v2.ui.view.item.driver.RideCardDriverSectionCarPlateView
        android:id="@+id/car_plate_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/driver_info_barrier"/>
</merge>
