<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panel"
    android:background="@drawable/msg_threadlist_zeroscreen_panel_bg"
    android:clipChildren="false"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_weight="1"
    android:layout_marginHorizontal="20dp"
    app:layout_constraintBottom_toBottomOf="@+id/horizontal_guideline"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent">
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="21dp"
        android:src="@drawable/msg_threadlist_zeroscreen_avatar"
        android:layout_marginStart="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/online_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginBottom="-1.5dp"
        android:src="@drawable/msg_threadlist_zeroscreen_panel_online"
        android:layout_marginEnd="-1.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"/>
    <TextView
        android:textSize="12dp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/threadlist_zeroscreen_name"
        android:fontFamily="@font/ya_medium"
        android:layout_marginStart="42dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="?attr/messagingIncomingPrimaryColor"
        android:id="@+id/message"
        android:background="@drawable/msg_threadlist_zeroscreen_panel_message_bg"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="@string/threadlist_zeroscreen_message"
        android:lineSpacingExtra="1dp"
        android:fontFamily="@font/ya_medium"
        android:paddingStart="10dp"
        android:paddingEnd="40dp"
        android:layout_marginHorizontal="42dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="?attr/messagingIncomingSecondaryColor"
        android:id="@+id/message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="11:32"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/message"
        app:layout_constraintEnd_toEndOf="@+id/message"/>
    <TextView
        android:textSize="16dp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:gravity="center_vertical"
        android:id="@+id/button_reply"
        android:background="@drawable/msg_threadlist_zeroscreen_panel_menu_item_bg"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:text="@string/menu_reply"
        android:drawablePadding="7dp"
        android:alpha="0.6"
        android:fontFamily="@font/ya_medium"
        android:layout_marginHorizontal="40dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        app:drawableStartCompat="@drawable/msg_ic_reply"
        app:drawableTint="?attr/messagingCommonTextPrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message"/>
    <TextView
        android:textSize="16dp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:gravity="center_vertical"
        android:id="@+id/button_forward"
        android:background="@drawable/msg_threadlist_zeroscreen_panel_menu_item_bg"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:text="@string/menu_forward"
        android:drawablePadding="7dp"
        android:alpha="0.6"
        android:fontFamily="@font/ya_medium"
        android:layout_marginHorizontal="40dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        app:drawableStartCompat="@drawable/msg_ic_arrow_to_forward"
        app:drawableTint="?attr/messagingCommonTextPrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_reply"/>
    <TextView
        android:textSize="20dp"
        android:textColor="?attr/messagingCommonAccentFgColor"
        android:gravity="center_vertical"
        android:id="@+id/button_thread"
        android:background="@drawable/msg_threadlist_zeroscreen_panel_menu_thread_bg"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="27dp"
        android:text="@string/menu_message_discuss"
        android:drawablePadding="8dp"
        android:fontFamily="@font/ya_medium"
        android:elevation="20dp"
        android:layout_marginHorizontal="13dp"
        android:paddingHorizontal="23dp"
        android:paddingVertical="15dp"
        app:drawableStartCompat="@drawable/msg_ic_thread"
        app:drawableTint="?attr/messagingCommonAccentFgColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_forward"/>
</androidx.constraintlayout.widget.ConstraintLayout>
