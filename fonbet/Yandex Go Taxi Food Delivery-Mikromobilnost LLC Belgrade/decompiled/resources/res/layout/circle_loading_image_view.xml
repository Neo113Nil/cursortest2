<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.buttons.CircleButtonImageView
        android:layout_gravity="center"
        android:id="@+id/photo_image"
        android:background="@drawable/circle_loading_image_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <ru.yandex.taxi.widget.progress.CircularProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="@dimen/circle_loading_image_progress_size"
        android:layout_height="@dimen/circle_loading_image_progress_size"
        app:component_stroke_color="?attr/textOnControlMinor"
        app:component_stroke_width="@dimen/circle_loading_image_stroke_width"/>
</merge>
