<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.yandex.go.design.view.GoImageView
        android:background="@drawable/bg_delete_icon"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_subtract"
        android:layout_marginStart="10dp"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="24sp"
        android:textColor="?attr/textMain"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/favorites_delete_modal_view_title"
        android:importantForAccessibility="yes"
        android:layout_marginHorizontal="16dp"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="?attr/textMain"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/favorites_delete_modal_view_subtitle"
        android:importantForAccessibility="yes"
        android:accessibilityTraversalAfter="@+id/title"
        android:layout_marginHorizontal="16dp"/>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/cancel_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/favorites_delete_modal_view_negative_button_title"
            android:importantForAccessibility="yes"
            android:accessibilityTraversalAfter="@+id/subtitle"
            app:component_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/delete_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/favorites_delete_modal_view_positive_button_title"
            android:importantForAccessibility="yes"
            android:accessibilityTraversalAfter="@+id/cancel_button"
            app:component_button_accent="true"/>
    </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
</LinearLayout>
