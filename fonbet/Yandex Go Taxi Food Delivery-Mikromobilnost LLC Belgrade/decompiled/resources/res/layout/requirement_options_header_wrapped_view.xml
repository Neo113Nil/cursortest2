<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/requirement_header_toolbar"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="normal"
        app:component_show_navigation_button="false"
        app:component_title_gravity="center_horizontal"
        app:component_toolbar_background_accent_enabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/requirement_content_scroll_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/requirement_done_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/requirement_header_toolbar"
        app:layout_constraintVertical_chainStyle="spread_inside">
        <FrameLayout
            android:id="@+id/requirement_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:id="@+id/requirements_shadow_indicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/requirement_content_scroll_view"
        app:layout_constraintEnd_toEndOf="@+id/requirement_content_scroll_view"
        app:layout_constraintStart_toStartOf="@+id/requirement_content_scroll_view"
        app:scroll_view_id="@+id/requirement_content_scroll_view"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/requirement_done_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:text="@string/common_done"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:component_button_accent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/requirement_content_scroll_view"/>
</merge>
