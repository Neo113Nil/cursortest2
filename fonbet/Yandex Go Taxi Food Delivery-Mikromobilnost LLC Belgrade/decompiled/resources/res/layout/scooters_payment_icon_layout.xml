<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/payment_layout"
    android:visibility="gone"
    android:layout_width="@dimen/component_image_holder_size"
    android:layout_height="@dimen/component_image_holder_size">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/payment_add_card_view"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_payment_add_card"
        android:scaleType="center"
        android:contentDescription="@string/scooters_offer_card_v2_a11y_payment_info_button_add"/>
    <com.yandex.go.payments.design.composite.CompositePaymentIconsView
        android:id="@+id/payment_info_view"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"/>
</com.yandex.go.design.view.GoFrameLayout>
