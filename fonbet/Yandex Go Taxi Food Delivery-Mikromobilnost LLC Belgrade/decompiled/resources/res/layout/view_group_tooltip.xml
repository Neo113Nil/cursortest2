<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.design.bubble.BubbleComponent xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="@dimen/go_design_s_space">
        <ru.yandex.taxi.widget.accessibility.AccessibilityLiveRegionTextView
            android:textSize="13sp"
            android:textColor="?attr/textInvert"
            android:ellipsize="end"
            android:id="@+id/tooltip_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/action_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/chevron_next"
            android:tint="?attr/textInvert"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</ru.yandex.taxi.design.bubble.BubbleComponent>
