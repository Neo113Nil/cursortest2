<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingEnd="12dp">
    <com.yandex.go.navigator.alt_select.traffic.TrafficJamView
        android:layout_gravity="end"
        android:id="@+id/traffic_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:component_circle_image_tint_enable="false"
        app:component_frame_height="@dimen/map_controls_height"
        app:component_frame_width="@dimen/map_controls_height"/>
    <com.yandex.go.navigator.map_interactions.parkings.CarParsToggle
        android:layout_gravity="end"
        android:id="@+id/car_parks"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:component_circle_image_tint_enable="false"
        app:component_frame_height="@dimen/map_controls_height"
        app:component_frame_width="@dimen/map_controls_height"/>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Space
        android:id="@+id/location_spacer"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ru.yandex.taxi.widget.floatbuttonholder.FloatButtonHolderLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/float_button_holder_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"/>
</com.yandex.go.design.view.GoLinearLayout>
