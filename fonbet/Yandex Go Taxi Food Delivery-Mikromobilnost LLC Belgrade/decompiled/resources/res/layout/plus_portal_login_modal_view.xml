<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_notification"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/BottomModalContentHolder">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_title"
            android:id="@+id/plus_portal_login_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/plus_link_portal_modal_header"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/plus_portal_login_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:robotoFontStyle="medium"
            style="@style/ListTitleComponent"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:id="@+id/plus_portal_login_text"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/plus_link_portal_modal_text"
            android:fontFamily="sans-serif"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/plus_portal_login_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:robotoFontStyle="regular"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/plus_portal_login_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/plus_link_portal_modal_button"
            android:fontFamily="sans-serif"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:component_button_accent="true"
            app:component_button_rounded_corners_radius="@dimen/go_design_m_space"
            app:component_button_size="L"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:robotoFontStyle="medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
