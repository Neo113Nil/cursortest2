<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/fab_component"
    android:layout_width="@dimen/circle_buttons_circle_size"
    android:layout_height="@dimen/circle_buttons_circle_size"
    android:layout_marginBottom="@dimen/go_design_s_space">
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/contact_circle_progress"
        android:padding="2dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:max="1000"
        android:indeterminate="false"
        android:progressDrawable="@drawable/circle_progress_amber"
        android:rotation="90"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="@color/component_black"
        android:layout_gravity="center"
        android:id="@+id/text_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:robotoFontStyle="bold"/>
</FrameLayout>
