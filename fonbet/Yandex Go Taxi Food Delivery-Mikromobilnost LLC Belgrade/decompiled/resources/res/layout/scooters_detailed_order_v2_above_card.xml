<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.BackButtonIconComponent
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="-12dp"
        app:component_circle_button_badge_color="?attr/controlMain"
        app:component_circle_button_badge_text_color="?attr/textOnControl"
        app:layout_constraintBottom_toTopOf="@+id/route_summary_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.scooters.presentation.detailed_order.v2.components.ScootersOrderSelectorView
        android:id="@+id/order_selector_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/route_summary_view"
        app:layout_constraintEnd_toStartOf="@+id/geo_control"
        app:layout_constraintStart_toEndOf="@+id/back_button"
        app:layout_constraintTop_toTopOf="@+id/back_button"
        app:layout_constraintVertical_bias="1"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/geo_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="-12dp"
        app:layout_constraintBottom_toTopOf="@+id/route_summary_view"
        app:layout_constraintEnd_toEndOf="parent">
        <ru.yandex.taxi.scooters.utils.ScootersGeoButtonIconComponent
            android:id="@+id/geo_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <ru.yandex.taxi.widget.ArrowsView
        android:id="@+id/arrows_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/route_summary_view"
        app:layout_constraintEnd_toEndOf="@+id/route_summary_view"
        app:layout_constraintStart_toStartOf="@+id/route_summary_view"/>
    <ru.yandex.taxi.scooters.presentation.route_navigation.route_summary.ScootersRouteSummaryView
        android:id="@+id/route_summary_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
