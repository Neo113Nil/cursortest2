<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/emptyState"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:constraint_referenced_ids="emptySubscriptionImage, emptySubscriptionTitle, emptySubscriptionDescription, agreeButton"/>
    <include
        android:id="@+id/loadingState"
        layout="@layout/ybsdk_qr_loading_subscriptions_list"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subscriptionsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.widgets.common.snackbar.SnackbarView
        android:id="@+id/subscriptionsSnackbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/emptySubscriptionImage"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28"
        app:srcCompat="@drawable/ybsdk_ic_empty_subscription"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/emptySubscriptionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ybsdk_qr_payment_subscriptions_empty_title"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emptySubscriptionImage"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/emptySubscriptionDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ybsdk_qr_payment_subscriptions_empty_description"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emptySubscriptionTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/agreeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ybsdk_buttonTitle="@string/ybsdk_qr_payment_payment_consent"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
</androidx.constraintlayout.widget.ConstraintLayout>
