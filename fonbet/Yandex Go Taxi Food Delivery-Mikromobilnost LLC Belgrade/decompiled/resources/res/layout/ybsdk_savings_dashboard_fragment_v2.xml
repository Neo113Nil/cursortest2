<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/savingsDashboardContentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/motionLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutDescription="@xml/ybsdk_savings_dashboard_motion_scene">
            <FrameLayout
                android:id="@+id/toolbarIconsContainer"
                android:paddingRight="@dimen/ybsdk_toolbar_view_side_padding"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ybsdk_toolbar_height"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/toolbarIconSupport"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/ybsdk_toolbar_icon_size"
                    android:layout_height="@dimen/ybsdk_toolbar_icon_size"
                    android:scaleType="center"
                    android:contentDescription="@string/ybsdk_dashboard_action_contact_support_title"
                    android:stateListAnimator="@animator/ybsdk_click_scale_animator"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/savingsTitleImage"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/savingsTitle"
                app:layout_constraintEnd_toStartOf="@+id/savingsTitle"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/savingsTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/savingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                app:layout_constraintBottom_toTopOf="@+id/spoilerSavingsBalanceView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/savingsTitleImage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Widget.YB.Text.Title2"/>
            <com.ybsdk.core.design.spoiler.SpoilerFrameLayout
                android:id="@+id/spoilerSavingsBalanceView"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/savingsTitle"
                app:ybsdk_spoiler_height="44dp"
                app:ybsdk_spoiler_horizontal_gravity="center"
                app:ybsdk_spoiler_vertical_gravity="bottom"
                app:ybsdk_spoiler_width="229dp">
                <com.ybsdk.feature.savings.internal.views.SavingsAccountTickerView
                    android:textColor="?attr/ybColor_textIcon_primary"
                    android:gravity="center"
                    android:id="@+id/savingsBalanceView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lineSpacingExtra="0sp"
                    android:importantForAccessibility="no"
                    android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                    style="@style/Widget.YB.Text.Numbers2"/>
            </com.ybsdk.core.design.spoiler.SpoilerFrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/noAccountsTitle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/savingsTitle"
                style="@style/Widget.YB.Text.Headline1"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/titleViewsBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="spoilerSavingsBalanceView,noAccountsTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/savingsDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/savingsDescriptionBalance"
                app:layout_constraintTop_toBottomOf="@+id/titleViewsBarrier"
                style="@style/Widget.YB.Text.Title3"/>
            <com.ybsdk.core.design.spoiler.SpoilerTextView
                android:id="@+id/savingsDescriptionBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:paddingVertical="1dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/savingsDescription"
                app:layout_constraintEnd_toStartOf="@+id/savingsDescription"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:ybsdk_spoiler_height="16dp"
                app:ybsdk_spoiler_horizontal_gravity="right"
                app:ybsdk_spoiler_width="58dp"
                style="@style/Widget.YB.Text.Title3"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:background="?attr/ybColor_background_primary"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="30dp"
                android:overScrollMode="never"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/savingsDescription"/>
        </androidx.constraintlayout.motion.widget.MotionLayout>
        <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer"
            android:background="?attr/ybColor_background_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/ybsdk_savings_dashboard_shimmer_layout_v2"/>
        </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
        <com.ybsdk.widgets.common.ErrorView
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/dragAndDropOnboardingBackground"
            android:background="?attr/ybColor_other_overlay"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/dragAndDropOnboardingCells"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            layout="@layout/ybsdk_drag_and_drop_onboarding_cells"/>
        <include
            android:id="@+id/dragAndDropOnboardingDivCells"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            layout="@layout/ybsdk_drag_and_drop_onboarding_div_cells"/>
        <include
            android:id="@+id/dragAndDropOnboardingDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ybsdk_toolbar_view_side_padding"
            layout="@layout/ybsdk_drag_and_drop_onboarding_dialog"/>
    </FrameLayout>
</com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout>
