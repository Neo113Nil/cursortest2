<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/shadow_frame_delegate"
        android:layout_width="48dp"
        android:layout_height="60dp"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/additionalSection"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        app:component_subtitle_ellipsize_mode="end"
        app:component_subtitle_max_lines="1"
        app:component_subtitle_typeface="regular"
        app:component_title_ellipsize_mode="end"
        app:component_title_max_lines="1"
        app:component_title_typeface="medium"
        app:component_title_with_navigation="true"
        app:component_vertical_padding="0dp"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:background="@drawable/oval_shape"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:progress="50"
        android:progressBackgroundTint="@color/white"
        app:indicatorColor="?attr/controlMain"
        app:indicatorDirectionCircular="clockwise"
        app:indicatorInset="4dp"
        app:trackColor="?attr/controlMinor"
        app:trackCornerRadius="4dp"
        app:trackThickness="4dp"/>
    <ru.yandex.taxi.widget.buttons.CircleButtonImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="12dp"/>
</merge>
