<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/go_design_m_space">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/mainTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="@string/go_default_font_settings"
        app:layout_constraintBottom_toTopOf="@+id/additionalViewContainer"
        app:layout_constraintEnd_toStartOf="@+id/check_box"
        app:layout_constraintTop_toTopOf="@+id/check_box"
        app:layout_constraintVertical_chainStyle="packed"
        app:robotoFontStyle="regular"/>
    <FrameLayout
        android:id="@+id/additionalViewContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/check_box"
        app:layout_constraintEnd_toEndOf="@+id/mainTextView"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/mainTextView"
        app:layout_constraintTop_toBottomOf="@+id/mainTextView">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="?attr/textMinor"
            android:id="@+id/additionalTextView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="@string/go_default_font_settings"/>
        <com.yandex.go.tariffcard.ui.view.MulticlassCashbackView
            android:id="@+id/cashbackView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ru.yandex.taxi.design.CheckBoxComponent
        android:layout_gravity="center_vertical"
        android:id="@+id/check_box"
        android:layout_width="@dimen/component_image_holder_size"
        android:layout_height="@dimen/component_image_holder_size"
        android:layout_marginStart="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
