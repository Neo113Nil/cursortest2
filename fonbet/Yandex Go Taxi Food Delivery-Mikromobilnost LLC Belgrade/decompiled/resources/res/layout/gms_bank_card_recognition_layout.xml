<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gms_bank_card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.camera.CameraPreview
        android:id="@+id/bank_card_camera_preview"
        android:background="@color/component_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.yandex.taxi.widget.BackButton
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_back_24dp"
        app:tint="@color/component_white"
        app:tintMode="src_in"
        style="@style/back_button"/>
    <Space
        android:id="@+id/top_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"/>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_space"
        app:layout_constraintVertical_weight="3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bank_card_camera_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/camera_card_border"
        android:scaleType="fitStart"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/top_space"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="@color/component_white"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/camera_card_scan_tip"
        android:textAlignment="gravity"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/bank_card_camera_target"/>
    <ru.yandex.taxi.widget.buttons.CircleButtonImageView
        android:id="@+id/flashlight_button"
        android:background="@drawable/selector_flashlight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
