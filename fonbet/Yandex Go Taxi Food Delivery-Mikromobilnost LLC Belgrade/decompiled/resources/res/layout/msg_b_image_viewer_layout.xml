<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/messagingViewerBackgroundColor"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/transition_image"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/image_viewer_toolbar"
        android:background="?attr/messagingViewerToolbarColor"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/go_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_back_button_content_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_back"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/messagingViewerIconsColor"
            android:ellipsize="end"
            android:id="@+id/from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/send_time"
            app:layout_constraintEnd_toStartOf="@+id/remove"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/go_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/messagingViewerIconsColor"
            android:id="@+id/send_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/remove"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/from"
            app:layout_constraintTop_toBottomOf="@+id/from"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/remove"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_remove_button_content_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_delete"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/action_bar"
        android:background="?attr/messagingViewerToolbarColor"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/pin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_pin_button_content_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reply"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_pin"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/reply"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_reply_button_content_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/forward"
            app:layout_constraintStart_toEndOf="@+id/pin"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_reply"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/forward"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_forward_button_content_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/resend"
            app:layout_constraintStart_toEndOf="@+id/reply"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_arrow_to_forward"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/resend"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_resend_button_content_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/download"
            app:layout_constraintStart_toEndOf="@+id/forward"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_arrow_to_forward"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/download"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_download_button_content_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/show_message"
            app:layout_constraintStart_toEndOf="@+id/resend"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_download"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/show_message"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_show_message_button_content_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/share"
            app:layout_constraintStart_toEndOf="@+id/download"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_jmp_to_message"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/share"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?attr/messagingViewerIconsColor"
            android:contentDescription="@string/image_viewer_share_button_content_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/show_message"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/msg_ic_share"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
