<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="@dimen/plus_sdk_animation_car_shadow_height"
        android:layout_marginTop="@dimen/plus_sdk_animation_car_shadow_top_margin"
        android:src="@drawable/plus_sdk_taxi_loading_anim_car_shadow"
        app:layout_constraintEnd_toEndOf="@+id/car"
        app:layout_constraintStart_toStartOf="@+id/car"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"/>
    <ImageView
        android:id="@+id/left_back_wheel"
        android:layout_width="@dimen/plus_sdk_animation_wheel_size"
        android:layout_height="@dimen/plus_sdk_animation_wheel_size"
        android:layout_marginTop="@dimen/plus_sdk_animation_wheel_top_margin"
        android:src="@drawable/plus_sdk_taxi_loading_anim_wheel_back"
        android:layout_marginEnd="@dimen/plus_sdk_animation_wheel_back_horizontal_margin"
        app:layout_constraintEnd_toEndOf="@+id/guideline_vertical"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"/>
    <ImageView
        android:id="@+id/right_back_wheel"
        android:layout_width="@dimen/plus_sdk_animation_wheel_size"
        android:layout_height="@dimen/plus_sdk_animation_wheel_size"
        android:layout_marginTop="@dimen/plus_sdk_animation_wheel_top_margin"
        android:src="@drawable/plus_sdk_taxi_loading_anim_wheel_back"
        android:layout_marginStart="@dimen/plus_sdk_animation_wheel_back_horizontal_margin"
        app:layout_constraintStart_toStartOf="@+id/guideline_vertical"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"/>
    <ImageView
        android:id="@+id/gift"
        android:layout_width="@dimen/plus_sdk_animation_common_icon_size"
        android:layout_height="@dimen/plus_sdk_animation_common_icon_size"
        android:layout_marginBottom="@dimen/plus_sdk_animation_icon_bottom_margin"
        android:src="@drawable/plus_sdk_taxi_loading_anim_gift"
        android:scaleType="centerCrop"
        android:translationX="@dimen/plus_sdk_animation_common_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/car"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/plus_sdk_animation_common_icon_size"
        android:layout_height="@dimen/plus_sdk_animation_common_icon_size"
        android:layout_marginBottom="@dimen/plus_sdk_animation_icon_bottom_margin"
        android:src="@drawable/plus_sdk_taxi_loading_anim_plus_avatar"
        android:scaleType="centerCrop"
        android:translationX="@dimen/plus_sdk_animation_common_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/car"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/car"
        android:layout_width="@dimen/plus_sdk_animation_car_width"
        android:layout_height="@dimen/plus_sdk_animation_car_height"
        android:src="@drawable/plus_sdk_taxi_loading_anim_car"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"/>
    <ImageView
        android:id="@+id/left_front_wheel"
        android:layout_width="@dimen/plus_sdk_animation_wheel_size"
        android:layout_height="@dimen/plus_sdk_animation_wheel_size"
        android:layout_marginTop="@dimen/plus_sdk_animation_wheel_top_margin"
        android:src="@drawable/plus_sdk_taxi_loading_anim_wheel_front"
        android:layout_marginEnd="@dimen/plus_sdk_animation_wheel_front_horizontal_margin"
        app:layout_constraintEnd_toEndOf="@+id/guideline_vertical"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"/>
    <ImageView
        android:id="@+id/right_front_wheel"
        android:layout_width="@dimen/plus_sdk_animation_wheel_size"
        android:layout_height="@dimen/plus_sdk_animation_wheel_size"
        android:layout_marginTop="@dimen/plus_sdk_animation_wheel_top_margin"
        android:src="@drawable/plus_sdk_taxi_loading_anim_wheel_front"
        android:layout_marginStart="@dimen/plus_sdk_animation_wheel_front_horizontal_margin"
        app:layout_constraintStart_toStartOf="@+id/guideline_vertical"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"/>
    <ImageView
        android:id="@+id/plus_dash"
        android:layout_width="@dimen/plus_sdk_animation_small_icon_size"
        android:layout_height="@dimen/plus_sdk_animation_dash_icon_height"
        android:src="@drawable/plus_sdk_taxi_loading_anim_plus_icon_dash"
        android:scaleType="centerCrop"
        android:translationX="@dimen/plus_sdk_animation_small_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/car"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/plus_icon"
        android:layout_width="@dimen/plus_sdk_animation_small_icon_size"
        android:layout_height="@dimen/plus_sdk_animation_small_icon_size"
        android:src="@drawable/plus_sdk_taxi_loading_anim_plus_icon"
        android:scaleType="centerCrop"
        android:translationX="@dimen/plus_sdk_animation_small_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/car"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
