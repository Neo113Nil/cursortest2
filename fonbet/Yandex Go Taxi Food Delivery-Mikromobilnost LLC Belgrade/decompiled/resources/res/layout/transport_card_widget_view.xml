<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/transport_card_notification_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/transport_card_main_container"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:id="@+id/transport_card_lead_image"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/transport_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:fontFeatureSettings="pnum, lnum"
            app:layout_constraintBottom_toTopOf="@+id/transport_card_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/transport_card_trail_button"
            app:layout_constraintStart_toEndOf="@+id/transport_card_lead_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="13sp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/transport_card_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:fontFeatureSettings="pnum, lnum"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/transport_card_trail_button"
            app:layout_constraintStart_toEndOf="@+id/transport_card_lead_image"
            app:layout_constraintTop_toBottomOf="@+id/transport_card_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.yandex.taxi.widget.buttons.ButtonTrailView
            android:textColor="?attr/textOnControlMinor"
            android:gravity="center"
            android:id="@+id/transport_card_trail_button"
            android:duplicateParentState="false"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="?attr/controlMinor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/transport_card_trail_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/transport_card_action_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp">
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_caption"
            android:id="@+id/transport_card_secondary_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            app:component_background_color="?attr/bgMinor"
            app:component_button_size="M"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_caption"
            android:id="@+id/transport_card_main_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            app:component_background_color="?attr/bgMinor"
            app:component_button_size="M"
            app:component_title_color="?attr/textOnControlMinor"/>
    </LinearLayout>
</merge>
