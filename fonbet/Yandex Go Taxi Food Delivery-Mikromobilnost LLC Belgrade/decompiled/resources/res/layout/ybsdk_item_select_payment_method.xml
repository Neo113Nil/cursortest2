<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/left_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/leftSubImage"
        android:background="@drawable/ybsdk_background_payment_method_left_sub_image"
        android:padding="2dp"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:translationX="6dp"
        android:translationY="2dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/left_image"
        app:layout_constraintEnd_toEndOf="@+id/left_image"/>
    <TextView
        android:id="@+id/payment_method_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/payment_method_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/checkboxBarrier"
        app:layout_constraintStart_toEndOf="@+id/left_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/checkboxBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="right_image,right_checkbox"/>
    <com.ybsdk.core.design.spoiler.SpoilerTextView
        android:id="@+id/payment_method_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/checkboxBarrier"
        app:layout_constraintStart_toEndOf="@+id/left_image"
        app:layout_constraintTop_toBottomOf="@+id/payment_method_title"
        app:ybsdk_spoiler_height="12dp"
        app:ybsdk_spoiler_vertical_gravity="bottom"
        app:ybsdk_spoiler_width="58dp"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    <ImageView
        android:id="@+id/right_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_arrow_short_forward"/>
    <com.ybsdk.widgets.common.checkbox.CheckBoxView
        android:id="@+id/right_checkbox"
        android:visibility="gone"
        android:layout_width="@dimen/ybsdk_payment_method_checkbox_size"
        android:layout_height="@dimen/ybsdk_payment_method_checkbox_size"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_colorType="dark"/>
</androidx.constraintlayout.widget.ConstraintLayout>
