<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.superapp.orders.card.OrderCardShimmeringView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_shimmering"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/skeleton_container"
        layout="@layout/order_card_skeleton"/>
    <include
        android:id="@+id/skeleton_redesign_container"
        layout="@layout/order_card_skeleton_redesign"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.superapp.orders.card.header.OrderCardHeaderView
            android:id="@+id/header"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_header_ripple"/>
        <com.yandex.go.superapp.orders.card.actions.OrderCardActionButtonsView
            android:orientation="horizontal"
            android:id="@+id/action_buttons"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.yandex.go.superapp.orders.card.circle_buttons.CircleButtonsView
            android:orientation="vertical"
            android:id="@+id/circle_buttons"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.yandex.go.superapp.orders.card.bottom_sections.BottomSectionsView
            android:orientation="vertical"
            android:id="@+id/bottom_sections"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.yandex.taxi.order.view.walking_info.WalkingInfoView
            android:id="@+id/walking_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.yandex.taxi.design.RatingBarComponent
            android:layout_gravity="center_horizontal"
            android:id="@+id/rating_bar"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            app:contentDescriptions="@array/rating_view_titles"
            app:starHeight="48dp"
            app:starPadding="4dp"
            app:starWidth="56dp"
            style="@style/rating_bar"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.superapp.orders.card.OrderCardShimmeringView>
