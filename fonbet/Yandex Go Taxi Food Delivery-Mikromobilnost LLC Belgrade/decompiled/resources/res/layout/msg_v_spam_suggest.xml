<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spam_suggest"
    android:background="?attr/messagingCommonActionbarColor"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:gravity="center"
        android:id="@+id/spam_suggest_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/spam_suggest_title"
        android:fontFamily="@font/ya_medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonDestructiveTextColor"
        android:id="@+id/spam_suggest_report_button"
        android:background="@android:color/transparent"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:text="@string/messenger_report"
        android:fontFamily="@font/ya_medium"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/spam_suggest_block_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spam_suggest_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonDestructiveTextColor"
        android:id="@+id/spam_suggest_block_button"
        android:background="@android:color/transparent"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:text="@string/spam_suggest_block"
        android:fontFamily="@font/ya_medium"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/spam_suggest_report_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spam_suggest_report_button"
        app:layout_constraintTop_toTopOf="@+id/spam_suggest_report_button"/>
    <ImageView
        android:id="@+id/spam_suggest_close_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:contentDescription="@string/spam_suggest_close_button_content_desc"
        android:paddingEnd="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/close_outline_md"
        app:tint="?attr/messagingCommonIconsPrimaryColor"/>
    <View
        android:id="@+id/spam_suggest_divider"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
