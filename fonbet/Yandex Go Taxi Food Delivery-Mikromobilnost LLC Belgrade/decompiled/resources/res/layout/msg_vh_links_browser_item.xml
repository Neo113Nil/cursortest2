<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="0dp">
    <ImageView
        android:id="@+id/link_icon"
        android:layout_marginTop="8dp"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.MediaBrowser.LinksBrowser.Item.FavIcon"/>
    <TextView
        android:id="@+id/link_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/link_content"
        app:layout_constraintEnd_toEndOf="@+id/link_list"
        app:layout_constraintStart_toStartOf="@+id/link_list"
        app:layout_constraintTop_toTopOf="@+id/link_icon"
        style="@style/Messaging.MediaBrowser.LinksBrowser.Item.Title"/>
    <TextView
        android:id="@+id/link_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/link_list"
        app:layout_constraintEnd_toEndOf="@+id/link_list"
        app:layout_constraintStart_toStartOf="@+id/link_list"
        app:layout_constraintTop_toBottomOf="@+id/link_title"
        style="@style/Messaging.MediaBrowser.LinksBrowser.Item.Content"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/link_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/message_author"
        app:layout_constraintEnd_toStartOf="@+id/link_item_menu"
        app:layout_constraintStart_toEndOf="@+id/link_icon"
        app:layout_constraintTop_toBottomOf="@+id/link_content"/>
    <TextView
        android:id="@+id/message_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/link_list"
        app:layout_constraintStart_toStartOf="@+id/link_list"
        app:layout_constraintTop_toBottomOf="@+id/link_list"
        style="@style/Messaging.MediaBrowser.LinksBrowser.Item.MessageAuthor"/>
    <ImageButton
        android:id="@+id/link_item_menu"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="64dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.MediaBrowser.MenuButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
