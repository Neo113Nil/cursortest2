<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ybsdk_toolbar_height">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/transferToolbarBase"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:id="@+id/transferToolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:layout_marginHorizontal="68dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.YB.Text.Title1"/>
    <Space
        android:id="@+id/startSpace"
        android:layout_width="68dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintEnd_toStartOf="@+id/transferToolbarLeftIcon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/transferToolbarSubtitleAccount"/>
    <ImageView
        android:id="@+id/transferToolbarLeftIcon"
        android:paddingRight="4dp"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintEnd_toStartOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintStart_toEndOf="@+id/startSpace"
        app:layout_constraintTop_toTopOf="@+id/transferToolbarSubtitleAccount"/>
    <TextView
        android:id="@+id/transferToolbarSubtitleAccount"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/transferToolbarSubtitleDelimeter"
        app:layout_constraintStart_toEndOf="@+id/transferToolbarLeftIcon"
        app:layout_constraintTop_toBottomOf="@+id/transferToolbarTitle"
        style="@style/Widget.YB.Text.Caption1.Regular"/>
    <TextView
        android:id="@+id/transferToolbarSubtitleDelimeter"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:text="@string/ybsdk_transfer_toolbar_subtitle_delimiter"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintEnd_toStartOf="@+id/transferToolbarSubtitleAmount"
        app:layout_constraintStart_toEndOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintTop_toTopOf="@+id/transferToolbarSubtitleAccount"
        style="@style/Widget.YB.Text.Caption1.Regular"/>
    <com.ybsdk.core.design.spoiler.SpoilerTextView
        android:id="@+id/transferToolbarSubtitleAmount"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintEnd_toStartOf="@+id/transferToolbarRightIcon"
        app:layout_constraintStart_toEndOf="@+id/transferToolbarSubtitleDelimeter"
        app:layout_constraintTop_toTopOf="@+id/transferToolbarSubtitleAccount"
        app:ybsdk_spoiler_height="12dp"
        app:ybsdk_spoiler_vertical_gravity="bottom"
        app:ybsdk_spoiler_width="58dp"
        style="@style/Widget.YB.Text.Caption1.Regular"/>
    <ImageView
        android:id="@+id/transferToolbarRightIcon"
        android:layout_width="16dp"
        android:layout_height="0dp"
        android:src="@drawable/ybsdk_arrow_short_bottom_gray_16"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintEnd_toStartOf="@+id/endSpace"
        app:layout_constraintStart_toEndOf="@+id/transferToolbarSubtitleAmount"
        app:layout_constraintTop_toTopOf="@+id/transferToolbarSubtitleAccount"/>
    <Space
        android:id="@+id/endSpace"
        android:layout_width="68dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferToolbarSubtitleAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/transferToolbarSubtitleAccount"/>
    <View
        android:id="@+id/transferToolbarSubtitleClickArea"
        android:background="@android:color/transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferToolbarLeftIcon"
        app:layout_constraintEnd_toEndOf="@+id/transferToolbarRightIcon"
        app:layout_constraintStart_toStartOf="@+id/transferToolbarLeftIcon"
        app:layout_constraintTop_toTopOf="@+id/transferToolbarTitle"/>
</merge>
