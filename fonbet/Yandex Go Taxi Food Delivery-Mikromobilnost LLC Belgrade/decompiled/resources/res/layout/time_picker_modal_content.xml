<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.due_selector.impl.presentation.ui.picker.dayspicker.DaysTimePicker
        android:layout_gravity="center_horizontal"
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:layout_gravity="center_horizontal"
        android:id="@+id/approve"
        android:background="?attr/controlMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"/>
</com.yandex.go.design.view.GoLinearLayout>
