<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_32dp_modal_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Space
            android:id="@+id/top_space"
            android:layout_width="0dp"
            android:layout_height="@dimen/header_top_radius"
            android:layout_alignParentTop="true"/>
        <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
            android:id="@+id/dashboard_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_above="@+id/below_footer_shadow"
            android:layout_below="@+id/top_space">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sections_container"
                android:paddingTop="@dimen/header_top_radius"
                android:paddingBottom="80dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
        <ru.yandex.taxi.design.ListHeaderComponent
            android:id="@+id/dashboard_header"
            android:background="@drawable/bg_intercity_dashboard_header"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:paddingStart="4dp"
            app:component_lead_image_padding_right="4dp"
            app:component_lead_image_size="@dimen/header_image_size"
            app:component_title_size="@dimen/component_text_size_toolbar"/>
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/footer_shadow"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/intercity_dashboard_buttons_container_holder"/>
        <View
            android:id="@+id/below_footer_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/footer_shadow"/>
        <FrameLayout
            android:id="@+id/intercity_dashboard_buttons_container_holder"
            android:background="@drawable/bg_rounded_24dp_modal_view"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/loading_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:paddingStart="@dimen/component_large_margin"
        android:paddingEnd="@dimen/component_large_margin">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:cardBackgroundColor="?attr/bgMinor"
            app:cardCornerRadius="@dimen/section_radius"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/section_margin"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:cardBackgroundColor="?attr/bgMinor"
            app:cardCornerRadius="@dimen/section_radius"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"/>
    </LinearLayout>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        app:placeholder_color="@color/transparent"
        app:placeholder_shimmering="true"/>
</FrameLayout>
