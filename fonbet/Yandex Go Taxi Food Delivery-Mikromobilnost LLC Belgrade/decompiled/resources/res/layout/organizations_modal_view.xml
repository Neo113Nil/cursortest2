<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.ShimmeringFrameLayout
        android:gravity="center"
        android:id="@+id/organizations_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shimmeringWidth="256dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/organization_item_search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/error_loading_container"
            android:paddingTop="@dimen/discovery_organizations_search_header"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/organizations_error_loading_container"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/empty_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/organizations_empty_container"/>
    </ru.yandex.taxi.widget.ShimmeringFrameLayout>
    <com.yandex.go.design.view.GoView
        android:id="@+id/input_bottom_shadow"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/header_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_container"/>
    <com.yandex.go.design.view.GoConstraintLayout
        android:id="@+id/header_container"
        android:background="@drawable/search_input_view_round_bg_main_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/back_button"
            android:background="@drawable/bg_round_16dp_minor"
            android:padding="12dp"
            android:layout_width="@dimen/discovery_organizations_image_size"
            android:layout_height="@dimen/discovery_organizations_image_size"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/common_back"
            android:layout_marginStart="@dimen/go_design_m_space"
            app:layout_constraintBottom_toTopOf="@+id/filter_chips"
            app:layout_constraintEnd_toStartOf="@+id/input_component"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="@dimen/go_design_m_space"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/input_component"
            android:background="@drawable/bg_round_16dp_minor"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/discovery_organizations_search_header_size"
            android:importantForAccessibility="noHideDescendants"
            android:layout_marginStart="@dimen/go_design_s_space"
            android:layout_marginEnd="@dimen/go_design_m_space"
            android:accessibilityHeading="true"
            app:component_title="Title"
            app:component_title_gravity="center_horizontal"
            app:component_title_max_lines="1"
            app:layout_constraintBottom_toBottomOf="@+id/back_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/back_button"
            app:layout_constraintTop_toTopOf="@+id/back_button"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filter_chips"
            android:visibility="visible"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="@dimen/go_design_m_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/back_button"/>
    </com.yandex.go.design.view.GoConstraintLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/open_map_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_l_space"
        android:minWidth="100dp"
        android:text="@string/discovery_organizations_open_map"
        app:component_background_color="?attr/textMain"
        app:component_button_accent="true"
        app:component_button_icon="@drawable/ic_discovery_map"
        app:component_button_icon_position="end"
        app:component_button_icon_tint="?attr/textInvert"
        app:component_button_rounded_corners_radius="100dp"
        app:component_button_size="S"
        app:component_title_color="?attr/textInvert"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.widget.buttons.CircleButtonImageView
        android:id="@+id/up_button"
        android:background="@drawable/floating_button_background"
        android:padding="12dp"
        android:layout_width="@dimen/discovery_organizations_up_button_size"
        android:layout_height="@dimen/discovery_organizations_up_button_size"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_scroll_up"
        android:contentDescription="@string/order_details_with_feed_collapse_button_content_description_title"
        android:layout_marginEnd="8dp"
        android:elevation="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
