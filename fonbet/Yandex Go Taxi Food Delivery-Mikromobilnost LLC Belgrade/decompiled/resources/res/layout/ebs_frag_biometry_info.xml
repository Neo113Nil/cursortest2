<?xml version="1.0" encoding="utf-8"?>
<ru.rt.ebs.cryptosdk.presentation.customView.CustomizableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ebs_frag_biometry_info_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:constraintLayoutType="biometryInfo">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/ebs_frag_biometry_info_guideline_content_center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.2"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ebssdk_margin_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ebs_frag_biometry_info_guideline_content_center">
        <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableScreenIcon
            android:layout_gravity="center_horizontal"
            android:id="@+id/ebs_frag_biometry_attention_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:screenIconType="attention"/>
        <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableTextView
            android:textAppearance="@style/Ebssdk.Text.Weight700"
            android:textSize="@dimen/ebssdk_text_20"
            android:id="@+id/ebs_frag_biometry_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ebssdk_margin_28"
            android:text="@string/ebssdk_biometry_info_title"
            android:textAlignment="center"
            app:textViewType="biometryInfo"/>
        <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableTextWithBulletPoint
            android:id="@+id/ebs_frag_biometry_info_message_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ebssdk_margin_12"
            app:customizableTextWithBulletPointTextRes="@string/ebssdk_biometry_info_message_1"
            app:customizableTextWithBulletPointViewType="biometryInfo"/>
        <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableTextWithBulletPoint
            android:id="@+id/ebs_frag_biometry_info_message_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ebssdk_margin_8"
            app:customizableTextWithBulletPointTextRes="@string/ebssdk_biometry_info_message_2"
            app:customizableTextWithBulletPointViewType="biometryInfo"/>
        <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableTextWithBulletPoint
            android:id="@+id/ebs_frag_biometry_info_message_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ebssdk_margin_8"
            app:customizableTextWithBulletPointTextRes="@string/ebssdk_biometry_info_message_3"
            app:customizableTextWithBulletPointViewType="biometryInfo"/>
    </LinearLayout>
    <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableButton
        android:id="@+id/ebs_frag_biometry_info_proceed_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ebssdk_margin_20"
        android:text="@string/ebssdk_proceed_btn_text"
        android:layout_marginHorizontal="@dimen/ebssdk_margin_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.rt.ebs.cryptosdk.presentation.customView.CustomizableHeader
        android:id="@+id/ebs_frag_biometry_info_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:headerType="defaultType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</ru.rt.ebs.cryptosdk.presentation.customView.CustomizableConstraintLayout>
