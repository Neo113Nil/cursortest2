<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.feature.divkit.api.ui.YbDivView
            android:id="@+id/transfersDashboardDivView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"/>
        <include
            android:id="@+id/transfersDashboardSkeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            layout="@layout/ybsdk_transfers_dashboard_slideable_view_loading"/>
        <include
            android:id="@+id/transfersDashboardSkeletonWithWidget"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            layout="@layout/ybsdk_transfers_dashboard_slideable_view_with_widget_loading"/>
        <com.ybsdk.feature.divkit.api.ui.skeletons.DivSkeletonsView
            android:id="@+id/divkitShimmerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ybsdk.feature.transfer.version2.internal.screens.dashboard.presentation.view.TransfersDashboardErrorView
                android:id="@+id/transfersDashboardErrorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
