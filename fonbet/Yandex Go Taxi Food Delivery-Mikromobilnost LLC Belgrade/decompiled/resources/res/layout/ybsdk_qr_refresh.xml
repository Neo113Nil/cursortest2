<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/qrRefreshToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_subtitle="@string/ybsdk_qr_payment_sbp_title"
        app:ybsdk_title="@string/ybsdk_qr_payment_qr_payment"
        app:ybsdk_transparentBackground="true"/>
    <com.ybsdk.feature.qr.payments.internal.screens.presentation.view.ImageToolbarView
        android:id="@+id/qrRefreshImageToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/qrRefreshImage"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintBottom_toTopOf="@+id/qrRefreshGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/qrRefreshGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.38"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/qrRefreshTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/qrRefreshGuideline"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/qrRefreshDescrition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/qrRefreshTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/qrRefreshButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
</androidx.constraintlayout.widget.ConstraintLayout>
