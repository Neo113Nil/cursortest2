<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:shape="rectangle"
            app:layout_constraintBottom_toTopOf="@+id/imageGuideline"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/imageGuideline"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintGuide_percent="0.45"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/shimmer45Title"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="133dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageGuideline"
            app:ybsdk_cornerRadius="8dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/shimmer45Text1"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="78dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shimmer45Title"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="188dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shimmer45Text1"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/shimmer45Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="@dimen/ybsdk_stories_shimmer_button_margin_bottom"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:ybsdk_cornerRadius="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
