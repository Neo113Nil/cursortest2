<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messaging.ui.chatlist.organizations.CutoutConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/organization_picker"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/avatar_organization_third"
        android:layout_width="24dp"
        android:layout_height="25dp"
        android:foreground="@drawable/msg_organization_picker_ripple"
        android:contentDescription="@null"
        android:layout_marginStart="-8dp"
        app:cornerRadius="8dp"
        app:cutoutWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_organization_second"
        app:layout_constraintStart_toStartOf="@+id/avatar_organization_second"
        app:layout_constraintTop_toTopOf="@+id/avatar_organization_second"
        app:layout_constraintVertical_bias="0.5"/>
    <ImageView
        android:id="@+id/avatar_organization_second"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:foreground="@drawable/msg_organization_picker_ripple"
        android:contentDescription="@null"
        android:layout_marginStart="-10dp"
        app:cornerRadius="10dp"
        app:cutoutWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/organization_current_layout"
        app:layout_constraintStart_toStartOf="@+id/organization_current_layout"
        app:layout_constraintTop_toTopOf="@+id/organization_current_layout"/>
    <LinearLayout
        android:id="@+id/organization_current_layout"
        android:background="?attr/messagingUserStatusBgOnline"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:foreground="@drawable/msg_organization_picker_ripple"
        android:layout_marginStart="22dp"
        app:cornerRadius="12dp"
        app:cutoutWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/avatar_organization_current"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            app:avatarPadding="0dp"
            app:avatarTextSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/chevron_bottom_outline_xs_regular"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"
            app:tint="?attr/messagingCommonTextPrimaryColor"/>
    </LinearLayout>
    <com.yandex.messaging.views.BadgeView
        android:id="@+id/badge_unread_counter"
        android:background="?attr/messagingCommonCounterColor"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:foreground="@drawable/msg_organization_picker_ripple"
        android:minWidth="16dp"
        android:paddingHorizontal="2dp"
        app:cornerRadius="8dp"
        app:cutoutWidth="1.5dp"
        app:layout_constraintEnd_toStartOf="@+id/organization_current_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.yandex.messaging.ui.chatlist.organizations.CutoutConstraintLayout>
