<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="bottom"
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shimmer_height"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/favorite_container"
        android:background="@drawable/bg_rounded_top"
        android:visibility="gone"
        style="@style/BottomModalContentHolder">
        <ru.yandex.taxi.design.ListTitleComponent
            android:id="@+id/title_component"
            android:background="@drawable/bg_rounded_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_subtitle_size="@dimen/component_text_size_body"
            app:component_subtitle_text_color="?attr/textMain"
            app:component_subtitle_typeface="regular"
            app:component_title_size="@dimen/component_text_size_title"
            app:component_title_text_color="?attr/textMain"
            app:component_title_typeface="bold"/>
        <ru.yandex.taxi.design.AddressInputComponent
            android:id="@+id/address_component"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_address_mode="view"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/bubbles_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/suggested_favorites_modal_view_horizontal_margin"
            android:layout_marginVertical="@dimen/suggested_favorites_modal_view_vertical_margin"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <ru.yandex.taxi.design.ListItemInputComponent
            android:id="@+id/new_categories_edit"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/suggested_favorites_modal_view_vertical_margin"
            android:layout_marginHorizontal="@dimen/suggested_favorites_modal_view_horizontal_margin"
            app:component_force_scrolling_enabled="true"
            app:component_input_type="text"
            app:component_max_lines="1"
            app:show_clear_button_unfocused="true"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textColor="@color/component_cinnaban_toxic"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/error_message"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginHorizontal="@dimen/error_message_horizontal_margin"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/suggested_favorites_modal_view_horizontal_margin"
            android:layout_marginVertical="@dimen/suggested_favorites_modal_view_vertical_margin"
            app:component_background_color="?attr/controlMain"
            app:component_button_accent="true"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControl"/>
    </LinearLayout>
</merge>
