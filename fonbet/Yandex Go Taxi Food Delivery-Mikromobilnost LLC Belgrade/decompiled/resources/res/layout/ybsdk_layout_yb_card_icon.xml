<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageCard"
        android:layout_width="@dimen/ybsdk_card_icon_width"
        android:layout_height="wrap_content"
        android:baselineAlignBottom="true"
        android:minHeight="32dp"
        android:contentDescription="@null"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_card_mir"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageStatus"
        android:background="@drawable/ybsdk_card_status_background"
        android:visibility="gone"
        android:layout_width="@dimen/ybsdk_card_icon_status_width"
        android:layout_height="@dimen/ybsdk_card_icon_status_height"
        android:scaleType="center"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/imageCard"
        app:layout_constraintEnd_toStartOf="@+id/imageCard"
        app:layout_constraintStart_toStartOf="@+id/imageCard"
        app:layout_constraintTop_toTopOf="@+id/imageCard"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:background="@drawable/ybsdk_card_status_background"
        android:layout_width="@dimen/ybsdk_card_icon_status_width"
        android:layout_height="@dimen/ybsdk_card_icon_status_height"
        android:indeterminate="true"
        app:indicatorColor="?attr/ybColor_textIcon_primaryStatic"
        app:indicatorSize="@dimen/ybsdk_card_icon_progress_size"
        app:layout_constraintBottom_toTopOf="@+id/imageCard"
        app:layout_constraintEnd_toStartOf="@+id/imageCard"
        app:layout_constraintStart_toStartOf="@+id/imageCard"
        app:layout_constraintTop_toTopOf="@+id/imageCard"
        app:trackThickness="@dimen/ybsdk_card_icon_progress_thickness"/>
</merge>
