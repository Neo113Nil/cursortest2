<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/chat_create_toolbar_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/chat_create_coordinator"
        android:background="?attr/messagingCommonBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="start|top"
            android:orientation="vertical"
            android:id="@+id/collapsing_button_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/border"
                android:background="?attr/messagingCommonDividerColor"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/messagingCommonAccentTextColor"
                android:gravity="center_vertical"
                android:id="@+id/create_group_chat_btn"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_group_chat"
                android:drawablePadding="10dp"
                android:fontFamily="@font/ya_medium"
                app:drawableStartCompat="@drawable/msg_ic_create_group"/>
            <View
                android:id="@+id/border2"
                android:background="?attr/messagingCommonDividerColor"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/messagingCommonAccentTextColor"
                android:gravity="center_vertical"
                android:id="@+id/create_channel_btn"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_channel"
                android:drawablePadding="10dp"
                android:fontFamily="@font/ya_medium"
                app:drawableStartCompat="@drawable/msg_ic_create_channel"/>
            <View
                android:id="@+id/invite_user_divider"
                android:background="?attr/messagingCommonDividerColor"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/messagingCommonAccentTextColor"
                android:gravity="center_vertical"
                android:id="@+id/invite_user_btn"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/messenger_invite_user"
                android:drawablePadding="10dp"
                android:fontFamily="@font/ya_medium"
                app:drawableStartCompat="@drawable/msg_ic_invite_user"/>
        </LinearLayout>
        <com.yandex.bricks.BrickSlotView
            android:id="@+id/user_list_slot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
