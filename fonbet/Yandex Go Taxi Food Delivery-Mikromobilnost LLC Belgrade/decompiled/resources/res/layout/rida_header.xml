<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/rida_header_height">
    <Space
        android:id="@+id/rida_header_top_margin_space"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/rida_header_logo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_rida_logo"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/rida_header_top_margin_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rida_header_top_margin_space"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/rida_header_skeleton"
        android:visibility="gone"
        android:layout_width="108dp"
        android:layout_height="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rida_header_top_margin_space"
        app:layout_goneMarginTop="32dp"
        app:placeholder_color="@color/component_black_opacity_10"
        app:placeholder_corner_radius="100dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rounded_line"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/rida_header_leading_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/rida_header_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rida_header_subtitle"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:ellipsize="end"
        android:id="@+id/rida_header_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rida_header_leading_icon"
        app:layout_constraintTop_toBottomOf="@+id/rida_header_top_margin_space"
        app:layout_goneMarginStart="16dp"
        app:layout_goneMarginTop="32dp"
        app:robotoFontStyle="bold"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rida_header_subtitle_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="rida_header_skeleton,rida_header_subtitle"/>
    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
        android:textSize="40dp"
        android:id="@+id/rida_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:minLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:letterSpacing="-0.02"
        android:fontFeatureSettings="@string/go_default_font_settings"
        android:lineHeight="42dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rida_header_subtitle_barrier"
        app:robotoFontStyle="heavy"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rida_header_content_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="rida_header_top_margin_space,rida_header_logo,rida_header_skeleton,rida_header_subtitle,rida_header_title"/>
</merge>
