<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/label_root"
    android:background="@color/white"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/go_design_s_space"
    android:paddingEnd="@dimen/go_design_s_space">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:gravity="start|top"
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxWidth="180dp"
        android:maxLines="1"/>
</com.yandex.go.design.view.GoLinearLayout>
