<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="top"
        android:id="@+id/rv"
        android:paddingBottom="136dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/go_design_m_space"/>
    <com.yandex.go.design.view.GoConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_container"
        android:background="@drawable/scooters_top_rounded_floating_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/close_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/go_design_s_space"
            android:layout_marginBottom="@dimen/go_design_m_space"
            android:text="@string/common_close"
            android:layout_marginHorizontal="@dimen/go_design_s_space"
            app:component_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textOnControlMinor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.yandex.go.design.view.GoConstraintLayout>
</com.yandex.go.design.view.GoFrameLayout>
