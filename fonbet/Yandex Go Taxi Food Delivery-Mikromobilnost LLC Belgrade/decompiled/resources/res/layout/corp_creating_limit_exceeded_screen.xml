<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/business_branched_corner_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/corp_success_title_icon"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:srcCompat="@drawable/creating_limit_exceeded_title_drawable"/>
        <ru.yandex.taxi.design.ListTitleComponent
            android:id="@+id/corp_success_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:component_auto_min_height="true"
            app:component_title_size="24sp"
            app:component_title_text_color="?attr/textMain"
            app:component_title_typeface="bold"
            app:component_vertical_padding="0dp"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/corp_success_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:component_auto_min_height="true"
            app:component_title_size="16sp"
            app:component_title_text_color="?attr/textMain"
            app:component_title_typeface="regular"
            app:component_vertical_padding="0dp"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/corp_success_button_accept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
