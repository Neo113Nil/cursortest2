<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/calls_remote_user_avatar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:contentDescription="@null"
        android:elevation="6dp"/>
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:gravity="center_horizontal"
        android:id="@+id/calls_remote_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:fontFamily="@font/ya_bold"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:gravity="center_horizontal"
        android:id="@+id/calls_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:lines="1"
        android:minLines="1"
        android:alpha="0.8"
        android:fontFamily="@font/ya_regular"/>
</LinearLayout>
