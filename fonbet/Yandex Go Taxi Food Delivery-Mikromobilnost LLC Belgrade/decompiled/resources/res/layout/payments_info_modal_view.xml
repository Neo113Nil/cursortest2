<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/error_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/discovery_payments_info_modal_view_error_image_view_margin_top"
        android:src="@drawable/ic_dialog_error"
        android:layout_marginStart="@dimen/discovery_payments_info_modal_view_error_image_view_margin_start"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/title_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginBottom="@dimen/discovery_payments_info_modal_view_subtitle_text_view_margin_top"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        android:accessibilityHeading="true"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/subtitle_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_l_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <com.yandex.go.design.view.GoView
        android:id="@+id/spacer"
        android:background="?attr/textMinor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/discovery_payments_info_modal_view_spacer_height"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:id="@+id/payment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/discovery_payments_info_modal_view_payment_container_height"
        android:layout_marginHorizontal="@dimen/go_design_m_space">
        <com.yandex.go.design.view.GoLinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/payment_method_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_body"
                android:textColor="?attr/textMain"
                android:id="@+id/payment_method_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_section_title"
                android:lineHeight="@dimen/discovery_payments_info_modal_view_payment_method_title_line_height"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="?attr/textMinor"
                android:id="@+id/payment_method_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineHeight="@dimen/discovery_payments_info_modal_view_payment_method_subtitle_line_height"/>
        </com.yandex.go.design.view.GoLinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/card_icon"
            android:layout_width="@dimen/discovery_payments_checkout_buttons_card_icon_width"
            android:layout_height="@dimen/discovery_payments_checkout_buttons_card_icon_height"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/go_design_l_space"/>
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/chevron_next"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/retry_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/discovery_payments_info_modal_view_retry_button_margin_top"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:text="@string/discovery_payments_processing_retry_text"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMain"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControl"
        app:robotoFontStyle="medium"/>
</com.yandex.go.design.view.GoLinearLayout>
