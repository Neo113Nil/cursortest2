<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/chips_container"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/go_design_s_space"
        android:paddingEnd="@dimen/go_design_s_space">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chips_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chips_text"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/chips_icon_loading"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/chips_icon"
            app:layout_constraintEnd_toEndOf="@+id/chips_icon"
            app:layout_constraintStart_toStartOf="@+id/chips_icon"
            app:layout_constraintTop_toTopOf="@+id/chips_icon"
            app:placeholder_animation_time="3000"
            app:placeholder_color="?attr/controlMinor"
            app:placeholder_shimmering="true"
            app:placeholder_type="oval"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chips_start_action"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/chips_start_barrier"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:barrierDirection="end"
            app:constraint_referenced_ids="chips_start_action, chips_icon"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="13dp"
            android:ellipsize="end"
            android:id="@+id/chips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/go_design_s_space"
            android:layout_marginEnd="@dimen/go_design_s_space"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chips_price"
            app:layout_constraintStart_toEndOf="@+id/chips_start_barrier"
            app:layout_constraintTop_toTopOf="parent"
            app:robotoFontStyle="regular"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="13dp"
            android:ellipsize="end"
            android:id="@+id/chips_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/go_design_s_space"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chips_end_action"
            app:layout_constraintStart_toEndOf="@+id/chips_text"
            app:layout_constraintTop_toTopOf="parent"
            app:robotoFontStyle="bold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chips_end_action"
            android:padding="4dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
