<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/scooter_photo_on_comment_item_size"
    android:layout_height="@dimen/scooter_photo_on_comment_item_size">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/scooters_photo"
        android:layout_marginEnd="6dp"/>
    <ru.yandex.taxi.scooters.presentation.feedback.comment.ScootersPhotoRemoveButton
        android:layout_gravity="end|top"
        android:id="@+id/remove_button"
        android:visibility="invisible"
        android:layout_width="32dp"
        android:layout_height="32dp"/>
</com.yandex.go.design.view.GoFrameLayout>
