<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/error_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_dialog_error"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:text="@string/scooters_booking_failed_you_have_a_dept_title"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_image"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/scooters_booking_failed_you_have_a_dept_subtitle"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:enabled="false"
        android:id="@+id/payment_info_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:component_divider_position="top"
        app:component_divider_type="margin"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_subtitle_typeface="regular"
        app:component_title="@string/scooters_payment_method"
        app:component_title_size="@dimen/component_text_size_body"
        app:component_trail_image="@drawable/chevron_next"
        app:layout_constraintBottom_toTopOf="@+id/pay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/payment_loading"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_margin="@dimen/go_design_s_space"
        app:barCornerRadius="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="@+id/payment_info_view"
        app:layout_constraintEnd_toEndOf="@+id/payment_info_view"
        app:layout_constraintStart_toStartOf="@+id/payment_info_view"
        app:layout_constraintTop_toTopOf="@+id/payment_info_view"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:enabled="false"
        android:id="@+id/pay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/payment_info_view"/>
</com.yandex.go.design.view.GoConstraintLayout>
