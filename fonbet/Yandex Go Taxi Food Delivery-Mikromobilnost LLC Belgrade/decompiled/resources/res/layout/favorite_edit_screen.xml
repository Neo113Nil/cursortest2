<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.yandex.taxi.design.ToolbarComponent
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_title="@string/favorite_edit_screen_default_title"
            app:component_title_gravity="center_horizontal"
            app:component_title_typeface="medium"
            app:component_trail_companion_text="@string/favorites_remove_address"
            app:component_trail_companion_text_style="strong"
            style="@style/Component.Toolbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottom_buttons"
            android:layout_below="@+id/toolbar">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ru.yandex.taxi.design.ListItemComponent
                        android:id="@+id/favorites_edit_header_title"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <ru.yandex.taxi.widget.ShimmeringBar
                        android:layout_gravity="center_vertical"
                        android:id="@+id/header_skeleton"
                        android:background="@drawable/bg_rounded"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/favorite_edit_skeleton_shimmering_height"
                        android:layout_marginStart="@dimen/favorite_edit_skeleton_margin_start"
                        android:layout_marginEnd="@dimen/favorite_edit_skeleton_margin_end"
                        android:backgroundTint="?attr/controlMinor"
                        app:barCornerRadius="@dimen/favorite_edit_skeleton_shimmering_radius"/>
                </FrameLayout>
                <include
                    android:id="@+id/map_widget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/header_container"
                    layout="@layout/favorite_edit_map_layout"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/address_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_title_input="@string/favorite_address_title_field"
                    app:component_type_input="textCapSentences"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/map_widget"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/address"
                    android:background="@drawable/bg_clickable_modal_view_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:component_divider_position="bottom"
                    app:component_divider_type="margin"
                    app:component_subtitle_ellipsize_mode="end"
                    app:component_subtitle_max_lines="2"
                    app:component_subtitle_size="@dimen/component_text_size_caption"
                    app:component_title_size="@dimen/component_text_size_body"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/address_name"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/porch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_title_input="@string/favorite_porch_field"
                    app:component_type_input="numberDecimal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/address"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/comment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_input_divider="false"
                    app:component_input_max_lines="8"
                    app:component_title_input="@string/comment_to_driver"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/porch"/>
                <ru.yandex.taxi.design.ListGroupHeaderComponent
                    android:id="@+id/delivery_block_title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    app:component_list_group_title="@string/delivery"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/comment"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/quarters"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_title_input="@string/apartment_or_office"
                    app:component_type_input="textCapSentences"
                    app:layout_constraintEnd_toStartOf="@+id/floor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_block_title"/>
                <View
                    android:id="@+id/delivery_floor_divider"
                    android:background="?attr/line"
                    android:visibility="gone"
                    android:layout_width="0.5dp"
                    android:layout_height="36dp"
                    android:imeOptions="actionNext"
                    app:component_type_input="text"
                    app:layout_constraintBottom_toBottomOf="@+id/quarters"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/quarters"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/floor"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_title_input="@string/floor"
                    app:component_type_input="numberDecimal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/delivery_floor_divider"
                    app:layout_constraintTop_toBottomOf="@+id/delivery_block_title"
                    app:layout_constraintWidth_min="wrap"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/doorphone"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_title_input="@string/intercom"
                    app:component_type_input="textCapSentences"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/floor"/>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/comment_to_courier"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:component_divider_margin_left="@dimen/go_design_m_space"
                    app:component_divider_margin_right="@dimen/go_design_m_space"
                    app:component_input_max_lines="8"
                    app:component_title_input="@string/comment_to_courier"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/doorphone"/>
                <include
                    android:id="@+id/fields_skeleton"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/map_widget"
                    layout="@layout/favorite_edit_fields_skeleton"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <FrameLayout
            android:id="@+id/bottom_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <ru.yandex.taxi.design.ButtonComponent
                android:textSize="17sp"
                android:id="@+id/select_as_destination_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/select_as_destination"
                android:accessibilityLiveRegion="polite"
                app:component_background_color="?attr/controlMinor"
                app:component_title_color="?attr/textOnControlMinor"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/save_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:text="@string/settings_save"
                android:maxLines="2"
                android:accessibilityLiveRegion="polite"
                app:component_button_rounded_corners="true"
                style="@style/settings_modal_view_confirm_button"/>
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>
