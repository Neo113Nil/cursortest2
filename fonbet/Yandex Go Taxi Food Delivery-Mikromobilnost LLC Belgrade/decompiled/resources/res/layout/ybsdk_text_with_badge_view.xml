<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/ybColor_textIcon_primary"
        android:id="@+id/text_badge_bubble"
        android:background="@drawable/ybsdk_rounded_rectangle_background_no_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ybsdk_text_badge_horizontal_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Title3"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_primary"
        android:id="@+id/text_badge_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ybsdk_text_badge_end_margin"
        android:layout_marginEnd="@dimen/ybsdk_padding_badgeview_text_end_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_badge_bubble"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
