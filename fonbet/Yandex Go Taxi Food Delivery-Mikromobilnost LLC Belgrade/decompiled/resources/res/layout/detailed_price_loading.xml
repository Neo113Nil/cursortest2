<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/detailed_price_loading_1"
        android:layout_width="0dp"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginTop="28dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8"
        app:placeholder_corner_radius="100dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/detailed_price_loading_2"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailed_price_loading_1"
        app:placeholder_corner_radius="20dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/detailed_price_loading_3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailed_price_loading_2"
        app:placeholder_corner_radius="20dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
</com.yandex.go.design.view.GoConstraintLayout>
