<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Headline3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/infoButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/ybsdk_ic_info_outline"
        app:tint="?attr/ybColor_textIcon_tertiary"/>
    <com.ybsdk.core.design.spoiler.SpoilerTextView
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/income"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/infoButton"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:ybsdk_spoiler_height="23dp"
        app:ybsdk_spoiler_horizontal_gravity="right"
        app:ybsdk_spoiler_vertical_gravity="bottom"
        app:ybsdk_spoiler_width="99dp"
        style="@style/Widget.YB.Text.Headline3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="end"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/infoButton"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Widget.YB.Text.Body3"/>
    <com.ybsdk.feature.savings.internal.screens.account.view.FundIncomeChartView
        android:id="@+id/chart"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/ybColor_textIcon_tertiary"
        android:id="@+id/dateStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chart"
        style="@style/Widget.YB.Text.Body3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/ybColor_textIcon_tertiary"
        android:gravity="end"
        android:id="@+id/dateEnd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBaseline_toBaselineOf="@+id/dateStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dateStart"
        style="@style/Widget.YB.Text.Body3"/>
    <HorizontalScrollView
        android:id="@+id/periodChipsScroll"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dateStart">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/periodChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
</merge>
