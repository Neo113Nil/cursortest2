<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/modal_layout"
    android:background="@drawable/bg_bottom_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/go_design_s_space">
    <ImageView
        android:id="@+id/icon"
        android:background="@drawable/oval_shape"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_location_fill_24"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="@dimen/go_design_s_space"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="24sp"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:gravity="start"
        android:layout_gravity="start"
        android:id="@+id/geo_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:text="@string/precise_location_permission_need_modal_header"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:gravity="start"
        android:layout_gravity="start"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/precise_location_permission_need_modal_view_description"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/button_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_l_space"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:text="@string/precise_location_permission_need_modal_button_title"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:robotoFontStyle="bold"/>
</LinearLayout>
