<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ListTitleComponent
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_title_gravity="start"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/dialog_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/about"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:component_lead_image="@drawable/ic_help"
        app:component_trail_mode="navigation"/>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/add_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_button_size="L"/>
    </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
</LinearLayout>
