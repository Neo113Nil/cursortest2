<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/operationStatusIcon"
        android:layout_width="@dimen/ybsdk_qr_payments_merchant_icon_size"
        android:layout_height="@dimen/ybsdk_qr_payments_merchant_icon_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/operationStatusProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:indicatorColor="?attr/ybColor_textIcon_quaternary"
        app:layout_constraintBottom_toBottomOf="@+id/operationStatusIcon"
        app:layout_constraintEnd_toEndOf="@+id/operationStatusIcon"
        app:layout_constraintStart_toStartOf="@+id/operationStatusIcon"
        app:layout_constraintTop_toTopOf="@+id/operationStatusIcon"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressView.AroundImage"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/operationStatusProgressSmall"
        android:background="@drawable/ybsdk_circle_button_background"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/operationStatusIcon"
        app:layout_constraintEnd_toEndOf="@+id/operationStatusIcon"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressViewStyleSmall"/>
</merge>
