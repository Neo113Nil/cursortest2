<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hire_driver_content"
    android:background="?attr/bgMain"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/hire_driver_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hire_driver_toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="56dp">
            <ru.yandex.taxi.design.ListTextComponent
                android:id="@+id/hire_driver_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_text_size="@dimen/component_text_size_header"/>
            <ru.yandex.taxi.design.ListTextComponent
                android:id="@+id/hire_driver_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/hire_driver_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="normal"
        app:component_trail_mode="navigation"
        app:layout_constraintBottom_toTopOf="@+id/hire_driver_send_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/hire_driver_send_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_text_color="?attr/textOnControl"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/textOnControl"
        app:component_title_typeface="medium"
        app:layout_constraintBottom_toTopOf="@+id/hire_driver_agreement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/hire_driver_agreement"
        android:paddingTop="@dimen/go_design_s_space"
        android:paddingBottom="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_text_color="?attr/textMinor"
        app:component_text_gravity="center_horizontal"
        app:component_text_size="@dimen/component_text_size_caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/hire_driver_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
