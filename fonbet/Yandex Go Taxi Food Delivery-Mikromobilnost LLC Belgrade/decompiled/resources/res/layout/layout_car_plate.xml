<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/car_plate_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/car_plate_linear_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/car_plate_text_size"
            android:textColor="?attr/textMain"
            android:id="@+id/plate_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="-9sp"
            android:importantForAccessibility="no"
            android:letterSpacing="-0.01"
            android:fontFeatureSettings="pnum, lnum"
            app:robotoFontStyle="medium"/>
        <com.yandex.go.taxi.order.details.v1.ui.CarPlateDividerView
            android:id="@+id/plate_divider_view"
            android:background="?attr/line"
            android:visibility="gone"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="6dp"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/car_plate_region_size"
            android:textColor="?attr/textMain"
            android:layout_gravity="center_horizontal"
            android:id="@+id/region_text"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="-2sp"
            android:importantForAccessibility="no"
            android:textAlignment="center"
            android:letterSpacing="-0.01"
            android:fontFeatureSettings="pnum, lnum"
            app:robotoFontStyle="medium"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</merge>
