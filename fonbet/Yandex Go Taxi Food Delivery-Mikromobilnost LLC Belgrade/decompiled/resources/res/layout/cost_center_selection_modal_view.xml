<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/cost_center_selection_top_spacing"
        style="@style/BottomModalContentHolder">
        <ru.yandex.taxi.design.ToolbarComponent
            android:id="@+id/cost_center_toolbar"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_divider_position="bottom"
            app:component_divider_type="normal"
            app:component_show_close_button="false"
            app:component_show_navigation_button="false"
            app:component_subtitle_gravity="center_horizontal"
            app:component_title="@string/cost_centers_selection_title"
            app:component_title_gravity="center_horizontal"
            app:component_title_size="@dimen/component_text_size_body"
            app:component_title_typeface="bold"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.design.ListItemInputComponent
            android:id="@+id/cost_center_filter"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            app:component_divider_position="bottom"
            app:component_divider_type="normal"
            app:component_input_clear_enable="true"
            app:layout_constraintTop_toBottomOf="@+id/cost_center_toolbar"/>
        <View
            android:id="@+id/ui_spacing"
            android:background="@color/component_gray_100"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@+id/cost_center_filter"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cost_center_variants"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/confirm"
            app:layout_constraintTop_toBottomOf="@+id/ui_spacing"/>
        <ru.yandex.taxi.widget.progress.CircularProgressBar
            android:layout_gravity="center"
            android:id="@+id/cost_center_spinner"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="@+id/cost_center_variants"
            app:layout_constraintEnd_toEndOf="@+id/cost_center_variants"
            app:layout_constraintStart_toStartOf="@+id/cost_center_variants"
            app:layout_constraintTop_toTopOf="@+id/cost_center_variants"/>
        <ru.yandex.taxi.design.ListTextComponent
            android:id="@+id/cost_center_empty_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_text="@string/cost_centers_selection_not_found"
            app:layout_constraintTop_toTopOf="@+id/cost_center_variants"/>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/list_shadow"
            android:background="0x7f081870"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/cost_center_variants"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_done"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/BottomEdgeButtonMarginStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
