<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_show_navigation_button="true"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/details_items_title_size"
        app:fontFamily="@font/ys_text_medium"/>
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yandex.go.design.view.GoLinearLayout
                android:id="@+id/banner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/payment_methods_banner_top_margin"
                android:layout_marginBottom="@dimen/details_items_vertical_margin"
                android:layout_marginHorizontal="@dimen/details_items_horizontal_margin">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/details_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_subtitle_size="@dimen/details_items_subtitle_size"
                    app:component_title_size="@dimen/details_items_title_size"
                    app:component_title_typeface="medium"
                    app:component_trail_mode="icon"
                    app:component_trail_vertical_gravity="top"
                    app:fontFamily="@font/ys_text_regular"/>
            </com.yandex.go.design.view.GoLinearLayout>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/sbp_token_details"
                android:background="@drawable/bg_payment_card_details_rounded_20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/details_items_vertical_margin"
                android:layout_marginHorizontal="@dimen/details_items_horizontal_margin"
                app:component_subtitle_text_color="?attr/textMain"
                app:component_subtitle_typeface="regular"
                app:component_title_size="@dimen/details_items_sbp_token_title_size"
                app:component_title_text_color="?attr/textMain"
                app:component_title_typeface="medium"
                app:fontFamily="@font/ys_text_regular"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/card_layout"
                android:background="@drawable/bg_payment_card_details_rounded_20dp"
                android:padding="@dimen/details_items_card_layout_padding"
                android:layout_width="match_parent"
                android:layout_height="@dimen/details_items_card_layout_height"
                android:layout_marginBottom="@dimen/details_items_vertical_margin"
                android:layout_marginHorizontal="@dimen/details_items_horizontal_margin">
                <com.yandex.go.design.view.GoFrameLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/details_items_height">
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="@dimen/details_items_card_error_info_text_size"
                        android:textColor="?attr/error"
                        android:gravity="start|top"
                        android:id="@+id/card_error_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/details_items_vertical_margin"
                        android:maxLines="1"
                        app:fontFamily="@font/ys_text_regular"/>
                    <com.yandex.go.design.view.GoImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/icon_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.yandex.go.design.view.GoFrameLayout>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textColor="?attr/textMain"
                    android:id="@+id/card_number"
                    android:layout_width="@dimen/details_items_card_number_width"
                    android:layout_height="@dimen/details_items_height"
                    android:maxLines="1"
                    android:lineSpacingExtra="1sp"
                    android:layout_marginVertical="@dimen/details_items_vertical_margin"
                    app:autoSizeMaxTextSize="@dimen/details_items_card_number_text_size"
                    app:autoSizeTextType="uniform"
                    app:fontFamily="@font/ys_text_medium"/>
                <com.yandex.go.design.view.GoFrameLayout
                    android:gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/details_items_card_layout_bottom_height">
                    <com.yandex.go.design.view.GoLinearLayout
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/card_expired_image"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_payment_card_expired"
                            android:layout_marginEnd="@dimen/details_items_card_expired_image_margin_end"/>
                        <ru.yandex.taxi.widget.RobotoTextView
                            android:textSize="@dimen/card_info_expiry_text_size"
                            android:textColor="?attr/textMain"
                            android:gravity="center"
                            android:id="@+id/card_exp_date"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/details_items_card_expired_height"
                            app:fontFamily="@font/ys_text_medium"/>
                    </com.yandex.go.design.view.GoLinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="end|bottom"
                        android:id="@+id/icon_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.yandex.go.design.view.GoFrameLayout>
            </com.yandex.go.design.view.GoLinearLayout>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/confirm"
                android:background="@drawable/bg_reject_delete_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/details_items_vertical_margin"
                android:layout_marginHorizontal="@dimen/details_items_horizontal_margin"
                app:component_lead_image="@drawable/ic_payment_verify"
                app:component_lead_image_tint="?attr/textMain"
                app:component_subtitle_size="@dimen/details_items_subtitle_size"
                app:component_title="@string/payment_antifraud_verify"
                app:component_title_size="@dimen/details_items_title_size"
                app:component_trail_image="@drawable/chevron_next"
                app:component_trail_image_tint="?attr/textMain"
                app:fontFamily="@font/ys_text_regular"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/delete_item_notification"
                android:background="@drawable/bg_reject_delete_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/details_items_vertical_margin"
                android:layout_marginHorizontal="@dimen/details_items_horizontal_margin"
                app:component_lead_image="@drawable/ic_payment_delete_info"
                app:component_subtitle="@string/payment_method_deletion_with_orders_unavailable_subtitle"
                app:component_subtitle_size="@dimen/details_items_subtitle_size"
                app:component_title="@string/payment_method_deletion_with_orders_unavailable_title"
                app:component_title_size="@dimen/details_items_title_size"
                app:fontFamily="@font/ys_text_regular"/>
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/divider"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_lead_image="@drawable/ic_payment_delete"
                app:component_title="@string/common_remove"
                app:component_title_size="@dimen/details_items_title_size"
                app:component_title_text_color="?attr/error"
                app:fontFamily="@font/ys_text_regular"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </ScrollView>
</LinearLayout>
