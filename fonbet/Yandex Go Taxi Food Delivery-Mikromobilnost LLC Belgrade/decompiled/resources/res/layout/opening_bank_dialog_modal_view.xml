<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="regular"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16dp"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/main_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="16dp"
        android:id="@+id/additional_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:component_background_color="?attr/controlMinor"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintBottom_toBottomOf="@+id/main_button"
        app:layout_constraintEnd_toStartOf="@+id/main_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_button"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="16dp"
        android:id="@+id/main_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_button_accent="true"
        app:component_button_size="L"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/additional_button"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="13dp"
        android:textColor="@color/component_gray_300"
        android:gravity="center"
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textAlignment="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:flow_verticalAlign="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
