<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.progress.CircularProgressBar
        android:layout_gravity="center"
        android:id="@+id/trusted_contacts_loading"
        android:visibility="gone"
        android:layout_width="@dimen/trusted_contacts_loading_view_size"
        android:layout_height="@dimen/trusted_contacts_loading_view_size"/>
    <FrameLayout
        android:id="@+id/trusted_contacts_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.yandex.taxi.design.ToolbarComponent
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/trusted_contacts_toolbar_height"
            app:component_show_navigation_button="false"
            app:component_title_gravity="center_horizontal"
            app:component_title_size="@dimen/component_text_size_body"
            app:component_title_typeface="medium"
            style="@style/Component.Toolbar"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/trusted_contacts_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/trusted_contacts_xl_space"
            android:layout_marginBottom="@dimen/trusted_contacts_xxxl_space"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="bottom"
            android:id="@+id/trusted_contacts_bottom_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/trusted_contacts_xxxl_space"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/trusted_contacts_divider"
            android:background="@drawable/bg_rounded_24dp_modal_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/trusted_contacts_bottom_content_height">
            <ru.yandex.taxi.design.ButtonComponent
                android:layout_gravity="bottom"
                android:id="@+id/trusted_contacts_action_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/trusted_contacts_action_button_height"
                android:layout_margin="@dimen/go_design_s_space"
                app:component_background_color="?attr/controlMain"
                app:component_button_accent="true"
                app:component_button_size="L"
                app:component_title_color="?attr/textOnControl"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
