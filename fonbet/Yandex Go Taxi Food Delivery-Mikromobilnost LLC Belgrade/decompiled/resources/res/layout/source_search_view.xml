<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bottom_shadow"
        android:background="@drawable/round_corners_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_alignBottom="@+id/bottom_space"
        android:layout_alignParentTop="true"/>
    <View
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/address_input_stub"/>
    <View
        android:id="@+id/address_input_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignTop="@+id/address_input"
        android:layout_alignBottom="@+id/address_input"
        android:importantForAccessibility="no"/>
    <ru.yandex.taxi.design.AddressInputComponent
        android:id="@+id/address_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_below="@+id/source_header"
        android:layout_marginEnd="@dimen/go_design_s_space"/>
    <View
        android:id="@+id/address_input_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <ru.yandex.taxi.preorder.suggested.selection.SuggestsView
        android:id="@+id/suggests_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/address_input"
        android:layout_alignParentBottom="true"
        android:translationZ="-1dp"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/suggests_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/address_input"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        layout="@layout/search_address_shimmering"/>
    <ViewStub
        android:id="@+id/empty_message_stub"
        android:layout="@layout/text_message"
        android:inflatedId="@+id/message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_below="@+id/address_input"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
