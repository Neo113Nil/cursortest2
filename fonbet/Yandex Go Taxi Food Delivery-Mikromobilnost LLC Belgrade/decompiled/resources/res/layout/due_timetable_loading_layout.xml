<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/day_selector_card"
        android:background="@drawable/round_section_bg_bottom"
        android:paddingBottom="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">
        <ru.yandex.taxi.widget.ShimmeringBar
            android:id="@+id/shimmering_day_selector"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/go_design_m_space"
            android:layout_marginEnd="32dp"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/cardDivider"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/due_timetable_card"
        android:background="@drawable/round_section_bg_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.ShimmeringBar
            android:layout_gravity="center"
            android:id="@+id/shimmering_price"
            android:layout_width="136dp"
            android:layout_height="16dp"
            android:layout_marginTop="20dp"/>
        <com.yandex.go.due_timetable.presentation.widget.ShimmeringDueTimetableView
            android:id="@+id/shimmering_due_timetable"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="40dp"/>
    </LinearLayout>
</LinearLayout>
