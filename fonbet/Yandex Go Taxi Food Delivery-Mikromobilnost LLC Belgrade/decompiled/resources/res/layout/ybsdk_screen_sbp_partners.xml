<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/sbpAccountsBanksToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/sbpAccountsBanksFilterInput"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"
        app:ybsdk_subtitle="@string/ybsdk_sbp_account_sbp_accounts_subtitle"
        app:ybsdk_title="@string/ybsdk_sbp_account_sbp_account_bank_selection"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/sbpAccountsBanksFilterInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/sbpAccountsBanksRecycler"
        app:layout_constraintTop_toBottomOf="@+id/sbpAccountsBanksToolbar"
        app:ybsdk_inputLabel="@string/ybsdk_transfer_transfer_bank_destination_title"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithoutBackground"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sbpAccountsBanksRecycler"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbpAccountsBanksFilterInput"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/sbpAccountsBanksErrorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbpAccountsBanksToolbar"/>
    <com.ybsdk.feature.main.internal.widgets.SbpYbsCustomErrorView
        android:id="@+id/sbpAccountsBanksCustomErrorView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbpAccountsBanksFilterInput"/>
</androidx.constraintlayout.widget.ConstraintLayout>
