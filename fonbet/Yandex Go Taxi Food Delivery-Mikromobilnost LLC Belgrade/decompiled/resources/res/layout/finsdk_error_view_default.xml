<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/finsdkCloseButton"
        android:background="@drawable/finsdk_ic_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/finsdkLinearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/finsdkTryAgainButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/finsdkCloseButton"
        app:layout_constraintVertical_bias="0.35">
        <View
            android:background="@drawable/finsdk_ic_warning"
            android:layout_width="72dp"
            android:layout_height="72dp"/>
        <TextView
            android:textAppearance="@style/FinsdkTextAppearance.Heading.M.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/finsdk_something_happened"
            android:textAlignment="center"/>
        <TextView
            android:textAppearance="@style/FinsdkTextAppearance.Text.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/finsdk_try_again"
            android:textAlignment="center"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/FinsdkTextAppearance.Text.L.Medium.PrimaryInverted"
        android:gravity="center"
        android:id="@+id/finsdkTryAgainButton"
        android:background="@drawable/finsdk_bg_radius_16"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/finsdk_try_again"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
