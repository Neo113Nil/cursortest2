<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/vertical_center_guide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/car_image"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/driver_section_simple_car_image_height"
        android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
        android:importantForAccessibility="no"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/avatar_background"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoView
        android:id="@+id/avatar_background"
        android:background="@drawable/driver_simple_avatar_bg_rounded"
        android:layout_width="@dimen/driver_section_simple_avatar_border_size"
        android:layout_height="@dimen/driver_section_simple_avatar_border_size"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/vertical_center_guide"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="-2dp"/>
    <ru.yandex.taxi.widget.ShimmeringImageView
        android:id="@+id/avatar_image"
        android:background="@drawable/driver_simple_avatar_ripple"
        android:layout_width="@dimen/driver_section_simple_avatar_image_size"
        android:layout_height="@dimen/driver_section_simple_avatar_image_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_background"
        app:layout_constraintEnd_toEndOf="@+id/avatar_background"
        app:layout_constraintStart_toStartOf="@+id/avatar_background"
        app:layout_constraintTop_toTopOf="@+id/avatar_background"/>
</merge>
