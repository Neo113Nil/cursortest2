<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <com.yandex.messaging.views.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/preview_image"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:leftBottomRadius="4dp"
            app:leftTopRadius="4dp"
            app:rightBottomRadius="4dp"
            app:rightTopRadius="4dp"/>
        <include
            android:layout_gravity="center"
            android:layout_width="@dimen/chat_preview_size"
            android:layout_height="@dimen/chat_preview_size"
            layout="@layout/msg_image_status_button"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/url_video_play_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:srcCompat="@drawable/msg_url_video_play_button"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13sp"
        android:textColor="?attr/messagingCommonAccentTextColor"
        android:ellipsize="end"
        android:id="@+id/url_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:fontFamily="@font/ya_medium"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:ellipsize="end"
        android:id="@+id/url_preview_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:lineSpacingExtra="2sp"
        android:fontFamily="@font/ya_medium"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.alicekit.core.views.EllipsizingTextView
            android:textSize="@dimen/messaging_default_url_preview_content_text"
            android:textColor="?attr/messagingCommonTextPrimaryColor"
            android:ellipsize="end"
            android:id="@+id/url_preview_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/ya_regular"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <include
            android:gravity="bottom"
            android:layout_gravity="end|bottom"
            android:orientation="horizontal"
            android:id="@+id/video_url_preview_message_status"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            layout="@layout/msg_default_url_preview_message_status_and_time"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/url_video_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="url_video_play_button"/>
</LinearLayout>
