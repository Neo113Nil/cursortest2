<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/status_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMain"
        android:id="@+id/status_title"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        style="@style/settings_modal_view_message.title"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMinor"
        android:id="@+id/status_text"
        style="@style/settings_modal_view_message"/>
</LinearLayout>
