<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="visible"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:id="@+id/top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="medium"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/back_float_btn"
        android:background="@drawable/background_circle_button"
        android:padding="12dp"
        android:focusable="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_left"
        android:contentDescription="@string/common_back"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_title"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/error_icon"
        android:padding="10dp"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_vault_fallback"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="24sp"
        android:id="@+id/error_icon_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/error_icon"
        app:layout_constraintStart_toStartOf="@+id/error_icon"
        app:layout_constraintTop_toBottomOf="@+id/error_icon"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="16sp"
        android:id="@+id/close_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/ys_text_regular"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/reload_btn"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="16sp"
        android:id="@+id/reload_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="36dp"
        android:fontFamily="@font/ys_text_regular"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
