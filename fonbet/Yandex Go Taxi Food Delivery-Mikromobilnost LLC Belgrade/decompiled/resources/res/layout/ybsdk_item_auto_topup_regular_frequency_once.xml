<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frequency_once"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@+id/autotopupFrequencyList">
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/autotopupAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="@dimen/ybsdk_loadable_input_height"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_should_restore_saved_instance_state="false"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    <View
        android:id="@+id/autotopupDateBackground"
        android:background="@drawable/ybsdk_autotopup_saver_source_background"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/autotopupAmount"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/autotopupDateArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ybsdk_ic_navigation_arrowdown"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupDateBackground"
        app:layout_constraintEnd_toEndOf="@+id/autotopupDateBackground"
        app:layout_constraintTop_toTopOf="@+id/autotopupDateBackground"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/autotopupDateHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/autotopupDateTitle"
        app:layout_constraintEnd_toStartOf="@+id/autotopupDateArrow"
        app:layout_constraintStart_toStartOf="@+id/autotopupDateBackground"
        app:layout_constraintTop_toTopOf="@+id/autotopupDateBackground"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/autotopupDateTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/autotopupDateBackground"
        app:layout_constraintEnd_toStartOf="@+id/autotopupDateArrow"
        app:layout_constraintStart_toStartOf="@+id/autotopupDateBackground"
        app:layout_constraintTop_toBottomOf="@+id/autotopupDateHint"
        style="@style/Widget.YB.Text.Body1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
