<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="?attr/bgMain">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:background="?attr/bgMain"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_title"
                android:textColor="?attr/textMain"
                android:id="@+id/tv_sharing_favorites_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sharing_favorites_title_top_padding"
                android:layout_marginStart="@dimen/sharing_favorites_title_side_padding"
                android:layout_marginEnd="@dimen/sharing_favorites_title_side_padding"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:robotoFontStyle="bold"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/item_send_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sharing_favorites_share_btn_top_padding"
                app:component_lead_image="@drawable/ic_share_location"
                app:component_subtitle_text_color="?attr/textMinor"
                app:component_title_text_color="?attr/textMain"
                app:component_title_typeface="medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sharing_favorites_title"/>
            <ru.yandex.taxi.design.ListGroupHeaderComponent
                android:id="@+id/header_choose_favorites"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/item_send_location"/>
            <FrameLayout
                android:id="@+id/favorites_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_choose_favorites">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/favorites_list"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </FrameLayout>
            <ru.yandex.taxi.design.ListGroupHeaderComponent
                android:id="@+id/header_add_to_favorites"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/favorites_container"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/item_add_to_favorites"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:component_lead_image="@drawable/ic_round_add_favorites"
                app:component_subtitle_text_color="?attr/textMinor"
                app:component_title_text_color="?attr/textMain"
                app:component_title_typeface="medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_add_to_favorites"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</merge>
