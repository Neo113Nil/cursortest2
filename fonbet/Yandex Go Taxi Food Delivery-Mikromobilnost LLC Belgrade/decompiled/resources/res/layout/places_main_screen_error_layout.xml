<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_24dp_modal_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="?attr/bgMain">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/icon"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/ic_places_main_screen_error_placeholder"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/close_button"
        android:padding="@dimen/go_design_s_space"
        android:layout_width="@dimen/discovery_close_button_size"
        android:layout_height="@dimen/discovery_close_button_size"
        android:layout_marginTop="@dimen/discovery_close_button_margin_top"
        android:foregroundGravity=""
        android:contentDescription="@string/common_close"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cross_filled"
        app:tint="?attr/iconMinor"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="30sp"
        android:textColor="?attr/textMain"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/discovery_organization_main_wrong"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/subtitle"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:text="@string/discovery_organizations_main_connection"
        android:fontFamily="@font/ys_text_regular"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/reload"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/reload"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/discovery_organizations_main_again"
        app:component_background_color="?attr/controlMain"
        app:component_button_accent="true"
        app:component_title_color="?attr/textOnControl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
</com.yandex.go.design.view.GoConstraintLayout>
