<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ybsdk_shimmer_auto_start="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/itemRoot"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_settings_item_top_margin"
        android:layout_marginBottom="@dimen/ybsdk_settings_item_bottom_margin">
        <TextView
            android:textColor="@color/ybsdk_settings_title_text_color"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ybsdk_transfer_settings_item_title_margin_end"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintEnd_toStartOf="@+id/chevron"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="16dp"
            style="@style/Widget.YB.Text.Title1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chevron"
            android:layout_width="@dimen/ybsdk_settings_button_icon_size"
            android:layout_height="@dimen/ybsdk_settings_button_icon_size"
            android:layout_marginTop="@dimen/ybsdk_transfer_settings_item_switch_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title"
            app:srcCompat="@drawable/ybsdk_ic_chevron_forward"/>
        <TextView
            android:textColor="?attr/ybColor_textIcon_secondary"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ybsdk_transfer_settings_item_subtitle_margin_top"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/title"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Widget.YB.Text.Body3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
