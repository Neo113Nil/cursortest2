<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="400dp">
    <ru.yandex.taxi.design.FloatingTitleToolbarComponent
        android:id="@+id/safety_center_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        app:component_title_image="@drawable/ic_heart"
        app:component_title_image_background="@drawable/gray_circle"
        app:component_title_image_size="48dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/safety_center_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/safety_center_toolbar"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/center_horizontal_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/safety_center_after"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        app:component_background_color="@color/component_gray_150"
        app:component_title_color="@color/component_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/center_horizontal_guideline"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/safety_center_add"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="4dp"
        app:component_background_color="@color/component_accent_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/center_horizontal_guideline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
