<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/ybsdk_toolbar_height"
    android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/sbpTitlePartOne"
            android:layout_width="218dp"
            android:layout_height="20dp"
            android:layout_marginTop="28dp"
            app:ybsdk_cornerRadius="@dimen/ybsdk_transfer_settings_item_skeleton_corner_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/sbpTitlePartTwo"
            android:layout_width="287dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            app:ybsdk_cornerRadius="@dimen/ybsdk_transfer_settings_item_skeleton_corner_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/sbpDescriptionPartOne"
            android:layout_width="287dp"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            app:ybsdk_cornerRadius="@dimen/ybsdk_transfer_settings_item_skeleton_corner_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/sbpDescriptionPartTwo"
            android:layout_width="247dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            app:ybsdk_cornerRadius="@dimen/ybsdk_transfer_settings_item_skeleton_corner_radius"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerOne"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/iconOne"
                android:layout_width="@dimen/ybsdk_clickable_icon_size"
                android:layout_height="@dimen/ybsdk_clickable_icon_size"
                android:shape="oval"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/titleOne"
                android:layout_width="195dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconOne"
                app:layout_constraintTop_toTopOf="parent"
                app:ybsdk_cornerRadius="4dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerTwo"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/iconTwo"
                android:layout_width="@dimen/ybsdk_clickable_icon_size"
                android:layout_height="@dimen/ybsdk_clickable_icon_size"
                android:shape="oval"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/titleTwo"
                android:layout_width="195dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconTwo"
                app:layout_constraintTop_toTopOf="parent"
                app:ybsdk_cornerRadius="4dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerThree"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/iconThree"
                android:layout_width="@dimen/ybsdk_clickable_icon_size"
                android:layout_height="@dimen/ybsdk_clickable_icon_size"
                android:shape="oval"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/titleThree"
                android:layout_width="195dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconThree"
                app:layout_constraintTop_toTopOf="parent"
                app:ybsdk_cornerRadius="4dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerFour"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/iconFour"
                android:layout_width="@dimen/ybsdk_clickable_icon_size"
                android:layout_height="@dimen/ybsdk_clickable_icon_size"
                android:shape="oval"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/titleFour"
                android:layout_width="195dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconFour"
                app:layout_constraintTop_toTopOf="parent"
                app:ybsdk_cornerRadius="4dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerFive"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/iconFive"
                android:layout_width="@dimen/ybsdk_clickable_icon_size"
                android:layout_height="@dimen/ybsdk_clickable_icon_size"
                android:shape="oval"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:id="@+id/titleFive"
                android:layout_width="195dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconFive"
                app:layout_constraintTop_toTopOf="parent"
                app:ybsdk_cornerRadius="4dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
