<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/go_design_m_space"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/loading_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="icon_placeholder, title_placeholder, content_placeholder, button_placeholder"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/icon_placeholder"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholder_corner_radius="@dimen/go_design_s_space"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/title_placeholder"
        android:layout_width="152dp"
        android:layout_height="28dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_placeholder"
        app:placeholder_corner_radius="@dimen/go_design_s_space"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/content_placeholder"
        android:layout_width="0dp"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_placeholder"
        app:placeholder_corner_radius="@dimen/go_design_s_space"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/button_placeholder"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_placeholder"
        app:placeholder_corner_radius="@dimen/button_component_default_rounded_corners_radius"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/content_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="header_icon, title_text, content_text, widgets_layout"/>
    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:maxWidth="@dimen/popup_icon_max_size"
        android:maxHeight="@dimen/popup_icon_max_size"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_icon"
        app:layout_goneMarginTop="0dp"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/content_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widgets_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
