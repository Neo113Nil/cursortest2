<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/delivery_point_content_extended"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/address_column_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3333"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/address_column_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6667"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/requirement_address_point"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        app:component_lead_image="@drawable/ic_summary_destination_point"
        app:component_title_input="@string/short_text"
        app:component_title_max_lines="1"
        app:layout_constraintEnd_toStartOf="@+id/address_column_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="?attr/line"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/requirement_address_point"
        app:layout_constraintEnd_toEndOf="@+id/address_column_2"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/requirement_address_porch_input"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="8dp"
        app:component_divider_margin_left="2dp"
        app:component_divider_margin_right="8dp"
        app:component_input_divider="true"
        app:layout_constraintBottom_toBottomOf="@+id/requirement_address_point"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/address_column_2"
        app:layout_constraintTop_toTopOf="@+id/requirement_address_point"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/requirement_address_apartment_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="2dp"
        app:component_divider_margin_left="8dp"
        app:component_divider_margin_right="2dp"
        app:component_input_divider="true"
        app:layout_constraintEnd_toEndOf="@+id/address_column_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/requirement_address_point"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/requirement_address_floor_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        app:component_divider_margin_left="2dp"
        app:component_divider_margin_right="2dp"
        app:component_input_divider="true"
        app:layout_constraintEnd_toEndOf="@+id/address_column_2"
        app:layout_constraintStart_toStartOf="@+id/address_column_1"
        app:layout_constraintTop_toBottomOf="@+id/requirement_address_point"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/requirement_address_door_phone_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="8dp"
        app:component_divider_margin_left="2dp"
        app:component_divider_margin_right="8dp"
        app:component_input_divider="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/address_column_2"
        app:layout_constraintTop_toBottomOf="@+id/requirement_address_point"/>
</androidx.constraintlayout.widget.ConstraintLayout>
