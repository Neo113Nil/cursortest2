<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/section_header_height"
        android:paddingStart="@dimen/content_horizontal_padding"
        android:layout_marginHorizontal="@dimen/component_medium_margin">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/section_header_text_size"
            android:textColor="?attr/textMinor"
            android:layout_gravity="center_vertical"
            android:id="@+id/seats_banner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:layout_gravity="center_vertical"
            android:id="@+id/seats_counter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/component_medium_margin"
            android:layout_marginEnd="4dp"
            app:component_lead_image="@drawable/intercity_minus"
            app:component_lead_image_padding_left="8dp"
            app:component_lead_image_padding_right="8dp"
            app:component_lead_image_size="40dp"
            app:component_lead_image_tint="?attr/textMain"
            app:component_rounded_background="?attr/bgMain"
            app:component_title_gravity="center_horizontal"
            app:component_title_size="@dimen/section_header_text_size"
            app:component_title_typeface="medium"
            app:component_title_use_minimum_width="true"
            app:component_titles_gravity="center_vertical"
            app:component_trail_image="@drawable/intercity_plus"
            app:component_trail_image_padding_left="8dp"
            app:component_trail_image_padding_right="8dp"
            app:component_trail_image_size="40dp"
            app:component_trail_image_tint="?attr/textMain"
            app:component_trail_vertical_gravity="center"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
