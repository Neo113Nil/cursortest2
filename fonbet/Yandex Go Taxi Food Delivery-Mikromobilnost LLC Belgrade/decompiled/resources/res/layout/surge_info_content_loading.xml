<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/surge_info_loading_1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholder_shimmering="true"
        app:placeholder_type="oval"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/surge_info_loading_2"
        android:layout_width="132dp"
        android:layout_height="28dp"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/surge_info_loading_1"
        app:placeholder_corner_radius="6dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/surge_info_loading_3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/surge_info_loading_2"
        app:placeholder_corner_radius="6dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/surge_info_loading_4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginTop="4dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/surge_info_loading_3"
        app:placeholder_corner_radius="6dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/surge_info_loading_5"
        android:layout_width="164dp"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginTop="4dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/surge_info_loading_4"
        app:placeholder_corner_radius="6dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/surge_info_loading_6"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="62dp"
        android:layout_marginBottom="14.5dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/surge_info_loading_5"
        app:placeholder_corner_radius="6dp"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
