<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.dashboard.DashboardViewLayout
        android:id="@+id/dashboardLayout"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.dashboard.DashboardCollapsingBalanceView
            android:gravity="bottom"
            android:id="@+id/linearLayout"
            android:tag="@string/ybsdk_tag_balance_view_container"
            android:paddingLeft="@dimen/ybsdk_screen_dashboard_padding_horizontal"
            android:paddingRight="@dimen/ybsdk_screen_dashboard_padding_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ybsdk.widgets.common.GradientTextView
                android:ellipsize="none"
                android:gravity="center_vertical"
                android:id="@+id/plusBalanceView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawableLeft="@drawable/ybsdk_ic_plus_badge"
                android:drawablePadding="8dp"
                android:lineSpacingExtra="0sp"
                app:layout_constraintBottom_toTopOf="@+id/accountBalanceView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"
                app:ybsdk_gradientColors="@array/ybsdk_plus_colors_array"
                app:ybsdk_gradientDirection="left"
                style="@style/Widget.YB.Text.Title1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/walletIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="@+id/accountTitleView"
                app:layout_constraintEnd_toStartOf="@+id/accountTitleView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/accountTitleView"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/accountTitleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:lineSpacingExtra="0sp"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toTopOf="@+id/accountBalanceView"
                app:layout_constraintStart_toEndOf="@+id/walletIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Widget.YB.Text.Title1"/>
            <com.ybsdk.widgets.common.DashboardBalanceTextView
                android:textColor="?attr/ybColor_textIcon_primary"
                android:gravity="center_vertical"
                android:id="@+id/accountBalanceView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_dashboard_account_balance_top_margin"
                android:maxLines="1"
                android:lineSpacingExtra="0sp"
                app:layout_constraintBottom_toTopOf="@+id/payButtonsContainer"
                app:layout_constraintEnd_toStartOf="@+id/cardStatusView"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/plusBalanceView"
                app:ybsdk_spoiler_height="44dp"
                app:ybsdk_spoiler_vertical_gravity="bottom"
                app:ybsdk_spoiler_width="219dp"
                style="@style/Widget.YB.Text.Numbers2"/>
            <include
                android:id="@+id/shimmerLayoutBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/accountBalanceView"
                app:layout_constraintEnd_toEndOf="@+id/accountBalanceView"
                app:layout_constraintStart_toStartOf="@+id/plusBalanceView"
                app:layout_constraintTop_toTopOf="@+id/plusBalanceView"
                layout="@layout/ybsdk_item_dashboard_balance_loading"/>
            <com.ybsdk.widgets.common.YbCardIconView
                android:id="@+id/cardStatusView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/accountBalanceView"
                app:layout_constraintEnd_toEndOf="parent"/>
            <LinearLayout
                android:layout_gravity="bottom"
                android:id="@+id/payButtonsContainer"
                android:tag="@string/ybsdk_tag_dashboard_middle_container_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_dashboard_buttons_top_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/accountBalanceView">
                <TextView
                    android:gravity="left"
                    android:id="@+id/subtitleTextView"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="0"
                    style="@style/Widget.YB.Text.Body3"/>
                <com.ybsdk.widgets.common.YbButtonView
                    android:enabled="false"
                    android:gravity="center_horizontal"
                    android:id="@+id/replenishButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/ybsdk_screen_dashboard_buttons_margin"
                    android:layout_weight="1"
                    style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Secondary.M"/>
                <com.ybsdk.widgets.common.YbButtonView
                    android:enabled="false"
                    android:gravity="center_horizontal"
                    android:id="@+id/transferButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Secondary.M"/>
            </LinearLayout>
            <include
                android:id="@+id/shimmerLayoutButtons"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/payButtonsContainer"
                app:layout_constraintEnd_toEndOf="@+id/payButtonsContainer"
                app:layout_constraintStart_toStartOf="@+id/payButtonsContainer"
                app:layout_constraintTop_toTopOf="@+id/payButtonsContainer"
                layout="@layout/ybsdk_item_dashboard_buttons_loading"/>
            <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerBalanceSubtitle"
                android:layout_width="220dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/payButtonsContainer"
                app:layout_constraintStart_toStartOf="@+id/payButtonsContainer"
                app:layout_constraintTop_toTopOf="@+id/payButtonsContainer">
                <com.ybsdk.widgets.common.SkeletonView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:ybsdk_cornerRadius="6dp"/>
            </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
        </com.ybsdk.widgets.common.dashboard.DashboardCollapsingBalanceView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="@string/ybsdk_tag_dashboard_toolbar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no">
            <View
                android:id="@+id/toolbarClickableArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/toolbarIconsContainer"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/logoPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/ybsdk_toolbar_dashboard_start_padding"
                android:contentDescription="@string/ybsdk_common_app_name"
                android:importantForAccessibility="yes"
                app:layout_constraintLeft_toLeftOf="parent">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/userAvatar"
                    android:layout_width="@dimen/ybsdk_dashboard_user_avatar"
                    android:layout_height="@dimen/ybsdk_dashboard_user_avatar"
                    android:importantForAccessibility="no"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/logo"
                    android:layout_width="@dimen/ybsdk_toolbar_logo_size"
                    android:layout_height="@dimen/ybsdk_toolbar_logo_size"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="8dp"
                    app:srcCompat="@drawable/ybsdk_ic_yandex_wallet"/>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/logoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    style="@style/Widget.YB.Text.Headline3"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/toolbarIconsRecycler"
                android:paddingRight="@dimen/ybsdk_toolbar_view_side_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/toolbarIconsContainer"
                android:paddingRight="@dimen/ybsdk_toolbar_view_side_padding"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintRight_toRightOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/toolbarIconQr"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="@dimen/ybsdk_toolbar_icon_size"
                    android:layout_height="@dimen/ybsdk_toolbar_icon_size"
                    android:scaleType="center"
                    android:contentDescription="@string/ybsdk_dashboard_action_qr_code_transfer_title"
                    app:srcCompat="@drawable/ybsdk_ic_qrcode_reader"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/toolbarIconSupport"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/ybsdk_toolbar_icon_size"
                    android:layout_height="@dimen/ybsdk_toolbar_icon_size"
                    android:layout_marginLeft="@dimen/ybsdk_toolbar_view_margin_between_icons"
                    android:scaleType="center"
                    android:contentDescription="@string/ybsdk_dashboard_action_contact_support_title"
                    app:srcCompat="@drawable/ybsdk_ic_support"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/toolbarIconProfile"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/ybsdk_toolbar_icon_size"
                    android:layout_height="@dimen/ybsdk_toolbar_icon_size"
                    android:layout_marginLeft="@dimen/ybsdk_toolbar_view_margin_between_icons"
                    android:contentDescription="@string/ybsdk_dashboard_action_profile_title"
                    app:srcCompat="@drawable/ybsdk_ic_profile"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.ybsdk.widgets.common.dashboard.DashboardViewLayout>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/creditAccountShimmer"
        layout="@layout/ybsdk_shimmer_credit_account"/>
    <include
        android:id="@+id/splitShimmer"
        layout="@layout/ybsdk_shimmer_split"/>
</FrameLayout>
