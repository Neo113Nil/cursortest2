<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/driver_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/driver_info_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/driver_info"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:component_subtitle_font_feature_settings="pnum, lnum"
        app:component_subtitle_size="14sp"
        app:component_subtitle_text_color="?attr/textMain"
        app:component_title_font_feature_settings="pnum, lnum"
        app:component_title_size="16sp"
        app:component_title_text_color="?attr/textMain"
        app:component_title_typeface="bold"
        app:layout_constraintEnd_toEndOf="@+id/avatar_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/avatar_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="avatar_image, car_image"/>
    <ImageView
        android:id="@+id/car_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:alpha="0"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <View
        android:id="@+id/avatar_background"
        android:background="@drawable/driver_avatar_round_corners"
        android:layout_width="@dimen/driver_avatar_border_size"
        android:layout_height="@dimen/driver_avatar_border_size"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintStart_toStartOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <ru.yandex.taxi.widget.ShimmeringImageView
        android:id="@+id/avatar_image"
        android:layout_width="@dimen/driver_avatar_size"
        android:layout_height="@dimen/driver_avatar_size"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/avatar_overlay"
        android:background="@drawable/ic_avatar_overlay_ok"
        android:visibility="gone"
        android:layout_width="@dimen/driver_avatar_size"
        android:layout_height="@dimen/driver_avatar_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintStart_toStartOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/driver_info_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="avatar_image, driver_info"/>
    <com.yandex.go.taxi.order.details.v1.ui.CarPlateLayout
        android:id="@+id/car_plate_layout"
        android:background="@drawable/car_plate_corners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/driver_info_barrier"/>
</merge>
