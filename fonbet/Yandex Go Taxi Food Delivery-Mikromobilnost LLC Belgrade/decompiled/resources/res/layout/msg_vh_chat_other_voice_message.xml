<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messaging.internal.view.chat.ChatItemLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/timeline_message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/reply"
            android:layout="@layout/msg_reply_layout"
            android:inflatedId="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"/>
        <ViewStub
            android:textColor="?attr/messagingIncomingSecondaryColor"
            android:id="@+id/forwarded_message"
            android:layout="@layout/msg_forwarded_message"
            android:inflatedId="@+id/forwarded_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"/>
        <FrameLayout
            android:id="@+id/message_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/pause_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/msg_media_button_pause_other"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/loading_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/msg_media_button_waiting_other"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/play_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/msg_media_button_play_other"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp">
                <com.yandex.messaging.views.WaveformView
                    android:id="@+id/waveform"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="12dp"
                    app:wv_fillcolor="?attr/messagingOtherVoiceMessageFillColor"
                    app:wv_progress_color="?attr/messagingOtherVoiceMessageProgressColor"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:textColor="?attr/messagingIncomingSecondaryColor"
                        android:layout_gravity="start"
                        android:id="@+id/duration"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ya_regular"
                        android:layout_marginStart="8dp"/>
                    <View
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/listened_indicator"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <include
                android:layout_gravity="end|bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="12dp"
                layout="@layout/msg_message_status_and_time"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/recognizing_group"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="?attr/messagingIncomingSecondaryColor"
                android:gravity="center"
                android:id="@+id/recognizing"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/messaging_recognizing"
                android:fontFamily="@font/ya_regular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="?attr/messagingIncomingPrimaryColor"
                android:id="@+id/recognized_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ya_regular"/>
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/msg_chat_error_icon_layout"/>
</com.yandex.messaging.internal.view.chat.ChatItemLinearLayout>
