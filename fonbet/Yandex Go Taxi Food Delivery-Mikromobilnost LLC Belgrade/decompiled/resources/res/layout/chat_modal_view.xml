<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/BottomModalContentHolder">
    <View
        android:id="@+id/status_bar"
        android:background="?attr/bgMinor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:gravity="center"
        android:id="@+id/title"
        android:background="?attr/bgMinor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/order_chat_title_height"
        android:text="@string/order_action_communication_with_driver"
        android:maxLines="2"
        android:layout_below="@+id/status_bar"
        app:robotoFontStyle="bold"/>
    <ImageView
        android:id="@+id/dismiss"
        android:background="@drawable/circle_button_background"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_cross_14dp"
        android:scaleType="center"
        android:layout_below="@+id/status_bar"
        android:contentDescription="@string/common_close"
        android:layout_alignParentEnd="true"/>
    <ru.yandex.taxi.design.DividerWithColorView
        android:background="?attr/line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_above="@+id/bottom_bar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="7dp"
        android:layout_alignParentBottom="true"
        android:animateLayoutChanges="true">
        <FrameLayout
            android:id="@+id/input_container"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true">
            <ru.yandex.taxi.widget.KeyboardAwareRobotoEditText
                android:textSize="@dimen/component_text_size_body"
                android:textColor="?attr/textMain"
                android:textColorHint="?attr/textMinor"
                android:gravity="center_vertical"
                android:id="@+id/message_input"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/chat_input_hint"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:maxLength="@integer/chat_message_max_length"
                android:drawablePadding="13dp"
                android:inputType="textAutoComplete"
                android:paddingStart="16dp"
                android:paddingEnd="60dp"
                app:robotoFontStyle="regular"/>
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/mic_container"
                android:padding="10dp"
                android:clipChildren="false"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/send"
                    android:background="@drawable/bg_chat_send"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/common_send_description"
                    app:srcCompat="@drawable/ic_arrow_upward"/>
            </FrameLayout>
        </FrameLayout>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textOnControl"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/coming"
            android:background="@drawable/bg_chat_coming"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/taxiotw_iam_coming"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="7dp"
            app:robotoFontStyle="medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/translation_info"
        android:background="@color/chat_translation_info_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="@dimen/go_design_s_space"
            android:src="0x7f0819f9"
            android:importantForAccessibility="no"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:paddingTop="@dimen/go_design_s_space"
            android:paddingBottom="@dimen/go_design_s_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/automatic_chat_translation_enabled"
            android:paddingEnd="@dimen/go_design_m_space"/>
    </LinearLayout>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/chat_call_button"
        android:background="@drawable/fab_button_component_background_green"
        android:layout_width="wrap_content"
        android:layout_height="88dp"
        android:layout_marginBottom="-16dp"
        android:layout_above="@+id/bottom_bar"
        android:layout_centerHorizontal="true"
        app:component_lead_image="@drawable/ic_call_component"
        app:component_lead_image_tint="@color/white"
        app:component_title="@string/taxiotw_call"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/bgMain"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/chat_call_button"
        android:layout_below="@+id/translation_info"
        android:paddingStart="@dimen/go_design_s_space"
        android:paddingEnd="@dimen/go_design_s_space"/>
    <ImageView
        android:id="@+id/messages_bottom_shadow"
        android:background="0x7f081870"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_above="@+id/chat_call_button"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/loading_placeholder"
        android:text="@string/chat_loading"
        android:layout_centerInParent="true"
        style="@style/empty_list_text"/>
</RelativeLayout>
