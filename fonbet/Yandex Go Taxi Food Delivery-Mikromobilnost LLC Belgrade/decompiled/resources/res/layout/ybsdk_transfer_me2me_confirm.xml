<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.core.transfer.utils.TransferToolbarView
        android:id="@+id/transferMe2meConfirmToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/transferMe2MeConfirmTooltipAnchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferMe2meConfirmAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/transferMe2meConfirmAmount"/>
    <TextView
        android:theme="@style/YbSdk.Widget.WidgetsCommon.NumbersInput"
        android:enabled="false"
        android:id="@+id/transferMe2meConfirmAmount"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:contentDescription="@string/ybsdk_common_accessibility_amount_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMe2meConfirmToolbar"
        app:layout_constraintVertical_bias="0.36"
        style="@style/Widget.YB.Text.Numbers2"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/transferMe2meConfirmComment"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        android:paddingHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMe2meConfirmAmount"
        style="@style/Widget.YB.Text.Body3"/>
    <com.ybsdk.core.transfer.utils.UnconditionalWidget
        android:id="@+id/transferMe2meConfirmWidgetView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:animateLayoutChanges="true"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.ybsdk.widgets.common.StadiumButtonView
        android:id="@+id/transferMe2meConfirmStadiumButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/loadingState"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/ybsdk_transfer_me2me_confirm_loading"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/transferMe2meConfirmErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
