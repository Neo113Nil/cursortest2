<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.core.transfer.utils.TransferToolbarView
        android:id="@+id/transferMe2MeConfirmPullToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/transferMe2MeConfirmPullIcon"
        android:visibility="invisible"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/transferMe2MeConfirmPullTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_yb_placeholder"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/transferMe2MeConfirmPullProgressBar"
        android:background="@drawable/ybsdk_circle_button_background"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginStart="52dp"
        app:layout_constraintStart_toStartOf="@+id/transferMe2MeConfirmPullIcon"
        app:layout_constraintTop_toTopOf="@+id/transferMe2MeConfirmPullIcon"
        app:ybsdk_indicatorColor="?attr/ybColor_button_primaryNormal"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressViewStyleSmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/transferMe2MeConfirmPullTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/transferMe2MeConfirmPullPrimaryButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/transferMe2MeConfirmPullDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/transferMe2MeConfirmPullTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/transferMe2MeConfirmPullPrimaryButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/transferMe2MeConfirmPullAgreementTextView"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <TextView
        android:gravity="center"
        android:id="@+id/transferMe2MeConfirmPullAgreementTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/transferConfirmPullSkeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/ybsdk_transfer_confirm_pull_loading_skeleton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
