<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/phone_select_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:component_title_ellipsize_mode="end"
        app:component_title_gravity="start"
        app:component_title_size="24sp"
        app:component_title_typeface="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="13sp"
        android:textColor="?attr/textMain"
        android:gravity="start"
        android:id="@+id/phone_select_description"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="0dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:letterSpacing="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_select_title"
        app:lineHeight="15dp"
        app:robotoFontStyle="regular"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/phone_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionNext"
        app:component_divider_margin_left="16dp"
        app:component_divider_margin_right="16dp"
        app:component_input_divider="true"
        app:component_input_focused_divider_color="?attr/controlMain"
        app:component_input_max_lines="1"
        app:component_input_unfocused_divider_color="?attr/line"
        app:component_title_input="@string/order_for_other_phone_input_hint"
        app:component_type_input="phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_select_description"/>
    <View
        android:id="@+id/phone_name_divider"
        android:background="?attr/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toBottomOf="@+id/phone_input"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/name_input"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionDone"
        app:component_input_divider="false"
        app:component_input_focused_divider_color="?attr/controlMain"
        app:component_input_max_lines="1"
        app:component_input_unfocused_divider_color="?attr/line"
        app:component_title_input="@string/order_for_other_name_input_hint"
        app:component_type_input="textCapWords"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_input"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contacts_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/contacts_confirm_button"
        app:layout_constraintTop_toBottomOf="@+id/phone_input"/>
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/contacts_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/contacts_confirm_button"
        app:layout_constraintTop_toBottomOf="@+id/name_input"
        app:layout_constraintVertical_chainStyle="spread_inside">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/default_contacts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/last_contacts_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ru.yandex.taxi.design.ListGroupHeaderComponent
                    android:id="@+id/last_orders_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_list_group_title="@string/order_for_other_last_orders_title"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/last_orders_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:id="@+id/last_orders_shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/contacts_scroll_container"
        app:layout_constraintEnd_toEndOf="@+id/contacts_scroll_container"
        app:layout_constraintStart_toStartOf="@+id/contacts_scroll_container"
        app:scroll_view_id="@+id/contacts_scroll_container"/>
    <ImageView
        android:id="@+id/contacts_recycler_view_scroll_shadow"
        android:background="0x7f081870"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/contacts_recycler_view"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/contacts_confirm_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="@string/common_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/permission_error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
