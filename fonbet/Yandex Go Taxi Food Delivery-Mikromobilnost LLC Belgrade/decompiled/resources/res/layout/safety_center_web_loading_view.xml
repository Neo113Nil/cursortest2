<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="start|top"
        android:id="@+id/back_float_btn"
        android:background="@drawable/ic_arrow_left"
        android:focusable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/common_back"
        android:layout_marginStart="16dp"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/title_icon_shimmer"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="42dp"
        app:barCornerRadius="32dp"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/title_shimmer"
        android:layout_width="143dp"
        android:layout_height="26dp"
        android:layout_marginTop="167dp"
        app:barCornerRadius="18dp"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle_shimmer"
        android:layout_width="243dp"
        android:layout_height="12dp"
        android:layout_marginTop="201dp"
        app:barCornerRadius="7dp"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/buttons_shimmer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="238dp"
        android:layout_marginHorizontal="12dp">
        <ru.yandex.taxi.widget.ShimmeringBar
            android:layout_gravity="start"
            android:id="@+id/call_emergency_shimmer"
            android:layout_width="115dp"
            android:layout_height="56dp"
            app:barCornerRadius="16dp"/>
        <ru.yandex.taxi.widget.ShimmeringBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/open_support_shimmer"
            android:layout_width="115dp"
            android:layout_height="56dp"
            app:barCornerRadius="16dp"/>
        <ru.yandex.taxi.widget.ShimmeringBar
            android:layout_gravity="end"
            android:id="@+id/share_route_shimmer"
            android:layout_width="115dp"
            android:layout_height="56dp"
            app:barCornerRadius="16dp"/>
    </FrameLayout>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/first_section_shimmer"
        android:layout_width="match_parent"
        android:layout_height="181dp"
        android:layout_marginTop="322dp"
        android:layout_marginHorizontal="12dp"
        app:barCornerRadius="20dp"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/second_section_shimmer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="519dp"
        android:layout_marginHorizontal="12dp"
        app:barCornerRadius="20dp"/>
</merge>
