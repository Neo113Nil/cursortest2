<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/create_shared_payment_account_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/go_design_m_space">
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/create_shared_payment_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title_size="@dimen/component_text_size_header"
                app:component_title_typeface="bold"/>
            <ru.yandex.taxi.design.ListTextComponent
                android:id="@+id/create_shared_payment_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title_size="@dimen/component_text_size_header"
                app:component_title_typeface="bold"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:id="@+id/create_shared_payment_descriptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="normal"/>
        </LinearLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:layout_gravity="bottom"
        android:id="@+id/create_shared_payment_account_scroll_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:scroll_view_id="@+id/create_shared_payment_account_scroll_view"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/create_shared_payment_account_create_button_container"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ListItemInputComponent
            android:id="@+id/create_shared_payment_account_name_input"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_divider_position="top"
            app:component_divider_type="normal"
            app:component_input_title="@string/shared_payments_create_name_hint"
            app:component_input_type="textCapSentences"
            app:component_max_lines="1"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/create_shared_payment_account_create_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shared_payments_create_confirm"
            style="@style/BottomEdgeButtonMarginStyle"/>
    </LinearLayout>
</FrameLayout>
