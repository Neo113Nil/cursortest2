<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/messaging_right_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.871"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/messaging_close"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/messagingCommonIconsSecondaryColor"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/messaging_edit_original_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/messaging_edit_original_panel"
        app:srcCompat="@drawable/msg_ic_close"
        style="@style/Messaging.InputPanelClear"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/messaging_edit_original_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/messaging_edit_input"
        app:layout_constraintEnd_toEndOf="@+id/messaging_right_guideline"
        app:layout_constraintStart_toEndOf="@+id/messaging_edit_icon">
        <com.yandex.messaging.views.AppCompatEmojiTextView
            android:textSize="14sp"
            android:textColor="?attr/messagingCommonTextSecondaryColor"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_message"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@font/ya_medium"
            android:textAlignment="viewStart"/>
        <com.yandex.messaging.views.AppCompatEmojiTextView
            android:textSize="14sp"
            android:textColor="?attr/messagingCommonTextSecondaryColor"
            android:ellipsize="end"
            android:id="@+id/messaging_edit_original_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <View
        android:id="@+id/messaging_edit_shadow"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/messaging_edit_original_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:layout_gravity="center_vertical"
        android:background="?attr/messagingCommonIconsSecondaryColor"
        android:layout_width="2dp"
        android:layout_height="26dp"
        android:alpha="0.5"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/messaging_edit_original_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/messaging_edit_original_panel"/>
    <com.yandex.messaging.views.RoundImageView
        android:id="@+id/messaging_edit_icon"
        android:layout_width="@dimen/chat_edit_message_image_size"
        android:layout_height="@dimen/chat_edit_message_image_size"
        android:scaleType="centerCrop"
        android:layout_marginStart="26dp"
        app:layout_constraintBottom_toBottomOf="@+id/messaging_edit_original_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/messaging_edit_original_panel"
        app:leftBottomRadius="4dp"
        app:leftTopRadius="4dp"
        app:rightBottomRadius="4dp"
        app:rightTopRadius="4dp"
        app:srcCompat="@drawable/msg_ic_edit"/>
    <com.yandex.messaging.internal.view.input.UnderKeyboardLinearLayout
        android:id="@+id/messaging_edit_emoji_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yandex.messaging.input.ChatInputEditText
        android:layout_gravity="start|center_vertical"
        android:id="@+id/messaging_edit_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/chat_input_margin_vertical"
        android:layout_marginBottom="@dimen/chat_input_margin_vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/messaging_edit_emoji_panel"
        app:layout_constraintEnd_toEndOf="@+id/messaging_right_guideline"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Messaging.ChatInput"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/messaging_edit_emoji_button"
        android:background="@drawable/msg_ripple_circle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:tint="?attr/messagingCommonIconsSecondaryColor"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/messaging_edit_emoji_panel"
        app:layout_constraintEnd_toEndOf="@+id/messaging_edit_input"/>
    <com.yandex.messaging.internal.view.input.mesix.Mesix
        android:id="@+id/chat_mesix"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="54dp"
        android:layout_height="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/messaging_edit_emoji_panel"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.yandex.bricks.BrickSlotView
        android:layout_gravity="bottom"
        android:id="@+id/messaging_suggest_slot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/messaging_edit_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
