<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:id="@+id/setting_menu_frame"
    android:background="@drawable/bg_button_round"
    android:layout_width="@dimen/settings_button_avatar_size"
    android:layout_height="@dimen/settings_button_avatar_size"
    android:layout_marginLeft="@dimen/go_design_s_space"
    android:layout_marginRight="@dimen/go_design_s_space">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/hamburger"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/settings_hamburger_description"/>
</FrameLayout>
