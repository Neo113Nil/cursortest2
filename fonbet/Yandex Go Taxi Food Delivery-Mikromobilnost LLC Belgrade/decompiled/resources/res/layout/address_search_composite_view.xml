<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="top"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/toolbar_stub"
        android:layout="@layout/address_search_composite_view_toolbar"
        android:inflatedId="@+id/toolbar_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top_space"/>
    <ru.yandex.taxi.preorder.suggested.selection.SuggestsView
        android:id="@+id/suggests_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/destination_address_input"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/address_input_shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignTop="@+id/source_address_input"
        android:layout_alignBottom="@+id/destination_address_input"
        android:importantForAccessibility="no"/>
    <Space
        android:id="@+id/top_space"
        android:layout_width="0dp"
        android:layout_height="@dimen/address_search_composite_top_space_height"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/source_destination_stub"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar_stub"/>
    <ru.yandex.taxi.design.AddressInputComponent
        android:id="@+id/source_address_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar_stub"
        android:layout_marginEnd="@dimen/go_design_s_space"/>
    <ru.yandex.taxi.design.AddressInputComponent
        android:id="@+id/destination_address_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/source_address_input"
        android:layout_marginEnd="@dimen/go_design_s_space"/>
    <View
        android:id="@+id/source_touch_area"
        android:background="@drawable/bg_transparent_ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignTop="@+id/source_address_input"
        android:layout_alignBottom="@+id/source_address_input"
        android:importantForAccessibility="no"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"/>
    <View
        android:id="@+id/destination_touch_area"
        android:background="@drawable/bg_transparent_ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignTop="@+id/destination_address_input"
        android:layout_alignBottom="@+id/destination_address_input"
        android:importantForAccessibility="no"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/suggests_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/destination_address_input"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        layout="@layout/search_address_shimmering"/>
    <ViewStub
        android:id="@+id/empty_message_stub"
        android:layout="@layout/text_message"
        android:inflatedId="@+id/message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_below="@+id/destination_address_input"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
