<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="?attr/textMain"
            android:layout_gravity="center_vertical"
            android:id="@+id/cashback_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="@string/go_default_font_settings"/>
        <ru.yandex.taxi.plus.design.view.ShaderClipFrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/gradient_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/cashback_icon"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/trail_cashback_icon_size"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/ic_plus_glyph_badge_small"/>
        </ru.yandex.taxi.plus.design.view.ShaderClipFrameLayout>
    </LinearLayout>
</merge>
