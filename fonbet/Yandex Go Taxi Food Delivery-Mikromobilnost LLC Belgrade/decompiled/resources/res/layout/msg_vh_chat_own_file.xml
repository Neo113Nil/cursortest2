<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messaging.internal.view.chat.ChatItemLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end|center_vertical"
    android:layout_gravity="end"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        layout="@layout/msg_chat_error_icon_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/timeline_message_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/reply"
            android:layout="@layout/msg_reply_layout"
            android:inflatedId="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"/>
        <ViewStub
            android:textColor="?attr/messagingCommonTextSecondaryColor"
            android:id="@+id/forwarded_message"
            android:layout="@layout/msg_forwarded_message"
            android:inflatedId="@+id/forwarded_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"/>
        <FrameLayout
            android:layout_gravity="start"
            android:id="@+id/file_layout_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="54sp">
            <include layout="@layout/msg_dialog_file_body"/>
            <include layout="@layout/msg_message_status_and_time"/>
        </FrameLayout>
    </LinearLayout>
</com.yandex.messaging.internal.view.chat.ChatItemLinearLayout>
