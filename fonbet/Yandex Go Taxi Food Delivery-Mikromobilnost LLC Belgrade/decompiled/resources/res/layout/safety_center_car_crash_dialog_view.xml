<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/safety_center_car_crash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image"
        android:paddingTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingStart="10dp"/>
    <ru.yandex.taxi.design.ListTitleComponent
        android:id="@+id/safety_center_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginBottom="12dp"
        app:component_auto_min_height="true"
        app:component_no_background="true"
        app:component_vertical_padding="0dp"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/safety_center_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/safety_center_top_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:component_background_color="?attr/controlMinor"
        app:component_button_icon="@drawable/ic_emergency_call"
        app:component_button_icon_padding="4dp"
        app:component_button_icon_tint="true"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControlMinor"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/safety_center_bottom_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:component_background_color="?attr/controlMain"
        app:component_button_icon_tint="true"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControl"/>
</LinearLayout>
