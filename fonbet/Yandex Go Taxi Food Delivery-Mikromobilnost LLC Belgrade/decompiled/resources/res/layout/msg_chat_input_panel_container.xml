<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <FrameLayout
        android:id="@+id/chat_input_panel_cutout_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.yandex.messaging.views.LimitedRoundImageView
            android:id="@+id/chat_input_panel_cutout_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:leftBottomRadius="12dp"
            app:leftTopRadius="12dp"
            app:rightBottomRadius="2dp"
            app:rightTopRadius="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/chat_input_panel_vertical_line"
                android:background="?attr/messagingCommonIconsSecondaryColor"
                android:layout_width="2dp"
                android:layout_height="@dimen/chat_input_panel_preview_size"
                android:alpha="0.5"
                android:layout_marginStart="12dp"/>
            <androidx.cardview.widget.CardView
                android:layout_gravity="center_vertical"
                android:id="@+id/chat_input_panel_image_preview_container"
                android:layout_width="@dimen/chat_input_panel_preview_size"
                android:layout_height="@dimen/chat_input_panel_preview_size"
                android:layout_marginStart="6dp"
                android:backgroundTint="@android:color/transparent"
                app:cardCornerRadius="@dimen/chat_input_attach_image_radius"
                app:cardElevation="0dp">
                <com.yandex.messaging.views.LimitedRoundImageView
                    android:id="@+id/chat_input_panel_image_preview"
                    android:layout_width="@dimen/chat_input_panel_preview_size"
                    android:layout_height="@dimen/chat_input_panel_preview_size"
                    android:scaleType="centerCrop"
                    app:leftBottomRadius="4dp"
                    app:leftTopRadius="4dp"
                    app:rightBottomRadius="4dp"
                    app:rightTopRadius="4dp"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/chat_input_panel_text_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="?attr/messagingCommonTextSecondaryColor"
                    android:ellipsize="end"
                    android:id="@+id/chat_input_panel_first_line"
                    android:layout_width="match_parent"
                    android:layout_height="16sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:fontFamily="@font/ya_medium"
                    android:textAlignment="viewStart"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/chat_input_panel_quote_area"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:textColor="?attr/messagingCommonTextPrimaryColor"
                        android:ellipsize="end"
                        android:id="@+id/chat_input_panel_second_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textAlignment="viewStart"
                        android:layout_marginEnd="8dp"/>
                    <ImageView
                        android:gravity="top"
                        android:id="@+id/chat_input_panel_quote_icon"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/msg_ic_quote"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/chat_input_clear"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/msg_chat_input_panel_container_content_desc"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:srcCompat="@drawable/msg_ic_close"
        app:tint="?attr/messagingCommonIconsSecondaryColor"
        style="@style/Messaging.InputPanelClear"/>
</LinearLayout>
