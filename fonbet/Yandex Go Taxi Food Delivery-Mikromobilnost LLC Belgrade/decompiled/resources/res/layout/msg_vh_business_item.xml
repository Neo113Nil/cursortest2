<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:id="@+id/department_item_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.ChatListAvatarView"/>
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:ellipsize="end"
        android:id="@+id/department_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/department_item_label"
        app:layout_constraintEnd_toStartOf="@+id/department_item_text_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/department_item_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Messaging.ChatListItemTitle"/>
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:ellipsize="end"
        android:id="@+id/department_item_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/department_item_badge"
        app:layout_constraintEnd_toStartOf="@+id/department_item_text_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/department_item_title"
        app:layout_constraintTop_toBottomOf="@+id/department_item_title"
        style="@style/Messaging.ChatListItemContent"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/department_item_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/department_item_text_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/department_item_label"
        app:layout_constraintTop_toBottomOf="@+id/department_item_label"/>
    <ImageView
        android:id="@+id/department_item_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_checkbox_checked"/>
    <ImageButton
        android:id="@+id/department_item_menu"
        android:background="?android:attr/selectableItemBackground"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_chat_info_user_menu"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="vertical"
        android:id="@+id/department_item_text_barrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="department_item_menu, department_item_select"/>
</androidx.constraintlayout.widget.ConstraintLayout>
