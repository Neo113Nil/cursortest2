<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMinor"
        android:gravity="center_vertical"
        android:id="@+id/scooters_in_parking_title"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMinor"
        android:gravity="center_vertical"
        android:id="@+id/parking_about_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:text="@string/scooters_about_parking_title"
        android:drawablePadding="4dp"
        android:drawableEnd="@drawable/chevron_next_text_size_caption"
        android:layout_marginEnd="16dp"
        android:drawableTint="?attr/textMinor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:minHeight="72dp"
        android:paddingHorizontal="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scooters_in_parking_title"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmering_title"
        android:layout_width="200dp"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ScootersStandartShimmeringBar"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/shimmering_list"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmering_title"
        app:layout_constraintVertical_bias="0"
        style="@style/ScootersStandartShimmeringBar"/>
</merge>
