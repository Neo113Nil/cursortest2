<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/check_in_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/check_in_instruction"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/check_in_button_text"
        android:layout_marginEnd="1dp"
        app:component_background_color="?attr/controlMinor"
        app:component_button_icon="@drawable/ic_walk_24dp"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintEnd_toStartOf="@+id/check_in_details"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/check_in_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/order_details"
        android:layout_marginStart="1dp"
        app:component_background_color="?attr/controlMinor"
        app:component_button_icon="@drawable/ic_details_order"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/check_in_instruction"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/check_in_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="@string/check_in_button_text"
        app:component_button_icon="@drawable/ic_tick"
        app:component_button_icon_tint="true"
        app:component_button_size="L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/check_in_instruction"/>
    <ru.yandex.taxi.design.SliderButtonView
        android:id="@+id/check_in_slider_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/check_in_instruction"/>
</androidx.constraintlayout.widget.ConstraintLayout>
