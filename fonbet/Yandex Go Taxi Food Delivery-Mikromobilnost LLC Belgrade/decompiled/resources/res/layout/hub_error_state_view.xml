<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/collapsed_error"
        android:background="@drawable/bg_round_20_minor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="@dimen/go_design_m_space"
        android:paddingVertical="10dp">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textColor="?attr/textMain"
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/error_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/collapsed_brick_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="14sp"
            android:textColor="?attr/textMinor"
            android:id="@+id/error_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/collapsed_brick_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_title"
            app:robotoFontStyle="regular"/>
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/collapsed_brick_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0805da"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.yandex.go.design.view.GoConstraintLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/expanded_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0805da"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_title"
            android:layout_gravity="center"
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAlignment="center"
            android:paddingHorizontal="32dp"
            app:robotoFontStyle="bold"/>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
