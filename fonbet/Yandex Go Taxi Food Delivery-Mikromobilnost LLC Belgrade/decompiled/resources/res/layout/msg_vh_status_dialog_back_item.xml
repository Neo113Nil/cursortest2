<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/statuses_dialog_back_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_arrow_start"
        app:tint="?attr/messagingCommonIconsSecondaryColor"/>
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:id="@+id/statuses_dialog_back_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toolbar_back_button_create_chat_content_desc"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/statuses_dialog_back_icon"
        app:layout_constraintStart_toEndOf="@+id/statuses_dialog_back_icon"
        app:layout_constraintTop_toTopOf="@+id/statuses_dialog_back_icon"
        style="@style/Messaging.BannerText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
