<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/bg_round_modal_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.logistics.sdk.photocomments.PhotocommentsView
        android:id="@+id/delivery_error_photos"
        android:paddingBottom="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/delivery_max_photos_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:component_title="@string/delivery_photocomment_error_dialog_title"
        style="@style/ListTitleComponent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_error_photos_dialog_discard_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_divider_type="none"
        app:component_rounded_background="?attr/controlMinor"
        app:component_title="@string/delivery_photocomment_error_dialog_discard_button_text"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/textMain"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_error_photos_dialog_retry_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_divider_type="none"
        app:component_rounded_background="?attr/controlMain"
        app:component_title="@string/delivery_photocomment_error_dialog_retry_button_text"
        app:component_title_gravity="center_horizontal"
        app:component_title_text_color="?attr/textOnControl"
        app:component_title_typeface="medium"/>
</LinearLayout>
