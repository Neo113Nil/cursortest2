<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_notification"
    style="@style/BottomModalContentHolder">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="bottom"
            android:id="@+id/gdpr_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="56dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/gdpr_center_image"
                    android:visibility="gone"
                    android:layout_width="@dimen/gdpr_agreement_image_size"
                    android:layout_height="@dimen/gdpr_agreement_image_size"
                    android:layout_marginBottom="24dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    <ImageView
                        android:id="@+id/gdpr_start_image"
                        android:visibility="gone"
                        android:layout_width="@dimen/gdpr_agreement_start_image_size"
                        android:layout_height="@dimen/gdpr_agreement_start_image_size"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/go_design_s_space"/>
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="21sp"
                        android:textColor="?attr/textMain"
                        android:gravity="start"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/gdpr_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        app:robotoFontStyle="bold"/>
                </LinearLayout>
                <ru.yandex.taxi.widget.RobotoTextView
                    android:textSize="17sp"
                    android:textStyle="normal"
                    android:textColor="?attr/textMain"
                    android:textColorLink="?attr/textMinor"
                    android:gravity="start"
                    android:id="@+id/gdpr_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/gdpr_scroll_indicator_line"
            android:background="?attr/line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/gdpr_scroll_indicator_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="28dp"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="28dp"
            app:srcCompat="@drawable/ic_arrow_drop_down_pool_grey"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/gdpr_close_button"
            android:padding="10dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/gdpr_close_button"
            android:contentDescription="@string/common_close"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <ru.yandex.taxi.widget.ButtonsView
        android:orientation="horizontal"
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:importantForAccessibility="no"/>
</LinearLayout>
