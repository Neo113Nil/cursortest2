<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
        android:textSize="13dp"
        android:gravity="center_vertical"
        android:id="@+id/tariff_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="6dp"
        android:letterSpacing="0.01"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="regular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/additional_price_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="@dimen/icons_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/surge_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tariff_title"
        app:layout_constraintVertical_bias="0.5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/surge_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/tariff_card_surge_note"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tariff_cost"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/additional_price_icon"
        app:layout_constraintTop_toBottomOf="@+id/tariff_title"
        app:layout_constraintVertical_bias="0.5"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/tariff_card_price_text_size"
        android:textColor="@color/text_black"
        android:id="@+id/tariff_cost"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFeatureSettings="@string/go_default_font_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tariff_original_cost"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/surge_icon"
        app:layout_constraintTop_toBottomOf="@+id/tariff_title"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="11dp"
        android:textColor="?attr/textMinor"
        android:id="@+id/tariff_original_cost"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="4dp"
        android:fontFeatureSettings="@string/go_default_font_settings"
        app:foreground="@drawable/ic_original_price_line"
        app:layout_constraintBaseline_toBaselineOf="@+id/tariff_cost"
        app:layout_constraintEnd_toStartOf="@+id/time_text"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tariff_cost"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMinor"
        android:id="@+id/time_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tariff_cost"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tariff_original_cost"/>
</androidx.constraintlayout.widget.ConstraintLayout>
