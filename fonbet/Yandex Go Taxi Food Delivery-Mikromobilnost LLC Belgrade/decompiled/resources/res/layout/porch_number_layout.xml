<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/input_layout"
    android:background="@drawable/bg_round_modal_view"
    android:layout_width="match_parent"
    android:layout_height="105dp"
    android:translationY="105dp">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMain"
        android:id="@+id/done"
        style="@style/ModalCloseButton"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/summary_item_text_size"
        android:textColor="?attr/textMinor"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/porch_hint"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:text="@string/summary_porchnumber_input_hint"
        android:importantForAccessibility="no"/>
    <ru.yandex.taxi.widget.KeyboardAwareRobotoEditText
        android:textSize="48sp"
        android:ellipsize="middle"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/input"
        android:background="@null"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:singleLine="true"
        android:digits="0123456789"
        android:contentDescription="@string/summary_porchnumber_input_hint"
        android:textCursorDrawable="@drawable/blue_toxic_input_cursor"
        app:robotoFontStyle="light"/>
</FrameLayout>
