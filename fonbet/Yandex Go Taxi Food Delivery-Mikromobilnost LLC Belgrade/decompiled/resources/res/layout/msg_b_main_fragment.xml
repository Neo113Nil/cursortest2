<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/tabs_content_slot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/navbar_buttons_container"
        android:background="?attr/messagingAttachmentsNavigationBarColorResource"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:baselineAligned="false">
        <com.yandex.messaging.views.NavTabView
            android:id="@+id/chats_tab"
            app:ntvDrawable="@drawable/msg_ic_chats_selector"
            app:ntvText="@string/nav_item_chats"
            style="@style/Messaging.NavTab"/>
        <com.yandex.messaging.views.NavTabView
            android:id="@+id/threads_tab"
            app:ntvDrawable="@drawable/msg_ic_thread_selector"
            app:ntvText="@string/nav_item_threads"
            style="@style/Messaging.NavTab"/>
        <com.yandex.messaging.views.NavTabView
            android:id="@+id/profile_tab"
            app:ntvDrawable="@drawable/msg_ic_profile_selector"
            app:ntvText="@string/nav_item_profile"
            style="@style/Messaging.NavTab"/>
    </LinearLayout>
</LinearLayout>
