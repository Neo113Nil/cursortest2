<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/progressView"
        android:visibility="gone"
        android:layout_width="@dimen/ybsdk_progress_indicator_size"
        android:layout_height="@dimen/ybsdk_progress_indicator_size"
        app:indicatorSize="@dimen/ybsdk_progress_indicator_size"
        style="@style/YbSdk.Widget.WidgetsCommon.CircularProgressIndicatorLoader"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
