<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.address.clarification.impl.ui.utils.MaxHeightConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/clarification_layout"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListTitleComponent
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_title_text_color="?attr/textMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/content_recycler_view"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="true"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_bias="0"/>
    <ImageView
        android:id="@+id/shadow"
        android:background="0x7f081870"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-12dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:backgroundTint="?attr/textMain"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/bottom_container"
        android:background="@drawable/bg_rounded_24dp_modal_view"
        android:padding="@dimen/go_design_s_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/done_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_button_accent="true"/>
    </FrameLayout>
</ru.yandex.taxi.address.clarification.impl.ui.utils.MaxHeightConstraintLayout>
