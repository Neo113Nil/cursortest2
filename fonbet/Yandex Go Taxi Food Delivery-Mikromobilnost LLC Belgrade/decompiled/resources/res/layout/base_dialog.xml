<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.design.CardComponent xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:id="@+id/content_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dialog_horizontal_margin"
    android:layout_marginRight="@dimen/dialog_horizontal_margin"
    app:cardBackgroundColor="?attr/bgMain"
    app:cardElevation="@dimen/dialog_elevation"
    app:strokeColor="@color/transparent">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp"/>
        <ru.yandex.taxi.design.ListHeaderComponent
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_lead_image_padding_left="@dimen/go_design_s_space"
            app:component_lead_image_padding_right="@dimen/go_design_s_space"
            app:component_title_typeface="bold"
            style="@style/ListTitleComponent"/>
        <ru.yandex.taxi.design.ListTextComponent
            android:id="@+id/message"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dialog_text_min_height"/>
        <FrameLayout
            android:id="@+id/custom_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:id="@+id/buttons"
            android:background="?attr/bgMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/go_design_s_space"/>
    </LinearLayout>
</ru.yandex.taxi.design.CardComponent>
