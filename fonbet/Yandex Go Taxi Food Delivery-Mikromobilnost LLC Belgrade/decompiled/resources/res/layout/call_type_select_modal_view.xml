<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/title"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/go_design_m_space"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/subtitle"
        android:paddingTop="12dp"
        android:paddingBottom="@dimen/go_design_m_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.ListItemCheckComponent
        android:id="@+id/remember_my_choice_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="margin"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/default_call_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inapp_call_button_vertical_space"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_button_size="L"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/inapp_call_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        android:layout_marginVertical="@dimen/inapp_call_button_vertical_space"
        app:component_button_size="L"/>
</com.yandex.go.design.view.GoLinearLayout>
