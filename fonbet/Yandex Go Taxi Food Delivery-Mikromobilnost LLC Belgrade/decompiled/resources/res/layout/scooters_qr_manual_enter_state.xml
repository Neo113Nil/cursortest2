<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/manual_enter_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="manual_enter_back_ground,       back_to_camera,       manual_enter_done,       prefix_selector_rv,       manual_enter_field,       vendor_selector_flow,       invisible_edit_text,       "/>
    <View
        android:id="@+id/manual_enter_back_ground"
        android:background="@color/component_fog_dark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/prefix_selector_rv"
        android:background="@drawable/bg_qr_prefix_selector"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:overScrollMode="never"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/manual_enter_field"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/manual_enter_field"
        android:layout_width="0dp"
        android:layout_height="@dimen/scooters_manual_number_enter_max_text_size"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/back_to_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.KeyboardAwareRobotoEditText
        android:id="@+id/invisible_edit_text"
        android:layout_width="1px"
        android:layout_height="1px"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        android:alpha="0"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/vendor_selector_flow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:flow_horizontalAlign="center"
        app:flow_horizontalGap="4dp"
        app:flow_horizontalStyle="packed"
        app:flow_verticalGap="8dp"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manual_enter_field"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/back_to_camera"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="@string/scooters_qr_back_to_camera"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="4dp"
        app:component_background_color="@color/component_fog_dark"
        app:component_button_rounded_corners_radius="100dp"
        app:component_title_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/offer_card_offset_guideline"
        app:layout_constraintEnd_toStartOf="@+id/manual_enter_done"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:enabled="false"
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/manual_enter_done"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="@string/scooters_done"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_background_color="@color/component_fog_dark"
        app:component_button_rounded_corners_radius="100dp"
        app:component_title_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/offer_card_offset_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_to_camera"/>
</merge>
