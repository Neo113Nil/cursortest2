<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/card_background"
        android:background="@drawable/postcard_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/btn_add_user"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/placeholder"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/common_done"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/card_background"
        app:layout_constraintEnd_toEndOf="@+id/card_background"
        app:layout_constraintStart_toStartOf="@+id/card_background"
        app:layout_constraintTop_toTopOf="@+id/card_background"
        app:placeholder_color="@color/transparent"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.KeyboardAwareRobotoEditText
        android:textSize="28sp"
        android:textColor="@color/white"
        android:textColorHint="@color/white_alpha20"
        android:gravity="center"
        android:id="@+id/card_text"
        android:background="@android:color/transparent"
        android:paddingTop="36dp"
        android:paddingBottom="36dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_background"
        app:layout_constraintEnd_toEndOf="@+id/card_background"
        app:layout_constraintStart_toStartOf="@+id/card_background"
        app:layout_constraintTop_toTopOf="@+id/card_background"/>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_cross_close_white"
        android:contentDescription="@string/common_close"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/card_background"
        app:layout_constraintTop_toTopOf="@+id/card_background"/>
    <ru.yandex.taxi.widget.buttons.LittleIconCircleButton
        android:id="@+id/btn_change_background_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:component_circle_button_badge_color="?attr/controlMain"
        app:component_shadow_enable="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_add_user"
        app:layout_constraintEnd_toEndOf="@+id/card_background">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/btn_change_card_background"
            android:background="@drawable/ic_plus_counter_circle"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:src="@drawable/ic_union"
            android:importantForAccessibility="no"
            android:backgroundTint="@color/black"/>
    </ru.yandex.taxi.widget.buttons.LittleIconCircleButton>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/btn_add_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
