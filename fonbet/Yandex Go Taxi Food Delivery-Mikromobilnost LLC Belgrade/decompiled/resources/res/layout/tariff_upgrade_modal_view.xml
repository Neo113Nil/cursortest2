<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/tariff_upgrade_root"
    android:background="@drawable/bg_rounded_24dp_modal_view"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListHeaderComponent
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_no_background="true"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_no_background="true"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/go_design_s_space"
                android:layout_marginStart="@dimen/go_design_m_space">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/plus_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
                    app:srcCompat="@drawable/bg_tariff_upgrade_plus"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/detail_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="normal"
        app:component_lead_image="@drawable/ic_tariff_upgrade_information"
        app:component_title="@string/tariff_upgrade_detail"
        app:component_trail_mode="navigation"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/done_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:text="@string/common_cool"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:component_background_color="@color/component_gray_600"
        app:component_title_color="@color/component_white"/>
</LinearLayout>
