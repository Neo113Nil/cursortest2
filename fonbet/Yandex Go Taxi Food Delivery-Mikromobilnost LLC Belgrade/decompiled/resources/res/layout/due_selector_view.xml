<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/due_select_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="normal"
        app:component_show_navigation_button="false"
        app:component_title="@string/preorder_due_select_modal_title"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_body"
        app:component_title_typeface="medium"
        app:component_toolbar_background_accent_enabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/due_select_state_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/buttons_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/due_select_toolbar"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/buttons_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="leading_button,trailing_button"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/leading_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="4dp"
        app:component_button_size="L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/trailing_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttons_barrier"
        app:layout_goneMarginEnd="@dimen/go_design_s_space"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/trailing_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_button_size="L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/leading_button"
        app:layout_constraintTop_toBottomOf="@+id/buttons_barrier"
        app:layout_goneMarginStart="@dimen/go_design_s_space"/>
</merge>
