<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/appBarShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/ybsdk_shimmer_root_appbar"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerTextShimmer1"
            android:layout_width="220dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/ybsdk_merchant_offers_shimmer_title_top_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerTextShimmer2"
            android:layout_width="284dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bannerTextShimmer1"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerTextShimmer3"
            android:layout_width="220dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bannerTextShimmer2"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerNotificationShimmer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bannerTextShimmer3"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerNotificationIconShimmer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:shape="oval"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="@+id/bannerNotificationShimmer"
            app:layout_constraintTop_toTopOf="@+id/bannerNotificationShimmer"
            app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerNotificationTitleShimmer"
            android:layout_width="148dp"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            app:layout_constraintEnd_toStartOf="@+id/bannerNotificationButtonShimmer"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/bannerNotificationIconShimmer"
            app:layout_constraintTop_toTopOf="@+id/bannerNotificationShimmer"
            app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerNotificationSubtitleShimmer"
            android:layout_width="100dp"
            android:layout_height="12dp"
            android:layout_marginTop="7dp"
            app:layout_constraintEnd_toStartOf="@+id/bannerNotificationButtonShimmer"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/bannerNotificationTitleShimmer"
            app:layout_constraintTop_toBottomOf="@+id/bannerNotificationTitleShimmer"
            app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/bannerNotificationButtonShimmer"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="@+id/bannerNotificationShimmer"
            app:layout_constraintTop_toTopOf="@+id/bannerNotificationShimmer"
            app:ybsdk_backgroundColor="?attr/ybColor_other_productSkeleton"
            app:ybsdk_cornerRadius="24dp"/>
        <include
            android:id="@+id/categoryShimmer1"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bannerNotificationShimmer"
            layout="@layout/ybsdk_item_shimmer_category"/>
        <include
            android:id="@+id/categoryShimmer2"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/categoryShimmer1"
            app:layout_constraintTop_toTopOf="@+id/categoryShimmer1"
            layout="@layout/ybsdk_item_shimmer_category"/>
        <include
            android:id="@+id/categoryShimmer3"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/categoryShimmer2"
            app:layout_constraintTop_toTopOf="@+id/categoryShimmer1"
            layout="@layout/ybsdk_item_shimmer_category"/>
        <include
            android:id="@+id/categoryShimmer4"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/categoryShimmer3"
            app:layout_constraintTop_toTopOf="@+id/categoryShimmer1"
            layout="@layout/ybsdk_item_shimmer_category"/>
        <include
            android:id="@+id/categoryShimmer5"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/categoryShimmer4"
            app:layout_constraintTop_toTopOf="@+id/categoryShimmer1"
            layout="@layout/ybsdk_item_shimmer_category"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/carouselTitleShimmer"
            android:layout_width="167dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/categoryShimmer1"
            app:ybsdk_cornerRadius="6dp"/>
        <include
            android:id="@+id/carouselOfferShimmer1"
            android:layout_width="152dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/carouselTitleShimmer"
            layout="@layout/ybsdk_item_shimmer_carousel_offer"/>
        <include
            android:id="@+id/carouselOfferShimmer2"
            android:layout_width="152dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/carouselOfferShimmer1"
            app:layout_constraintTop_toTopOf="@+id/carouselOfferShimmer1"
            layout="@layout/ybsdk_item_shimmer_carousel_offer"/>
        <include
            android:id="@+id/carouselOfferShimmer3"
            android:layout_width="152dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/carouselOfferShimmer2"
            app:layout_constraintTop_toTopOf="@+id/carouselOfferShimmer1"
            layout="@layout/ybsdk_item_shimmer_carousel_offer"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/offersTitleShimmer"
            android:layout_width="167dp"
            android:layout_height="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/carouselOfferShimmer1"
            app:ybsdk_cornerRadius="6dp"/>
        <include
            android:id="@+id/offerShimmer1"
            android:layout_width="0dp"
            android:layout_height="436dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/offersTitleShimmer"
            layout="@layout/ybsdk_item_paging_loading"/>
        <include
            android:id="@+id/offerShimmer2"
            android:layout_width="0dp"
            android:layout_height="436dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/offerShimmer1"
            layout="@layout/ybsdk_item_paging_loading"/>
        <include
            android:id="@+id/offerShimmer3"
            android:layout_width="0dp"
            android:layout_height="436dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/offerShimmer2"
            layout="@layout/ybsdk_item_paging_loading"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
