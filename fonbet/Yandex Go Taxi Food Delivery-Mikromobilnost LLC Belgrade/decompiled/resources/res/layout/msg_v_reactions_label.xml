<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">
    <com.yandex.messaging.internal.view.timeline.overlay.ReactionsView
        android:id="@+id/reactions"
        android:background="@drawable/msg_reactions_shadow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:outlineSpotShadowColor="?attr/messagingCommonElevationShadowColor"
        android:outlineAmbientShadowColor="?attr/messagingCommonElevationShadowColor"/>
</FrameLayout>
