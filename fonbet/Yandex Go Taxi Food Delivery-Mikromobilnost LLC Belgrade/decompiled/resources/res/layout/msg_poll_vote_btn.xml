<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/poll_vote_btn_container"
        android:background="@drawable/msg_bg_poll_message_vote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="6dp">
        <TextView
            android:id="@+id/poll_vote_btn_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/messenger_poll_message_vote_btn_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Messaging.PollMessage.VoteButton"/>
        <ImageView
            android:id="@+id/poll_vote_pending_indicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/poll_vote_btn_label"
            app:layout_constraintStart_toEndOf="@+id/poll_vote_btn_label"
            app:layout_constraintTop_toTopOf="@+id/poll_vote_btn_label"
            app:srcCompat="@drawable/msg_anim_poll_vote_btn_progress"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/poll_show_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="6dp"
        android:text="@string/messenger_poll_results_btn_text"
        android:paddingVertical="8dp"
        style="@style/Messaging.PollMessage.ResultsButton"/>
    <View
        android:id="@+id/poll_common_padding"
        android:layout_width="wrap_content"
        android:layout_height="12dp"/>
</merge>
