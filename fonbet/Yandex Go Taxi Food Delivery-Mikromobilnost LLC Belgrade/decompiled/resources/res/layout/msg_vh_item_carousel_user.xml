<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:id="@+id/carousel_user_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="4dp"
        app:avatarPadding="0dp"
        app:avatarTextSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/carousel_user_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:placeholderBackground="@drawable/msg_bg_search_item_avatar_placeholder"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/carousel_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/carousel_user_avatar"/>
    <ImageView
        android:id="@+id/ic_carousel_remove_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ic_carousel_remove_user_button_content_des__res_0x7f150997"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_delete_participant"/>
</androidx.constraintlayout.widget.ConstraintLayout>
