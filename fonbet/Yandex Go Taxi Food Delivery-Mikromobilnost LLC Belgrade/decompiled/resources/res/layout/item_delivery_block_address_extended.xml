<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/delivery_point_content_extended"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMinor"
        android:id="@+id/delivery_point_title_extended"
        android:background="@drawable/logistics_point_title_background"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DeliveryUnitedPointTitle"/>
    <FrameLayout
        android:id="@+id/contact_group_extended"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delivery_point_title_extended"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/call_icon_extended"
        android:padding="21dp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_logistics_contact_phone"
        app:layout_constraintStart_toStartOf="@+id/contact_group_extended"
        app:layout_constraintTop_toTopOf="@+id/contact_group_extended"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMinor"
        android:id="@+id/delivery_phone_subtitle_text_extended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/delivery_phone_select_extended"
        app:layout_constraintStart_toEndOf="@+id/call_icon_extended"
        app:layout_constraintTop_toTopOf="@+id/contact_group_extended"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="16sp"
        android:textColor="?attr/textMain"
        android:id="@+id/delivery_phone_select_extended"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/contact_group_extended"
        app:layout_constraintEnd_toEndOf="@+id/contact_group_extended"
        app:layout_constraintStart_toEndOf="@+id/call_icon_extended"
        app:layout_constraintTop_toBottomOf="@+id/delivery_phone_subtitle_text_extended"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:src="@drawable/chevron_next"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/contact_group_extended"
        app:layout_constraintEnd_toEndOf="@+id/contact_group_extended"
        app:layout_constraintTop_toTopOf="@+id/contact_group_extended"/>
    <View
        android:background="?attr/line"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/contact_group_extended"
        app:layout_constraintEnd_toEndOf="@+id/contact_group_extended"
        app:layout_constraintStart_toStartOf="@+id/contact_group_extended"/>
    <ru.yandex.taxi.design.bubble.BubbleTextComponent
        android:id="@+id/delivery_contact_autofill_bubble_extended"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationZ="1dp"
        app:bubble_component_text="@string/delivery_contact_autofill_bubble_text"
        app:layout_constraintBottom_toBottomOf="@+id/delivery_phone_subtitle_text_extended"
        app:layout_constraintStart_toEndOf="@+id/delivery_phone_subtitle_text_extended"/>
    <FrameLayout
        android:id="@+id/address_row"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginRight="8dp"
        app:layout_constraintTop_toBottomOf="@+id/contact_group_extended"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_point_address_extended"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        app:component_lead_image="@drawable/ic_summary_destination_point"
        app:component_title_input="@string/short_text"
        app:component_title_max_lines="1"
        app:layout_constraintBottom_toBottomOf="@+id/address_row"
        app:layout_constraintEnd_toStartOf="@+id/delivery_point_porch_extended"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="@+id/address_row"
        app:layout_constraintTop_toTopOf="@+id/address_row"/>
    <View
        android:background="?attr/line"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/delivery_point_address_extended"
        app:layout_constraintEnd_toEndOf="@+id/delivery_point_address_extended"
        app:layout_constraintStart_toStartOf="@+id/delivery_point_address_extended"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/delivery_point_porch_extended"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:component_divider_margin_left="2dp"
        app:component_divider_margin_right="8dp"
        app:component_input_divider="true"
        app:component_title_input="Подъезд..."
        app:layout_constraintBottom_toBottomOf="@+id/address_row"
        app:layout_constraintEnd_toEndOf="@+id/address_row"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/delivery_point_address_extended"
        app:layout_constraintTop_toTopOf="@+id/address_row"/>
    <View
        android:id="@+id/delivery_bubble_anchor_extended"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/delivery_point_floor_extended"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.design.bubble.BubbleTextComponent
        android:id="@+id/delivery_point_bubble_extended"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/delivery_bubble_anchor_extended"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/delivery_bubble_anchor_extended"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/delivery_point_apartment_extended"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="2dp"
        app:component_divider_margin_left="8dp"
        app:component_divider_margin_right="2dp"
        app:component_input_divider="true"
        app:component_title_input="Квартира, офис"
        app:layout_constraintEnd_toStartOf="@+id/delivery_point_floor_extended"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delivery_point_address_extended"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/delivery_point_floor_extended"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        app:component_divider_margin_left="2dp"
        app:component_divider_margin_right="2dp"
        app:component_input_divider="true"
        app:component_title_input="Этаж"
        app:layout_constraintEnd_toStartOf="@+id/delivery_point_door_phone_extended"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/delivery_point_apartment_extended"
        app:layout_constraintTop_toBottomOf="@+id/delivery_point_address_extended"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/delivery_point_door_phone_extended"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="8dp"
        app:component_divider_margin_left="2dp"
        app:component_divider_margin_right="8dp"
        app:component_input_divider="true"
        app:component_title_input="Домофон"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/delivery_point_floor_extended"
        app:layout_constraintTop_toBottomOf="@+id/delivery_point_address_extended"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/delivery_point_comment_extended"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:component_divider_margin_left="16dp"
        app:component_input_max_lines="8"
        app:component_title_input="Коментарий"
        app:layout_constraintBottom_toTopOf="@+id/delivery_photocomments_extended"
        app:layout_constraintEnd_toStartOf="@+id/delivery_upload_photocomment_button_extended"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delivery_point_floor_extended"/>
    <ru.yandex.taxi.delivery.ui.photocomment.AddPhotocommentButtonView
        android:layout_gravity="center"
        android:id="@+id/delivery_upload_photocomment_button_extended"
        android:padding="@dimen/go_design_s_space"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="@+id/delivery_point_comment_extended"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/delivery_point_comment_extended"
        app:layout_constraintTop_toTopOf="@+id/delivery_point_comment_extended"/>
    <View
        android:id="@+id/delivery_point_comment_extended_divider"
        android:background="?attr/line"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/delivery_photocomments_extended"
        app:layout_constraintEnd_toEndOf="@+id/delivery_upload_photocomment_button_extended"
        app:layout_constraintStart_toStartOf="@+id/delivery_point_comment_extended"/>
    <ru.yandex.taxi.logistics.sdk.photocomments.PhotocommentsView
        android:id="@+id/delivery_photocomments_extended"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
