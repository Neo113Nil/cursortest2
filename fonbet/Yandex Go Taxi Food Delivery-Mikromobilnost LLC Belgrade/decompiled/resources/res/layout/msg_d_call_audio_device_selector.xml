<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/messagingCommonActionbarColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:padding="16dp"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_select_audio_device_title"
        style="@style/Messaging.MessagePopupButton"/>
    <View
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:id="@+id/call_audio_device_bluetooth"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_select_audio_device_bluetooth"
        android:drawableLeft="@drawable/msg_ic_calls_bluetooth"
        android:drawableStart="@drawable/msg_ic_calls_bluetooth"
        android:drawableTint="?attr/messagingCommonIconsPrimaryColor"
        style="@style/Messaging.MessagePopupButton"/>
    <TextView
        android:id="@+id/call_audio_device_wired_headset"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_select_audio_device_wired_headset"
        android:drawableLeft="@drawable/msg_ic_calls_headphones"
        android:drawableStart="@drawable/msg_ic_calls_headphones"
        android:drawableTint="?attr/messagingCommonIconsPrimaryColor"
        style="@style/Messaging.MessagePopupButton"/>
    <TextView
        android:id="@+id/call_audio_device_earpiece"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_select_audio_device_earpiece"
        android:drawableLeft="@drawable/msg_ic_audio_call"
        android:drawableStart="@drawable/msg_ic_audio_call"
        android:drawableTint="?attr/messagingCommonIconsPrimaryColor"
        style="@style/Messaging.MessagePopupButton"/>
    <TextView
        android:id="@+id/call_audio_device_speaker"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_select_audio_device_speakerphone"
        android:drawableLeft="@drawable/msg_calls_speaker"
        android:drawableStart="@drawable/msg_calls_speaker"
        android:drawableTint="?attr/messagingCommonIconsPrimaryColor"
        style="@style/Messaging.MessagePopupButton"/>
</LinearLayout>
