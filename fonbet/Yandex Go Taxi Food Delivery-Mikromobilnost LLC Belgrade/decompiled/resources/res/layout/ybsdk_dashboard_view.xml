<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
    android:id="@+id/coordinator"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:tag="@string/ybsdk_util_scroll_up_check"
        android:background="?attr/ybColor_background_primary"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        app:layout_behavior="com.ybsdk.widgets.common.behaviors.BlockableAppBarLayoutBehavior">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:statusBarScrim="?attr/ybColor_background_primary">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/dashboardViewToolbar"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ybsdk_toolbar_height"
                android:importantForAccessibility="no"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:background="?attr/ybColor_background_primary"
        android:paddingTop="@dimen/ybsdk_dashboard_recycler_padding_top"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:layout_gravity="bottom"
        android:id="@+id/dashboard_bottom_button"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="@dimen/ybsdk_dashboard_footer_button_vertical_margin"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
