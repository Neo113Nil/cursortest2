<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/title_component"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/settings_promocode"
        android:paddingHorizontal="@dimen/go_design_m_space"
        android:accessibilityHeading="true"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.design.AnimatedListItemInputComponent
        android:id="@+id/input_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionDone"
        app:component_divider_margin_left="@dimen/go_design_m_space"
        app:component_divider_margin_right="@dimen/go_design_m_space"
        app:component_hint_input="@string/promocode_activate_hint"
        app:component_input_focused_divider_color="?attr/textMain"
        app:component_input_max_length="50"
        app:component_input_max_lines="1"
        app:component_type_input="textNoSuggestions"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:text="@string/activate_promocode"
        app:component_button_accent="true"
        style="@style/BottomEdgeButtonMarginStyle"/>
</com.yandex.go.design.view.GoLinearLayout>
