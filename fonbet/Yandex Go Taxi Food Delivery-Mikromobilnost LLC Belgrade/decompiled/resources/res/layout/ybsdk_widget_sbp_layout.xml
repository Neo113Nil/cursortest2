<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ybsdk_widget_sbp_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/widget_sbp_text_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawableRight="@drawable/ybsdk_ic_arrow_forward"
        android:drawablePadding="4dp"
        style="@style/Widget.YB.Text.Title2"/>
    <TextView
        android:id="@+id/widget_sbp_text_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        style="@style/Widget.YB.Text.Caption1.Regular"/>
</LinearLayout>
