<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toll_road_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ToolbarComponent
            android:id="@+id/toll_road_title"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_show_navigation_button="false"
            app:component_title_size="24sp"
            app:component_title_text_color="?attr/textMain"
            app:component_title_typeface="bold"
            app:component_toolbar_background_color="?attr/bgMain"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:id="@+id/toll_road_description"
            android:paddingTop="0dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:robotoFontStyle="regular"/>
        <ru.yandex.taxi.design.AutoDividerComponentList
            android:orientation="vertical"
            android:id="@+id/toll_road_options_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_middle_divider_type="margin"/>
        <include
            android:id="@+id/shimmering"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/toll_road_shimmering"/>
        <ru.yandex.taxi.design.button.OrderButtonComponent
            android:id="@+id/toll_road_order_button"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
