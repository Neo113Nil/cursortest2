<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/child_container"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="@dimen/confirm_button_height">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.AnimatedListItemInputComponent
                android:id="@+id/mail_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:component_title_input="@string/settings_mail_hint"
                app:component_type_input="email"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="14sp"
                android:textColor="?attr/textMinor"
                android:id="@+id/mail_status_message"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>
        </LinearLayout>
    </ScrollView>
    <ru.yandex.taxi.design.FloatingTitleToolbarComponent
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_floating_title="@string/settings_mail_title"
        app:component_toolbar_item_title="@string/settings_remove_email"
        app:component_tracked_view="@+id/scroll"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:layout_gravity="bottom"
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="@string/favorites_summary_add"
        app:component_button_accent="true"/>
</FrameLayout>
