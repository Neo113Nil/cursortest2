<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/summaryInfoBackground"
        android:background="@drawable/ybsdk_autotopup_rounding_background"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constrainedHeight="false"
        app:layout_constraintBottom_toTopOf="@+id/summaryInfoBottomGuide"
        app:ybsdk_shimmer_auto_start="false"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/summaryInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/summaryInfoTooltipButton"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/summaryInfoBackground"
        app:layout_constraintTop_toTopOf="@+id/summaryInfoBackground"
        style="@style/Widget.YB.Text.Caption1.Regular.Inverted"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/summaryInfoTooltipButton"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/summaryInfoText"
        app:layout_constraintEnd_toEndOf="@+id/summaryInfoBackground"
        app:layout_constraintStart_toEndOf="@+id/summaryInfoText"
        app:layout_constraintTop_toTopOf="@+id/summaryInfoText"
        app:srcCompat="@drawable/ybsdk_ic_info_outline"
        app:tint="?attr/ybColor_textIcon_primaryInverted"/>
    <View
        android:id="@+id/summaryDropdownBackground"
        android:background="@drawable/ybsdk_autotopup_rounding_background"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:orientation="vertical"
        android:id="@+id/summaryInfoBottomGuide"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="42dp"
        app:layout_constraintTop_toTopOf="@+id/summaryDropdownBackground"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/summaryDropdownIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="@+id/summaryDropdownBackground"
        app:layout_constraintTop_toTopOf="@+id/summaryDropdownBackground"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/summaryDropdownArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="28dp"
        android:contentDescription="@null"
        android:rotation="180"
        android:importantForAccessibility="no"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="@+id/summaryDropdownBackground"
        app:layout_constraintTop_toTopOf="@+id/summaryDropdownBackground"
        app:srcCompat="@drawable/ybsdk_ic_arrow_short_top"/>
    <com.ybsdk.core.design.spoiler.SpoilerTextView
        android:textColor="?attr/ybColor_textIcon_primary"
        android:ellipsize="end"
        android:id="@+id/summaryDropdownAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/summaryDropdownDescription"
        app:layout_constraintEnd_toStartOf="@+id/summaryDropdownArrow"
        app:layout_constraintStart_toEndOf="@+id/summaryDropdownIcon"
        app:layout_constraintTop_toTopOf="@+id/summaryDropdownIcon"
        app:layout_constraintVertical_chainStyle="packed"
        app:ybsdk_spoiler_height="20dp"
        app:ybsdk_spoiler_horizontal_gravity="left"
        app:ybsdk_spoiler_width="86dp"
        style="@style/Widget.YB.Text.Numbers6"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/summaryDropdownDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/summaryDropdownArrow"
        app:layout_constraintEnd_toStartOf="@+id/summaryDropdownArrow"
        app:layout_constraintStart_toEndOf="@+id/summaryDropdownIcon"
        app:layout_constraintTop_toBottomOf="@+id/summaryDropdownAmount"
        style="@style/Widget.YB.Text.Caption1.Regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/summaryDropdownRecycler"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:alpha="0"
        android:paddingHorizontal="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/summaryDropdownIcon"/>
</merge>
