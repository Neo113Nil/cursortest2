<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="18dp"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/go_design_m_space"
    android:paddingEnd="@dimen/go_design_m_space">
    <ru.yandex.taxi.plus.badge.CashbackAmountView
        android:id="@+id/cashback_view"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:paddingStart="@dimen/go_design_s_space"
        android:paddingEnd="@dimen/go_design_s_space"
        app:bounceOffset="@dimen/cashback_menu_oval_bounce_offset"
        app:cashbackTextColor="@color/component_white"
        app:cashbackTextSize="@dimen/component_text_size_body"
        app:gradientOvalHeight="24dp"
        app:ovalHeight="@dimen/cashback_menu_oval_height"
        app:stackOffset="@dimen/cashback_menu_ovals_distance"/>
</FrameLayout>
