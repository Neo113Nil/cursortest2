<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start"
        android:id="@+id/timeline_message_container"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ViewStub
            android:textColor="?attr/messagingCommonTextSecondaryColor"
            android:id="@+id/forwarded_message"
            android:visibility="gone"
            android:layout="@layout/msg_forwarded_message"
            android:inflatedId="@+id/forwarded_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewStub
            android:id="@+id/reply"
            android:layout="@layout/msg_reply_layout"
            android:inflatedId="@+id/reply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forwarded_message"/>
        <com.yandex.messaging.views.LimitedRoundFrameLayout
            android:id="@+id/dialog_item_video_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/timeline_image_min_size"
            android:minHeight="@dimen/timeline_image_min_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reply">
            <ImageView
                android:id="@+id/dialog_item_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"/>
        </com.yandex.messaging.views.LimitedRoundFrameLayout>
        <include
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            layout="@layout/msg_image_message_status_and_time"/>
        <include
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintStart_toStartOf="@+id/dialog_item_video_container"
            app:layout_constraintTop_toTopOf="@+id/dialog_item_video_container"
            layout="@layout/msg_chat_error_icon_layout"/>
        <com.yandex.messaging.internal.view.custom.ProgressIndicator
            android:id="@+id/progress_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="?attr/messagingViewerIconsColor"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_item_video_container"
            app:layout_constraintEnd_toEndOf="@+id/dialog_item_video_container"
            app:layout_constraintStart_toStartOf="@+id/dialog_item_video_container"
            app:layout_constraintTop_toTopOf="@+id/dialog_item_video_container"/>
        <ImageView
            android:id="@+id/video_play_button"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/play_solid_lg"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_item_video_container"
            app:layout_constraintEnd_toEndOf="@+id/dialog_item_video_container"
            app:layout_constraintStart_toStartOf="@+id/dialog_item_video_container"
            app:layout_constraintTop_toTopOf="@+id/dialog_item_video_container"
            style="@style/Messaging.ViewerVideoPlayerActionButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
