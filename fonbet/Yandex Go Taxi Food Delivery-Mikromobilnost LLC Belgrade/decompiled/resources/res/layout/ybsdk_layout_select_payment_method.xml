<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/ybsdk_bottom_sheet_inset_height"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/select_payment_method_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/select_payment_widget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.ybsdk.widgets.common.paymentmethod.WidgetSbpView
        android:id="@+id/select_payment_method_widget"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/ybsdk_screen_horizontal_space"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/select_payment_method_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
</LinearLayout>
