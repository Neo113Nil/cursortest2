<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/add_status_label"
        android:background="@drawable/msg_ripple_common"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@string/create_custom_status_content_des__res_0x7f1505af"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/add_status_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/add_status_label"
        app:layout_constraintStart_toStartOf="@+id/add_status_label"
        app:layout_constraintTop_toTopOf="@+id/add_status_label"
        app:srcCompat="@drawable/msg_ic_add_status"
        app:tint="?attr/messagingCommonTextPrimaryColor"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/add_status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/add_status_label"
        android:lines="1"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/add_status_label"
        app:layout_constraintEnd_toEndOf="@+id/add_status_label"
        app:layout_constraintStart_toEndOf="@+id/add_status_icon"
        app:layout_constraintTop_toTopOf="@+id/add_status_label"
        style="@style/Messaging.StatusNameText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
