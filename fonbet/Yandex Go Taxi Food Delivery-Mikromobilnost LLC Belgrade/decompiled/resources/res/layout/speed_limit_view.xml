<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="64dp"
    android:layout_height="64dp">
    <View
        android:layout_gravity="center"
        android:id="@+id/view_speedlimit_alarm"
        android:background="@drawable/map_speedalarm"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/view_speedlimit_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textStyle="bold"
        android:textColor="?attr/textMain"
        android:ellipsize="none"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/text_speedlimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
</com.yandex.go.design.view.GoFrameLayout>
