<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/icon_placeholder"
        android:layout_width="@dimen/icon_placeholder_size"
        android:layout_height="@dimen/icon_placeholder_size"
        android:layout_margin="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholder_corner_radius="@dimen/placeholder_radius"
        app:placeholder_shimmering="true"
        app:placeholder_type="oval"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/title_placeholder"
        android:layout_width="0dp"
        android:layout_height="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/title_placeholder_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholder_corner_radius="@dimen/placeholder_radius"
        app:placeholder_shimmering="true"
        app:placeholder_type="rectangle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
