<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/messagingCommonActionbarColor"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.messaging.views.LimitedRoundImageView
        android:id="@+id/metadata_image"
        android:background="?attr/messagingCommonIconsSecondaryColor"
        android:layout_width="@dimen/chat_pinned_message_image_size"
        android:layout_height="@dimen/chat_pinned_message_image_size"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:leftBottomRadius="4dp"
        app:leftTopRadius="4dp"
        app:rightBottomRadius="4dp"
        app:rightTopRadius="4dp"/>
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:ellipsize="end"
        android:id="@+id/metadata_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/metadata_body_text"
        app:layout_constraintEnd_toStartOf="@+id/metadata_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/metadata_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="8dp"
        app:layout_goneMarginEnd="12dp"
        app:layout_goneMarginStart="12dp"
        style="@style/Messaging.PinnedMessageText"/>
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:ellipsize="end"
        android:id="@+id/metadata_body_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/metadata_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/metadata_image"
        app:layout_constraintTop_toBottomOf="@+id/metadata_title_text"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="12dp"
        app:layout_goneMarginStart="12dp"
        app:layout_goneMarginTop="8dp"
        style="@style/Messaging.PinnedMessageText"/>
    <Button
        android:id="@+id/metadata_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:textAllCaps="false"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.MetadataButton"/>
    <View
        android:id="@+id/metadata_bottom_separator"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
