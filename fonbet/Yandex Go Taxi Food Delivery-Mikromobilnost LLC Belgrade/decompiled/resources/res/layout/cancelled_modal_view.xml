<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/cost_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@+id/cost_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:maxLines="2"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="18sp"
                android:id="@+id/cost_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="18sp"
                android:textColor="?attr/textMinor"
                android:id="@+id/cost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/rate_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.yandex.taxi.widget.RobotoTextView
            android:gravity="center"
            android:id="@+id/rate_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_label"
            style="@style/header"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:gravity="center"
            android:id="@+id/rate_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@style/Settings.Text"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="80sp"
            android:ellipsize="none"
            android:gravity="center"
            android:id="@+id/rate_cost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="15dp"
            android:singleLine="true"
            android:layout_above="@+id/rate_message"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:robotoFontStyle="light"/>
    </RelativeLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:textColor="?attr/textOnControl"
        android:id="@+id/done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rate_confirm"
        android:layout_alignParentBottom="true"
        app:component_background_color="?attr/controlMain"
        app:component_button_accent="true"
        style="@style/BottomEdgeButtonMarginStyle"/>
</RelativeLayout>
