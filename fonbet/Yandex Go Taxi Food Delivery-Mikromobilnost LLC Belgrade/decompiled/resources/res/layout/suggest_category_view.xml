<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/category_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:component_background_corner_radius="6dp"
        app:component_rounded_background="?attr/bgMinor"
        app:component_title_text_color="?attr/textMinor"
        app:component_title_typeface="medium"
        app:component_vertical_padding="4dp"/>
</FrameLayout>
