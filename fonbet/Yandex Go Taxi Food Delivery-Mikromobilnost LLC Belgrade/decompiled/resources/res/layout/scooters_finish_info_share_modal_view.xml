<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ListItemComponent
        android:layout_gravity="top|fill_horizontal"
        android:id="@+id/toolbar_list_item_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:component_no_background="true"
        app:component_title="@string/scooters_finish_info_share_title"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_body"/>
    <com.yandex.go.design.view.GoConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/share_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/scooters_finish_info_share_a11y_card"
        android:elevation="12dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/logo_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/scooters_finish_info_share_a11y_app_logo"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:layout_constraintEnd_toStartOf="@+id/vehicle_icon_image_view"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginTop="0dp"/>
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/vehicle_icon_image_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/go_design_s_space"
            android:scaleType="center"
            android:contentDescription="@string/scooters_finish_info_share_a11y_scooter"
            android:layout_marginEnd="@dimen/go_design_s_space"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption_secondary"
            android:textColor="?attr/textMain"
            android:id="@+id/route_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintEnd_toStartOf="@+id/vehicle_icon_image_view"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo_image_view"
            app:layout_constraintVertical_bias="0"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="logo_image_view,route_text_view,vehicle_icon_image_view"/>
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/statistics_items_recycler_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_constraintVertical_bias="1"
            app:layout_goneMarginBottom="12dp">
            <ru.yandex.taxi.widget.ShimmeringBar
                android:id="@+id/map_shimmering_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="100dp"
                android:layout_marginHorizontal="12dp"
                app:barCornerRadius="12dp"
                app:centerColor="@color/shimmering_center_light"
                app:edgeColor="@color/component_gray_100"/>
            <com.yandex.go.design.view.GoImageView
                android:id="@+id/map_image_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:minHeight="100dp"
                android:contentDescription="@string/scooters_finish_info_share_a11y_map_with_route"
                android:layout_marginHorizontal="12dp"/>
        </com.yandex.go.design.view.GoFrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statistics_items_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.yandex.go.design.view.GoConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/round_buttons_recycler_view"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:paddingHorizontal="12dp"/>
</com.yandex.go.design.view.GoFrameLayout>
