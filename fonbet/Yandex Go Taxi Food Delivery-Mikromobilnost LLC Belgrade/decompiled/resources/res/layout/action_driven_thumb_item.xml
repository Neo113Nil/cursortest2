<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.widget.AnimatedRoundedCornersImageView
        android:id="@+id/shortcut_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:cornerRadius="@dimen/shortcuts_corners_round"
        app:layout_constraintBottom_toTopOf="@+id/shortcut_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_weight="78"
        app:rounded_corners_mode="with_scale_fix"/>
    <ru.yandex.taxi.design.BadgeView
        android:id="@+id/corner_text_badge"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:badge_horizontal_padding="6dp"
        app:badge_text_size="16sp"
        app:badge_text_typeface="regular"
        app:layout_constraintBottom_toBottomOf="@+id/shortcut_background"
        app:layout_constraintEnd_toEndOf="@+id/shortcut_background"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="wrap"/>
    <ru.yandex.taxi.design.BadgeView
        android:id="@+id/bubble_badge"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        app:badge_horizontal_padding="6dp"
        app:badge_text_size="16sp"
        app:badge_text_typeface="regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/shortcut_background"
        app:layout_constraintTop_toTopOf="@+id/shortcut_background"
        app:layout_constraintWidth_max="wrap"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/shortcuts_title"
        android:ellipsize="end"
        android:id="@+id/shortcut_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/shortcut_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shortcut_background"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:id="@+id/shortcut_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shortcut_title"/>
    <include layout="@layout/shortcut_labels_anchor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
