<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/firstColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:component_no_background="true"
            app:component_subtitle_lineSpacingExtra="@dimen/detailed_price_block_slot_line_spacing_extra"
            app:component_title_lineSpacingExtra="@dimen/detailed_price_block_slot_line_spacing_extra"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/secondColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:component_no_background="true"
            app:component_subtitle_lineSpacingExtra="@dimen/detailed_price_block_slot_line_spacing_extra"
            app:component_title_lineSpacingExtra="@dimen/detailed_price_block_slot_line_spacing_extra"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <Space
        android:id="@+id/tooltipAnchor"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</com.yandex.go.design.view.GoFrameLayout>
