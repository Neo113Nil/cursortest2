<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListHeaderComponent
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:component_title_font_feature_settings="pnum, lnum"
                app:component_title_lineSpacingExtra="-1sp"
                app:component_title_max_lines="2"
                app:component_title_size="27sp"
                app:component_title_typeface="bold"
                style="@style/ListTitleComponent"/>
            <com.yandex.go.transfer_requirement.ui.date_selector.TransferDateSelectorView
                android:id="@+id/transfer_date_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"/>
            <com.yandex.go.transfer_requirement.ui.flight_input.TransferNumberInputView
                android:id="@+id/number_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:orientation="horizontal"
                android:id="@+id/train_time_carriage_row"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/train_time_row"
                    android:background="@drawable/bg_transparent_ripple"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:component_divider_focused_state_margin_left="56dp"
                    app:component_divider_margin_left="56dp"
                    app:component_input_focused_divider_color="?attr/textMain"
                    app:component_input_unfocused_divider_color="?attr/textMinor"
                    app:component_subtitle_max_lines="2"
                    app:component_title_max_lines="2"/>
                <com.yandex.go.transfer_requirement.ui.flight_input.TransferNumberInputView
                    android:id="@+id/train_carriage_input"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </com.yandex.go.design.view.GoLinearLayout>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/luggage_count_list_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListItemSwitchComponent
                android:id="@+id/luggage_info_toggle"
                android:background="@drawable/bg_transparent_ripple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_subtitle_max_lines="2"
                app:component_title_max_lines="2"/>
            <ru.yandex.taxi.design.ListGroupHeaderComponent
                android:id="@+id/meeting_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                app:component_title_size="@dimen/component_text_size_caption"
                app:component_title_typeface="medium"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/passenger_selector"
                android:background="@drawable/bg_transparent_ripple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_subtitle_size="@dimen/component_text_size_body"
                app:component_subtitle_text_color="?attr/textMain"
                app:component_title_size="@dimen/component_text_size_caption"
                app:component_title_text_color="?attr/textMinor"/>
            <com.yandex.go.design.view.GoView
                android:id="@+id/meeting_section_divider"
                android:background="@drawable/transfer_item_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/component_text_size_caption"
                        android:ellipsize="end"
                        android:id="@+id/sign_input_title_helper_text_view"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="58dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/sign_input_title_helper_view"
                        android:visibility="invisible"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        app:layout_constraintStart_toEndOf="@+id/sign_input_title_helper_text_view"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ru.yandex.taxi.design.AnimatedListItemInputComponent
                    android:id="@+id/sign_text_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:component_divider_focused_state_margin_left="56dp"
                    app:component_input_clear_enable="false"
                    app:component_input_focused_divider_color="?attr/textMain"
                    app:component_input_max_lines="5"
                    app:component_input_type="text"
                    app:component_input_unfocused_divider_color="@color/transparent"
                    app:imeOptions="actionUnspecified"/>
            </FrameLayout>
            <ru.yandex.taxi.design.ListGroupHeaderComponent
                android:id="@+id/rules_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                app:component_title_size="@dimen/component_text_size_caption"
                app:component_title_typeface="medium"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:orientation="vertical"
                android:id="@+id/rules_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle"
                app:component_title_size="@dimen/component_text_size_body"
                app:component_title_text_color="?attr/textMain"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yandex.go.design.view.GoView
                    android:layout_gravity="top"
                    android:id="@+id/footer_shadow"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:importantForAccessibility="no"/>
                <com.yandex.go.design.view.GoLinearLayout
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:id="@+id/done_button_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="16sp"
                        android:textColor="?attr/error"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/done_button_error_text"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingHorizontal="@dimen/go_design_s_space"
                        app:component_title_font_feature_settings="pnum, lnum"
                        app:component_title_lineSpacingExtra="-1sp"
                        app:component_title_max_lines="2"/>
                    <ru.yandex.taxi.design.ButtonComponent
                        android:textSize="16sp"
                        android:id="@+id/done_button"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"/>
                </com.yandex.go.design.view.GoLinearLayout>
            </FrameLayout>
        </com.yandex.go.design.view.GoLinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/tooltip_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/sign_input_confirmation_container"
        android:background="@drawable/bg_confirmation_rounded_top"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp">
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="16sp"
            android:id="@+id/sign_input_cancel_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/common_cancel"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:component_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textMain"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="16sp"
            android:id="@+id/sign_input_save_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_save"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:component_button_outline_width="0dp"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoFrameLayout>
