<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/accessibility_scroll_up_helper"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/a11y_scroll_up_content"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@+id/rate_scroll_view"/>
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/rate_scroll_view"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/done_button_frame"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no">
            <com.yandex.go.taxi.order.details.v1.elements.upsell.UpsellView
                android:id="@+id/upsell"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/go_design_s_space"
                android:elevation="@dimen/order_screens_card_elevation"
                android:layout_marginHorizontal="@dimen/go_design_s_space"/>
            <FrameLayout
                android:id="@+id/bottom_sheet_card"
                android:background="@drawable/round_section_bg_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/order_screens_card_elevation">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_container"
                    android:background="?attr/cardDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/feedback_section"
                        android:background="@drawable/ic_complete_screen_top_container"
                        android:paddingTop="@dimen/order_state_view_top_padding"
                        android:paddingBottom="@dimen/order_state_view_top_padding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:tag="@string/bottom_sheet_peek_tag"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <include layout="@layout/order_screens_titles_text"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/top_divider"
                            android:background="?attr/line"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginHorizontal="@dimen/order_screens_card_content_side_offset"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/details_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/go_design_m_space"
                            android:layout_marginBottom="@dimen/go_design_s_space"
                            android:layout_marginHorizontal="@dimen/order_screens_card_content_side_offset">
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/new_cost_details_layout"
                                android:padding="@dimen/go_design_s_space"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/cost_details_layout"
                                android:paddingTop="@dimen/go_design_s_space"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="24dp"/>
                            <TextView
                                android:textSize="@dimen/component_text_size_caption"
                                android:textColor="@color/component_gray_300"
                                android:id="@+id/cost_message"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="24dp"/>
                            <com.yandex.go.taxi.order.details.v1.ui.SectionDetailView
                                android:id="@+id/section_detail"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginHorizontal="24dp"/>
                        </LinearLayout>
                        <com.yandex.go.design.divider.CardDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.yandex.go.taxi.order.communications.FramedRecyclerView
                            android:id="@+id/promo_plaque_top_section"
                            android:background="@drawable/rounded_border"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="@dimen/go_design_m_space"
                            android:layout_marginHorizontal="@dimen/go_design_s_space"/>
                        <com.yandex.go.taxi.order.details.v1.ui.DriverSectionView
                            android:id="@+id/driver_section"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <ru.yandex.taxi.design.CircleButtonsPanelComponent
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/rate_top_buttons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:fit_multiorder_card="false">
                            <ViewStub
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/driver_stub"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <ru.yandex.taxi.widget.buttons.IconCircleButton
                                android:id="@+id/safety_center"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:component_circle_image="@drawable/ic_safety_center_24"
                                app:component_circle_title_autofit="true"/>
                            <ru.yandex.taxi.widget.buttons.IconCircleButton
                                android:id="@+id/support_chat_button"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:component_circle_image="@drawable/ic_support"
                                app:component_circle_title_autofit="true"/>
                        </ru.yandex.taxi.design.CircleButtonsPanelComponent>
                        <ru.yandex.taxi.order.view.FeedbackView
                            android:id="@+id/feedback_rate_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
                            android:id="@+id/driver_phone_number_component"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/promo_plaque_bottom_section"
                        android:background="@drawable/round_section_bg"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false"
                        android:clipToOutline="true"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <com.yandex.go.taxi.order.quality_question.ui.QualityQuestionButton
                        android:id="@+id/quality_question_banner"
                        android:background="@drawable/ic_complete_section_background"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingVertical="8dp"/>
                    <ru.yandex.taxi.combo.ui.TravelCompanionDetailView
                        android:id="@+id/travel_companion_detail_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/ic_complete_screen_bottom_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <ru.yandex.taxi.design.AutoDividerComponentList
                            android:orientation="vertical"
                            android:id="@+id/auto_divider_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:component_middle_divider_type="icon"
                            app:component_top_divider_type="normal">
                            <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
                                android:id="@+id/ride_support"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:component_no_background="true"/>
                            <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
                                android:id="@+id/payment_method"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:component_navigation_icon="@drawable/component_trail_navigation_elevator"
                                app:component_no_background="true"
                                app:component_subtitle="@string/summary_payment_method_title"/>
                            <ru.yandex.taxi.costcenters.ride.OpenCostCenterListItem
                                android:id="@+id/cost_center"
                                android:background="@color/transparent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                            <com.yandex.go.taxi.order.details.v1.ui.DetailsCardListItem
                                android:id="@+id/details"
                                android:background="@color/transparent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </ru.yandex.taxi.design.AutoDividerComponentList>
                        <com.yandex.go.taxi.order.details.v1.ui.DetailsCardHorizontalButtons
                            android:id="@+id/horizontal_buttons"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/done_button_frame"
        app:scroll_view_id="@+id/rate_scroll_view"/>
    <View
        android:id="@+id/accessibility_scroll_down_helper"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/a11y_scroll_down_content"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@+id/done_button_frame"/>
    <FrameLayout
        android:id="@+id/done_button_frame"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rate_scroll_view">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_done"
            app:component_background_color="?attr/controlMain"
            app:component_button_accent="true"
            app:component_disabled_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textOnControl"
            style="@style/BottomEdgeButtonMarginStyle"/>
    </FrameLayout>
</merge>
