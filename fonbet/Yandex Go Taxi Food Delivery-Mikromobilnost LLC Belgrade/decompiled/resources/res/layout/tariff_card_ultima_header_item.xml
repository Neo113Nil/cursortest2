<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgMinor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.yandex.go.design.view.GoConstraintLayout
        android:id="@+id/ultima_header_layout"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/tariff_card_background_image"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/tariff_card_background_gradient"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/addresses"
            android:background="@drawable/bg_white_ripple"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginStart="56dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/tariff_card_info_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="@color/white"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/source_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:maxLines="1"
                app:robotoFontStyle="medium"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="@color/white"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/destination_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:robotoFontStyle="medium"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tariff_card_info_icon"
            android:background="@drawable/bg_white_ripple"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_info"
            android:scaleType="centerCrop"
            android:contentDescription="@string/summary_accessibility_tariff_details"
            android:paddingHorizontal="@dimen/go_design_m_space"
            android:paddingVertical="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white_alpha50"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_title"
            android:textColor="@color/white"
            android:id="@+id/tariff_card_tariff_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-4sp"
            android:importantForAccessibility="yes"
            android:textAlignment="viewStart"
            android:fontFeatureSettings="@string/go_default_font_settings"
            android:layout_marginHorizontal="@dimen/go_design_m_space"
            android:lineHeight="30sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tariff_card_tariff_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.widget.ShimmeringRobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="@color/white_alpha50"
            android:id="@+id/tariff_card_tariff_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:importantForAccessibility="yes"
            android:textAlignment="viewStart"
            android:fontFeatureSettings="@string/go_default_font_settings"
            android:layout_marginHorizontal="@dimen/go_design_m_space"
            android:lineHeight="14sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tariff_card_price"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/tariff_description_placeholder"
            android:layout_width="223dp"
            android:layout_height="16sp"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/go_design_m_space"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tariff_card_tariff_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tariff_card_tariff_description"
            app:placeholder_color="@color/component_placeholder_spanish_grey"
            app:placeholder_corner_radius="6dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.ShimmeringRobotoTextView
            android:textSize="@dimen/component_text_size_title"
            android:textColor="@color/white"
            android:id="@+id/tariff_card_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-7sp"
            android:layout_marginStart="@dimen/go_design_m_space"
            android:fontFeatureSettings="@string/go_default_font_settings"
            android:paddingVertical="6dp"
            android:lineHeight="21sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/price_placeholder"
            android:layout_width="63dp"
            android:layout_height="24sp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/tariff_card_price"
            app:layout_constraintStart_toStartOf="@+id/tariff_card_price"
            app:layout_constraintTop_toTopOf="@+id/tariff_card_price"
            app:placeholder_color="@color/component_placeholder_spanish_grey"
            app:placeholder_corner_radius="6dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <ru.yandex.taxi.widget.ShimmeringRobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="@color/white_alpha50"
            android:id="@+id/tariff_card_price_details"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFeatureSettings="@string/go_default_font_settings"
            android:layout_marginHorizontal="@dimen/go_design_m_space"
            android:lineHeight="15sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/tariff_card_price"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/tariff_card_price"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.widget.PlaceholderView
            android:id="@+id/price_details_placeholder"
            android:layout_width="172dp"
            android:layout_height="15sp"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="@dimen/go_design_m_space"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/price_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="@+id/price_placeholder"
            app:layout_constraintTop_toTopOf="@+id/price_placeholder"
            app:placeholder_color="@color/component_placeholder_spanish_grey"
            app:placeholder_corner_radius="6dp"
            app:placeholder_shimmering="true"
            app:placeholder_type="rectangle"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/prices_flow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:constraint_referenced_ids="tariff_card_price,tariff_card_price_details"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="16dp"
            app:flow_horizontalStyle="spread_inside"
            app:flow_verticalAlign="baseline"
            app:flow_verticalGap="-12dp"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.yandex.go.design.view.GoConstraintLayout>
</com.yandex.go.design.view.GoFrameLayout>
