<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space">
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="218dp"
            android:layout_height="32dp"
            android:layout_marginTop="72dp"
            app:ybsdk_cornerRadius="8dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="273dp"
            android:layout_height="16dp"
            android:layout_marginTop="13dp"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="164dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            app:ybsdk_cornerRadius="6dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:paddingVertical="12dp">
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_width="40dp"
                android:layout_height="27dp"
                android:layout_marginVertical="6.5dp"
                app:ybsdk_cornerRadius="6dp"/>
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_width="219dp"
                android:layout_height="24dp"
                android:layout_marginStart="15dp"
                android:layout_marginVertical="6.5dp"
                app:ybsdk_cornerRadius="8dp"/>
        </LinearLayout>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="327dp"
            android:layout_height="72dp"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="101dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            app:ybsdk_cornerRadius="12dp"/>
    </LinearLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
