<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_scooter_circle_icon"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:id="@+id/about_tariff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scooters_fix_about"
        android:drawablePadding="3dp"
        android:drawableEnd="@drawable/ic_nav_arrow"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:text="@string/scooters_tariff_fix_title"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/scooters_tariff_fix_subtitle"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        app:component_divider_position="top"
        app:component_divider_type="margin"
        app:component_lead_image="@drawable/ic_scooter_b_point"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_trail_mode="navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/suggest_shimmer_1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toBottomOf="@+id/address"
        app:layout_constraintEnd_toEndOf="@+id/address"
        app:layout_constraintStart_toStartOf="@+id/address"
        app:layout_constraintTop_toTopOf="@+id/address"
        app:scrolledHorizontally="true"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/time_on_the_way"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_divider_position="top"
        app:component_divider_type="margin"
        app:component_lead_image="@drawable/ic_scooters_tariff_fix_route_time"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_trail_mode="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/address"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/suggest_shimmer_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_on_the_way"
        app:layout_constraintStart_toStartOf="@+id/time_on_the_way"
        app:layout_constraintTop_toBottomOf="@+id/time_on_the_way"
        app:scrolledHorizontally="true"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:enabled="false"
        android:id="@+id/order_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/scooters_book"
        app:component_title_color="?attr/textMain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_on_the_way"
        style="@style/BottomEdgeButtonMarginStyle"/>
</com.yandex.go.design.view.GoConstraintLayout>
