<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp">
    <ImageView
        android:id="@+id/errorIcon"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:layout_marginTop="26dp"
        android:src="@drawable/ybsdk_ic_error_icon"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ybsdk_common_error_layout_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorIcon"
        style="@style/Widget.YB.Text.Headline1"/>
    <TextView
        android:id="@+id/errorTextSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ybsdk_app_common_bank_sdk_div_bottom_sheet_error_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorText"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/errorRetryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/errorTextSubtitle"
        app:ybsdk_buttonTitle="@string/ybsdk_common_error_retry"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <com.ybsdk.widgets.common.TraceIdErrorView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/errorTextViewTraceId"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_common_trace_id_error_code"
        android:maxLines="1"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorRetryButton"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
