<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:paddingBottom="@dimen/go_design_s_space"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/incident_icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/incident_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/small_camera_icon"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="-5dp"
        android:src="@drawable/ic_small_camera"
        android:layout_marginEnd="-5dp"
        app:layout_constraintBottom_toBottomOf="@+id/incident_icon"
        app:layout_constraintEnd_toEndOf="@+id/incident_icon"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/incident_icon"
        app:layout_constraintTop_toTopOf="@+id/incident_icon"
        app:layout_constraintVertical_bias="0"/>
    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:id="@+id/incident_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/incident_icon"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
        android:textColor="?attr/textMinor"
        android:id="@+id/incident_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/incident_title"
        app:robotoFontStyle="regular"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/incident_no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/component_dots_indicator_small_item_size"
        app:component_background_color="?attr/controlMinor"
        app:component_title_color="?attr/textOnControlMinor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/incident_yes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/incident_subtitle"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/incident_yes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMain"
        app:component_title_color="?attr/textOnControl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/incident_no"
        app:layout_constraintTop_toBottomOf="@+id/incident_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
