<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/suggest_yb_card_header_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/suggest_yb_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:component_title_gravity="start"
        app:component_title_typeface="bold"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/suggest_yb_card_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_text_size="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/suggest_yb_card_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_background_color="?attr/controlMinor"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/suggest_yb_card_accept_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_background_color="?attr/controlMain"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControl"/>
    </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
</LinearLayout>
