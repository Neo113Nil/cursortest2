<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/loyaltyErrorView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_loyalty_wallet_widget_error_title"
        android:paddingVertical="4dp"
        style="@style/Widget.YB.Text.Caption1.Medium"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:theme="@style/Theme.YB.Widgets.Common.Light"
        android:textColor="?attr/ybColor_textIcon_primaryStaticInverted"
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        app:ybsdk_buttonTitle="@string/ybsdk_loyalty_wallet_widget_error_button_title"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.S"/>
</LinearLayout>
