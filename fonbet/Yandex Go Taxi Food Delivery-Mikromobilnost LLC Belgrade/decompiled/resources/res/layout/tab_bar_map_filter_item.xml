<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/tab_bar_map_filter_selectable_background"
    android:padding="@dimen/discovery_map_category_filter_padding"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/discovery_map_category_filter_icon_size"
        android:layout_height="@dimen/discovery_map_category_filter_icon_size"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMain"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineHeight="@dimen/discovery_map_category_filter_line_height"
        app:robotoFontStyle="medium"/>
</com.yandex.go.design.view.GoLinearLayout>
