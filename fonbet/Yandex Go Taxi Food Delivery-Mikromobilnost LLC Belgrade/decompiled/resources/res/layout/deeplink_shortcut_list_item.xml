<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shortcut_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Space
            android:id="@+id/shortcut_bottom_start_space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="@dimen/go_design_s_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="0dp"
            app:layout_goneMarginStart="0dp"/>
        <Space
            android:id="@+id/shortcut_bottom_end_space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="6dp"
            android:layout_marginEnd="@dimen/go_design_s_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginEnd="0dp"/>
        <include layout="@layout/base_shortcut_list_item"/>
        <include layout="@layout/right_bottom_badge_anchor"/>
        <ru.yandex.taxi.design.BadgeView
            android:id="@+id/shortcut_badge_right"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:badge_horizontal_padding="6dp"
            app:badge_text_size="32dp"
            app:badge_text_typeface="light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="wrap"/>
        <ru.yandex.taxi.design.BadgeView
            android:id="@+id/shortcut_badge_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/shortcut_bottom_start_space"
            app:layout_constraintEnd_toEndOf="@+id/shortcut_bottom_end_space"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/shortcut_bottom_start_space"
            app:layout_constraintWidth_max="wrap"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include layout="@layout/shortcut_labels_anchor"/>
</FrameLayout>
