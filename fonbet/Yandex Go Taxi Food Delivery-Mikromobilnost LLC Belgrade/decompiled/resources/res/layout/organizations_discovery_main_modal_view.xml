<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/organization_main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/inner_flex_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/inner_native_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.yandex.taxi.widget.ShimmeringFrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/shimmering_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        app:shimmeringCornerRadius="100dp">
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_body"
            android:id="@+id/open_map_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:text="@string/discovery_organizations_open_map"
            app:component_background_color="?attr/textMain"
            app:component_button_accent="true"
            app:component_button_icon="@drawable/ic_discovery_map"
            app:component_button_icon_position="end"
            app:component_button_icon_tint="?attr/textInvert"
            app:component_button_rounded_corners_radius="100dp"
            app:component_button_size="S"
            app:component_title_color="?attr/textInvert"/>
    </ru.yandex.taxi.widget.ShimmeringFrameLayout>
    <com.yandex.go.design.view.GoView
        android:layout_gravity="bottom"
        android:id="@+id/navbar_view"
        android:background="?attr/bgMain"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/tab_bar"
        android:background="@drawable/discovery_main_tab_bar_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.yandex.go.design.view.GoFrameLayout>
