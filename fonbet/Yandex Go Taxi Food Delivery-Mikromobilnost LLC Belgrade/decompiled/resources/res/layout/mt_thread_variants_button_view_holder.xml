<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoView
        android:id="@+id/lead"
        android:layout_width="56dp"
        android:layout_height="36dp"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_caption"
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:component_background_color="?attr/controlMinor"
        app:component_button_outline_width="0dp"
        app:component_button_rounded_corners_radius="10dp"
        app:component_button_size="XS"
        app:component_title_color="?attr/textOnControlMinor"/>
</com.yandex.go.design.view.GoLinearLayout>
