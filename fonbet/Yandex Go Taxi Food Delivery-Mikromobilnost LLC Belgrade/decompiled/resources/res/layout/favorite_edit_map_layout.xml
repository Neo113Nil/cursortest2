<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    app:cardBackgroundColor="?attr/bgTransparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/favorite_map_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0.5dp"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="?attr/bgTransparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <com.yandex.go.design.view.GoConstraintLayout
                android:background="?attr/controlMinor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ru.yandex.taxi.widget.ShimmeringImageView
                    android:id="@+id/map_image_view"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/point_on_map"
                    android:importantForAccessibility="yes"
                    app:layout_constraintBottom_toBottomOf="@+id/map_error_container"
                    app:layout_constraintTop_toTopOf="@+id/map_error_container"/>
                <androidx.cardview.widget.CardView
                    android:layout_gravity="center"
                    android:id="@+id/map_pin"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    app:cardBackgroundColor="?attr/bgMain"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/map_image_view"
                    app:layout_constraintEnd_toEndOf="@+id/map_image_view"
                    app:layout_constraintStart_toStartOf="@+id/map_image_view"
                    app:layout_constraintTop_toTopOf="@+id/map_image_view">
                    <com.yandex.go.design.view.GoFrameLayout
                        android:layout_gravity="center"
                        android:background="@drawable/favorite_map_pin_background"
                        android:layout_width="28dp"
                        android:layout_height="28dp">
                        <com.yandex.go.design.view.GoImageView
                            android:layout_gravity="center"
                            android:id="@+id/map_pin_image"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_favorite_map_pin"
                            android:tint="?attr/textOnControlMinor"
                            android:importantForAccessibility="no"/>
                    </com.yandex.go.design.view.GoFrameLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/map_error_container"
                    android:visibility="invisible"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/favorite_edit_map_preview_error_title"
                    android:importantForAccessibility="yes"
                    android:paddingVertical="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.yandex.go.design.view.GoImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_favorite_map_error"
                        android:tint="?attr/error"
                        android:importantForAccessibility="no"/>
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="13sp"
                        android:textColor="?attr/error"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/favorite_edit_map_preview_error_title"
                        android:importantForAccessibility="no"
                        app:robotoFontStyle="medium"/>
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="11sp"
                        android:textColor="?attr/error"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:text="@string/favorite_edit_map_preview_error_subtitle"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </com.yandex.go.design.view.GoConstraintLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:textColor="?attr/textMain"
                android:id="@+id/map_address_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1"
                android:importantForAccessibility="yes"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:layout_gravity="center_vertical"
                android:id="@+id/map_address_skeleton"
                android:background="@drawable/bg_rounded"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/favorite_edit_skeleton_shimmering_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="32dp"
                android:backgroundTint="?attr/controlMinor"
                app:barCornerRadius="@dimen/favorite_edit_skeleton_shimmering_radius"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:textSize="13sp"
                android:id="@+id/map_edit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_edit"
                android:importantForAccessibility="yes"
                android:layout_marginStart="8dp"
                android:layout_marginVertical="12dp"
                app:component_background_color="?attr/controlMinor"
                app:component_button_size="XS"
                app:component_title_color="?attr/textMain"/>
        </LinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</androidx.cardview.widget.CardView>
