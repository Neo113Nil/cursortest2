<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/invite_link_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/copy_invite_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/copy_invite_link"
        android:contentDescription="@string/copy_invite_link_content_desc"
        style="@style/Messaging.Settings.Item.Text"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/share_invite_link"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/share_invite_link_content_desc"
        android:layout_marginEnd="16dp"
        app:srcCompat="@drawable/msg_ic_share"
        app:tint="?attr/messagingSettingsIconsColor"/>
</FrameLayout>
