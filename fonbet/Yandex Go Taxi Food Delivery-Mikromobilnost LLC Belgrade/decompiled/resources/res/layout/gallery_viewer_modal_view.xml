<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.image_viewer.ScalingContentFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"/>
    <com.yandex.go.image_viewer.ScalingContentViewPager
        android:id="@+id/image_slider"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.yandex.taxi.design.StoryProgressComponent
        android:id="@+id/image_progress_component"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:border_enabled="false"
        app:color="@color/shimmering_edge_point_2_light"
        app:fill_color="@color/shimmering_center_light"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|top"
        android:id="@+id/complaint_button"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/go_design_s_space"
        android:scaleType="center"
        app:srcCompat="@drawable/more_horizontal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/content_close_button"
        android:background="@drawable/close_floating"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/go_design_s_space"
        android:scaleType="center"
        android:elevation="2dp"
        app:srcCompat="@drawable/ic_cross_close"/>
</com.yandex.go.image_viewer.ScalingContentFrameLayout>
