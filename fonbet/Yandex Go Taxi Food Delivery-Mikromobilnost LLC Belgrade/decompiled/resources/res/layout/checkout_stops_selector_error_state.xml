<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/error_container"
        android:background="?attr/bgMain"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="704dp">
        <com.yandex.go.design.view.GoLinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/image_and_texts_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.yandex.go.design.view.GoImageView
                android:layout_gravity="center"
                android:id="@+id/error_stops_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0805da"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:id="@+id/error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/mt_stops_selector_stops_not_available_error_title"
                android:textAlignment="center"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:id="@+id/error_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mt_stops_selector_stops_not_available_error_subtitle"
                android:fontFamily="@font/ya_regular"
                android:textAlignment="center"/>
        </com.yandex.go.design.view.GoLinearLayout>
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/refresh_button_container"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp">
            <ru.yandex.taxi.widget.ButtonsView
                android:id="@+id/refresh_button"
                android:background="?attr/bgTransparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.yandex.go.design.view.GoFrameLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</merge>
