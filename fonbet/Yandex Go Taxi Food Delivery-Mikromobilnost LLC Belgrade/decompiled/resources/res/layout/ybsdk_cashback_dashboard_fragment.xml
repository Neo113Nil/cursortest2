<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.dashboard.DashboardViewLayout
        android:id="@+id/dashboardView"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.dashboard.DashboardCollapsingBalanceView
            android:id="@+id/linearLayout"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.ybsdk.widgets.common.DashboardDrawableTextView
                android:id="@+id/cashbackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/cashbackBalanceView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.ybsdk.widgets.common.DashboardBalanceTextView
                android:textColor="?attr/ybColor_textIcon_primary"
                android:gravity="center_vertical"
                android:id="@+id/cashbackBalanceView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_dashboard_account_balance_top_margin"
                android:maxLines="1"
                android:lineSpacingExtra="0sp"
                app:layout_constraintBottom_toTopOf="@+id/cashbackDescription"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cashbackTitle"
                style="@style/Widget.YB.Text.Numbers2"/>
            <TextView
                android:textColor="?attr/ybColor_textIcon_primary"
                android:gravity="center_vertical"
                android:id="@+id/cashbackDescription"
                android:tag="@string/ybsdk_tag_dashboard_middle_container_footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="0sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Widget.YB.Text.Body3"/>
        </com.ybsdk.widgets.common.dashboard.DashboardCollapsingBalanceView>
    </com.ybsdk.widgets.common.dashboard.DashboardViewLayout>
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/ybsdk_cashback_skeleton_item"/>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
