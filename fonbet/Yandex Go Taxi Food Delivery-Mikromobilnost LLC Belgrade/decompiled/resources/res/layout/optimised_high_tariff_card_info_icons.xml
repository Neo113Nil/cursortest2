<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <ViewStub
        android:id="@+id/coupon_icon_stub"
        android:layout="@layout/tariff_card_info_coupon_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"/>
    <ViewStub
        android:id="@+id/branding_icon_stub"
        android:layout="@layout/tariff_card_info_branding_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"/>
    <ru.yandex.taxi.plus.badge.CashbackHorizontalView
        android:id="@+id/text_plus_cash_back"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"/>
</FrameLayout>
