<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/pfmFilterCard"
    android:background="@drawable/ybsdk_pfm_filter_background"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/ybsdk_pfm_filter_min_height">
    <ImageView
        android:id="@+id/pfmFilterCardIconStart"
        android:padding="@dimen/ybsdk_pfm_filter_start_icon_paddings"
        android:visibility="gone"
        android:layout_width="@dimen/ybsdk_pfm_filter_icons_size"
        android:layout_height="@dimen/ybsdk_pfm_filter_icons_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pfmFilterTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/pfmFilterTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ybsdk_pfm_filter_icons_size"
        android:maxLines="1"
        android:layout_marginStart="@dimen/ybsdk_pfm_filter_text_margin_horizontal"
        android:layout_marginEnd="@dimen/ybsdk_pfm_filter_text_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pfmFilterIconEnd"
        app:layout_constraintStart_toEndOf="@+id/pfmFilterCardIconStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"
        style="@style/Widget.YB.Text.Body3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pfmFilterIconEnd"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/ybsdk_pfm_filter_icons_size"
        android:layout_height="@dimen/ybsdk_pfm_filter_icons_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pfmFilterTitle"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
