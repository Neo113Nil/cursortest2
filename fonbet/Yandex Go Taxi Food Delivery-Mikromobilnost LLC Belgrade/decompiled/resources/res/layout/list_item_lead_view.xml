<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lead_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:paddingEnd="@dimen/go_design_s_space"
    android:paddingVertical="@dimen/go_design_s_space">
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="center"
        android:id="@+id/lead_background"
        android:background="@drawable/bg_list_shortcut_background"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"/>
</FrameLayout>
