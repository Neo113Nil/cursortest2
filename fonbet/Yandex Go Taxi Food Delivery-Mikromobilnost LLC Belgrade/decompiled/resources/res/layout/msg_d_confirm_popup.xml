<?xml version="1.0" encoding="utf-8"?>
<com.yandex.alicekit.core.views.BackHandlingLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/messagingCommonActionbarColor"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/button_delete"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="24dp"
        style="@style/Messaging.MessagePopupDestructiveButton"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/button_cancel"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_confirm_cancel"
        android:drawablePadding="24dp"
        android:drawableTint="?attr/messagingCommonIconsSecondaryColor"
        style="@style/Messaging.MessagePopupButton"/>
</com.yandex.alicekit.core.views.BackHandlingLinearLayout>
