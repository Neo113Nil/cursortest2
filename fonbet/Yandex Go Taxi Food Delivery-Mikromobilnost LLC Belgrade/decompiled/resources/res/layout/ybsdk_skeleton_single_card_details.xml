<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonCard"
            android:layout_width="@dimen/ybsdk_screen_card_image_width"
            android:layout_height="@dimen/ybsdk_screen_card_image_height"
            android:layout_marginTop="@dimen/ybsdk_screen_card_toolbar_height"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ybsdk_cornerRadius="10dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonCardName"
            android:layout_width="109dp"
            android:layout_height="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonCard"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonCardDescription"
            android:layout_width="64dp"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonCardName"
            app:ybsdk_cornerRadius="24dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonRequisites"
            android:layout_width="167dp"
            android:layout_height="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonCardDescription"
            app:ybsdk_cornerRadius="6dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonCardNumber"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_card_details_skeleton_height_big"
            android:layout_marginTop="20dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintTop_toBottomOf="@+id/skeletonRequisites"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonCardExpire"
            android:layout_width="0dp"
            android:layout_height="@dimen/ybsdk_card_details_skeleton_height_big"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/skeletonCardCvv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonCardNumber"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonCardCvv"
            android:layout_width="0dp"
            android:layout_height="@dimen/ybsdk_card_details_skeleton_height_big"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/skeletonCardExpire"
            app:layout_constraintTop_toBottomOf="@+id/skeletonCardNumber"
            app:ybsdk_cornerRadius="16dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonSetting"
            android:layout_width="167dp"
            android:layout_height="20dp"
            android:layout_marginTop="36dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonCardCvv"
            app:ybsdk_cornerRadius="6dp"/>
        <include
            android:id="@+id/skeletonSettingsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@+id/skeletonSetting"
            layout="@layout/ybsdk_skeleton_card_settings_list"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/skeletonSettingManagement"
            android:layout_width="167dp"
            android:layout_height="20dp"
            android:layout_marginTop="36dp"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonSettingsList"
            app:ybsdk_cornerRadius="6dp"/>
        <include
            android:id="@+id/skeletonSettingsManagementList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@+id/skeletonSettingManagement"
            layout="@layout/ybsdk_skeleton_card_settings_list"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
