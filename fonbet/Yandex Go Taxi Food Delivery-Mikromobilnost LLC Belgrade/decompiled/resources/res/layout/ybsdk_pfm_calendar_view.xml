<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/inputs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ybsdk_loadable_input_height"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.ybsdk.widgets.common.LoadableInput
            android:id="@+id/startDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ybsdk_loadable_input_height"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
        <com.ybsdk.widgets.common.LoadableInput
            android:id="@+id/endDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ybsdk_loadable_input_height"
            android:layout_weight="1"
            style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    </LinearLayout>
    <com.ybsdk.widgets.common.rangedatepicker.RangeDatePickerCalendarView
        android:orientation="vertical"
        android:id="@+id/verticalCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inputs"/>
</merge>
