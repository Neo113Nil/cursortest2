<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/savingsAccountGoalContentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/goalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_savings_goal_title_default"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/Widget.YB.Text.Headline1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/goalSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ybsdk_savings_goal_subtitle_default"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/goalTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/goalSubtitle"
        app:ybsdk_inputLabel="@string/ybsdk_savings_goal_input_label_amount"
        app:ybsdk_should_restore_saved_instance_state="false"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground">
        <requestFocus/>
    </com.ybsdk.widgets.common.LoadableInput>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/amount"
        app:ybsdk_inputLabel="@string/ybsdk_savings_goal_input_label_date"
        app:ybsdk_should_restore_saved_instance_state="false"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/buttonsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard"/>
    <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
