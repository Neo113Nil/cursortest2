<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/top_fade"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoConstraintLayout
        android:id="@+id/service_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/service_icon_image"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:alpha="0"
            android:elevation="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/service_name_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/service_name_view"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:id="@+id/service_name_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:alpha="0"
            android:layout_marginStart="@dimen/go_design_s_space"
            app:layout_constraintStart_toEndOf="@+id/service_icon_image"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.yandex.go.design.view.GoConstraintLayout>
    <include
        android:id="@+id/plus_container"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/top_end_corner_with_cashback"/>
    <FrameLayout
        android:id="@+id/surge_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoImageButton
        android:id="@+id/super_profile_menu_button"
        android:background="@drawable/bg_transparent_rounded_ripple"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_hamburger"
        android:tint="?attr/textMain"
        android:layout_marginVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
