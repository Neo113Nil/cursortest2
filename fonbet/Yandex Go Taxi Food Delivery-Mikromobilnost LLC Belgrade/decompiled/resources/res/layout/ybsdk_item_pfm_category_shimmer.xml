<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="@dimen/ybsdk_pfm_category_amount_margin_top"
            android:shape="rectangle"
            app:ybsdk_backgroundColor="?attr/ybColor_other_skeleton"
            app:ybsdk_cornerRadius="@dimen/ybsdk_pfm_category_corner_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:shape="rectangle"
            android:layout_marginHorizontal="13dp"
            android:layout_marginVertical="4dp"
            app:ybsdk_backgroundColor="?attr/ybColor_other_skeleton"
            app:ybsdk_cornerRadius="@dimen/ybsdk_pfm_shimmer_category_texts_corner_radius"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_marginBottom="2dp"
            android:shape="rectangle"
            android:layout_marginHorizontal="27dp"
            app:ybsdk_backgroundColor="?attr/ybColor_other_skeleton"
            app:ybsdk_cornerRadius="@dimen/ybsdk_pfm_shimmer_category_texts_corner_radius"/>
    </LinearLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
