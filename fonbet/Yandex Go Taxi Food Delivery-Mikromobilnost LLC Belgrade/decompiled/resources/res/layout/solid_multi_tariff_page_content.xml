<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.DialogueComponent
        android:id="@+id/multi_tariff_page_dialogue"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/multi_tariff_page_dialogue_header"
            layout="@layout/summary_dialog_header_item"/>
        <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
            android:id="@+id/tariff_card_scroll_view"
            android:background="?attr/bgMain"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/solid_tariff_page_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/solid_summary_order_button_block_height"
                android:animateLayoutChanges="false">
                <FrameLayout
                    android:id="@+id/tariff_page_source_destination_container"
                    android:background="@drawable/round_section_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/summary_tariff_page_divider"
                    style="@style/SummaryTariffPageDivider"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tariff_info_container"
                    android:background="@drawable/round_section_bg_top"
                    android:paddingTop="@dimen/go_design_m_space"
                    android:paddingBottom="@dimen/go_design_s_space"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/select_destination_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:id="@+id/solid_tariff_page_name"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/tariff_page_content_title_height"
                        android:layout_marginStart="@dimen/go_design_m_space"
                        android:layout_marginEnd="@dimen/go_design_m_space"
                        app:layout_constraintEnd_toStartOf="@+id/solid_tariff_page_price"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/select_destination_container"
                        style="@style/SummaryTariffPageTitle"/>
                    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
                        android:textSize="@dimen/component_text_size_header"
                        android:id="@+id/solid_tariff_page_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/go_design_m_space"
                        android:fontFeatureSettings="@string/go_default_font_settings"
                        app:layout_constraintBaseline_toBaselineOf="@+id/solid_tariff_page_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:robotoFontStyle="light"/>
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="@dimen/component_text_size_body"
                        android:id="@+id/solid_tariff_page_subtitle"
                        android:paddingBottom="@dimen/go_design_s_space"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/go_design_m_space"
                        android:layout_marginStart="@dimen/go_design_m_space"
                        android:layout_marginEnd="@dimen/go_design_m_space"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/solid_tariff_page_name"
                        app:robotoFontStyle="regular"/>
                    <ru.yandex.taxi.widget.RobotoTextView
                        android:textSize="@dimen/component_text_size_caption"
                        android:id="@+id/solid_tariff_page_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:translationY="@dimen/solid_summary_eta_margin"
                        android:layout_marginEnd="@dimen/go_design_m_space"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/solid_tariff_page_price"
                        app:robotoFontStyle="medium"/>
                    <ru.yandex.taxi.requirements.ui.bubbles.RequirementsBubblesContainer
                        android:id="@+id/multi_tariff_page_bubbles_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@+id/solid_tariff_page_subtitle"/>
                    <ViewStub
                        android:id="@+id/tariff_page_auction_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/go_design_s_space"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/multi_tariff_page_bubbles_container"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/multi_tariff_rest_content_divider"
                    style="@style/SummaryTariffPageDivider"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/multi_tariff_rest_content"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ru.yandex.taxi.design.AutoDividerComponentList
                        android:orientation="vertical"
                        android:id="@+id/badges_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:component_middle_divider_type="margin"/>
                    <ru.yandex.taxi.design.AutoDividerComponentList
                        android:id="@+id/multi_tariff_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:component_middle_divider_type="margin"
                        app:component_top_divider_type="normal"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/requirements_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>
            </LinearLayout>
        </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    </ru.yandex.taxi.design.DialogueComponent>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:layout_gravity="bottom"
        android:id="@+id/scroll_indicator_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/solid_summary_order_button_block_height"
        app:scroll_view_id="@+id/tariff_card_scroll_view"/>
    <include
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/tariff_page_order_button"/>
</FrameLayout>
