<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/expanded_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/lead_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="center"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:translationY="-0.12sp"
            android:importantForAccessibility="no"
            android:textAlignment="center"
            android:layout_marginEnd="40dp"
            android:letterSpacing="0"
            android:fontFeatureSettings="pnum, lnum"
            android:paddingHorizontal="8dp"
            android:lineHeight="17sp"
            app:robotoFontStyle="medium"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/collapsed_button"
        android:layout_width="@dimen/places_searchbar_size_collapsed"
        android:layout_height="@dimen/places_searchbar_size_collapsed"
        android:foreground="@drawable/ripple_places_searchbar"
        android:scaleType="center"
        android:translationX="@dimen/places_searchbar_size_collapsed"/>
</merge>
