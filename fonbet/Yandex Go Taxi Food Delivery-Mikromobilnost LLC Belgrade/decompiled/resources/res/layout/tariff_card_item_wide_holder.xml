<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/wide_tariff_tariff_card_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:addStatesFromChildren="true"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/tariff_card_height">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wide_tariff_touch_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tariff_card_inner_height"
        android:paddingStart="@dimen/wide_tariff_card_horizontal_margin">
        <View
            android:id="@+id/wide_tariff_min_width_view"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/wide_tariff_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/price_icons_group"/>
        <FrameLayout
            android:id="@+id/wide_tariff_class_icon_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="false"
            app:layout_constraintBottom_toBottomOf="@+id/wide_tariff_min_width_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/price_icons_group"
            app:layout_constraintTop_toTopOf="@+id/wide_tariff_min_width_view">
            <ImageView
                android:id="@+id/wide_tariff_class_icon"
                android:layout_width="84dp"
                android:layout_height="@dimen/tariff_card_inner_height"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/price_icons_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            app:layout_constraintBottom_toTopOf="@+id/wide_tariff_title"
            app:layout_constraintEnd_toStartOf="@+id/wide_tariff_class_icon_group"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/wide_tariff_antisurge_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/wide_tariff_surge_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/tariff_card_surge_note"
                android:layout_marginEnd="2dp"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/tariff_card_price_text_size"
                android:id="@+id/wide_tariff_cost"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:robotoFontStyle="regular"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/tariff_card_original_price_text_size"
                android:textColor="?attr/textMinor"
                android:id="@+id/wide_tariff_original_cost"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:importantForAccessibility="no"
                android:layout_marginStart="2dp"
                app:robotoFontStyle="regular"/>
        </LinearLayout>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:gravity="center_vertical"
            android:id="@+id/wide_tariff_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="6dp"
            android:layout_marginEnd="@dimen/wide_tariff_card_horizontal_margin"
            android:letterSpacing="0.01"
            app:layout_constraintBottom_toTopOf="@+id/wide_tariff_modifier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/price_icons_group"
            app:layout_constraintTop_toBottomOf="@+id/price_icons_group"
            app:robotoFontStyle="regular"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_caption"
            android:textColor="?attr/textMinor"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/wide_tariff_modifier"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="216dp"
            android:maxLines="1"
            android:lineSpacingExtra="6dp"
            android:paddingEnd="@dimen/wide_tariff_card_horizontal_margin"
            android:letterSpacing="0.01"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/price_icons_group"
            app:layout_constraintTop_toBottomOf="@+id/wide_tariff_title"
            app:robotoFontStyle="regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.yandex.go.design.view.GoFrameLayout>
