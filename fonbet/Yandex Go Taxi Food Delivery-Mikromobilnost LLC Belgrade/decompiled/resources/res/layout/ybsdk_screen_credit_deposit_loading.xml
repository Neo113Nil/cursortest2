<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/creditDepositToolbarSkeleton"
        android:layout_width="186dp"
        android:layout_height="20dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_cornerRadius="8dp"/>
    <com.ybsdk.widgets.common.MoneyInputEditView
        android:theme="@style/YbSdk.Widget.WidgetsCommon.NumbersInput"
        android:enabled="false"
        android:textColor="?attr/ybColor_fill_default_200"
        android:id="@+id/creditDepositAmountInputSkeleton"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ybsdk_transfer_amount_hint"
        android:singleLine="true"
        android:digits="0123456789.,"
        android:inputType="numberDecimal"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toTopOf="@+id/creditDepositDescriptionSkeleton"
        app:layout_constraintEnd_toStartOf="@+id/creditDepositAmountCurrencySkeleton"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creditDepositToolbarSkeleton"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.YB.Text.Numbers2"/>
    <TextView
        android:textColor="?attr/ybColor_fill_default_200"
        android:id="@+id/creditDepositAmountCurrencySkeleton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/ybsdk_transfer_currency_hint"
        app:layout_constraintBaseline_toBaselineOf="@+id/creditDepositAmountInputSkeleton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/creditDepositAmountInputSkeleton"
        style="@style/Widget.YB.Text.Numbers2"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/creditDepositDescriptionSkeleton"
        android:layout_width="218dp"
        android:layout_height="28dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/creditDepositKeyboardSkeleton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creditDepositAmountInputSkeleton"
        app:ybsdk_cornerRadius="6dp"/>
    <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
        android:id="@+id/creditDepositKeyboardSkeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/creditDepositButtonSkeleton"
        app:ybsdk_additionalButtonType="comma"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/creditDepositButtonSkeleton"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_button_min_height_large"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ybsdk_cornerRadius="@dimen/ybsdk_cornerradius_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
