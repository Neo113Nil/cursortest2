<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFeatureSettings="@string/go_default_font_settings"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/reasons_recycler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reasons_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:background="@drawable/top_corners_24dp"
        android:paddingTop="@dimen/go_design_s_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="@dimen/cancel_reasons_controls_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reasons_recycler">
        <ru.yandex.taxi.design.ListItemInputComponent
            android:id="@+id/commentField"
            android:background="@drawable/cancel_reasons_feedback_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:layout_marginHorizontal="@dimen/go_design_s_space"
            app:component_input_clear_enable="false"
            app:component_input_hint="@string/comment_hint"
            app:component_max_lines="3"
            app:component_show_underline="false"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:textColor="?attr/textOnControl"
            android:id="@+id/done_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_done"
            app:component_background_color="?attr/controlMain"
            app:component_button_accent="true"
            style="@style/BottomEdgeButtonMarginStyle"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
