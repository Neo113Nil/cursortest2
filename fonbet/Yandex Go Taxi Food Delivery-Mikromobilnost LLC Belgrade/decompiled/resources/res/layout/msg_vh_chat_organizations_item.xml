<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:id="@+id/chat_organizations_avatar"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:layout_marginStart="12dp"
        app:avatarPadding="0dp"
        app:borderMargin="2dp"
        app:borderThickness="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/chat_organizations_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/chat_info_default_item_height"
        android:maxLines="3"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/chat_organizations_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/chat_organizations_avatar"
        app:layout_constraintTop_toTopOf="@+id/chat_organizations_avatar"
        style="@style/Messaging.Settings.Item.Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
