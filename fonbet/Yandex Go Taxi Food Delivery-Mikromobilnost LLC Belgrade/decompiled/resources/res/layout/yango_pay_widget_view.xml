<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/yango_pay_main_container"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:id="@+id/yango_pay_lead_image"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="?attr/textMain"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/yango_pay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:fontFeatureSettings="pnum, lnum"
            app:layout_constraintBottom_toTopOf="@+id/yango_pay_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/yango_trail_button"
            app:layout_constraintStart_toEndOf="@+id/yango_pay_lead_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="13sp"
            android:textColor="?attr/textMinor"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/yango_pay_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:fontFeatureSettings="pnum, lnum"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/yango_trail_button"
            app:layout_constraintStart_toEndOf="@+id/yango_pay_lead_image"
            app:layout_constraintTop_toBottomOf="@+id/yango_pay_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textColor="?attr/textOnControlMinor"
            android:gravity="center"
            android:id="@+id/yango_trail_button"
            android:background="@drawable/bg_yango_pay_information_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="?attr/controlMinor"
            android:layout_marginHorizontal="8dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/yango_pay_checkbox"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.design.CheckBoxComponent
            android:id="@+id/yango_pay_checkbox"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/yango_pay_switch"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.yandex.taxi.design.SwitchComponent
            android:id="@+id/yango_pay_switch"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/yango_pay_trail_image"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <GridLayout
        android:id="@+id/yango_pay_actions_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:columnCount="2"/>
</merge>
