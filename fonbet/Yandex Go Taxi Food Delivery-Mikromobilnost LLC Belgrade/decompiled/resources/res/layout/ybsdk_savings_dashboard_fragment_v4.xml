<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout
        android:id="@+id/dashboardContainer"
        android:background="?attr/ybColor_fill_default_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/motionLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutDescription="@xml/ybsdk_savings_dashboard_motion_scene_v4">
            <View
                android:id="@+id/headerBackground"
                android:background="@drawable/ybsdk_savings_dashboard_header_background"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:backgroundTint="?attr/ybColor_fill_default_0"
                app:layout_constraintBottom_toBottomOf="@+id/headerBarrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/backgroundGradient"
                android:focusable="false"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ybsdk_savings_dashboard_v4_background_gradient_height"
                android:importantForAccessibility="no"/>
            <FrameLayout
                android:id="@+id/toolbarIconsContainer"
                android:paddingRight="@dimen/ybsdk_toolbar_view_side_padding"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ybsdk_toolbar_height"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/endIcon"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/ybsdk_toolbar_icon_size"
                    android:layout_height="@dimen/ybsdk_toolbar_icon_size"
                    android:scaleType="center"
                    android:contentDescription="@string/ybsdk_dashboard_action_contact_support_title"
                    android:stateListAnimator="@animator/ybsdk_click_scale_animator"
                    app:srcCompat="@drawable/ybsdk_ic_support_v2"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/headerTitleImage"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/headerTitle"
                app:layout_constraintEnd_toStartOf="@+id/headerTitle"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/headerTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_savings_header_content_top_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/headerTitleImage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Widget.YB.Text.Title2"/>
            <com.ybsdk.core.design.spoiler.SpoilerFrameLayout
                android:id="@+id/headerTotalAmountSpoiler"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="yes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/headerTitle"
                app:ybsdk_spoiler_height="44dp"
                app:ybsdk_spoiler_horizontal_gravity="center"
                app:ybsdk_spoiler_vertical_gravity="bottom"
                app:ybsdk_spoiler_width="229dp">
                <com.ybsdk.feature.savings.internal.views.SavingsAccountTickerView
                    android:textColor="?attr/ybColor_textIcon_primary"
                    android:gravity="center"
                    android:id="@+id/headerTotalAmountView"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lineSpacingExtra="0sp"
                    android:importantForAccessibility="no"
                    android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                    style="@style/Widget.YB.Text.Numbers2"/>
            </com.ybsdk.core.design.spoiler.SpoilerFrameLayout>
            <com.ybsdk.feature.divkit.api.ui.YbDivView
                android:id="@+id/headerDivView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/headerTotalAmountSpoiler"
                app:layout_goneMarginTop="0dp"/>
            <include
                android:id="@+id/headerShimmer"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_savings_header_content_top_margin"
                android:importantForAccessibility="noHideDescendants"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/ybsdk_savings_dashboard_header_shimmer_layout_v4"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/headerBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="headerDivView,headerShimmer"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/recyclerContent"
                android:paddingBottom="@dimen/ybsdk_savings_shelves_vertical_margins"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/headerBarrier"/>
            <View
                android:id="@+id/contentShimmer"
                android:background="@drawable/ybsdk_savings_dashboard_content_shimmer_background"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/ybsdk_savings_shelves_vertical_margins"
                android:importantForAccessibility="no"
                android:backgroundTint="?attr/ybColor_fill_default_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/recyclerContent"/>
        </androidx.constraintlayout.motion.widget.MotionLayout>
    </com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
