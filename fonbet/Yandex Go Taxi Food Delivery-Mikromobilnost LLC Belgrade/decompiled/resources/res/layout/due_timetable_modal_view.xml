<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="@dimen/go_design_m_space"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@+id/center_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_subtitle"
            android:textColor="?attr/textMain"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:robotoFontStyle="medium"/>
        <ru.yandex.taxi.widget.SingleShimmeringBar
            android:id="@+id/title_shimmering_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:paddingEnd="32dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/center_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/footer_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container">
        <include
            android:id="@+id/content_container"
            android:visibility="gone"
            layout="@layout/due_timetable_content_layout"/>
        <include
            android:id="@+id/loading_container"
            android:visibility="gone"
            layout="@layout/due_timetable_loading_layout"/>
        <include
            android:id="@+id/error_container"
            android:visibility="gone"
            layout="@layout/due_timetable_error_layout"/>
        <include
            android:id="@+id/empty_container"
            android:visibility="gone"
            layout="@layout/due_timetable_empty_layout"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/footer_shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/footer_container"/>
    <include
        android:id="@+id/footer_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_container"
        layout="@layout/due_timetable_modal_footer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
