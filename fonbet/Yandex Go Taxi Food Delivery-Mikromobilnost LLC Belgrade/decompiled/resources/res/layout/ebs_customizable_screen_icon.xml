<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/ebssdk_screen_icon_size"
    android:layout_height="@dimen/ebssdk_screen_icon_size">
    <View
        android:layout_gravity="center"
        android:id="@+id/ebs_customizable_screen_icon_bg"
        android:background="@drawable/ebssdk_bg_circle"
        android:layout_width="@dimen/ebssdk_screen_icon_bg_size"
        android:layout_height="@dimen/ebssdk_screen_icon_bg_size"/>
    <ImageView
        android:id="@+id/ebs_customizable_screen_icon"
        android:layout_width="@dimen/ebssdk_screen_icon_size"
        android:layout_height="@dimen/ebssdk_screen_icon_size"/>
</merge>
