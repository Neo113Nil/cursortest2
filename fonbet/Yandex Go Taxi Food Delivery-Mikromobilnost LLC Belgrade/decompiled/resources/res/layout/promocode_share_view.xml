<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/sharing_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ReferralScreenToolbar"/>
    <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sharing_toolbar"
        app:scroll_view_id="@+id/scroll_view"
        app:scroll_view_position="top"/>
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sharing_toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scroll_view_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.LoadingComponent
                android:id="@+id/loading_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/go_design_m_space"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:component_no_background="true"
                app:component_title_size="@dimen/component_text_size_header"
                app:component_title_typeface="medium"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:component_no_background="true"
                app:component_subtitle_gravity="center_horizontal"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/share_view_pic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <ImageView
        android:id="@+id/bottom_views_scroll_shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="0x7f081870"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/bottom_views_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/bottom_views_background"
        android:background="?attr/bgMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sharing_promocode"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/sharing_promocode"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:component_no_background="true"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_header"
        app:component_title_typeface="bold"
        app:layout_constraintBottom_toTopOf="@+id/button_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:id="@+id/button_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/promocode_sharing_first_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:component_background_color="?attr/controlMinor"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/send_promocode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/promocode_send"
            android:layout_weight="1"
            app:component_button_accent="true"/>
    </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
