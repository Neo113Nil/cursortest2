<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:foreground="@drawable/phone_permission_background">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/phone_permission_content_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/permission_phone_border_size"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/phone_permission_icons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/permission_phone_icons_border"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/phone_permission_content_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/permission_phone_border_size"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/phone_permission_content_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/permission_phone_border_size"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/phone_permission_content_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/permission_phone_bottom_offset"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:layout_width="@dimen/permission_phone_camera_size"
        android:layout_height="@dimen/permission_phone_camera_size"
        android:layout_margin="@dimen/permission_phone_camera_margin"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toTopOf="@+id/phone_permission_content_top"
        app:placeholder_color="@color/component_gray_100"
        app:placeholder_type="oval"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/phone_permission_logo"
        android:layout_width="@dimen/permission_phone_app_icon_size"
        android:layout_height="@dimen/permission_phone_app_icon_size"
        android:layout_marginTop="@dimen/permission_phone_app_icon_top"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_content_end"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toTopOf="@+id/phone_permission_content_top"
        app:srcCompat="@mipmap/icon_foreground"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/phone_permission_app_title"
        android:layout_width="@dimen/permission_phone_text_placeholder_width"
        android:layout_height="@dimen/permission_phone_text_placeholder_height"
        android:layout_marginTop="@dimen/permission_phone_app_title_top"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_content_end"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toBottomOf="@+id/phone_permission_logo"
        app:placeholder_color="@color/component_gray_100"
        app:placeholder_corner_radius="@dimen/permission_phone_placeholder_radius"
        app:placeholder_type="rectangle"/>
    <View
        android:id="@+id/phone_permission_app_title_divider"
        android:background="@color/component_black_opacity_20"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/permission_phone_divider_top_offset"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_content_end"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toBottomOf="@+id/phone_permission_app_title"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/phone_permission_first_icon"
        android:layout_width="@dimen/permission_phone_icon_size"
        android:layout_height="@dimen/permission_phone_icon_size"
        android:layout_marginTop="@dimen/permission_phone_first_icon_top"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_icons"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toBottomOf="@+id/phone_permission_app_title_divider"
        app:placeholder_color="@color/component_gray_100"
        app:placeholder_corner_radius="@dimen/permission_phone_placeholder_radius"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/phone_permission_first_title"
        android:layout_width="@dimen/permission_phone_text_placeholder_width"
        android:layout_height="@dimen/permission_phone_text_placeholder_height"
        app:layout_constraintBottom_toBottomOf="@+id/phone_permission_first_icon"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_icons"
        app:layout_constraintTop_toTopOf="@+id/phone_permission_first_icon"
        app:placeholder_color="@color/component_gray_100"
        app:placeholder_corner_radius="@dimen/permission_phone_placeholder_radius"
        app:placeholder_type="rectangle"/>
    <View
        android:id="@+id/phone_permission_main_item"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/phone_permission_second_icon"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_content_end"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toTopOf="@+id/phone_permission_second_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/phone_permission_second_icon"
        android:layout_width="@dimen/permission_phone_icon_size"
        android:layout_height="@dimen/permission_phone_icon_size"
        android:layout_marginTop="@dimen/permission_phone_second_icon_vertical_space"
        android:src="@color/component_gray_100"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_icons"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toBottomOf="@+id/phone_permission_first_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/phone_permission_second_arrow"
        android:layout_width="@dimen/permission_phone_arrow_width"
        android:layout_height="@dimen/permission_phone_arrow_height"
        android:src="@drawable/ic_permission_navigation_arrow"
        android:layout_marginEnd="@dimen/permission_phone_arrow_end"
        app:layout_constraintBottom_toBottomOf="@+id/phone_permission_second_icon"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_content_end"
        app:layout_constraintTop_toTopOf="@+id/phone_permission_second_icon"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/permission_phone_permission_name_size"
        android:textColor="@color/component_gray_450"
        android:id="@+id/phone_permission_second_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/phone_permission_second_icon"
        app:layout_constraintEnd_toStartOf="@+id/phone_permission_second_arrow"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_icons"
        app:layout_constraintTop_toTopOf="@+id/phone_permission_second_icon"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/phone_permission_third_icon"
        android:layout_width="@dimen/permission_phone_icon_size"
        android:layout_height="@dimen/permission_phone_icon_size"
        android:layout_marginTop="@dimen/permission_phone_second_icon_vertical_space"
        app:layout_constraintBottom_toBottomOf="@+id/phone_permission_content_bottom"
        app:layout_constraintEnd_toEndOf="@+id/phone_permission_icons"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_content_start"
        app:layout_constraintTop_toBottomOf="@+id/phone_permission_second_icon"
        app:placeholder_color="@color/component_gray_100"
        app:placeholder_corner_radius="@dimen/permission_phone_placeholder_radius"
        app:placeholder_type="rectangle"/>
    <ru.yandex.taxi.widget.PlaceholderView
        android:id="@+id/phone_permission_third_title"
        android:layout_width="@dimen/permission_phone_text_placeholder_width"
        android:layout_height="@dimen/permission_phone_text_placeholder_height"
        app:layout_constraintBottom_toBottomOf="@+id/phone_permission_third_icon"
        app:layout_constraintStart_toStartOf="@+id/phone_permission_icons"
        app:layout_constraintTop_toTopOf="@+id/phone_permission_third_icon"
        app:placeholder_color="@color/component_gray_100"
        app:placeholder_corner_radius="@dimen/permission_phone_placeholder_radius"
        app:placeholder_type="rectangle"/>
</merge>
