<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.design.AutoDividerComponentList xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/delivery_form"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_form_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:component_title="@string/short_text"
        app:component_title_size="20sp"
        app:component_title_typeface="medium"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/delivery_form_annotation"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
</ru.yandex.taxi.design.AutoDividerComponentList>
