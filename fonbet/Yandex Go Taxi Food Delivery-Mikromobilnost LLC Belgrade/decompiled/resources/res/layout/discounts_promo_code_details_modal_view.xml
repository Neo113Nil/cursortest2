<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/go_design_s_space">
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/title_header_component"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        app:component_no_background="false"
        app:component_title_size="@dimen/component_text_size_header"
        app:layout_constraintBottom_toTopOf="@+id/main_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_container"
        android:background="?attr/bgMain"
        android:padding="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/info_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/go_design_s_space"
            android:importantForAccessibility="no"
            android:nestedScrollingEnabled="false"
            android:layout_marginHorizontal="@dimen/go_design_s_space"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/buttons_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/go_design_s_space"
            android:importantForAccessibility="no"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
    <com.yandex.go.promocodes.base.impl.discounts.presentation.ui.dotted_line.DiscountsDottedLineView
        android:id="@+id/dotted_line"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="-2dp"
        android:layout_marginHorizontal="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_header_component"/>
</androidx.constraintlayout.widget.ConstraintLayout>
