<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/reaction_image"
        android:padding="2dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="11sp"
        android:textColor="?attr/messagingChatMyReactionCounterFgColor"
        android:layout_gravity="bottom|right"
        android:id="@+id/reaction_count"
        android:background="@drawable/msg_bg_reaction_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ya_medium"
        android:backgroundTint="?attr/messagingChatMyReactionCounterBgColor"/>
</FrameLayout>
