<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.mainscreen.superapp.popup.presentation.SuperAppMainScreenPopupShadowView
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:alpha="0"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/bg_rounded_24dp_modal_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:animateLayoutChanges="true">
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_no_background="true"
            app:component_subtitle="@string/super_app_fallback_assistant_title_without_products_cache"
            app:component_title="@string/super_app_fallback_assistant_subtitle_without_products_cache"
            app:component_title_typeface="medium"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/reload_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/super_app_fallback_assistant_reload"
            android:layout_marginHorizontal="@dimen/go_design_s_space"
            app:component_background_color="?attr/controlMinor"
            app:component_button_outline_width="0dp"
            app:component_button_size="L"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/order_taxi_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/super_app_fallback_assistant_taxi"
            android:layout_marginHorizontal="@dimen/go_design_s_space"
            app:component_button_accent="true"
            app:component_button_size="L"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/order_taxi_by_phone_call_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/go_design_s_space"
            app:component_button_accent="true"
            app:component_button_size="L"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</merge>
