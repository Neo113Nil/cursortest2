<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contact_info_window"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contact_info_menu_bar"
        android:background="?attr/messagingCommonBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="24dp"
                android:paddingRight="16dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yandex.messaging.internal.avatar.AvatarImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/contact_avatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@string/user_info_avatar_content_des__res_0x7f15197b"
                    app:onlineIndicatorSize="16dp"
                    app:placeholderBackground="@drawable/msg_bg_toolbar_logo_placeholder"
                    style="@style/Messaging.UsersAvatarView"/>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/contact_badge"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"/>
                    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/contact_badge_2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <com.yandex.messaging.views.AppCompatEmojiTextView
                    android:gravity="center_horizontal"
                    android:layout_gravity="center"
                    android:id="@+id/contact_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Messaging.Title"/>
                <TextView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/contact_passport_name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    style="@style/Messaging.ContactPassportName"/>
                <TextView
                    android:textSize="12sp"
                    android:gravity="center_horizontal"
                    android:id="@+id/contact_online_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Messaging.SubtitleNonLimited"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/contact_user_interactions"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/write_message"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/messenger_contact_info_write_message"
                    android:layout_weight="1"
                    app:drawableTopCompat="@drawable/msg_ic_create_chat"
                    style="@style/Messaging.Settings.Action.Button"/>
                <TextView
                    android:id="@+id/audio_call"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/messenger_contact_info_audio_call"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    app:drawableTint="?attr/messagingCommonIconsPrimaryColor"
                    app:drawableTopCompat="@drawable/msg_ic_audio_call"
                    style="@style/Messaging.Settings.Action.Button"/>
                <TextView
                    android:id="@+id/video_call"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/messaging_contact_info_video_call"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    app:drawableTint="?attr/messagingCommonIconsPrimaryColor"
                    app:drawableTopCompat="@drawable/msg_ic_video_call"
                    style="@style/Messaging.Settings.Action.Button"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/user_gaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/actions_with_user"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/msg_divider_settings_items"
                android:showDividers="middle">
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/show_notifications"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_show_notifications"
                    style="@style/Messaging.Settings.Switch"/>
                <TextView
                    android:id="@+id/find_in_history"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/messaging_chat_search_menu_item"
                    app:drawableStartCompat="@drawable/msg_ic_search"
                    app:drawableTint="?attr/messagingCommonIconsPrimaryColor"
                    style="@style/Messaging.Settings.Item.Text"/>
                <TextView
                    android:id="@+id/common_files"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_common_files"
                    style="@style/Messaging.Settings.Item.Text"/>
                <TextView
                    android:id="@+id/edit_contact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_edit"
                    style="@style/Messaging.Settings.Item.Text"/>
                <TextView
                    android:id="@+id/share_contact"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_share_contact"
                    style="@style/Messaging.Settings.Item.Text"/>
                <TextView
                    android:id="@+id/media_browser"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/messenger_user_info_media_browser_title_new"
                    style="@style/Messaging.Settings.Item.Text"/>
                <TextView
                    android:id="@+id/stars_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/messaging_starred_messages"
                    style="@style/Messaging.Settings.Item.Text"/>
                <TextView
                    android:textColor="?attr/messagingCommonDestructiveTextColor"
                    android:id="@+id/report"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_report"
                    android:drawableTint="?attr/messagingCommonDestructiveIconsColor"
                    style="@style/Messaging.Settings.Item.Text"/>
                <TextView
                    android:textColor="?attr/messagingCommonDestructiveTextColor"
                    android:id="@+id/block_contact"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_block_and_hide"
                    android:drawableTint="?attr/messagingCommonDestructiveIconsColor"
                    style="@style/Messaging.Settings.Item.Text"/>
            </LinearLayout>
            <com.yandex.bricks.BrickSlotView
                android:id="@+id/employee_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
