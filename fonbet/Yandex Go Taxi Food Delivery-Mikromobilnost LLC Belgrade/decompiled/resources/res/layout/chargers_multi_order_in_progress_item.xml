<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/MultiOrderItemStyle">
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/MultiOrderItemLayoutStyle">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="20sp"
            android:textColor="?attr/textMain"
            android:ellipsize="end"
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textFontWeight="700"/>
        <ru.yandex.taxi.widget.progress.SpinnerProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            app:spinnerColor="@color/component_amber_toxic"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <View
        android:id="@+id/separator"
        android:background="?attr/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"/>
</com.yandex.go.design.view.GoFrameLayout>
