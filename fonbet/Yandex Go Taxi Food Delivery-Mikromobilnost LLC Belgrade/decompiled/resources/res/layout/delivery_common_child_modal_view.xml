<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/delivery_common_child_header"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/component_float_button_icon_shadow_compensation"
        android:layout_marginEnd="@dimen/component_float_button_icon_shadow_compensation"/>
    <FrameLayout
        android:id="@+id/delivery_common_child_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
