<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.core.transfer.utils.TransferToolbarView
        android:id="@+id/transferMainToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tooltipAnchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/transferMainAmountInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/transferMainAmountInput"/>
    <com.ybsdk.widgets.common.MoneyInputEditView
        android:theme="@style/YbSdk.Widget.WidgetsCommon.NumbersInput"
        android:id="@+id/transferMainAmountInput"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_transfer_amount_hint"
        android:singleLine="true"
        android:digits="0123456789.,"
        android:inputType="numberDecimal"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toTopOf="@+id/transferMainCashback"
        app:layout_constraintEnd_toStartOf="@+id/transferMainAmountCurrency"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainToolbar"
        app:layout_constraintVertical_chainStyle="packed"
        app:ybsdk_hide_soft_keyboard_on_focus="true"
        style="@style/Widget.YB.Text.Numbers2"/>
    <TextView
        android:id="@+id/transferMainAmountCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:contentDescription="@string/ybsdk_common_accessibility_amount_description"
        android:labelFor="@+id/transferMainAmountInput"
        app:layout_constraintBaseline_toBaselineOf="@+id/transferMainAmountInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/transferMainAmountInput"
        style="@style/Widget.YB.Text.Numbers2"/>
    <TextView
        android:gravity="center"
        android:id="@+id/transferDepositCurrencyRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainAmountInput"
        style="@style/Widget.YB.Text.Body3"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:id="@+id/transferCurrencyRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferDepositCurrencyRate"
        style="@style/Widget.YB.Text.Body3"/>
    <com.ybsdk.core.transfer.utils.CashbackView
        android:gravity="center_horizontal"
        android:id="@+id/transferMainCashback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/transferMainSuggests"
        app:layout_constraintTop_toBottomOf="@+id/transferMainAmountInput"/>
    <com.ybsdk.widgets.common.SuggestsGroupView
        android:id="@+id/transferMainSuggests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/transferMainFee"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainCashback"/>
    <TextView
        android:gravity="center"
        android:id="@+id/transferMainFee"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toTopOf="@+id/transferMainComment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainSuggests"
        style="@style/Widget.YB.Text.Body3"/>
    <TextView
        android:gravity="center"
        android:id="@+id/transferMainInfo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:autoSizeMaxTextSize="@dimen/ybsdk_transfer_main_info_autosize_max_text_size"
        app:autoSizeMinTextSize="@dimen/ybsdk_transfer_main_info_autosize_min_text_size"
        app:autoSizeTextType="uniform"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/transferMainPager"
        app:layout_constraintTop_toBottomOf="@+id/transferMainSuggests"
        app:layout_constraintVertical_bias="0"
        style="@style/Widget.YB.Text.Body3"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColorHint="@color/ybsdk_transfer_comment_hint_color"
        android:gravity="center_horizontal"
        android:id="@+id/transferMainComment"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/ybsdk_transfer_add_comment"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionNone"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@+id/transferMainPager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainFee"
        style="@style/Widget.YB.Text.Body3"/>
    <include
        android:id="@+id/transferMainScenarioSkeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/ybsdk_transfer_main_scenario_loading"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/transferMainPager"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/transferMainPagerIndicators"/>
    <com.ybsdk.widgets.common.PageIndicatorView
        android:id="@+id/transferMainPagerIndicators"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        app:layout_constraintBottom_toTopOf="@+id/transferMainKeyboard"/>
    <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
        android:id="@+id/transferMainKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/transferMainConfirmButton"
        app:ybsdk_additionalButtonType="comma"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/transferMainErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.feature.transfer.version2.internal.screens.main.presentation.view.TransferMainSkeletonView
        android:id="@+id/transferMainSkeletonDesignV2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupToHideOnScenarioLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="transferMainAmountInput, transferMainAmountCurrency, transferMainKeyboard"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/transferMainConfirmButton"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/infoSubtitleTextView"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_secondary"
        android:textColorLink="?attr/ybColor_textIcon_linkNormal"
        android:gravity="center"
        android:id="@+id/infoSubtitleTextView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Widget.YB.Text.Caption3.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
