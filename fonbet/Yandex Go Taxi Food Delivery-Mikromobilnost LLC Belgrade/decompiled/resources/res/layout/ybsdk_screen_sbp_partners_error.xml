<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/errorNotFoundText"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/errorRetryButtonCentral"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Title2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/errorRetryButtonCentral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorText"
        app:ybsdk_buttonTitle="@string/ybsdk_common_error_retry"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
</merge>
