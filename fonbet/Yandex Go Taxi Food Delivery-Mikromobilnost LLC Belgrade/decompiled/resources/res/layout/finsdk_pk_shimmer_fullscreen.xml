<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/finsdkShimmerFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_base_alpha="1"
            app:shimmer_base_color="@color/finsdk_default_0"
            app:shimmer_colored="true"
            app:shimmer_dropoff="0.9"
            app:shimmer_highlight_alpha="0.25"
            app:shimmer_highlight_color="@color/finsdk_fullscreen_shimmer_color"
            app:shimmer_intensity="0.2"
            app:shimmer_shape="linear"
            app:shimmer_tilt="0">
            <View
                android:id="@+id/finsdkShimmerCards"
                android:background="@drawable/finsdk_bg_radius_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <com.yandex.fintechsdk.core.ui.impl.api.view.button.back.BackButtonView
            android:id="@+id/finsdkPKBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="13dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
