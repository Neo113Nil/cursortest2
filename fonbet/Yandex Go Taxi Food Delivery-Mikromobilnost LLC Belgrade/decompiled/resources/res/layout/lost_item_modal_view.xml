<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:scaleType="centerCrop"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"/>
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_titles_gravity="top"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/loading_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        android:layout_marginVertical="@dimen/go_design_s_space">
        <ru.yandex.taxi.widget.ShimmeringBar
            android:id="@+id/header_shimmering_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            app:barCornerRadius="@dimen/go_design_m_space"/>
        <ru.yandex.taxi.widget.ShimmeringBar
            android:id="@+id/description_shimmering_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="@dimen/go_design_m_space"
            app:barCornerRadius="@dimen/go_design_m_space"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.widget.ShimmeringBar
                android:layout_gravity="center_vertical"
                android:id="@+id/icon_shimmering_bar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:barCornerRadius="100dp"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:layout_gravity="center_vertical"
                android:id="@+id/text_shimmering_bar"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/go_design_s_space"
                android:layout_marginEnd="@dimen/go_design_l_space"
                app:barCornerRadius="@dimen/go_design_m_space"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:id="@+id/bullets"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/action_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/common_loading"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        android:layout_marginVertical="@dimen/go_design_s_space"
        app:component_button_icon_position="start"
        app:component_button_icon_tint="?attr/textMain"
        app:component_button_size="L"/>
</com.yandex.go.design.view.GoLinearLayout>
