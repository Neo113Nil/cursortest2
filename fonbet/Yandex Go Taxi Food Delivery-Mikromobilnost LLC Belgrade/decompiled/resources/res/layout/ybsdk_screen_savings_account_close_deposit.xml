<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        android:paddingTop="@dimen/ybsdk_toolbar_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Headline1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Widget.YB.Text.Body2"/>
    <View
        android:id="@+id/profitPossibleChart"
        android:background="@drawable/ybsdk_savings_account_close_deposit_background_profit"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="37.5dp"
        app:layout_constraintBottom_toTopOf="@+id/separator"
        app:layout_constraintEnd_toStartOf="@+id/profitScaryChart"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/profitPossibleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/ybsdk_savings_savings_closing_deposit_label_profit"
        app:layout_constraintBottom_toTopOf="@+id/profitPossibleAmount"
        app:layout_constraintEnd_toEndOf="@+id/profitPossibleChart"
        app:layout_constraintStart_toStartOf="@+id/profitPossibleChart"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/profitPossibleAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="37dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonsGroup"
        app:layout_constraintEnd_toEndOf="@+id/profitPossibleChart"
        app:layout_constraintStart_toStartOf="@+id/profitPossibleChart"
        style="@style/Widget.YB.Text.Numbers6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/profitPossibleDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/profitPossibleAmount"
        app:layout_constraintStart_toStartOf="@+id/profitPossibleAmount"
        app:layout_constraintTop_toBottomOf="@+id/profitPossibleAmount"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
    <View
        android:id="@+id/profitScaryChart"
        android:background="@drawable/ybsdk_savings_account_close_deposit_background_scary"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginStart="37.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/profitPossibleChart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/profitPossibleChart"
        app:layout_constraintTop_toTopOf="@+id/profitPossibleChart"
        app:layout_constraintVertical_bias="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/profitScaryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_savings_savings_closing_deposit_label_penalty"
        app:layout_constraintBaseline_toBaselineOf="@+id/profitPossibleLabel"
        app:layout_constraintEnd_toEndOf="@+id/profitScaryChart"
        app:layout_constraintStart_toStartOf="@+id/profitScaryChart"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/profitScaryAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/profitPossibleAmount"
        app:layout_constraintEnd_toEndOf="@+id/profitScaryChart"
        app:layout_constraintStart_toStartOf="@+id/profitScaryChart"
        style="@style/Widget.YB.Text.Numbers6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/profitScaryDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/profitScaryAmount"
        app:layout_constraintStart_toStartOf="@+id/profitScaryAmount"
        app:layout_constraintTop_toBottomOf="@+id/profitScaryAmount"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/ybColor_other_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="44dp"
        app:layout_constraintBottom_toTopOf="@+id/profitPossibleLabel"/>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/buttonsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
