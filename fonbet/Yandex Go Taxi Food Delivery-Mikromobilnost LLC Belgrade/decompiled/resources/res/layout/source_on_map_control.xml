<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ru.yandex.taxi.widget.map.PinSlot
        android:id="@+id/pin_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"/>
    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
        android:textSize="11dp"
        android:textColor="?attr/textOnPin"
        android:ellipsize="middle"
        android:id="@+id/source_on_map_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-2dp"
        android:maxLines="1"
        android:layout_marginStart="2dp"
        android:letterSpacing="0.01"
        android:fontFeatureSettings="@string/go_default_font_settings"
        app:robotoFontStyle="regular"
        app:useMinimumWidth="true"/>
    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
        android:textSize="13dp"
        android:textColor="?attr/textOnPin"
        android:id="@+id/source_on_map_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="2dp"
        android:fontFeatureSettings="@string/go_default_font_settings"
        app:robotoFontStyle="medium"
        app:useMinimumWidth="true"/>
</merge>
