<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.widget.ToolbarModalView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
            android:id="@+id/shared_payment_settings_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ru.yandex.taxi.design.ListItemInputComponent
                    android:id="@+id/shared_payment_settings_account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_input_type="textCapSentences"
                    app:component_max_lines="1"
                    app:imeOptions="actionUnspecified"/>
                <ru.yandex.taxi.design.ListGroupHeaderComponent
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ru.yandex.taxi.design.AutoDividerComponentList
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_middle_divider_type="margin">
                    <ru.yandex.taxi.design.ListItemComponent
                        android:id="@+id/shared_payment_settings_reports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:component_trail_mode="navigation"/>
                    <ru.yandex.taxi.design.ListItemComponent
                        android:id="@+id/shared_payment_settings_limits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:component_trail_mode="navigation"/>
                </ru.yandex.taxi.design.AutoDividerComponentList>
            </LinearLayout>
        </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
        <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
            android:layout_gravity="bottom"
            android:id="@+id/shared_payment_settings_scroll_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:scroll_view_id="@+id/shared_payment_settings_scroll_view"/>
        <ru.yandex.taxi.widget.BottomEdgeButtonLayout
            android:layout_gravity="bottom"
            android:id="@+id/shared_payment_settings_save_container"
            android:background="?attr/bgMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/shared_payment_settings_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
        <FrameLayout
            android:id="@+id/shared_payment_settings_controls_blocker"
            android:background="@color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</ru.yandex.taxi.widget.ToolbarModalView>
