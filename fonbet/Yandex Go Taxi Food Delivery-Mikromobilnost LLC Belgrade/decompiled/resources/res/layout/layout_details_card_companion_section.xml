<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:id="@+id/companion_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:fontFeatureSettings="@string/go_default_font_settings"
        app:layout_constraintBottom_toTopOf="@+id/companion_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/trail_container_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:ellipsize="end"
        android:id="@+id/companion_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFeatureSettings="@string/go_default_font_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/companion_title"
        app:layout_constraintStart_toStartOf="@+id/companion_title"
        app:layout_constraintTop_toBottomOf="@+id/companion_title"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/trail_container_layout"
        android:layout_width="@dimen/companion_trail_item_size"
        android:layout_height="@dimen/companion_trail_item_size"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/companion_title"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
