<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passesWidgetContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.feature.divkit.api.ui.YbDivView
        android:id="@+id/divView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.ybsdk.feature.divkit.api.ui.skeletons.DivSkeletonsView
        android:id="@+id/skeletonView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="94dp"/>
    <com.ybsdk.feature.passes.widget.api.presentation.PassesWidgetErrorView
        android:id="@+id/passesWidgetErrorView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="40dp"/>
</FrameLayout>
