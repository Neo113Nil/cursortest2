<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="-1dp">
    <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
        android:id="@+id/scroll_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/route_line">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="vertical"
            android:id="@+id/scroll_child"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/route_line_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:divider_type="both"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_subtitle"
                android:textColor="?attr/textMain"
                android:gravity="center"
                android:id="@+id/destination_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="@dimen/component_done_button_bottom_margin"
                android:layout_marginHorizontal="@dimen/component_done_button_bottom_margin"
                app:robotoFontStyle="bold"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:orientation="horizontal"
                android:id="@+id/horizontal_buttons_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/component_done_button_base_margin"
                android:layout_marginHorizontal="@dimen/component_done_button_bottom_margin"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:orientation="vertical"
                android:id="@+id/vertical_buttons_container"
                android:background="@drawable/driving_button_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/component_done_button_bottom_margin"
                app:component_middle_divider_type="icon_margin"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/top_shadow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.design.view.GoImageButton
        android:id="@+id/alt_route_button"
        android:background="@drawable/bg_close_button_round"
        android:padding="15dp"
        android:layout_width="@dimen/navigator_float_button_size"
        android:layout_height="@dimen/navigator_float_button_size"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_search_24dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/time_barrier"
        app:layout_constraintEnd_toEndOf="@+id/route_barrier_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/route_barrier_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="alt_route_button"/>
    <com.yandex.go.navigator.driving.DrivingTimeTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:gravity="center_horizontal"
        android:id="@+id/remaining_distance_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/alt_route_button"
        app:layout_constraintEnd_toStartOf="@+id/route_barrier_end"
        app:layout_constraintStart_toStartOf="@+id/route_barrier_start"
        app:layout_constraintTop_toBottomOf="@+id/arrival_time"
        app:robotoFontStyle="medium"/>
    <com.yandex.go.navigator.driving.DrivingTimeTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:gravity="center_horizontal"
        android:id="@+id/arrival_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/remaining_distance_time"
        app:layout_constraintEnd_toStartOf="@+id/route_barrier_end"
        app:layout_constraintStart_toStartOf="@+id/route_barrier_start"
        app:layout_constraintTop_toTopOf="@+id/alt_route_button"
        app:robotoFontStyle="medium"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/time_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="alt_route_button, expand_button"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/route_barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="expand_button"/>
    <com.yandex.go.design.view.GoImageButton
        android:id="@+id/expand_button"
        android:background="@drawable/bg_close_button_round"
        android:padding="15dp"
        android:layout_width="@dimen/navigator_float_button_size"
        android:layout_height="@dimen/navigator_float_button_size"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_chevron_down_l"
        android:rotation="180"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/time_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/route_barrier_end"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yandex.go.navigator.driving.ProgressView
        android:id="@+id/route_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_barrier"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/buttons_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="scroll_view, bottom_container"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll_view">
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/shadow_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-24dp"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:textSize="@dimen/component_text_size_subtitle"
            android:id="@+id/finish_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_component_size_XL"
            android:layout_marginTop="@dimen/component_done_button_base_margin"
            android:layout_marginBottom="@dimen/component_done_button_bottom_margin"
            android:text="@string/navigator_driving_screen_finish_button"
            android:layout_marginHorizontal="@dimen/component_done_button_bottom_margin"
            app:component_background_color="?attr/error"
            app:component_button_accent="true"
            app:component_button_rounded_corners_radius="20dp"
            app:component_disabled_background_color="?attr/controlMinor"
            app:component_title_color="@color/white"
            app:robotoFontStyle="bold"/>
    </com.yandex.go.design.view.GoFrameLayout>
</com.yandex.go.design.view.GoConstraintLayout>
