<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/overlay"
        android:background="?attr/ybColor_other_overlayStatic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.feature.kyc.internal.screens.photo.views.RotateLayout
        android:id="@+id/rotationableContainer"
        android:background="?attr/ybColor_internal_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/content"
            layout="@layout/ybsdk_screen_kyc_photo_portrait"/>
    </com.ybsdk.feature.kyc.internal.screens.photo.views.RotateLayout>
    <com.ybsdk.widgets.common.FullscreenStatusView
        android:id="@+id/statusView"
        android:background="?attr/ybColor_background_primary"
        android:paddingTop="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:paddingTop="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/frontLight"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
</FrameLayout>
