<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/source_fragment_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/main_screen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/summary_parent_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/top_end_corner_with_cashback"/>
    <ru.yandex.taxi.widget.PriorityFrame
        android:layout_gravity="end"
        android:id="@+id/top_end_corner"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
