<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:component_background_color="?attr/controlMain"
        app:component_button_disabled_alpha="0.5"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControl"
        app:robotoFontStyle="medium"/>
</com.yandex.go.design.view.GoFrameLayout>
