<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/top_component"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_no_background="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/payment_method_container"
        android:visibility="gone"
        layout="@layout/chargers_payment_icon_layout"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/discounts_button"
        app:layout_constraintStart_toEndOf="@+id/payment_method_container"
        app:layout_constraintTop_toBottomOf="@+id/top_component"
        app:layout_goneMarginEnd="8dp"
        app:layout_goneMarginStart="8dp"/>
    <ru.yandex.taxi.widget.ShimmeringRobotoTextView
        android:textSize="11sp"
        android:textColor="?attr/textMinor"
        android:textColorLink="?attr/textMinor"
        android:id="@+id/legal_terms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/discounts_button"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_coupon_24"
        app:layout_constraintBottom_toBottomOf="@+id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button"
        app:layout_constraintTop_toTopOf="@+id/button"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:id="@+id/discounts_button_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1.5dp"
        app:layout_constraintEnd_toEndOf="@+id/discounts_button"
        app:layout_constraintTop_toTopOf="@+id/discounts_button"
        app:robotoFontStyle="thin"/>
</merge>
