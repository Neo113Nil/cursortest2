<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/ybsdk_card_promo_point_padding_vertical"
    android:paddingBottom="@dimen/ybsdk_card_promo_point_padding_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/image"
        android:layout_width="@dimen/ybsdk_number_option_icon_view_width"
        android:layout_height="@dimen/ybsdk_number_option_icon_view_width"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/imageShimmer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image">
        <com.ybsdk.widgets.common.SkeletonView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:shape="oval"/>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Body2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
