<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/bgMain"
    android:clickable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/gas_stations_overview_content_height">
    <com.yandex.go.design.view.GoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="30sp"
            android:textColor="?attr/textMain"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/go_design_m_space"
            app:robotoFontStyle="bold"/>
        <ru.yandex.taxi.widget.ShimmeringBar
            android:layout_gravity="start|center_vertical"
            android:id="@+id/title_shimmer"
            android:visibility="gone"
            android:layout_width="126dp"
            android:layout_height="30dp"
            android:layout_marginStart="@dimen/go_design_m_space"
            app:barCornerRadius="16dp"/>
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/filters_button"
            android:background="@drawable/bg_round_16dp_minor"
            android:padding="14dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:src="@drawable/ic_settings_fill_20dp"
            android:layout_marginEnd="@dimen/go_design_m_space"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/no_results_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="@dimen/component_text_size_body"
            android:textColor="?attr/textMinor"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/no_results_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/go_design_m_space"
            app:robotoFontStyle="medium"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/buttons_container"
            android:padding="@dimen/go_design_s_space"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ButtonComponent
                android:textSize="@dimen/component_text_size_body"
                android:id="@+id/minor_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:component_background_color="?attr/controlMinor"
                app:component_button_accent="true"
                app:component_button_size="L"
                app:component_title_color="?attr/textOnControlMinor"/>
            <Space
                android:layout_width="4dp"
                android:layout_height="0dp"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:textSize="@dimen/component_text_size_body"
                android:layout_gravity="bottom"
                android:id="@+id/main_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:component_background_color="?attr/controlMain"
                app:component_button_accent="true"
                app:component_button_size="L"
                app:component_title_color="?attr/textOnControl"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gas_station_cards_rv"
        android:layout_width="match_parent"
        android:layout_height="139dp"
        android:layout_marginVertical="4dp"/>
    <ru.yandex.taxi.widget.DotsIndicatorView
        android:layout_gravity="center"
        android:id="@+id/dots_indicator"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:dotIconColor="?attr/textMinor"
        app:dotsCount="3"
        app:selectedDotIconColor="?attr/textMain"/>
</com.yandex.go.design.view.GoLinearLayout>
