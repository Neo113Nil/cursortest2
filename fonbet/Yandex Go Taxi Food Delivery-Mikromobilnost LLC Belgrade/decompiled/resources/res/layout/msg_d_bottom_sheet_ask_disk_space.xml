<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/ask_disk_space_title"
        android:background="#00000000"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ask_disk_space_title"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.Title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:id="@+id/ask_disk_space_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ask_disk_space_text"
        android:lineSpacingExtra="6sp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ask_disk_space_title"/>
    <ImageView
        android:id="@+id/ask_disk_space_file_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@+id/ask_disk_space_text"
        app:layout_constraintTop_toBottomOf="@+id/ask_disk_space_text"
        app:srcCompat="@drawable/msg_ic_file"
        app:tint="?attr/messagingCommonAccentColor"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:ellipsize="middle"
        android:id="@+id/ask_disk_space_file_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ask_disk_space_file_icon"
        app:layout_constraintEnd_toEndOf="@+id/ask_disk_space_file_size"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ask_disk_space_file_icon"
        app:layout_constraintTop_toTopOf="@+id/ask_disk_space_file_icon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/ask_disk_space_file_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/ask_disk_space_file_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ask_disk_space_file_name"
        app:layout_constraintTop_toTopOf="@+id/ask_disk_space_file_name"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/ask_disk_space_delete_btn"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:text="@string/ask_disk_space_delete_btn"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ask_disk_space_file_icon"
        style="@style/Messaging.Button2"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/ask_disk_space_repeat_btn"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:text="@string/ask_disk_space_repeat_btn"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ask_disk_space_delete_btn"
        style="@style/Messaging.Button2.Secondary"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/ask_disk_space_cancel_btn"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:text="@string/ask_disk_space_cancel_btn"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ask_disk_space_repeat_btn"
        app:layout_constraintVertical_bias="0"
        style="@style/Messaging.Button2.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
