<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.widget.ShimmeringFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/go_design_m_space">
    <View
        android:id="@+id/condition_title_placeholder"
        android:background="@drawable/bg_placeholder_large"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"/>
    <View
        android:id="@+id/condition_subtitle_placeholder"
        android:background="@drawable/bg_placeholder_med"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/go_design_m_space"/>
    <View
        android:id="@+id/condition_block_placeholder"
        android:background="@drawable/bg_placeholder_min"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/condition_placeholders_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="11dp">
        <View
            android:id="@+id/condition_name_placeholder"
            android:background="@drawable/bg_placeholder_large"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:layout_marginEnd="32dp"/>
        <View
            android:id="@+id/condition_value_placeholder"
            android:background="@drawable/bg_placeholder_large"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_weight="6"/>
    </LinearLayout>
</ru.yandex.taxi.widget.ShimmeringFrameLayout>
