<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/listEmptyImage"
        android:layout_width="62dp"
        android:layout_height="100dp"
        android:layout_marginTop="100dp"
        android:src="0x7f081c72"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_primary"
        android:gravity="center"
        android:id="@+id/listEmptyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ybsdk_transactions_emptyFeedListTitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listEmptyImage"
        style="@style/Widget.YB.Text.Headline3"/>
    <TextView
        android:textColor="?attr/ybColor_textIcon_primary"
        android:gravity="center"
        android:id="@+id/listEmptyDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="100dp"
        android:text="@string/ybsdk_transactions_emptyFeedListSubtitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listEmptyTitle"
        style="@style/Widget.YB.Text.Body2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
