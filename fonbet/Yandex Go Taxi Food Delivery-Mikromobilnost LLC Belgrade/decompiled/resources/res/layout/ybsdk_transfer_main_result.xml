<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/transferMainResultIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_bias="0.23"
        app:srcCompat="@drawable/ybsdk_ic_yb_placeholder"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/transferMainResultProgressBar"
        android:background="@drawable/ybsdk_circle_button_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginStart="52dp"
        app:layout_constraintStart_toStartOf="@+id/transferMainResultIcon"
        app:layout_constraintTop_toTopOf="@+id/transferMainResultIcon"
        app:ybsdk_indicatorColor="?attr/ybColor_button_primaryNormal"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressViewStyleSmall"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/transferMainResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/transferMainResultIcon"
        style="@style/Widget.YB.Text.Headline2"/>
    <com.ybsdk.core.transfer.utils.CashbackView
        android:gravity="center_horizontal"
        android:id="@+id/transferMainResultCashback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainResultTitle"/>
    <com.ybsdk.feature.divkit.api.ui.YbDivView
        android:id="@+id/transferMainResultDivkitUnderAmount"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainResultCashback"
        app:layout_goneMarginTop="0dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/transferMainResultAboveCommentBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="transferMainResultCashback,transferMainResultDivkitUnderAmount"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/transferMainResultComment"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainResultAboveCommentBarrier"
        style="@style/Widget.YB.Text.Body3.Secondary"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/transferMainResultDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/transferMainResultComment"
        style="@style/Widget.YB.Text.Body2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/transferMainResultQuickActions"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transferMainResultDescription"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/buttonGroup"
        app:layout_constraintTop_toBottomOf="@+id/transferMainResultQuickActions"
        app:reverseLayout="true"/>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/buttonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/web3dsViewContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
