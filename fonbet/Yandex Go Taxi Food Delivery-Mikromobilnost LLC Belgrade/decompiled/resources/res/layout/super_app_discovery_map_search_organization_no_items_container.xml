<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/go_design_m_space"
    android:layout_marginVertical="60dp">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/search_organization_no_items_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMain"
        android:gravity="center_horizontal"
        android:id="@+id/search_organization_no_items_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMinor"
        android:gravity="center_horizontal"
        android:id="@+id/search_organization_no_items_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:gravity="center_horizontal"
        android:id="@+id/search_organization_no_items_button"
        android:visibility="gone"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
</com.yandex.go.design.view.GoLinearLayout>
