<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/scooter_item_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="72dp"
    android:foreground="@drawable/scooter_item_fg"
    android:minWidth="80dp">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/vehicle_number_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:lines="1"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="medium"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_caption"
        android:textColor="?attr/textMinor"
        android:gravity="center"
        android:id="@+id/remaining_charge"
        android:background="@drawable/scooter_charge_badge_bg"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:minWidth="44dp"
        android:lines="1"
        android:importantForAccessibility="yes"
        android:layout_marginStart="-12dp"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/scooter_charged_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/scooter_charged_icon"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/scooter_charged_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="0x7f080d78"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vehicle_number_text_view"
        app:layout_constraintVertical_bias="1"/>
</com.yandex.go.design.view.GoConstraintLayout>
