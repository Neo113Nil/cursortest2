<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.order.view.walking_info.WalkingInfoView
        android:id="@+id/walking_info_block"
        android:background="@drawable/bg_walking_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/details_card_layout"
        android:background="@drawable/transparent_rounded_corners"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="true">
        <FrameLayout
            android:id="@+id/order_state_view_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/order_name"
            android:paddingTop="@dimen/arrows_margin_top"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_divider_position="bottom"
            app:component_subtitle_gravity="center_horizontal"
            app:component_title_gravity="center_horizontal"
            app:component_title_max_lines="2"
            app:component_title_typeface="medium"/>
        <ru.yandex.taxi.widget.ArrowsView
            android:layout_gravity="center_horizontal"
            android:id="@+id/arrows_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/arrows_margin_top"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/navigation_bar"
            android:background="?attr/bgMain"
            android:layout_width="wrap_content"
            android:layout_height="0dp"/>
    </FrameLayout>
</merge>
