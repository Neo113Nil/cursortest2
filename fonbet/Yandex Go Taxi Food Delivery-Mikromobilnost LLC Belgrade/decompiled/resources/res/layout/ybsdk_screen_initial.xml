<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/initialProgress"
            android:visibility="gone"
            android:layout_width="@dimen/ybsdk_size_progress_indicator"
            android:layout_height="@dimen/ybsdk_size_progress_indicator"
            app:layout_constraintBottom_toTopOf="@+id/progressTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/YbSdk.Widget.WidgetsCommon.CircularProgressIndicatorLoader"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/progressTitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/progressSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/initialProgress"
            style="@style/Widget.YB.Text.Headline2"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/progressSubtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressTitle"
            app:layout_goneMarginTop="0dp"
            style="@style/Widget.YB.Text.Body2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
