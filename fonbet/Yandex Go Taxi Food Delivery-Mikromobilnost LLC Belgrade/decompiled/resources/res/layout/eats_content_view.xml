<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/service_placeholder"
        android:background="?attr/bgMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/service_logo_container"
            layout="@layout/eats_part_logo"/>
    </FrameLayout>
    <include
        android:id="@+id/error_layout"
        layout="@layout/eats_content_error"/>
    <include
        android:id="@+id/no_auth_layout"
        layout="@layout/eats_content_no_auth"/>
</merge>
