<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.widgets.common.ToolbarView
            android:id="@+id/cardToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_screen_card_toolbar_height"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/ybsdk_screen_card_toolbar_height"
            android:fillViewport="true"
            android:overScrollMode="never">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/cardImageView"
                    android:layout_width="@dimen/ybsdk_screen_card_image_width"
                    android:layout_height="@dimen/ybsdk_screen_card_image_height"
                    android:importantForAccessibility="no"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/cardBadgeImageView"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:contentDescription="@null"
                    app:layout_constraintEnd_toEndOf="@+id/cardImageView"
                    app:layout_constraintTop_toTopOf="@+id/cardImageView"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/cardTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:maxLines="2"
                    android:layout_marginHorizontal="56dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardImageView"
                    app:layout_constraintWidth_default="wrap"
                    style="@style/Widget.YB.Text.Headline3"/>
                <ImageView
                    android:id="@+id/titleActionButton"
                    android:padding="4dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/ybsdk_card_accessibility_rename_card"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/cardTitleTextView"
                    app:layout_constraintStart_toEndOf="@+id/cardTitleTextView"
                    app:layout_constraintTop_toTopOf="@+id/cardTitleTextView"/>
                <TextView
                    android:id="@+id/cardSubtitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardTitleTextView"
                    style="@style/Widget.YB.Text.Body3"/>
                <com.ybsdk.feature.divkit.api.ui.YbDivView
                    android:id="@+id/divView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardSubtitleTextView"/>
                <TextView
                    android:textColor="?attr/ybColor_textIcon_primary"
                    android:id="@+id/textCardRequisites"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ybsdk_card_card_payment_details"
                    android:paddingEnd="52dp"
                    android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
                    android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divView"
                    style="@style/Widget.YB.Text.Headline4"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/buttonShowHideRequisites"
                    android:padding="@dimen/ybsdk_clickable_icon_padding"
                    android:layout_width="@dimen/ybsdk_clickable_icon_size"
                    android:layout_height="@dimen/ybsdk_clickable_icon_size"
                    app:layout_constraintBottom_toBottomOf="@+id/textCardRequisites"
                    app:layout_constraintEnd_toEndOf="@+id/textCardRequisites"
                    app:layout_constraintTop_toTopOf="@+id/textCardRequisites"
                    app:srcCompat="@drawable/ybsdk_ic_eye_outline"/>
                <com.ybsdk.feature.card.internal.presentation.carddetails.CardRequisiteFieldView
                    android:id="@+id/requisiteCardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ybsdk_card_card_pan_title"
                    android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
                    android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
                    app:layout_constraintTop_toBottomOf="@+id/textCardRequisites"/>
                <com.ybsdk.feature.card.internal.presentation.carddetails.CardRequisiteFieldView
                    android:id="@+id/requisiteCardExpire"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/ybsdk_card_card_expiratio_date_title"
                    android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/requisiteCardCvv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/requisiteCardNumber"/>
                <com.ybsdk.feature.card.internal.presentation.carddetails.CardRequisiteFieldView
                    android:id="@+id/requisiteCardCvv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/ybsdk_card_card_cvv_title"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/requisiteCardExpire"
                    app:layout_constraintTop_toBottomOf="@+id/requisiteCardNumber"/>
                <TextView
                    android:textColor="?attr/ybColor_textIcon_primary"
                    android:id="@+id/managementTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/requisiteCardExpire"
                    style="@style/Widget.YB.Text.Headline4"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/managementRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:overScrollMode="never"
                    android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/managementTitle"/>
                <TextView
                    android:textColor="?attr/ybColor_textIcon_primary"
                    android:id="@+id/settingsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/managementRecycler"
                    style="@style/Widget.YB.Text.Headline4"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/settingsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/settingsTitle"/>
                <TextView
                    android:textColor="?attr/ybColor_textIcon_primary"
                    android:id="@+id/cardAdditionalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/settingsView"
                    style="@style/Widget.YB.Text.Headline4"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/cardAdditionalSettingRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/cardAdditionalTitle"/>
                <com.ybsdk.feature.divkit.api.ui.YbDivView
                    android:id="@+id/divViewBottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardAdditionalSettingRecycler"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <include
        android:id="@+id/shimmerLayout"
        android:visibility="gone"
        layout="@layout/ybsdk_skeleton_single_card_details"/>
    <include
        android:id="@+id/shimmerLayoutForSplitTranasctional"
        android:visibility="gone"
        layout="@layout/ybsdk_skeleton_single_card_details_for_split_transactional"/>
    <include
        android:id="@+id/shimmerLayoutForCorpCard"
        android:visibility="gone"
        layout="@layout/ybsdk_skeleton_single_card_details_for_corp_card"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
