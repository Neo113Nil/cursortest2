<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.core.transfer.utils.TransferToolbarView
        android:id="@+id/fpsPayEnrollToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fpsPayEnrollImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fpsPayEnrollToolbar"
        app:layout_constraintVertical_bias="0.18"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/fpsPayEnrollTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/fpsPayEnrollImage"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/fpsPayEnrollDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/fpsPayEnrollTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/fpsPayEnrollButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/fpsPayEnrollButtonDescription"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/fpsPayEnrollButtonDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/fpsPayEnrollErrorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fpsPayEnrollToolbar"/>
    <include
        android:id="@+id/loadingState"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/ybsdk_fps_pay_enroll_loading"/>
</androidx.constraintlayout.widget.ConstraintLayout>
