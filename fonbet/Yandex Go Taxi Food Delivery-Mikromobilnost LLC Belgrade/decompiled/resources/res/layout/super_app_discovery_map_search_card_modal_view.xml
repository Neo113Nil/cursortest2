<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/organization_item_search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/error_loading_container"
            android:paddingTop="@dimen/super_app_discovery_map_organizations_search_header"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/super_app_discovery_map_organizations_error_loading_container"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <com.yandex.go.design.view.GoView
        android:id="@+id/input_bottom_shadow"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/header_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_container"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="horizontal"
        android:id="@+id/header_container"
        android:background="@drawable/super_app_discovery_map_search_input_view_round_bg_main_32"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/super_app_discovery_map_organizations_search_header"
        android:paddingVertical="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yandex.go.design.view.GoImageView
            android:id="@+id/back_button"
            android:background="@drawable/bg_round_16dp_minor"
            android:padding="12dp"
            android:layout_width="@dimen/super_app_discovery_map_organizations_image_size"
            android:layout_height="@dimen/super_app_discovery_map_organizations_image_size"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/common_back"
            android:rotationY="@integer/rtl_support_angle_for_image_mirrored"
            android:layout_marginStart="@dimen/go_design_m_space"/>
        <ru.yandex.taxi.design.ListItemInputComponent
            android:layout_gravity="center_vertical"
            android:id="@+id/input_component"
            android:background="@drawable/bg_round_16dp_minor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/go_design_s_space"
            android:layout_marginEnd="@dimen/go_design_m_space"
            app:component_input_hint="@string/super_app_discovery_map_search"
            app:component_max_lines="1"
            app:component_show_underline="false"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoConstraintLayout>
