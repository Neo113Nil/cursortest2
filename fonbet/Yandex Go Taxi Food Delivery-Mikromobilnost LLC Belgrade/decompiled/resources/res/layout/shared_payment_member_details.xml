<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.widget.ToolbarModalView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced
            android:id="@+id/shared_payment_member_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ru.yandex.taxi.design.ListItemInputComponent
                    android:id="@+id/shared_payment_member_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_input_type="textCapWords"
                    app:imeOptions="actionUnspecified"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ru.yandex.taxi.design.ListItemInputComponent
                        android:id="@+id/shared_payment_member_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:component_input_type="phone"
                        app:component_max_lines="1"
                        app:imeOptions="actionUnspecified"/>
                    <View
                        android:background="@color/component_gray_225"
                        android:layout_width="0.5dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/go_design_m_space"
                        android:layout_marginBottom="@dimen/go_design_m_space"/>
                    <ru.yandex.taxi.design.ListItemComponent
                        android:id="@+id/shared_payment_member_select_contact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:component_title_text_color="@color/component_berryblue_normal"/>
                </LinearLayout>
                <ru.yandex.taxi.design.ListGroupHeaderComponent
                    android:id="@+id/shared_payment_member_limits_divider"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>
                <ru.yandex.taxi.design.ListItemSwitchComponent
                    android:id="@+id/shared_payment_member_limit_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_divider_position="bottom"
                    app:component_divider_type="margin"
                    app:component_subtitle="@string/shared_payment_member_details_limits_subtitle"/>
                <ru.yandex.taxi.design.ListItemInputComponent
                    android:id="@+id/shared_payment_member_limit_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_input_type="number"
                    app:component_max_lines="1"
                    app:imeOptions="actionUnspecified"/>
            </LinearLayout>
        </ru.yandex.taxi.widget.scroll.NestedScrollViewAdvanced>
        <ru.yandex.taxi.widget.scroll.ShadowScrollIndicator
            android:layout_gravity="bottom"
            android:id="@+id/shared_payment_member_scroll_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:scroll_view_id="@+id/shared_payment_member_scroll_view"/>
        <ru.yandex.taxi.widget.BottomEdgeButtonLayout
            android:layout_gravity="bottom"
            android:id="@+id/shared_payment_member_save_container"
            android:background="?attr/bgMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/shared_payment_member_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shared_payments_member_save"/>
        </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
        <FrameLayout
            android:id="@+id/shared_payment_member_controls_blocker"
            android:background="@color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</ru.yandex.taxi.widget.ToolbarModalView>
