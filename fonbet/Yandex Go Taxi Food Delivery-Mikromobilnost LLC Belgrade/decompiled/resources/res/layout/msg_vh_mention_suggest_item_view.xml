<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/msg_ripple_common"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:id="@+id/mention_suggest_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:layout_marginStart="12dp"
        app:avatarPadding="2dp"
        app:borderMargin="1dp"
        app:borderThickness="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:onlineIndicatorSize="7dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:ellipsize="end"
        android:id="@+id/mention_suggest_shown_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="11dp"
        android:maxLines="1"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:lineSpacingExtra="4sp"
        android:fontFamily="sans-serif"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/mention_suggest_avatar"
        app:layout_constraintEnd_toStartOf="@+id/mention_suggest_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/mention_suggest_avatar"
        app:layout_constraintTop_toTopOf="@+id/mention_suggest_avatar"
        app:layout_goneMarginEnd="12dp"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/mention_suggest_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/mention_suggest_shown_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mention_suggest_shown_name"
        app:layout_constraintTop_toTopOf="@+id/mention_suggest_shown_name"
        app:layout_constraintWidth_max="200dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
