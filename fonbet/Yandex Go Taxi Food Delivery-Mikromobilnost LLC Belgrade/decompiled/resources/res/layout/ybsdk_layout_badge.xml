<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image_badge_plus"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/ybsdk_padding_badgeview_icon_margin"
        android:layout_marginBottom="@dimen/ybsdk_padding_badgeview_icon_margin"
        android:layout_marginStart="@dimen/ybsdk_padding_badgeview_icon_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ybsdk_ic_plus"/>
    <com.ybsdk.widgets.common.GradientTextView
        android:id="@+id/text_badge_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ybsdk_padding_badgeview_icon_margin"
        android:layout_marginEnd="@dimen/ybsdk_padding_badgeview_text_end_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_badge_plus"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_gradientColors="@array/ybsdk_plus_colors_array"
        style="@style/Widget.YB.Text.Caption2.Medium"/>
</merge>
