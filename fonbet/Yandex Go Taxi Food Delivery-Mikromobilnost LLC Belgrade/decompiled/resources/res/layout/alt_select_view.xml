<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yandex.go.navigator.alt_select.AddressStateView
        android:id="@+id/source_destination_state_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yandex.go.design.view.GoView
        android:id="@+id/verticals_stub"
        android:paddingTop="@dimen/go_design_s_space"
        android:paddingBottom="@dimen/go_design_s_space"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/go_design_m_space"
        android:paddingEnd="@dimen/go_design_m_space"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:paddingBottom="@dimen/go_design_s_space"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/error_placeholder"
            android:visibility="gone"
            android:layout="@layout/alt_select_error_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/go_design_m_space"
            android:paddingEnd="@dimen/go_design_m_space">
            <include
                android:id="@+id/error_container"
                layout="@layout/alt_select_error_view"/>
        </com.yandex.go.design.view.GoFrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/go_design_m_space"
            android:paddingEnd="@dimen/go_design_m_space"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/placeholder"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/go_design_m_space"
            android:paddingEnd="@dimen/go_design_m_space">
            <ru.yandex.taxi.widget.ShimmeringBar
                android:orientation="vertical"
                android:background="@drawable/alt_select_placeholder"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:orientation="vertical"
                android:background="@drawable/alt_select_placeholder"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:orientation="vertical"
                android:background="@drawable/alt_select_placeholder"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:orientation="vertical"
                android:background="@drawable/alt_select_placeholder"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"/>
            <ru.yandex.taxi.widget.ShimmeringBar
                android:orientation="vertical"
                android:background="@drawable/alt_select_placeholder"
                android:layout_width="72dp"
                android:layout_height="72dp"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoFrameLayout>
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/bottom_notification"
            android:background="@drawable/bg_transparent_ripple"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/bottom_buttons_container"
            android:padding="@dimen/go_design_s_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <com.yandex.go.design.view.GoFrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ru.yandex.taxi.design.ButtonComponent
                    android:textSize="@dimen/component_text_size_body"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/go_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/navigator_go"
                    app:component_button_accent="true"
                    app:component_button_size="L"
                    app:component_disabled_background_color="?attr/controlMinor"
                    app:component_disabled_title_color="?attr/textOnControlMinor"/>
            </com.yandex.go.design.view.GoFrameLayout>
            <com.yandex.go.design.view.GoFrameLayout
                android:id="@+id/settings_container"
                android:background="@drawable/bg_transparent_ripple"
                android:layout_width="56dp"
                android:layout_height="56dp">
                <com.yandex.go.design.view.GoImageView
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_summary_options"/>
            </com.yandex.go.design.view.GoFrameLayout>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoLinearLayout>
