<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/qrPaymentsSubscriptionWidgetShimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ybsdk_shimmer_auto_start="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/qrPaymentsSubscriptionWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/qrPaymentsSubscriptionWidgetIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitEnd"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/qrPaymentsSubscriptionWidgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ybsdk_qr_payments_subscription_widget_vertical_paddings"
                android:layout_marginBottom="@dimen/ybsdk_qr_payments_subscription_widget_text_vertical_margin"
                android:maxLines="1"
                android:layout_marginStart="@dimen/ybsdk_qr_payments_subscription_widget_horizontal_paddings"
                app:layout_constraintBottom_toTopOf="@+id/qrPaymentsSubscriptionWidgetDescription"
                app:layout_constraintEnd_toStartOf="@+id/qrPaymentsSubscriptionWidgetSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Widget.YB.Text.Title3"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/qrPaymentsSubscriptionWidgetDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ybsdk_qr_payments_subscription_widget_vertical_paddings"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/qrPaymentsSubscriptionWidgetTitle"
                app:layout_constraintStart_toStartOf="@+id/qrPaymentsSubscriptionWidgetTitle"
                app:layout_constraintTop_toBottomOf="@+id/qrPaymentsSubscriptionWidgetTitle"
                style="@style/Widget.YB.Text.Body3"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/qrPaymentsSubscriptionWidgetSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="?attr/ybColor_control_handleDefault"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
</merge>
