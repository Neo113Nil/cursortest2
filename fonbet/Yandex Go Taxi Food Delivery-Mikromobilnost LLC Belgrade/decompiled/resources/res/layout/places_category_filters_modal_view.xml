<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/discovery_accessibility_content_description_map">
    <com.yandex.go.places.common.ui.ControlButtonView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_arrow_back_24dp"
        android:contentDescription="@string/common_back"
        android:layout_marginStart="@dimen/go_design_s_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/header_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/discovery_map_header_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/places_map_header_template"/>
    <include
        android:id="@+id/booking_container"
        android:background="@drawable/light_rounded_booking_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/discovery_booking_item_height"
        android:layout_marginTop="@dimen/go_design_s_space"
        android:layout_marginHorizontal="@dimen/discovery_booking_template_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container"
        layout="@layout/places_booking_template"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yandex.go.places.common.ui.ControlButtonView
            android:id="@+id/plus_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:src="@drawable/ic_plus"
            android:contentDescription="@string/mt_zoom_in_map_content_description"/>
        <com.yandex.go.places.common.ui.ControlButtonView
            android:id="@+id/minus_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_minus"
            android:contentDescription="@string/mt_zoom_out_map_content_description"/>
    </LinearLayout>
    <com.yandex.go.places.common.ui.ControlButtonView
        android:id="@+id/compass_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_places_compass"
        android:contentDescription="@string/discovery_accessibility_restore_map_rotation"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="@+id/location_focusing_button"
        app:layout_constraintEnd_toStartOf="@+id/location_focusing_button"/>
    <com.yandex.go.places.common.ui.ControlButtonView
        android:id="@+id/location_focusing_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:src="@drawable/ic_location_fill_24"
        android:contentDescription="@string/select_current_geolocation_description"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toTopOf="@+id/map_category_filters"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/map_category_filters"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:paddingHorizontal="12dp"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
