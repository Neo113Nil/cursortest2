<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/msg_bg_new_poll_list_item"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:layout_marginStart="18dp"
    android:layout_marginEnd="20dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/messenger_create_poll_new_variant"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.PollCreate.AddVariant"/>
    <ImageView
        android:id="@+id/plus_icon"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_poll_plus"
        app:tint="?attr/messagingCommonIconsSecondaryColor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
