<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ride_card_modal_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="ru.yandex.taxi.coordinator.AnchorBottomSheetBehavior">
    <FrameLayout
        android:id="@+id/top_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="1dp">
        <FrameLayout
            android:id="@+id/buttons_container"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.BackButtonIconComponent
                android:layout_gravity="start|top"
                android:id="@+id/ic_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:layout_marginStart="-12dp"
                android:layout_marginEnd="-12dp"/>
        </FrameLayout>
        <ViewStub
            android:layout_gravity="start|bottom"
            android:id="@+id/top_decoration_stub"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.yandex.taxi.widget.floatbuttonholder.FloatButtonHolderLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/float_right_button_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:layout_marginHorizontal="5dp"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/walking_info_stub"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ViewStub
        android:id="@+id/upsell_stub"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yandex.go.design.view.GoConstraintLayout
        android:id="@+id/content_container"
        android:background="?attr/bgMain"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:layout_gravity="end|top"
            android:id="@+id/badge_stub"
            android:layout="@layout/ride_card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/go_design_s_space"
            android:layout_marginEnd="@dimen/go_design_m_space"
            android:translationZ="100dp"
            android:paddingHorizontal="@dimen/go_design_s_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/button_footer"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <com.yandex.go.design.view.GoView
            android:layout_gravity="bottom"
            android:id="@+id/footer_shadow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ride_card_done_footer_margin"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.yandex.go.design.view.GoFrameLayout
            android:id="@+id/button_footer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.yandex.go.design.view.GoFrameLayout
                android:id="@+id/button_done_container"
                android:background="@drawable/ride_card_footer_top_corners_floating"
                android:paddingTop="@dimen/go_design_s_space"
                android:paddingBottom="@dimen/go_design_m_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/go_design_s_space">
                <ViewStub
                    android:id="@+id/button_done_stub"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.yandex.go.design.view.GoFrameLayout>
        </com.yandex.go.design.view.GoFrameLayout>
    </com.yandex.go.design.view.GoConstraintLayout>
</com.yandex.go.design.view.GoLinearLayout>
