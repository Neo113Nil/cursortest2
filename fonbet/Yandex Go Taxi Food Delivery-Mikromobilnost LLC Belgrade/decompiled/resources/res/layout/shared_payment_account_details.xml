<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/shared_payment_account_details_scroll_view"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListTitleComponent
                android:ellipsize="end"
                android:id="@+id/account_details_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Group
                android:orientation="vertical"
                android:id="@+id/shared_payment_account_details_loader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="loader1, loader2, loader3, plus_multi_banner_placeholder"/>
            <ru.yandex.taxi.design.LoadingComponent
                android:id="@+id/loader1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/account_details_name"/>
            <ru.yandex.taxi.design.LoadingComponent
                android:id="@+id/loader2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loader1"/>
            <ru.yandex.taxi.widget.PlaceholderView
                android:id="@+id/plus_multi_banner_placeholder"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="@dimen/go_design_s_space"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loader2"
                app:placeholder_corner_radius="24dp"
                app:placeholder_shimmering="true"/>
            <ru.yandex.taxi.design.LoadingComponent
                android:id="@+id/loader3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/plus_multi_banner_placeholder"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/shared_payment_account_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="list_items_container, yango_pay_actions_container, settings_group_divider, shared_payment_account_settings, shared_payment_account_remove"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:id="@+id/list_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:component_middle_divider_type="normal"
                app:component_top_divider_type="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/account_details_name">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/shared_payment_account_members"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_title="@string/shared_payments_members"
                    app:component_title_text_color="?attr/textMain"
                    app:component_trail_mode="navigation"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/shared_payment_account_payment_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_subtitle_size="@dimen/component_text_size_body"
                    app:component_subtitle_text_color="?attr/textMain"
                    app:component_title="@string/summary_payment_method_title"
                    app:component_title_size="@dimen/component_text_size_caption"
                    app:component_title_text_color="?attr/textMinor"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/shared_payment_account_payment_method_with_error"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_subtitle="@string/summary_payment_method_title"
                    app:component_subtitle_size="@dimen/component_text_size_caption"
                    app:component_subtitle_text_color="@color/component_red_normal"
                    app:component_title_size="@dimen/component_text_size_body"
                    app:component_title_text_color="?attr/textMain"
                    app:component_trail_mode="navigation"/>
            </ru.yandex.taxi.design.AutoDividerComponentList>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:id="@+id/yango_pay_actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:component_middle_divider_type="normal"
                app:component_top_divider_type="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/list_items_container"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/plus_multi_banner_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="plus_multi_banner, plus_multi_banner_title, plus_multi_banner_text, plus_multi_banner_arrow"/>
            <ru.yandex.taxi.widget.RoundedCornersImageView
                android:id="@+id/plus_multi_banner"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/go_design_s_space"
                android:layout_marginBottom="@dimen/go_design_s_space"
                android:foreground="@drawable/plus_multi_banner_ripple"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/go_design_m_space"
                android:layout_marginEnd="@dimen/go_design_m_space"
                app:cornerRadius="24dp"
                app:layout_constraintBottom_toTopOf="@+id/settings_group_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/yango_pay_actions_container"
                app:layout_goneMarginBottom="0dp"/>
            <ru.yandex.taxi.design.ListGroupHeaderComponent
                android:id="@+id/settings_group_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/shared_payment_account_settings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/plus_multi_banner"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/shared_payment_account_settings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title="@string/shared_payment_details_settings"
                app:component_trail_mode="navigation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/settings_group_divider"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/shared_payment_account_remove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title="@string/shared_payments_details_delete"
                app:component_trail_image="@drawable/ic_trash_transparent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shared_payment_account_settings"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_subtitle"
                android:id="@+id/plus_multi_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="@+id/plus_multi_banner"
                app:layout_constraintStart_toStartOf="@+id/plus_multi_banner"
                app:layout_constraintTop_toTopOf="@+id/plus_multi_banner"
                app:robotoFontStyle="bold"/>
            <ImageView
                android:id="@+id/plus_multi_banner_arrow"
                android:background="@drawable/circle_outline"
                android:padding="@dimen/go_design_s_space"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/plus_multi_banner"
                app:layout_constraintEnd_toEndOf="@+id/plus_multi_banner"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toEndOf="@+id/plus_multi_banner_text"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="@dimen/component_text_size_caption"
                android:textColor="?attr/textMinor"
                android:id="@+id/plus_multi_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/plus_multi_banner"
                app:layout_constraintEnd_toStartOf="@+id/plus_multi_banner_arrow"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="@+id/plus_multi_banner"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
