<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="180dp">
    <com.yandex.go.design.view.GoFrameLayout
        android:background="@drawable/bg_minor_rounded_20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="30dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/tariff_icon_holder"
            android:layout_width="match_parent"
            android:layout_height="76dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/unselected_tariff_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/selected_tariff_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/textMinor"
            android:ellipsize="end"
            android:id="@+id/tariff_title_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="@font/ys_text_regular"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="?attr/textMinor"
            android:id="@+id/tariff_subtitle_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_text_regular"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <include
                    android:id="@+id/tariff_price_binding"
                    layout="@layout/intercity_dashboard_tariff_price_view"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ru.yandex.taxi.design.CheckBoxComponent
                    android:id="@+id/tariff_checkbox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/tariff_lock_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_intercity_dashboard_tariff_lock"
                    android:scaleType="centerInside"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
