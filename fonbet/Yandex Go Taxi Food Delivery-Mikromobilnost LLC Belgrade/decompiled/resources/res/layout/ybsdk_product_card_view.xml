<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/backgroundImageNewStack"
        android:background="@drawable/ybsdk_product_card_view_background_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/iconsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/ybsdk_product_card_icon_size"
        android:minHeight="@dimen/ybsdk_product_card_icon_size"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/ybsdk_product_card_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_product_card_title_top_margin"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/ybsdk_product_card_title_start_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iconAfterTitle"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/iconsContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/ybsdk_product_card_horizontal_margin"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.feature.divkit.api.ui.YbDivView
        android:id="@+id/caption"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/rightPart"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:id="@+id/iconAfterTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ybsdk_product_card_icon_size"
        android:layout_marginLeft="@dimen/ybsdk_product_card_title_to_badge_margin"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/rightPart"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.ybsdk.widgets.common.NfcCardBadgeView
        android:id="@+id/nfcCardBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_nfc_card_badgeview_margin_top"
        app:layout_constraintEnd_toEndOf="@+id/rightPart"
        app:layout_constraintTop_toBottomOf="@+id/rightPart"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rightPart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/ybsdk_product_card_title_to_balance_margin"
        android:layout_marginEnd="@dimen/ybsdk_product_card_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title">
        <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
            android:layout_gravity="right"
            android:id="@+id/subtitleShimmerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ybsdk_shimmer_auto_start="false"
            app:ybsdk_shimmer_duration="3000"
            app:ybsdk_shimmer_fixed_width="@dimen/ybsdk_product_card_subtitle_shimmer_fixed_width"
            app:ybsdk_shimmer_gradient_highlight_alpha="0.8"
            app:ybsdk_shimmer_gradient_shape="tilted_oval">
            <com.ybsdk.core.design.spoiler.SpoilerFrameLayout
                android:layout_gravity="right"
                android:id="@+id/subtitleSpoiler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ybsdk_spoiler_height="@dimen/ybsdk_product_card_balance_spoiler_height"
                app:ybsdk_spoiler_horizontal_gravity="right"
                app:ybsdk_spoiler_width="@dimen/ybsdk_product_card_balance_spoiler_width">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.ybsdk.widgets.common.RadialGradientTextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/subtitleIcon"
                        android:visibility="gone"
                        android:layout_width="@dimen/ybsdk_product_card_subtitle_icon_size"
                        android:layout_height="@dimen/ybsdk_product_card_subtitle_icon_size"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
                        app:layout_constraintEnd_toStartOf="@+id/subtitle"
                        app:layout_constraintTop_toTopOf="@+id/subtitle"/>
                    <com.ybsdk.widgets.common.RadialGradientTextView
                        android:id="@+id/subtitleMini"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
                    <ImageView
                        android:id="@+id/subtitleMiniIcon"
                        android:visibility="gone"
                        android:layout_width="@dimen/ybsdk_product_card_subtitle_mini_icon_size"
                        android:layout_height="@dimen/ybsdk_product_card_subtitle_mini_icon_size"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="@+id/subtitleMini"
                        app:layout_constraintEnd_toStartOf="@+id/subtitleMini"
                        app:layout_constraintTop_toTopOf="@+id/subtitleMini"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.ybsdk.core.design.spoiler.SpoilerFrameLayout>
        </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
        <com.ybsdk.feature.divkit.api.ui.YbDivView
            android:layout_gravity="end"
            android:id="@+id/divRightPart"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</merge>
