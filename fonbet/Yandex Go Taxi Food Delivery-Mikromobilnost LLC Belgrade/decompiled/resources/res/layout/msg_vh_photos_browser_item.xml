<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">
    <com.yandex.messaging.views.SquareImageView
        android:id="@+id/photos_browser_image"
        android:background="?attr/messagingCommonBackgroundSecondaryColor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.yandex.messaging.internal.view.custom.ProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/photos_browser_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/messagingViewerIconsColor"/>
</FrameLayout>
