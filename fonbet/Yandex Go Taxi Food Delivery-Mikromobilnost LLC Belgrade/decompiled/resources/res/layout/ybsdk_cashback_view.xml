<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/cashbackViewLeftText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        style="@style/Widget.YB.Text.Body3"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/cashbackViewImage"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="4dp"/>
    <TextView
        android:id="@+id/cashbackViewRightText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        style="@style/Widget.YB.Text.Body3"/>
</merge>
