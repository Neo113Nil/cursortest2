<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonAccentTextColor"
        android:gravity="center_vertical"
        android:id="@+id/text"
        android:background="@drawable/msg_reactions_shadow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:text="@string/messaging_starred_message_label"
        android:drawablePadding="3dp"
        android:fontFamily="@font/ya_medium"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:elevation="2dp"
        android:outlineSpotShadowColor="?attr/messagingCommonElevationShadowColor"
        android:outlineAmbientShadowColor="?attr/messagingCommonElevationShadowColor"
        app:drawableStartCompat="@drawable/msg_ic_star_filled_small"
        app:drawableTint="?attr/messagingCommonAccentTextColor"/>
</FrameLayout>
