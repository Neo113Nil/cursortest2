<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.BackButtonIconComponent
        android:layout_gravity="start|top"
        android:id="@+id/ic_route_stops_close"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-12dp"
        android:scaleType="center"
        android:layout_marginStart="-12dp"
        android:layout_marginEnd="-12dp"/>
    <ImageView
        android:id="@+id/route_stops_shadow"
        android:background="0x7f081870"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-12dp"
        android:scaleType="fitXY"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/route_stops_scroll_view"
        android:paddingTop="20dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/route_stops"
                android:scrollbars="none"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
