<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="bottom"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/chat_input_button_height"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonAccentColor"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/messaging_input_button"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chat_input_button_height"
        android:foreground="?android:attr/selectableItemBackground"
        android:textAllCaps="false"
        android:fontFamily="@font/ya_medium"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/messaging_input_progress"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="@dimen/chat_input_button_height"
        android:layout_height="@dimen/chat_input_button_height"/>
    <com.yandex.bricks.BrickSlotView
        android:layout_gravity="bottom"
        android:id="@+id/messaging_input_slot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chat_input_button_height"/>
</FrameLayout>
