<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:id="@+id/user_item_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        app:avatarPadding="3dp"
        app:avatarTextSize="16sp"
        app:borderMargin="1dp"
        app:borderThickness="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:onlineIndicatorSize="@dimen/online_indicator_height_and_width_small"
        app:placeholderBackground="@drawable/avatar_placeholder"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="?attr/messagingCommonTextPrimaryColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/user_item_display_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/user_item_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/user_item_text_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/user_item_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/user_item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/user_item_badge"
        app:layout_constraintEnd_toStartOf="@+id/user_item_text_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/user_item_display_name"
        app:layout_constraintTop_toBottomOf="@+id/user_item_display_name"
        style="@style/Messaging.Subtitle"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/user_item_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/user_item_text_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/user_item_subtitle"
        app:layout_constraintTop_toBottomOf="@+id/user_item_subtitle"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/user_item_badge2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/user_item_badge"
        app:layout_constraintEnd_toEndOf="@+id/user_item_text_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/user_item_badge"
        app:layout_constraintTop_toTopOf="@+id/user_item_badge"/>
    <ImageView
        android:id="@+id/ic_user_selection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_checkbox_checked"/>
    <ImageButton
        android:id="@+id/ic_user_menu"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:contentDescription="@string/user_item_menu_button_content_desc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_chat_info_user_menu"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="vertical"
        android:id="@+id/user_item_text_barrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="ic_user_menu, ic_user_selection"/>
</androidx.constraintlayout.widget.ConstraintLayout>
