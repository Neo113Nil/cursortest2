<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ToolbarComponent
            android:id="@+id/order_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_divider_position="bottom"
            app:component_divider_type="normal"
            app:component_subtitle_gravity="center_horizontal"
            app:component_title="@string/info_title"
            app:component_title_gravity="center_horizontal"
            app:component_title_size="@dimen/component_text_size_body"
            app:component_title_typeface="medium"
            app:component_toolbar_background_accent_enabled="true"/>
        <FrameLayout
            android:id="@+id/order_info_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</merge>
