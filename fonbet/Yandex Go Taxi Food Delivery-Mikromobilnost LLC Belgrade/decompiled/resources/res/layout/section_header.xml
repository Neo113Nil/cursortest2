<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/turbo_buttons_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/shortcuts_section_title_height"
    android:paddingHorizontal="4dp">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/shortcuts_section_header"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="-4dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        app:component_no_background="true"
        app:component_title_ellipsize_mode="end"
        app:component_title_max_lines="1"
        app:component_title_size="@dimen/component_text_size_subtitle"
        app:component_title_typeface="medium"/>
</FrameLayout>
