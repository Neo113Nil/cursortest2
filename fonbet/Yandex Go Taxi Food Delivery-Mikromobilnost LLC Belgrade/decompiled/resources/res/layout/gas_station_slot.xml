<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:paddingStart="12dp"
    android:paddingEnd="@dimen/go_design_m_space">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gas_station_shimmer_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="gas_station_logo_shimmer, gas_station_name_shimmer,       route_duration_diff_shimmer"/>
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/gas_station_logo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:foreground="@drawable/fg_oval_stroke"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/gas_station_logo_shimmer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        app:barCornerRadius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_subtitle"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:id="@+id/gas_station_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/gas_station_fuel_types"
        app:layout_constraintEnd_toStartOf="@+id/route_duration_diff"
        app:layout_constraintStart_toEndOf="@+id/gas_station_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="0dp"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:ellipsize="end"
        android:id="@+id/gas_station_fuel_types"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/route_duration_diff"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/gas_station_logo"
        app:layout_constraintTop_toBottomOf="@+id/gas_station_name"
        app:layout_goneMarginEnd="0dp"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/gas_station_name_shimmer"
        android:layout_width="90dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        app:barCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gas_station_logo_shimmer"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/route_duration_diff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:id="@+id/route_duration_diff_shimmer"
        android:layout_width="60dp"
        android:layout_height="20dp"
        app:barCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.yandex.go.design.view.GoConstraintLayout>
