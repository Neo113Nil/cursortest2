            app:layout_constraintTop_toTopOf="@+id/left_image_third"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_title_third"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="8dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/right_subtitle_third"
            app:layout_constraintEnd_toEndOf="@+id/right_image_third"
            app:layout_constraintStart_toStartOf="@+id/right_image_third"
            app:layout_constraintTop_toBottomOf="@+id/right_image_third"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_subtitle_third"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="4dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toBottomOf="@+id/left_subtitle_third"
            app:layout_constraintEnd_toEndOf="@+id/right_image_third"
            app:layout_constraintStart_toStartOf="@+id/right_image_third"
            app:layout_constraintTop_toBottomOf="@+id/right_title_third"/>
