<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shortcut_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/header_image"
            android:layout_width="@dimen/market_header_placeholder_image_size"
            android:layout_height="@dimen/market_header_placeholder_image_size"
            android:layout_marginTop="16dp"
            app:corner_radius="56dp"
            app:layout_constraintBottom_toTopOf="@+id/left_image_first"
            app:layout_constraintEnd_toStartOf="@+id/header_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="48dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toBottomOf="@+id/header_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/header_image"
            app:layout_constraintTop_toTopOf="@+id/header_image"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_image_first"
            android:layout_width="@dimen/market_item_placeholder_size"
            android:layout_height="@dimen/market_item_placeholder_size"
            android:layout_marginTop="8dp"
            app:corner_radius="@dimen/market_item_placeholder_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_title_first"
            app:layout_constraintEnd_toStartOf="@+id/right_image_first"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_image"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_title_first"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="8dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_subtitle_first"
            app:layout_constraintEnd_toEndOf="@+id/left_image_first"
            app:layout_constraintStart_toStartOf="@+id/left_image_first"
            app:layout_constraintTop_toBottomOf="@+id/left_image_first"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_subtitle_first"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="4dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_image_second"
            app:layout_constraintEnd_toEndOf="@+id/left_image_first"
            app:layout_constraintStart_toStartOf="@+id/left_image_first"
            app:layout_constraintTop_toBottomOf="@+id/left_title_first"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_image_first"
            android:layout_width="@dimen/market_item_placeholder_size"
            android:layout_height="@dimen/market_item_placeholder_size"
            app:corner_radius="@dimen/market_item_placeholder_corner_size"
            app:layout_constraintBottom_toBottomOf="@+id/left_image_first"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/left_image_first"
            app:layout_constraintTop_toTopOf="@+id/left_image_first"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_title_first"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="8dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/right_subtitle_first"
            app:layout_constraintEnd_toEndOf="@+id/right_image_first"
            app:layout_constraintStart_toStartOf="@+id/right_image_first"
            app:layout_constraintTop_toBottomOf="@+id/right_image_first"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_subtitle_first"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="4dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toBottomOf="@+id/left_subtitle_first"
            app:layout_constraintEnd_toEndOf="@+id/right_image_first"
            app:layout_constraintStart_toStartOf="@+id/right_image_first"
            app:layout_constraintTop_toBottomOf="@+id/right_title_first"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_image_second"
            android:layout_width="@dimen/market_item_placeholder_size"
            android:layout_height="@dimen/market_item_placeholder_size"
            android:layout_marginTop="16dp"
            app:corner_radius="@dimen/market_item_placeholder_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_title_second"
            app:layout_constraintEnd_toStartOf="@+id/right_image_second"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/left_subtitle_first"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_title_second"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="8dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_subtitle_second"
            app:layout_constraintEnd_toEndOf="@+id/left_image_second"
            app:layout_constraintStart_toStartOf="@+id/left_image_second"
            app:layout_constraintTop_toBottomOf="@+id/left_image_second"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_subtitle_second"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="4dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_image_third"
            app:layout_constraintEnd_toEndOf="@+id/left_image_second"
            app:layout_constraintStart_toStartOf="@+id/left_image_second"
            app:layout_constraintTop_toBottomOf="@+id/left_title_second"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_image_second"
            android:layout_width="@dimen/market_item_placeholder_size"
            android:layout_height="@dimen/market_item_placeholder_size"
            app:corner_radius="@dimen/market_item_placeholder_corner_size"
            app:layout_constraintBottom_toBottomOf="@+id/left_image_second"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/left_image_second"
            app:layout_constraintTop_toTopOf="@+id/left_image_second"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_title_second"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="8dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/right_subtitle_second"
            app:layout_constraintEnd_toEndOf="@+id/right_image_second"
            app:layout_constraintStart_toStartOf="@+id/right_image_second"
            app:layout_constraintTop_toBottomOf="@+id/right_image_second"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_subtitle_second"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="4dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toBottomOf="@+id/left_subtitle_second"
            app:layout_constraintEnd_toEndOf="@+id/right_image_second"
            app:layout_constraintStart_toStartOf="@+id/right_image_second"
            app:layout_constraintTop_toBottomOf="@+id/right_title_second"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_image_third"
            android:layout_width="@dimen/market_item_placeholder_size"
            android:layout_height="@dimen/market_item_placeholder_size"
            android:layout_marginTop="16dp"
            app:corner_radius="@dimen/market_item_placeholder_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_title_third"
            app:layout_constraintEnd_toStartOf="@+id/right_image_third"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/left_subtitle_second"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_title_third"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="8dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toTopOf="@+id/left_subtitle_third"
            app:layout_constraintEnd_toEndOf="@+id/left_image_third"
            app:layout_constraintStart_toStartOf="@+id/left_image_third"
            app:layout_constraintTop_toBottomOf="@+id/left_image_third"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/left_subtitle_third"
            android:layout_width="0dp"
            android:layout_height="@dimen/market_item_placeholder_text_size"
            android:layout_marginTop="4dp"
            app:corner_radius="@dimen/market_item_placeholder_text_corner_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/left_image_third"
            app:layout_constraintStart_toStartOf="@+id/left_image_third"
            app:layout_constraintTop_toBottomOf="@+id/left_title_third"/>
        <ru.yandex.taxi.plus.design.view.ShimmeringView
            android:id="@+id/right_image_third"
            android:layout_width="@dimen/market_item_placeholder_size"
            android:layout_height="@dimen/market_item_placeholder_size"
            app:corner_radius="@dimen/market_item_placeholder_corner_size"
            app:layout_constraintBottom_toBottomOf="@+id/left_image_third"
            app:layout_constraintEnd_toEndOf="parent"
