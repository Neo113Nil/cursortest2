<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/me2meDebitResultToolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me2meDebitResultImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toTopOf="@+id/me2meDebitResultTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me2meDebitResultToolbar"
        app:layout_constraintVertical_bias="0.38"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/ybsdk_ic_yb_placeholder"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/me2meDebitResultProgress"
        android:background="@drawable/ybsdk_circle_button_background"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="56dp"
        app:layout_constraintStart_toStartOf="@+id/me2meDebitResultImage"
        app:layout_constraintTop_toTopOf="@+id/me2meDebitResultImage"
        app:ybsdk_indicatorColor="?attr/ybColor_button_primaryNormal"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressViewStyleSmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/me2meDebitResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/me2meDebitResultAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me2meDebitResultImage"
        style="@style/Widget.YB.Text.Headline2"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/me2meDebitResultAmount"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/me2meDebitResultDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me2meDebitResultTitle"
        style="@style/Widget.YB.Text.Numbers2"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/me2meDebitResultDescription"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/me2meDebitResultWidget"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me2meDebitResultAmount"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.WidgetWithSwitchView
        android:id="@+id/me2meDebitResultWidget"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/me2meDebitResultButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/me2meDebitResultButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
</androidx.constraintlayout.widget.ConstraintLayout>
