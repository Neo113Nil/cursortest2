<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/testPaymentStatusToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"/>
    <ImageView
        android:id="@+id/testPaymentStatusMemberIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="152dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testPaymentStatusToolbar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.ybsdk.widgets.common.OperationProgressView
        android:id="@+id/testPaymentStatusOperationIcon"
        android:background="@drawable/ybsdk_circle_button_background"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="56dp"
        app:layout_constraintStart_toStartOf="@+id/testPaymentStatusMemberIcon"
        app:layout_constraintTop_toTopOf="@+id/testPaymentStatusMemberIcon"
        style="@style/YbSdk.Widget.WidgetsCommon.OperationProgressViewStyleSmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/testPaymentStatusTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/testPaymentStatusMemberIcon"
        style="@style/Widget.YB.Text.Headline2"/>
    <include
        android:id="@+id/testPaymentStatusSkeletons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="200dp"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ybsdk_test_payment_skeletons"/>
    <TextView
        android:gravity="center"
        android:id="@+id/testPaymentStatusDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="202dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/testPaymentStatusTitle"
        style="@style/Widget.YB.Text.Body2"/>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/testPaymentStatusButtonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/testPaymentStatusErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
