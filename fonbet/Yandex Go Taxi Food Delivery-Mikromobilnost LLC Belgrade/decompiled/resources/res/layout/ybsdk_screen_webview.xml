<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gripBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_sliding_view_top_inset_height"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/toolbar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/gripBackground"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/webViewProgress"
        android:layout_width="@dimen/ybsdk_progress_indicator_size"
        android:layout_height="@dimen/ybsdk_progress_indicator_size"
        android:indeterminate="true"
        app:indicatorColor="?attr/ybColor_button_primaryNormal"
        app:indicatorSize="@dimen/ybsdk_progress_indicator_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:trackThickness="@dimen/ybsdk_progress_indicator_thickness"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.ybsdk.widgets.common.CloseButtonView
        android:id="@+id/closeButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_view_overlay_dialog_close_icon_marginTop"
        android:layout_marginEnd="@dimen/ybsdk_view_overlay_dialog_close_icon_marginEnd"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
