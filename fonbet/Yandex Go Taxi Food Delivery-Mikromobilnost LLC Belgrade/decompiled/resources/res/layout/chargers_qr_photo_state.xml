<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/photo_buttons_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="flash_light_btn, enter_number_manually, qr_state_back_button, text_hint,"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/text_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/chargers_top_hint"
        android:layout_marginHorizontal="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/flash_light_btn"
        android:background="@drawable/flash_light_56dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_marginEnd="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="@+id/offer_card_offset_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/enter_number_manually"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/enter_number_manually"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:text="@string/scooters_qr_enter_number"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:component_background_color="@color/component_fog_dark"
        app:component_button_rounded_corners_radius="100dp"
        app:component_title_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/offer_card_offset_guideline"
        app:layout_constraintEnd_toStartOf="@+id/flash_light_btn"
        app:layout_constraintStart_toEndOf="@+id/qr_state_back_button"/>
    <com.yandex.go.design.widget.qr.QrBackButtonComponent
        android:id="@+id/qr_state_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:layout_marginStart="@dimen/go_design_s_space"
        app:layout_constraintBottom_toBottomOf="@+id/offer_card_offset_guideline"
        app:layout_constraintEnd_toStartOf="@+id/enter_number_manually"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
