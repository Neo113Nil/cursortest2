<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/feed_sdk_intercity_dashboard_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.go.design.view.GoFrameLayout
        android:layout_gravity="center"
        android:id="@+id/feed_sdk_intercity_dashboard_progress"
        android:background="?attr/bgMain"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/common_loading">
        <ru.yandex.taxi.widget.progress.CircularProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.yandex.go.design.view.GoFrameLayout>
</merge>
