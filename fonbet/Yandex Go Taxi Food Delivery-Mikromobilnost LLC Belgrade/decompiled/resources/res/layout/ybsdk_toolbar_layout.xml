<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ybsdk_toolbar_height">
    <ImageView
        android:id="@+id/image"
        android:padding="4dp"
        android:visibility="invisible"
        android:layout_width="@dimen/ybsdk_toolbar_view_icon_size"
        android:layout_height="@dimen/ybsdk_toolbar_view_icon_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/subtitleContainer"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.YB.Text.Title1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/subtitleContainer"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:id="@+id/leftSubtitleIcon"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
        <TextView
            android:id="@+id/toolbarSubtitleDelimeter"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="@string/ybsdk_toolbar_subtitle_delimiter"
            android:layout_marginHorizontal="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/subtitle"
            app:layout_constraintEnd_toStartOf="@+id/subtitleWithSpoiler"
            app:layout_constraintStart_toEndOf="@+id/subtitle"
            app:layout_constraintTop_toTopOf="@+id/subtitle"
            style="@style/Widget.YB.Text.Caption1.Regular"/>
        <com.ybsdk.core.design.spoiler.SpoilerTextView
            android:ellipsize="end"
            android:id="@+id/subtitleWithSpoiler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:ybsdk_spoiler_height="12dp"
            app:ybsdk_spoiler_horizontal_gravity="center"
            app:ybsdk_spoiler_vertical_gravity="bottom"
            app:ybsdk_spoiler_width="58dp"
            style="@style/Widget.YB.Text.Caption1.Regular.SecondaryColor"/>
    </LinearLayout>
    <com.ybsdk.widgets.common.CloseButtonView
        android:id="@+id/close_button"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/toolbar_right_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/ybsdk_auto_topup_setup_information"
        android:layout_marginEnd="@dimen/ybsdk_toolbar_view_button_marginEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/toolbarCustomRightPartContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
