<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="192dp"
    android:paddingVertical="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/textsHolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/errorButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <TextView
            android:gravity="center"
            android:id="@+id/errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ybsdk_dashboard_error_view_message"
            style="@style/Widget.YB.Text.Title1"/>
        <TextView
            android:gravity="center"
            android:id="@+id/errorSubtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.YB.Text.Body2"/>
    </LinearLayout>
    <com.ybsdk.widgets.common.YbButtonView
        android:id="@+id/errorButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/errorTraceId"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textsHolder"
        app:ybsdk_buttonTitle="@string/ybsdk_dashboard_button_reload"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.M"/>
    <com.ybsdk.widgets.common.TraceIdErrorView
        android:ellipsize="end"
        android:id="@+id/errorTraceId"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/ybsdk_common_trace_id_error_code"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.YB.Text.Caption3.Regular.SecondaryColor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
