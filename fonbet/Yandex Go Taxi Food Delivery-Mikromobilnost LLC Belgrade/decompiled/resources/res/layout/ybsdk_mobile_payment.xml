<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/mobilePaymentToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"
        app:ybsdk_title="@string/ybsdk_transfer_mobile_payments_phone_header_title"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/mobilePaymentInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintTop_toBottomOf="@+id/mobilePaymentToolbar"
        app:ybsdk_inputLabel="@string/ybsdk_transfer_mobile_payments_phone_destination_title"
        app:ybsdk_placeholder="@string/ybsdk_transfer_mobile_payments_phone_placeholder"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobilePaymentRecycler"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mobilePaymentInput"/>
</androidx.constraintlayout.widget.ConstraintLayout>
