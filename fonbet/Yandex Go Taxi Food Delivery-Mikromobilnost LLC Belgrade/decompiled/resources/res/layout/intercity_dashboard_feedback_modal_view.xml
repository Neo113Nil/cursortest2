<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFeatureSettings="@string/go_default_font_settings"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/reasons_recycler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:robotoFontStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reasons_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:background="@drawable/top_corners_24dp"
        android:paddingTop="@dimen/go_design_s_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reasons_recycler">
        <ru.yandex.taxi.design.ListItemInputComponent
            android:id="@+id/commentField"
            android:background="@drawable/bg_comment_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:minHeight="56dp"
            android:layout_marginHorizontal="@dimen/go_design_s_space"
            app:component_max_lines="3"
            app:component_show_underline="false"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/button_container"
            android:background="@drawable/top_corners_24dp"
            android:paddingTop="@dimen/go_design_s_space"
            android:paddingBottom="@dimen/go_design_s_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/cancel_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="2dp"
                app:component_background_color="?attr/controlMinor"
                app:component_button_accent="true"
                app:component_title_color="?attr/textMain"/>
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/done_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="8dp"
                app:component_background_color="?attr/controlMain"
                app:component_button_accent="true"
                app:component_title_color="?attr/textOnControl"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoConstraintLayout>
