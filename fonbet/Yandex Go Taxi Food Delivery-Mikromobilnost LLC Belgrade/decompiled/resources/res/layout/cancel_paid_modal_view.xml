<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListTitleComponent
        android:id="@+id/cancel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.ListTextComponent
        android:id="@+id/cancel_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.design.AutoDividerComponentList
        android:id="@+id/cancel_allowed_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_middle_divider_type="margin"
        app:component_top_divider_type="margin"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="@dimen/go_design_s_space"
        android:paddingBottom="@dimen/go_design_m_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/go_design_m_space"
        android:paddingEnd="@dimen/go_design_m_space">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/do_not_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            app:component_background_color="?attr/controlMinor"
            app:component_button_outline_width="0dp"
            app:component_title_color="?attr/textOnControlMinor"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            app:component_subtitle_gravity="center_horizontal"
            app:component_title_gravity="center_horizontal"
            app:component_vertical_padding="0dp"/>
    </LinearLayout>
</LinearLayout>
