<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dialog_bio_small_padding"
    android:paddingEnd="@dimen/dialog_bio_small_padding">
    <TextView
        android:textSize="@dimen/dialog_bio_small_title_text_size"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_bio_small_title_height"
        android:text="@string/CompanyName"
        android:paddingStart="@dimen/dialog_bio_small_padding"
        android:paddingEnd="@dimen/dialog_bio_small_padding"
        app:layout_constraintBottom_toTopOf="@+id/bioFrameLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/dialog_bio_small_hint_text_size"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/tvHint"
        android:padding="@dimen/dialog_bio_small_click_area_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/BioRnd"
        app:layout_constraintBottom_toBottomOf="@+id/bioFrameLayout"
        app:layout_constraintEnd_toEndOf="@+id/bioFrameLayout"
        app:layout_constraintStart_toStartOf="@+id/bioFrameLayout"
        app:layout_constraintTop_toTopOf="@+id/bioFrameLayout"/>
    <ru.CryptoPro.JCSP.tools.common.window.elements.BioRndView
        android:id="@+id/bioFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@+id/pbBioBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbBioBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_bio_small_progress_bar_panel_height"
        android:layout_marginTop="@dimen/dialog_bio_small_padding"
        android:progress="0"
        android:paddingStart="@dimen/dialog_bio_small_padding"
        android:paddingEnd="@dimen/dialog_bio_small_padding"
        app:layout_constraintBottom_toTopOf="@+id/btCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bioFrameLayout"
        app:trackThickness="@dimen/dialog_bio_small_progress_bar_track_thickness"/>
    <Button
        android:textSize="@dimen/dialog_bio_small_button_text_size"
        android:id="@+id/btCancel"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dialog_bio_small_button_panel_height"
        android:text="@string/Cancel"
        android:insetTop="@dimen/dialog_bio_small_button_padding"
        android:insetBottom="@dimen/dialog_bio_small_button_padding"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pbBioBar"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
