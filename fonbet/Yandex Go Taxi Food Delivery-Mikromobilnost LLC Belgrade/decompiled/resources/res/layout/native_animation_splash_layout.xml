<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/white_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/image_city_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="30sp"
        android:id="@+id/title"
        android:paddingTop="@dimen/go_design_m_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="0.8"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/logo2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.yandex.go.splash.presentation.ClippedFrameLayout
        android:id="@+id/clipped_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/logo1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.yandex.go.splash.presentation.ClippedFrameLayout>
</FrameLayout>
