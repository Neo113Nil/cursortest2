<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="84sp"
    android:paddingVertical="12dp">
    <com.yandex.messaging.internal.avatar.AvatarImageView
        android:id="@+id/global_search_message_avatar"
        android:layout_width="@dimen/chat_list_item_avatar_height_and_width"
        android:layout_height="@dimen/chat_list_item_avatar_height_and_width"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Messaging.ChatListAvatarView"/>
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:ellipsize="end"
        android:id="@+id/global_search_message_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="78dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/global_search_message_text"
        app:layout_constraintEnd_toStartOf="@+id/global_search_message_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Messaging.ChatListItemTitle"/>
    <com.yandex.messaging.views.AppCompatEmojiTextView
        android:ellipsize="end"
        android:id="@+id/global_search_message_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="2"
        android:singleLine="false"
        android:layout_marginStart="78dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/global_search_message_badge"
        app:layout_constraintEnd_toStartOf="@+id/global_search_message_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/global_search_message_title"
        style="@style/Messaging.ChatListItemContent"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/global_search_message_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/global_search_message_text"
        app:layout_constraintTop_toBottomOf="@+id/global_search_message_text"/>
    <com.yandex.messaging.ui.badges.MarkedBadgeImageView
        android:id="@+id/global_search_message_badge2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/global_search_message_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/global_search_message_badge"
        app:layout_constraintTop_toTopOf="@+id/global_search_message_badge"/>
    <TextView
        android:id="@+id/global_search_message_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_alignTop="@+id/global_search_message_title"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="@+id/global_search_message_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/global_search_message_title"
        style="@style/Messaging.ChatListItemTime"/>
</androidx.constraintlayout.widget.ConstraintLayout>
