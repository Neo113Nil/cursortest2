<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/organization_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/go_design_s_space"
    android:paddingEnd="@dimen/go_design_s_space">
    <com.yandex.go.design.view.GoFrameLayout
        android:id="@+id/image_slider_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/image_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.yandex.go.places.common.ui.indicator.DotsIndicatorComponent
            android:layout_gravity="end|bottom"
            android:id="@+id/banner_dots_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/go_design_m_space"
            android:layout_marginEnd="@dimen/go_design_m_space"/>
        <com.yandex.go.design.view.GoView
            android:layout_gravity="start|bottom"
            android:id="@+id/badge_shadow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/discovery_organizations_badge_shadow_margin"
            android:layout_marginStart="@dimen/discovery_organizations_badge_shadow_margin"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:layout_gravity="start|bottom"
            android:id="@+id/badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="12dp"
            android:paddingVertical="6dp"/>
    </com.yandex.go.design.view.GoFrameLayout>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textColor="?attr/textMain"
        android:id="@+id/title"
        android:paddingTop="@dimen/go_design_s_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginHorizontal="10dp"/>
    <com.yandex.go.places.impl.ui.common.compression_resistant.CompressionResistantListComponent
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginHorizontal="10dp"/>
    <com.yandex.go.places.impl.ui.common.compression_resistant.CompressionResistantListComponent
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginHorizontal="10dp"/>
    <include layout="@layout/organizations_shimmering_layout"/>
</LinearLayout>
