<?xml version="1.0" encoding="utf-8"?>
<ru.yandex.taxi.scooters.presentation.common.ui.ScootersCameraView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/done_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="84dp"
        android:text="@string/scooters_done"
        app:component_background_color="@color/component_fog_dark"
        app:component_button_rounded_corners_radius="100dp"
        app:component_title_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/take_photo_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/take_photo_btn"
        app:layout_constraintTop_toTopOf="@+id/take_photo_btn"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/scooters_photo_list"
        android:paddingHorizontal="@dimen/go_design_m_space"
        app:layout_constraintBottom_toTopOf="@+id/take_photo_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</ru.yandex.taxi.scooters.presentation.common.ui.ScootersCameraView>
