<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/prize_lottie_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/back_button"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_cross"
            android:tint="@color/white"
            android:contentDescription="@string/common_back"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/background_effect_image_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="0x7f080d4f"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toTopOf="@+id/bottom_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/background_image_view"
            android:layout_width="192dp"
            android:layout_height="192dp"
            app:layout_constraintBottom_toBottomOf="@+id/background_effect_image_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/background_effect_image_view"/>
        <ru.yandex.taxi.widget.InsetsAwareLinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottom_container"
            android:paddingTop="@dimen/go_design_l_space"
            android:paddingBottom="@dimen/go_design_m_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="32sp"
                android:textColor="@color/white"
                android:textColorLink="?attr/textInvert"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_text_bold"
                android:layout_marginHorizontal="16dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textColorLink="@color/white"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"/>
            <com.yandex.go.design.view.GoLinearLayout
                android:orientation="vertical"
                android:id="@+id/buttons_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ru.yandex.taxi.widget.InsetsAwareLinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
