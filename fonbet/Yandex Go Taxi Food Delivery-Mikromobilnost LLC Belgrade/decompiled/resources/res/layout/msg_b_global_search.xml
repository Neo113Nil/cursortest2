<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/global_search_toolbar"
        android:background="@drawable/msg_bg_toolbar"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/global_search_back"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/toolbar_back_button_global_search_content_desc"
            app:srcCompat="@drawable/msg_ic_back"/>
        <com.yandex.messaging.views.SearchEditText
            android:textSize="16sp"
            android:textColor="?attr/messagingCommonTextPrimaryColor"
            android:textColorHint="?attr/messagingCommonTextSecondaryColor"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/global_search_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="2dp"
            android:hint="@string/messenger_global_search_hint_text"
            android:layout_weight="1"
            android:lineSpacingExtra="4sp"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:fontFamily="@font/ya_regular"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/global_search_clear_input_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:contentDescription="@string/global_search_clear_input_button_content_des__res_0x7f150895"
            app:srcCompat="@drawable/msg_ic_clear"/>
        <com.yandex.alicekit.core.views.FixedProgressBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/global_search_progress_bar"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/msg_anim_spinner"
            android:contentDescription="@null"/>
    </LinearLayout>
    <View
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/global_search_result"
        android:background="?attr/messagingCommonBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/global_search_no_results"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textColor="?attr/messagingCommonTextPrimaryColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/global_search_no_results"
            android:fontFamily="@font/ya_bold"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="0x7f081440"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/global_search_retry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textColor="?attr/messagingCommonTextPrimaryColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/global_search_error_title"
            android:fontFamily="@font/ya_bold"/>
        <TextView
            android:textSize="20sp"
            android:textColor="?attr/messagingCommonTextSecondaryColor"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/global_search_error_text"
            android:layout_marginHorizontal="32dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/messagingCommonAccentFgColor"
            android:gravity="center"
            android:id="@+id/global_search_retry_button"
            android:background="@drawable/msg_bg_accent_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/global_search_error_retry_btn"
            android:textAllCaps="false"
            android:fontFamily="@font/ya_medium"
            android:translationZ="1dp"
            android:elevation="3dp"
            android:paddingHorizontal="16dp"/>
    </LinearLayout>
</LinearLayout>
