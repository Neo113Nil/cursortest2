<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/solid_summary_trap_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/summary_header_title"/>
    <FrameLayout
        android:id="@+id/source_destination_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/solid_summary_trap_title"/>
    <include
        android:id="@+id/solid_summary_tariffs_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/source_destination_container"
        layout="@layout/solid_summary_tariffs_container"/>
    <Space
        android:id="@+id/solid_summary_bubbles_container_anchor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/solid_summary_tariffs_container"/>
    <FrameLayout
        android:id="@+id/solid_summary_tooltip_container"
        android:paddingBottom="4dp"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/go_design_m_space"
        android:paddingEnd="@dimen/go_design_m_space"
        app:layout_constraintTop_toBottomOf="@+id/solid_summary_bubbles_container_anchor"/>
    <ru.yandex.taxi.requirements.ui.bubbles.RequirementsBubblesContainer
        android:id="@+id/solid_summary_bubbles_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        app:layout_constraintTop_toBottomOf="@+id/solid_summary_tooltip_container"/>
    <ViewStub
        android:id="@+id/auction_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/go_design_s_space"
        app:layout_constraintBottom_toTopOf="@+id/solid_summary_bottom_edge"
        app:layout_constraintTop_toBottomOf="@+id/solid_summary_bubbles_container"/>
    <Space
        android:id="@+id/solid_summary_bottom_edge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="85dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/auction_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
