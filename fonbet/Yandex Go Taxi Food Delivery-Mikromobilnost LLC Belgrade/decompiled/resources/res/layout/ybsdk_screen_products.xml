<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productsMainLayout"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.feature.main.internal.widgets.gradient.ProductsV4GradientView
        android:id="@+id/headerGradientView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_products_v4_gradient_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.feature.main.internal.widgets.gradient.ProductsV4GradientView
        android:id="@+id/footerGradientView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ybsdk_products_v4_gradient_height"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="@+id/bottomBar"/>
    <com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/productsCoordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBarLayout"
                android:background="?attr/ybColor_internal_transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collapsingToolbar"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                    <com.ybsdk.feature.divkit.api.ui.YbDivView
                        android:id="@+id/quickActionsHeaderDivView"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.ybsdk.feature.main.internal.widgets.ProductCardListView
                        android:id="@+id/productsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:importantForAccessibility="yes"
                        android:layout_marginHorizontal="@dimen/ybsdk_product_card_h_margin"
                        app:layout_collapseMode="none"/>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <com.ybsdk.widgets.common.recycler.OrientationAwareRecyclerView
                android:orientation="vertical"
                android:id="@+id/screenProductsRecycler"
                android:background="@drawable/ybsdk_bg_products_recycler"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ybsdk_products_recycler_margin_top"
                android:overScrollMode="never"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.ybsdk.widgets.common.swiperefresh.CustomSwipeRefreshLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:background="?attr/ybColor_background_primary"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/ybsdk_toolbar_height"
        android:paddingStart="@dimen/ybsdk_screen_horizontal_space"
        android:paddingEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ybLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ybsdk_ic_pay_logo"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.ybsdk.feature.divkit.api.ui.YbDivView
            android:id="@+id/divUserInfoBlock"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.ybsdk.widgets.common.CloseButtonView
            android:id="@+id/closeButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="-8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.ybsdk.feature.main.internal.screens.products.views.TsarButtonView
        android:id="@+id/tsarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="@+id/bottomBar"/>
    <com.ybsdk.widgets.common.bottombar.BottomBarNavigation
        android:id="@+id/bottomBar"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerSkeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="@+id/bottomBar"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_shimmer_auto_start="false">
        <include
            android:id="@+id/shimmerSkeletonContent"
            layout="@layout/ybsdk_skeleton_products"/>
    </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
    <com.ybsdk.feature.divkit.api.ui.skeletons.DivSkeletonsView
        android:id="@+id/divSkeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="@+id/bottomBar"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/divSkeletonYbLogo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ybsdk_toolbar_height"
            android:contentDescription="@null"
            android:alpha="0.7"
            android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
            app:srcCompat="@drawable/ybsdk_ic_pay_logo"/>
    </com.ybsdk.feature.divkit.api.ui.skeletons.DivSkeletonsView>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/errorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
