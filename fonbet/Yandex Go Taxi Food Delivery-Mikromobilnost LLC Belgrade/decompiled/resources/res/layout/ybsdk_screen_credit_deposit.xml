<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ybsdk_shimmer_auto_start="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ybsdk.core.transfer.utils.TransferToolbarView
            android:id="@+id/creditDepositToolbar"
            android:layout_width="0dp"
            android:layout_height="@dimen/ybsdk_toolbar_height"
            android:paddingHorizontal="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/tooltipAnchor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/creditDepositAmountInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/creditDepositAmountInput"/>
        <com.ybsdk.widgets.common.MoneyInputEditView
            android:theme="@style/YbSdk.Widget.WidgetsCommon.NumbersInput"
            android:id="@+id/creditDepositAmountInput"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ybsdk_transfer_amount_hint"
            android:singleLine="true"
            android:digits="0123456789.,"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toTopOf="@+id/creditDepositSuggestsShimmerLayout"
            app:layout_constraintEnd_toStartOf="@+id/creditDepositAmountCurrency"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creditDepositToolbar"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Widget.YB.Text.Numbers2"/>
        <TextView
            android:id="@+id/creditDepositAmountCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:contentDescription="@string/ybsdk_common_accessibility_amount_description"
            android:labelFor="@+id/creditDepositAmountInput"
            app:layout_constraintBaseline_toBaselineOf="@+id/creditDepositAmountInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/creditDepositAmountInput"
            style="@style/Widget.YB.Text.Numbers2"/>
        <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
            android:id="@+id/creditDepositSuggestsShimmerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/creditDepositDescriptionShimmerLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creditDepositAmountInput"
            app:ybsdk_shimmer_auto_start="false">
            <com.ybsdk.widgets.common.SuggestsGroupView
                android:layout_gravity="center_horizontal"
                android:id="@+id/creditDepositSuggests"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="@dimen/ybsdk_screen_horizontal_space"/>
        </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
        <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
            android:id="@+id/creditDepositDescriptionShimmerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/creditDepositDivkitShimmerLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creditDepositSuggestsShimmerLayout"
            app:ybsdk_shimmer_auto_start="false">
            <TextView
                android:gravity="center"
                android:id="@+id/creditDepositDescription"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:layout_marginVertical="12dp"
                android:paddingHorizontal="@dimen/ybsdk_screen_horizontal_space"
                style="@style/Widget.YB.Text.Body3"/>
        </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
        <com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout
            android:id="@+id/creditDepositDivkitShimmerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/creditDepositKeyboard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:ybsdk_shimmer_auto_start="false">
            <com.ybsdk.feature.divkit.api.ui.YbDivView
                android:id="@+id/creditDepositKeyboardDivKitView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
        <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
            android:id="@+id/creditDepositKeyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/creditDepositButton"
            app:ybsdk_additionalButtonType="comma"/>
        <com.ybsdk.widgets.common.YbButtonView
            android:id="@+id/creditDepositButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.L"/>
        <include
            android:id="@+id/creditDepositSkeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/ybsdk_screen_credit_deposit_loading"/>
        <com.ybsdk.widgets.common.OperationProgressOverlayDialog
            android:id="@+id/transactionProgressView"
            android:background="?attr/ybColor_background_primary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creditDepositToolbar"/>
        <com.ybsdk.widgets.common.ErrorView
            android:id="@+id/creditDepositErrorView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/web3dsViewContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creditDepositToolbar"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupToHideDuringLoading"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="creditDepositAmountInput,creditDepositAmountCurrency,creditDepositSuggestsShimmerLayout,creditDepositDescriptionShimmerLayout,creditDepositErrorView,creditDepositDivkitShimmerLayout,creditDepositKeyboard,creditDepositButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
