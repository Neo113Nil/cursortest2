<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_caption"
        android:id="@+id/book_another_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        android:lineHeight="@dimen/scooters_component_text_line_height_caption"
        app:component_background_color="?attr/bgFloating"
        app:component_button_icon="@drawable/ic_plus_fill"
        app:component_button_icon_padding="4dp"
        app:component_button_rounded_corners_radius="100dp"
        app:component_button_size="M"
        app:component_title_color="?attr/textMain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.SegmentedComponent
        android:id="@+id/selector_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selector_plus_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.widget.buttons.CircleButtonImageView
        android:id="@+id/selector_plus_button"
        android:background="@drawable/fab_component_light"
        android:padding="11dp"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_plus_fill"
        android:scaleType="fitCenter"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/selector_view"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
