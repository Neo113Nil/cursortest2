<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/go_design_m_space"
        android:layout_marginEnd="@dimen/go_design_m_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.yandex.taxi.widget.progress.CircularProgressBar
            android:id="@+id/loading_progress_bar"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            app:component_stroke_color="@color/white"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/message_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            app:robotoFontStyle="medium"/>
        <Space
            android:id="@+id/message_right_space"
            android:layout_width="8dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <ru.yandex.taxi.widget.BottomEdgeButtonLayout
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/retry_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preload_launch_retry_button_title"
            app:component_background_color="@color/white"
            app:component_title_color="@color/text_black"/>
    </ru.yandex.taxi.widget.BottomEdgeButtonLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
