<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messaging.internal.view.input.UnderKeyboardLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="top"
        android:id="@+id/emoji_sticker_switcher_strip"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/emoji_sticker_switcher_height"
        app:tabBackground="@null"
        app:tabGravity="fill"
        app:tabIndicatorColor="@android:color/transparent"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabPaddingBottom="0dp"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabPaddingTop="0dp"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/emoji_sticker_switcher_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.yandex.messaging.internal.view.input.UnderKeyboardLinearLayout>
