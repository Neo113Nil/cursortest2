<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yandex.go.payments.paymentlist.ui.PaymentMethodChooserView
        android:id="@+id/payment_method_chooser_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:layout_gravity="bottom"
        android:id="@+id/payment_method_chooser_done"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_done_button_base_margin"
        android:layout_marginBottom="@dimen/component_done_button_bottom_margin"
        android:text="@string/common_done"
        android:layout_marginHorizontal="@dimen/component_done_button_base_margin"/>
</FrameLayout>
