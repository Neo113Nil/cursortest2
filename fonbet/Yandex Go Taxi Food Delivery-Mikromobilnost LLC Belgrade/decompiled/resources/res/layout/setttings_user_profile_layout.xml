<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/name_item"
        android:background="@drawable/bg_main_ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="margin"
        app:component_subtitle="@string/user_profile_name_title"
        app:component_subtitle_font_feature_settings="@string/go_default_font_settings"
        app:component_subtitle_size="14sp"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title_font_feature_settings="@string/go_default_font_settings"
        app:component_title_size="17sp"
        app:component_title_text_color="?attr/textMain"
        app:component_trail_mode="navigation"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/phone_item"
        android:background="@drawable/bg_main_ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_divider_position="bottom"
        app:component_divider_type="margin"
        app:component_subtitle="@string/settings_phone"
        app:component_subtitle_font_feature_settings="@string/go_default_font_settings"
        app:component_subtitle_size="14sp"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title_font_feature_settings="@string/go_default_font_settings"
        app:component_title_size="17sp"
        app:component_title_text_color="?attr/textMain"
        app:component_trail_mode="navigation"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/email_item"
        android:background="@drawable/bg_main_ripple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_subtitle_font_feature_settings="@string/go_default_font_settings"
        app:component_subtitle_size="14sp"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title="@string/settings_add_email"
        app:component_title_font_feature_settings="@string/go_default_font_settings"
        app:component_title_size="17sp"
        app:component_title_text_color="?attr/textMain"
        app:component_trail_mode="navigation"/>
</merge>
