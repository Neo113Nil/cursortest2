<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_browser_recycler"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
    <View
        android:id="@+id/media_browser_no_data_divider"
        android:background="@drawable/msg_divider_settings_group"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:id="@+id/media_browser_no_data_text"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/media_browser_no_data"
        android:paddingHorizontal="16dp"/>
</LinearLayout>
