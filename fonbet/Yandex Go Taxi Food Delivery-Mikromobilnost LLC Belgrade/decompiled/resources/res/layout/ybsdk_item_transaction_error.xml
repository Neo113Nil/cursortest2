<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/ybsdk_item_transaction_error_height"
    android:paddingVertical="@dimen/ybsdk_item_transaction_error_padding_vertical">
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="@dimen/ybsdk_item_transaction_error_label_width"
        android:layout_height="wrap_content"
        android:text="@string/ybsdk_dashboard_error_view_message"
        style="@style/Widget.YB.Text.Title1"/>
    <com.ybsdk.widgets.common.YbButtonView
        android:layout_gravity="center_horizontal"
        android:id="@+id/refreshButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_item_transaction_error_button_margin_top"
        app:ybsdk_buttonTitle="@string/ybsdk_dashboard_button_reload"
        style="@style/YbSdk.Widget.WidgetsCommon.YbButtonView.Primary.M"/>
</LinearLayout>
