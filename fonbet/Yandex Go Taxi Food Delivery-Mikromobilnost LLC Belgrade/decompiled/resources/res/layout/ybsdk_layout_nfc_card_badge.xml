<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/backgroundNfcCardBadge"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imageNfcCardBadge"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="@dimen/ybsdk_padding_nfc_card_badgeview_icon_margin"
        android:layout_marginBottom="@dimen/ybsdk_padding_nfc_card_badgeview_icon_margin"
        android:layout_marginStart="@dimen/ybsdk_padding_nfc_card_badgeview_icon_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/textNfcCardBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ybsdk_padding_badgeview_icon_margin"
        android:layout_marginEnd="@dimen/ybsdk_padding_nfc_card_badgeview_text_end_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageNfcCardBadge"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.YB.Text.Caption3.Bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
