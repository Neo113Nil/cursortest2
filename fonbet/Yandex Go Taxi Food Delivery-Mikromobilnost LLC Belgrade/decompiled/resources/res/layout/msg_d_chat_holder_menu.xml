<?xml version="1.0" encoding="utf-8"?>
<com.yandex.alicekit.core.views.BackHandlingLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/chat_message_menu"
    android:background="@drawable/msg_bg_rounded_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="1"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:layout_marginHorizontal="16dp"
        style="@style/Messaging.MessagePopupText"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_dialog_details"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        style="@style/Messaging.StatusDescriptionText"/>
    <View
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/actions_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.yandex.alicekit.core.views.BackHandlingLinearLayout>
