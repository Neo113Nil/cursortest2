<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.widget.ShimmeringFrameLayout
            android:id="@+id/icon_container"
            android:background="@drawable/bg_step_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="?attr/bgMinor"
            app:shimmeringCornerRadius="28dp">
            <com.yandex.go.design.view.GoImageView
                android:id="@+id/icon"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </ru.yandex.taxi.widget.ShimmeringFrameLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp">
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textMain"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.AppCompat.Body2"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textColor="?attr/textMinor"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.AppCompat.Caption"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.communications.stepsinstructions.components.StepsDashedLine
            android:id="@+id/dottedLine"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginStart="28dp"/>
        <ru.yandex.taxi.widget.ShimmeringFrameLayout
            android:id="@+id/image_container"
            android:background="@drawable/bg_rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="?attr/bgMinor">
            <ru.yandex.taxi.widget.RoundedCornersImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                app:cornerRadius="16dp"/>
        </ru.yandex.taxi.widget.ShimmeringFrameLayout>
    </LinearLayout>
</LinearLayout>
