<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationSliderRoot"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/fullViewportStubView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/childNavigationContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/grip"
        layout="@layout/ybsdk_grip_view"/>
    <ImageView
        android:id="@+id/slideableViewBackButton"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/ybsdk_clickable_icon_size"
        android:layout_height="@dimen/ybsdk_clickable_icon_size"
        android:layout_marginTop="@dimen/ybsdk_back_button_margin_top_card"
        android:scaleType="center"
        android:contentDescription="@string/ybsdk_common_accessability_back_title"
        android:layout_marginStart="@dimen/ybsdk_slideable_view_back_button_margin_start"
        app:srcCompat="@drawable/ybsdk_ic_arrow_short_back"
        app:tint="?attr/ybColor_textIcon_primary"/>
    <com.ybsdk.widgets.common.FrameLayoutAddViewAware
        android:id="@+id/ybsdkBottomSheetDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:id="@+id/ybsdkPlusSdkBottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="false"
        android:importantForAccessibility="no"/>
    <View
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/ybsdkSnackbarAnchor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <View
        android:id="@+id/ybSdkTooltipFromDeeplinkAnchor"
        android:layout_width="1px"
        android:layout_height="1px"/>
</FrameLayout>
