<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/logo_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_container">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textColor="?attr/textMain"
            android:id="@+id/onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-12dp"
            android:paddingHorizontal="@dimen/text_padding"/>
        <com.yandex.go.beginners.presentation.services_info.views.CommonServicesContainer
            android:layout_gravity="start"
            android:id="@+id/services_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/go_design_s_space"
        app:component_button_disabled_alpha="0.5"
        app:component_button_size="L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.design.badge.DiscountBadgeView
        android:textSize="24sp"
        android:textColor="@color/white"
        android:layout_gravity="end|top"
        android:id="@+id/discount_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-22dp"
        android:rotation="-7.5"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="32dp"
        app:discount_background_color="#1cc052"
        app:discount_corner_radius="6dp"
        app:edge_clip_radius="3dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:robotoFontStyle="bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
