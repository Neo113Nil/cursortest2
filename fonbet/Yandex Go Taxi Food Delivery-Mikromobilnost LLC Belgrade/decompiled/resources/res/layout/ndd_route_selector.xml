<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/ndd_route_selector_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ListTitleComponent
            android:id="@+id/error_title_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/list_item_height"
            app:component_subtitle_text_color="?attr/textMain"
            app:component_title="Ошибка, что-то пошло не так"/>
        <ru.yandex.taxi.design.ButtonComponent
            android:id="@+id/error_button_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="4dp"
            app:component_button_accent="true"
            app:component_button_size="L"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.taxi.design.ListTitleComponent
            android:id="@+id/title_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            app:component_subtitle_text_color="?attr/textMain"
            app:component_title="Тестовый Куда отнести"/>
        <ru.yandex.taxi.design.SegmentedComponent
            android:id="@+id/address_flow_switch"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/go_design_s_space"
            android:layout_marginHorizontal="@dimen/go_design_s_space"/>
        <ru.yandex.taxi.design.ListItemComponent
            android:id="@+id/address_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:component_divider_position="both"
            app:component_divider_type="margin"
            app:component_lead_image="@drawable/ic_ndd_pvz_selection_dialog_icon"
            app:component_subtitle_size="@dimen/component_text_size_body"
            app:component_subtitle_text_color="?attr/textMain"
            app:component_title="Тестовый Пункт приёма"
            app:component_title_size="@dimen/component_text_size_caption"
            app:component_title_text_color="?attr/textMinor"
            app:component_trail_image="@drawable/chevron_next"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/share_component"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginBottom="@dimen/go_design_s_space"
                android:minHeight="60dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/go_design_s_space"
                android:layout_marginEnd="@dimen/go_design_s_space"
                app:component_divider_type="none"
                app:component_no_background="true"
                app:component_rounded_background="?attr/controlMinor"
                app:component_subtitle="@string/delivery_ndd_share_button_subtitle"
                app:component_subtitle_gravity="center_horizontal"
                app:component_subtitle_typeface="regular"
                app:component_title="@string/delivery_ndd_share_button_title"
                app:component_title_gravity="center_horizontal"
                app:component_title_text_color="?attr/textOnControlMinor"
                app:component_title_typeface="medium"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/done_component"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_margin="@dimen/go_design_s_space"
                android:text="Тестовый Принесу сюда"
                android:layout_weight="1"
                app:component_divider_type="none"
                app:component_no_background="true"
                app:component_rounded_background="?attr/controlMain"
                app:component_subtitle_gravity="center_horizontal"
                app:component_subtitle_typeface="regular"
                app:component_title_gravity="center_horizontal"
                app:component_title_text_color="?attr/textOnControl"
                app:component_title_typeface="medium"
                style="@style/OrderButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
