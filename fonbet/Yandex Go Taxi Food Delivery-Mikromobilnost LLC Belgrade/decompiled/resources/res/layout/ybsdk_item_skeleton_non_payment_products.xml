<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/nonPaymentProduct1"
        android:layout_width="0dp"
        android:layout_height="128dp"
        app:layout_constraintEnd_toStartOf="@+id/nonPaymentProduct2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_cornerRadius="24dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/nonPaymentProduct2"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/nonPaymentProduct1"
        app:layout_constraintTop_toTopOf="@+id/nonPaymentProduct1"
        app:ybsdk_cornerRadius="24dp"/>
    <com.ybsdk.widgets.common.SkeletonView
        android:id="@+id/nonPaymentProduct3"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/nonPaymentProduct1"
        app:layout_constraintStart_toStartOf="@+id/nonPaymentProduct1"
        app:layout_constraintTop_toBottomOf="@+id/nonPaymentProduct1"
        app:ybsdk_cornerRadius="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
