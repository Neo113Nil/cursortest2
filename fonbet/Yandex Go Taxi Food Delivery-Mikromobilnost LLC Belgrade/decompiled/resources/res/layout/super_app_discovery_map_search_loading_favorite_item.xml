<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/go_design_s_space"
    android:layout_marginEnd="@dimen/go_design_m_space">
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="center"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="@dimen/go_design_s_space"
        app:barCornerRadius="12dp"/>
    <ru.yandex.taxi.widget.ShimmeringBar
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginEnd="32dp"
        app:barCornerRadius="8dp"/>
</LinearLayout>
