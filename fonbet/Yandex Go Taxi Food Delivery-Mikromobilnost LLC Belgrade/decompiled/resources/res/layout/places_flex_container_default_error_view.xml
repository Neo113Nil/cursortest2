<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/placesFlexContainerErrorBackButton"
        android:background="@drawable/bg_button_round"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_arrow_back_24dp"
        android:contentDescription="@string/common_back"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/topSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/placesFlexContainerErrorTitle"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:gravity="center"
        android:id="@+id/placesFlexContainerErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/discovery_organization_main_wrong"
        app:layout_constraintBottom_toTopOf="@+id/placesFlexContainerErrorSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topSpace"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:gravity="center"
        android:id="@+id/placesFlexContainerErrorSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/webview_error_description"
        app:layout_constraintBottom_toTopOf="@+id/bottomSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/placesFlexContainerErrorTitle"
        app:robotoFontStyle="regular"
        style="@style/TextAppearance.AppCompat.Body2"/>
    <View
        android:id="@+id/bottomSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/placesFlexContainerErrorActionButton"
        app:layout_constraintTop_toBottomOf="@+id/placesFlexContainerErrorSubtitle"
        app:layout_constraintVertical_weight="1"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:id="@+id/placesFlexContainerErrorActionButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="56dp"
        android:text="@string/webview_error_reload"
        android:layout_marginHorizontal="16dp"
        app:component_background_color="?attr/controlMain"
        app:component_button_accent="true"
        app:component_title_color="?attr/textOnControl"
        app:component_title_text_size="@dimen/component_text_size_body"
        app:component_title_typeface="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomSpace"/>
</com.yandex.go.design.view.GoConstraintLayout>
