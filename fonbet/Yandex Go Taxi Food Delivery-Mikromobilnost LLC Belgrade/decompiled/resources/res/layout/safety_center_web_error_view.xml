<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoView
        android:id="@+id/gradient"
        android:layout_width="match_parent"
        android:layout_height="234dp"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="start|top"
        android:id="@+id/back_float_btn"
        android:background="@drawable/ic_arrow_left"
        android:focusable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/common_back"
        android:textAlignment="center"
        android:layout_marginStart="16dp"/>
    <com.yandex.go.design.view.GoImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/title_image"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:layout_marginTop="42dp"/>
    <com.yandex.go.design.view.GoLinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp">
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="?attr/textMain"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAlignment="center"
            android:letterSpacing="0"
            android:layout_marginHorizontal="10dp"
            android:textFontWeight="900"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="13sp"
            android:textColor="?attr/textMinor"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:letterSpacing="0"
            android:layout_marginHorizontal="10dp"
            android:textFontWeight="500"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:layout_gravity="top|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="10dp">
            <include
                android:id="@+id/call_emergency_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                layout="@layout/safety_center_web_failure_screen_btn"/>
            <include
                android:id="@+id/open_support_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                layout="@layout/safety_center_web_failure_screen_btn"/>
            <include
                android:id="@+id/share_route_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                layout="@layout/safety_center_web_failure_screen_btn"/>
        </com.yandex.go.design.view.GoLinearLayout>
    </com.yandex.go.design.view.GoLinearLayout>
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="16sp"
        android:layout_gravity="bottom"
        android:id="@+id/reload_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:component_background_color="?attr/controlMain"
        app:component_title_color="?attr/textOnControl"
        app:robotoFontStyle="bold"/>
</merge>
