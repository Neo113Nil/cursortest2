<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/retry_load_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/go_design_s_space"
    android:paddingEnd="@dimen/go_design_s_space">
    <com.yandex.go.design.view.GoImageView
        android:id="@+id/reload_icon"
        android:layout_width="@dimen/component_image_holder_custom_width"
        android:layout_height="@dimen/component_image_holder_custom_width"
        android:src="@drawable/ic_arrow_round_48"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/reload_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_subtitle_text_color="?attr/textMinor"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_body"
        app:component_title_text_color="?attr/textMain"/>
</LinearLayout>
