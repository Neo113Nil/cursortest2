<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@drawable/msg_bg_poll_message_vote"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/poll_download_results_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:layout_marginHorizontal="8dp"
        app:srcCompat="@drawable/msg_ic_poll_results_file"/>
    <TextView
        android:id="@+id/poll_download_results_btn_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/messenger_poll_results_download"
        style="@style/Messaging.PollResults.DownloadButton"/>
</LinearLayout>
