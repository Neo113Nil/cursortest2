<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.taxi.design.ButtonComponent
        android:textSize="@dimen/component_text_size_body"
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/go_design_s_space"
        android:text="@string/mt_routes_button_show_route"
        app:component_background_color="?attr/controlMain"
        app:component_button_disabled_alpha="0.5"
        app:component_button_size="L"
        app:component_title_color="?attr/textOnControl"
        app:robotoFontStyle="medium"/>
</FrameLayout>
