<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/chat_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ToolbarComponent
        android:id="@+id/courier_chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_close_button_position="end"
        app:component_divider_position="bottom"
        app:component_divider_type="normal"
        app:component_show_close_button="true"
        app:component_show_navigation_button="false"
        app:component_subtitle_gravity="start"
        app:component_subtitle_text_color="@color/component_black_opacity_50"
        app:component_title_gravity="start"
        app:component_title_text_color="@color/component_black"
        app:component_toolbar_background_color="@color/component_white"
        app:component_toolbar_close_icon_color="@color/black"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
