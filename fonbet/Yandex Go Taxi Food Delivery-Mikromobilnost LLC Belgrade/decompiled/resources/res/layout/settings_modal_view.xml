<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_content"
    android:background="?attr/bgMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp">
        <ru.yandex.taxi.widget.ComponentLinearLayout
            android:orientation="vertical"
            android:id="@+id/settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:id="@+id/user_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/appearance_and_map_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListTitleComponent
                android:id="@+id/appearance_and_map_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_divider_position="bottom"
                app:component_divider_type="margin"
                app:component_title="@string/settings_appearance_and_map_section"
                app:component_title_font_feature_settings="@string/go_default_font_settings"
                app:component_title_size="@dimen/component_text_size_subtitle"
                app:component_title_text_color="?attr/textMain"
                app:component_title_typeface="medium"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/extra_items_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/dark_theme_mode"
                android:background="@drawable/bg_main_ripple"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title="@string/settings_theme_switch"
                app:component_trail_mode="navigation"
                style="@style/MainMenuItem"/>
            <ru.yandex.taxi.design.ListItemSwitchComponent
                android:id="@+id/haptic_toggle"
                android:background="@drawable/bg_main_ripple"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_divider_position="top"
                app:component_divider_type="margin"
                app:component_title="@string/settings_splash_haptic_option"
                app:component_trail_mode="none"
                style="@style/MainMenuItem"/>
            <ru.yandex.taxi.design.ListItemSwitchComponent
                android:id="@+id/hide_balance_toggle"
                android:background="@drawable/bg_main_ripple"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_divider_position="top"
                app:component_divider_type="margin"
                app:component_subtitle="@string/hide_yandex_bank_balance_subtitle"
                app:component_title="@string/hide_yandex_bank_balance_title"
                app:component_trail_mode="none"
                style="@style/MainMenuItem"/>
            <ru.yandex.taxi.design.ListItemSwitchComponent
                android:id="@+id/location_diagnostic_switch"
                android:background="@drawable/bg_main_ripple"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_divider_position="top"
                app:component_divider_type="margin"
                app:component_switch_checked="false"
                app:component_switch_enabled="true"
                app:component_title="@string/location_diagnostic_switch"
                style="@style/MainMenuItem"/>
            <ru.yandex.taxi.design.ListItemSwitchComponent
                android:id="@+id/show_traffic_item"
                android:background="@drawable/bg_main_ripple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_divider_position="top"
                app:component_divider_type="margin"
                app:component_title="@string/settings_show_traffic"
                style="@style/MainMenuItem"/>
            <com.yandex.go.design.divider.CardDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/lang"
                android:background="@drawable/bg_main_ripple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_title="@string/settings_lang"
                app:component_trail_mode="navigation"
                style="@style/MainMenuItem"/>
            <com.yandex.go.design.divider.CardDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="margin">
                <ru.yandex.taxi.design.ListItemSwitchComponent
                    android:id="@+id/dont_call_item"
                    android:background="@drawable/bg_main_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_subtitle="@string/settings_dont_call_subtitle"
                    app:component_title="@string/settings_dont_call"
                    style="@style/MainMenuItem"/>
                <ru.yandex.taxi.design.ListItemSwitchComponent
                    android:id="@+id/inapp_only_item"
                    android:background="@drawable/bg_main_ripple"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/MainMenuItem"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/use_inapp_calls_item"
                    android:background="@drawable/bg_main_ripple"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_trail_mode="navigation"
                    style="@style/MainMenuItem"/>
                <ru.yandex.taxi.design.ListItemSwitchComponent
                    android:id="@+id/sms_item"
                    android:background="@drawable/bg_main_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_divider_position="top"
                    app:component_divider_type="margin"
                    app:component_title="@string/settings_sms_order_status"
                    style="@style/MainMenuItem"/>
                <ru.yandex.taxi.design.ListItemSwitchComponent
                    android:id="@+id/promo_pushes_item"
                    android:background="@drawable/bg_main_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_divider_position="top"
                    app:component_divider_type="margin"
                    app:component_subtitle="@string/settings_promo_pushes_subtitle"
                    app:component_title="@string/settings_promo_pushes_title"
                    style="@style/MainMenuItem"/>
                <ru.yandex.taxi.design.ListItemSwitchComponent
                    android:id="@+id/geosharing_item"
                    android:background="@drawable/bg_main_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_divider_position="top"
                    app:component_divider_type="margin"
                    app:component_subtitle="@string/live_location_settings_details"
                    app:component_title="@string/location_sharing_control_button"
                    style="@style/MainMenuItem"/>
            </ru.yandex.taxi.design.AutoDividerComponentList>
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/push_settings_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:orientation="vertical"
                android:id="@+id/push_settings_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="margin">
                <ru.yandex.taxi.design.ListTitleComponent
                    android:id="@+id/push_settings_section_title"
                    android:background="?attr/bgMain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_title_size="@dimen/component_text_size_subtitle"/>
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/more_push_settings"
                    android:background="@drawable/bg_main_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_trail_mode="navigation"
                    style="@style/MainMenuItem"/>
            </ru.yandex.taxi.design.AutoDividerComponentList>
            <com.yandex.go.design.divider.CardDivider
                android:id="@+id/logout_divider"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.yandex.taxi.design.AutoDividerComponentList
                android:orientation="vertical"
                android:id="@+id/logout_container"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:component_middle_divider_type="margin">
                <ru.yandex.taxi.design.ListItemComponent
                    android:id="@+id/logout_item"
                    android:background="@drawable/bg_main_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:component_title="@string/profile_exit"
                    style="@style/MainMenuItem"/>
            </ru.yandex.taxi.design.AutoDividerComponentList>
        </ru.yandex.taxi.widget.ComponentLinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ru.yandex.taxi.design.FloatingTitleToolbarComponent
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_floating_title="@string/settings_title"/>
</FrameLayout>
