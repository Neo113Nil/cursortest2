<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/statebar_background"
    android:background="@color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="10dp">
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/statebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/statebar_height"
        app:component_navigation_icon="@drawable/chevron_next"
        app:component_no_background="true"
        app:component_subtitle_gravity="center_horizontal"
        app:component_subtitle_size="@dimen/component_text_size_caption"
        app:component_title_gravity="center_horizontal"
        app:component_title_size="@dimen/component_text_size_caption"
        app:component_title_typeface="bold"
        app:component_trail_mode="navigation"
        app:component_vertical_padding="0dp"/>
</com.yandex.go.design.view.GoFrameLayout>
