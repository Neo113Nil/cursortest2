<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.yandex.go.design.view.GoLinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/expanded_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp">
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/lead_buttons"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>
        <com.yandex.go.design.view.GoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/texts_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="12dp">
            <com.yandex.go.superapp.print_animation_text.PrintAnimationTextView
                android:textSize="16sp"
                android:textColor="?attr/textMain"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:translationY="-0.12sp"
                android:importantForAccessibility="no"
                android:letterSpacing="0"
                android:fontFeatureSettings="pnum, lnum"
                android:lineHeight="19sp"
                app:robotoFontStyle="regular"/>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="12sp"
                android:textColor="?attr/textMinor"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0sp"
                android:letterSpacing="0.01"
                android:fontFeatureSettings="pnum, lnum"
                android:lineHeight="13sp"
                app:robotoFontStyle="regular"/>
        </com.yandex.go.design.view.GoLinearLayout>
        <com.yandex.go.design.view.GoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/trail_buttons"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>
    </com.yandex.go.design.view.GoLinearLayout>
    <com.yandex.go.superapp.searchbar.impl.ui.searchbar.SuperappSearchbarButtonView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/collapsed_button"
        android:layout_width="@dimen/superapp_searchbar_size_collapsed"
        android:layout_height="@dimen/superapp_searchbar_size_collapsed"
        android:foreground="@drawable/ripple_superapp_searchbar"
        android:translationX="@dimen/superapp_searchbar_size_collapsed"/>
</merge>
