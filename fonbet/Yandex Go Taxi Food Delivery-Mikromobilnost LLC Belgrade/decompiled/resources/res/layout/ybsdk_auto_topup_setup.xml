<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.NoAutoScrollForFocusedView
        android:id="@+id/nestedScrollView"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/autoTopupSaveButtons"
        app:layout_constraintTop_toBottomOf="@+id/autoTopupToolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/autoTopupPaymentMethod">
            <com.ybsdk.widgets.common.SelectedItemFormView
                android:id="@+id/autoTopupPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/autoFundHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/autoTopupPaymentMethod">
                <com.ybsdk.feature.autotopup.internal.presentation.view.AutoTopupToggleView
                    android:id="@+id/autoFundSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.ybsdk.widgets.common.LoadableInput
                    android:id="@+id/autoFundAmountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/autoTopupHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/autoFundHolder">
                <com.ybsdk.feature.autotopup.internal.presentation.view.AutoTopupToggleView
                    android:id="@+id/autoTopupSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="8dp"/>
                <com.ybsdk.widgets.common.tabview.TabView
                    android:id="@+id/autoTopupSetupTabView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>
                <com.ybsdk.widgets.common.LoadableInput
                    android:id="@+id/autoTopupAmountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
                <com.ybsdk.widgets.common.LoadableInput
                    android:id="@+id/autoTopupThresholdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithBackground"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.ybsdk.widgets.common.NoAutoScrollForFocusedView>
    <com.ybsdk.widgets.common.YbButtonViewGroup
        android:id="@+id/autoTopupSaveButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/autoTopupKeyboard"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/autoTopupErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ybsdk.widgets.common.keyboard.NumberKeyboardView
        android:id="@+id/autoTopupKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:ybsdk_additionalButtonType="comma"
        app:ybsdk_hidden="true"/>
    <include
        android:id="@+id/autoTopupSkeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/autoTopupKeyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/autoTopupToolbar"
        layout="@layout/ybsdk_auto_topup_setup_skeleton"/>
    <com.ybsdk.widgets.common.communication.CommunicationFullScreenView
        android:id="@+id/communicationFullScreen"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/autoTopupToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ybsdk_root_card_inset_height"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
