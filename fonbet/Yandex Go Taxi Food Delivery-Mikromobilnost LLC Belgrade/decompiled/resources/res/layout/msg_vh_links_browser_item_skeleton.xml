<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="17dp"
    android:layout_marginVertical="17dp">
    <ImageView
        android:id="@+id/links_browser_item_image_skeleton"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_bg_media_browser_links_icon_skeleton"/>
    <ImageView
        android:id="@+id/links_browser_item_line_1"
        android:layout_width="238dp"
        android:layout_height="20dp"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toEndOf="@+id/links_browser_item_image_skeleton"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_bg_files_browser_item_skeleton"/>
    <ImageView
        android:id="@+id/links_browser_item_line_2"
        android:layout_width="205dp"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toEndOf="@+id/links_browser_item_image_skeleton"
        app:layout_constraintTop_toBottomOf="@+id/links_browser_item_line_1"
        app:srcCompat="@drawable/msg_bg_files_browser_item_skeleton"/>
    <ImageView
        android:id="@+id/links_browser_item_line_3"
        android:layout_width="131dp"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toEndOf="@+id/links_browser_item_image_skeleton"
        app:layout_constraintTop_toBottomOf="@+id/links_browser_item_line_2"
        app:srcCompat="@drawable/msg_bg_files_browser_item_skeleton"/>
    <ImageView
        android:id="@+id/links_browser_item_line_4"
        android:layout_width="152dp"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toEndOf="@+id/links_browser_item_image_skeleton"
        app:layout_constraintTop_toBottomOf="@+id/links_browser_item_line_3"
        app:srcCompat="@drawable/msg_bg_files_browser_item_skeleton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
