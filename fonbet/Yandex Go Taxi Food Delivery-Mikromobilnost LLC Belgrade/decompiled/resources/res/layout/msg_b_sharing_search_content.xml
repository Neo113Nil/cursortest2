<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/sharing_search_container"
        android:background="?attr/messagingCommonActionbarColor"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.yandex.messaging.views.SearchEditText
            android:textSize="16sp"
            android:textColor="?attr/messagingCommonTextPrimaryColor"
            android:textColorHint="?attr/messagingCommonTextSecondaryColor"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@+id/sharing_search_input"
            android:background="@drawable/msg_bg_colored_rounded_input"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/messenger_advanced_sharing_search_hint_text"
            android:scrollHorizontally="true"
            android:lineSpacingExtra="1sp"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:fontFamily="@font/ya_regular"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/sharing_search_loader"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="11dp"
            app:srcCompat="@drawable/msg_ic_colored_input_loader"/>
    </FrameLayout>
    <View
        android:id="@+id/user_list_search_border"
        android:background="?attr/messagingCommonDividerColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sharing_search_results"
        android:background="?attr/messagingCommonBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
