<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.design.view.GoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_round_16dp_minor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.go.design.view.GoLinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="16dp">
        <com.yandex.go.design.view.GoImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chat_outline_24"/>
        <ru.yandex.taxi.widget.RobotoTextView
            android:textSize="11sp"
            android:textColor="?attr/textMain"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:paddingTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="center"
            android:letterSpacing="0.01"
            android:textFontWeight="700"
            app:robotoFontStyle="bold"/>
    </com.yandex.go.design.view.GoLinearLayout>
</com.yandex.go.design.view.GoFrameLayout>
