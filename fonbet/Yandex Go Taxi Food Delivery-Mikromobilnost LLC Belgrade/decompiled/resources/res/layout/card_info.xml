<?xml version="1.0" encoding="utf-8"?>
<com.yandex.go.payments.paymentlist.ui.CardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/card_layout"
    android:background="@drawable/bg_black_rounded_12dp"
    android:paddingLeft="@dimen/card_info_padding_horizontal"
    android:paddingRight="@dimen/card_info_padding_horizontal"
    android:paddingBottom="@dimen/card_info_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginLeft="19dp"
    android:layout_marginRight="19dp"
    android:layout_marginBottom="204dp"
    android:paddingStart="@dimen/card_info_padding_horizontal"
    android:paddingEnd="@dimen/card_info_padding_horizontal"
    android:layout_marginStart="19dp"
    android:layout_marginEnd="19dp">
    <TextView
        android:textSize="30dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/card_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_info_number_margin_top"
        android:maxLines="1"
        android:lineSpacingExtra="1sp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/card_info_expiry_text_size"
            android:textColor="@color/white"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/card_exp_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</com.yandex.go.payments.paymentlist.ui.CardLayout>
