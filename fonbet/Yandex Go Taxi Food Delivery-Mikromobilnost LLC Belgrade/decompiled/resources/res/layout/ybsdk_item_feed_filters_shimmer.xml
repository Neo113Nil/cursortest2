<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/titleSkeleton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="218dp"
            app:ybsdk_cornerRadius="8dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/filterSkeleton1"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleSkeleton"
            app:ybsdk_cornerRadius="48dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/filterSkeleton2"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/filterSkeleton1"
            app:layout_constraintTop_toTopOf="@+id/filterSkeleton1"
            app:ybsdk_cornerRadius="48dp"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/filterSkeleton3"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/filterSkeleton2"
            app:layout_constraintTop_toTopOf="@+id/filterSkeleton2"
            app:ybsdk_cornerRadius="48dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
