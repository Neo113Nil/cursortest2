<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ybsdk.widgets.common.ToolbarView
        android:id="@+id/partnersToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/partnersFilterInput"
        app:layout_constraintTop_toTopOf="parent"
        app:ybsdk_closeIconVisible="true"
        app:ybsdk_subtitle="@string/ybsdk_transfer_sbp_title"
        app:ybsdk_title="@string/ybsdk_transfer_transfer_bank_selection"/>
    <com.ybsdk.widgets.common.LoadableInput
        android:id="@+id/partnersFilterInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ybsdk_screen_horizontal_space"
        android:layout_marginEnd="@dimen/ybsdk_screen_horizontal_space"
        app:layout_constraintBottom_toTopOf="@+id/partnersRecycler"
        app:layout_constraintTop_toBottomOf="@+id/partnersToolbar"
        app:ybsdk_inputLabel="@string/ybsdk_transfer_transfer_bank_destination_title"
        style="@style/YbSdk.Widget.WidgetsCommon.LoadableInput.WithoutBackground"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/partnersRecycler"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/partnersFilterInput"/>
    <com.ybsdk.widgets.common.FullscreenStatusView
        android:id="@+id/partnersFullscreenView"
        android:background="?attr/ybColor_background_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:ybsdk_closeIconVisible="true"/>
    <com.ybsdk.widgets.common.ErrorView
        android:id="@+id/partnersErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
