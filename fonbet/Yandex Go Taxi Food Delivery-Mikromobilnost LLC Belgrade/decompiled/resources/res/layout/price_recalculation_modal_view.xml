<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.taxi.design.ListHeaderComponent
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:component_subtitle_size="16sp"
        app:component_subtitle_text_color="?attr/textMain"
        app:component_subtitle_typeface="bold"
        app:component_title_size="24sp"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.yandex.taxi.design.ListItemComponent
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <ImageView
        android:id="@+id/shadow"
        android:background="0x7f081870"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="-14dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:backgroundTint="?attr/textMain"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:background="@drawable/bg_rounded_24dp_modal_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:layout_marginHorizontal="8dp">
            <ru.yandex.taxi.widget.ShimmeringFrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/recalculation_price_text_shimmering"
                android:background="@drawable/bg_rounded"
                android:layout_width="match_parent"
                android:layout_height="16sp"
                android:backgroundTint="?attr/bgMinor"
                android:layout_marginHorizontal="40dp"/>
            <ru.yandex.taxi.widget.ShimmeringFrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/recalculation_price_image_shimmering"
                android:background="@drawable/bg_rounded"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="?attr/bgMinor">
                <ImageView
                    android:id="@+id/recalculation_price_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"/>
            </ru.yandex.taxi.widget.ShimmeringFrameLayout>
            <ru.yandex.taxi.widget.RobotoTextView
                android:textSize="16sp"
                android:textColor="?attr/textMain"
                android:ellipsize="middle"
                android:layout_gravity="center"
                android:id="@+id/recalculation_price_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp">
            <ru.yandex.taxi.design.ButtonComponent
                android:id="@+id/cancel_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/common_cancel"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                app:component_background_color="?attr/controlMinor"
                app:component_title_color="?attr/textOnControlMinor"/>
            <ru.yandex.taxi.design.ListItemComponent
                android:id="@+id/confirm_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/common_done"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                app:component_rounded_background="?attr/controlMain"
                app:component_title_color="?attr/textOnControl"
                app:component_title_gravity="center_horizontal"
                app:component_title_text_color="?attr/textOnControl"
                app:component_title_typeface="medium"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
