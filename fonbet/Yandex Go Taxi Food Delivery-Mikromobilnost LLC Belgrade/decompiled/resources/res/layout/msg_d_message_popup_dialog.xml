<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/popup_dialog_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/messaging_reactions_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/reactions_chooser_height">
                <com.yandex.bricks.BrickSlotView
                    android:id="@+id/messaging_reactions_slot"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/orb_spacing_6m"
                    android:layout_marginEnd="@dimen/orb_spacing_6m"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/popup_dialog_message"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingHorizontal="16dp"
                style="@style/Messaging.MessagePopupText"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/popup_dialog_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                style="@style/Messaging.ChatPreviewText"/>
            <View
                android:id="@+id/popup_dialog_separator"
                android:background="?attr/messagingCommonBackgroundSecondaryColor"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chat_separator_size"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/popup_dialog_menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/chat_message_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/message_reactions"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Messaging.MessagePopupButton"/>
                <View
                    android:id="@+id/message_menu_divider_first_block"
                    style="@style/Messaging.MessageMenuDivider"/>
                <TextView
                    android:id="@+id/message_reply"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_reply"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_forward"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_forward"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_share"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_share"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_show_thread"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_message_discuss"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_reply_in_thread"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_message_discuss"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_copy_link"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_message_copy_link"
                    style="@style/Messaging.MessagePopupButton"/>
                <View
                    android:id="@+id/message_menu_divider_second_block"
                    style="@style/Messaging.MessageMenuDivider"/>
                <TextView
                    android:id="@+id/message_open_file"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_open_file"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_download"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_save"
                    style="@style/Messaging.MessagePopupButton"/>
                <View
                    android:id="@+id/message_menu_divider_third_block"
                    style="@style/Messaging.MessageMenuDivider"/>
                <TextView
                    android:id="@+id/message_copy"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_copy"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_added_to_saved_messages"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_to_saved"
                    android:textAllCaps="false"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_mark_unread"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_mark_unread"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/thread_mark_read"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_mark_read"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_revote"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/messenger_message_menu_revote"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_pin"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_pin"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_change_starred_status"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_message_make_starred"
                    style="@style/Messaging.MessagePopupButton"/>
                <View
                    android:id="@+id/message_menu_divider_fourth_block"
                    style="@style/Messaging.MessageMenuDivider"/>
                <TextView
                    android:id="@+id/message_edit"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_edit"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_select"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_select"
                    style="@style/Messaging.MessagePopupButton"/>
                <TextView
                    android:id="@+id/message_retry"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_retry_send"
                    style="@style/Messaging.MessagePopupButton"/>
                <View
                    android:id="@+id/message_menu_divider_danger_zone"
                    style="@style/Messaging.MessageMenuDivider"/>
                <TextView
                    android:id="@+id/message_cancel"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_delete"
                    style="@style/Messaging.MessagePopupDestructiveButton"/>
                <TextView
                    android:id="@+id/report"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/messenger_report"
                    style="@style/Messaging.MessagePopupDestructiveButton"/>
                <TextView
                    android:id="@+id/hide"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/messenger_hide"
                    style="@style/Messaging.MessagePopupDestructiveButton"/>
                <TextView
                    android:id="@+id/block_user"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_block_and_hide"
                    style="@style/Messaging.MessagePopupDestructiveButton"/>
                <TextView
                    android:id="@+id/message_delete"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_delete"
                    style="@style/Messaging.MessagePopupDestructiveButton"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
