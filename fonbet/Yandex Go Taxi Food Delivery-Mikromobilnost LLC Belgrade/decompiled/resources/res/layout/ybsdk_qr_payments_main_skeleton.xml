<?xml version="1.0" encoding="utf-8"?>
<com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/ybColor_background_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/toolbarSkeletonContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_toolbar_height"
            app:layout_constraintTop_toTopOf="parent">
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_gravity="center"
                android:id="@+id/toolbarSkeleton"
                android:layout_width="@dimen/ybsdk_qr_payments_yb_logo_width"
                android:layout_height="@dimen/ybsdk_qr_payments_yb_logo_height"
                app:ybsdk_cornerRadius="10dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/merchantIconSkeletonContainer"
            android:layout_width="@dimen/ybsdk_operation_progress_view_around_image_size"
            android:layout_height="@dimen/ybsdk_operation_progress_view_around_image_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbarSkeletonContainer">
            <com.ybsdk.widgets.common.SkeletonView
                android:layout_gravity="center"
                android:layout_width="@dimen/ybsdk_qr_payments_merchant_icon_size"
                android:layout_height="@dimen/ybsdk_qr_payments_merchant_icon_size"
                android:shape="oval"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </FrameLayout>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/merchantNameSkeleton"
            android:layout_width="122dp"
            android:layout_height="@dimen/ybsdk_lineheight_title2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/merchantIconSkeletonContainer"
            app:ybsdk_cornerRadius="4dp"/>
        <Space
            android:id="@+id/subtitleSpace"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ybsdk_wallet_lineheight_caption1"
            android:layout_marginBottom="@dimen/ybsdk_qr_payments_amount_top_margin"
            app:layout_constraintTop_toBottomOf="@+id/merchantNameSkeleton"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/ybColor_fill_default_100"
            android:id="@+id/amountSkeleton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ybsdk_qr_payments_amount_top_margin"
            android:text="@string/ybsdk_qr_payment_amount_skeleton_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitleSpace"
            style="@style/Widget.YB.Text.Numbers2"/>
        <com.ybsdk.feature.divkit.api.ui.skeletons.DivSkeletonsView
            android:id="@+id/agreementsSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/ybButtonSkeleton"/>
        <com.ybsdk.widgets.common.SkeletonView
            android:id="@+id/ybButtonSkeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/ybsdk_button_min_height_large"
            android:layout_marginBottom="@dimen/ybsdk_qr_payments_yb_button_bottom_margin"
            android:layout_marginHorizontal="@dimen/ybsdk_screen_horizontal_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:ybsdk_cornerRadius="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ybsdk.widgets.common.shimmer.ShimmerFrameLayout>
