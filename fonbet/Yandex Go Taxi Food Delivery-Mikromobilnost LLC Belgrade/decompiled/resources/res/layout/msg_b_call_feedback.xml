<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/messagingTelemostBackgroundColor"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <ImageButton
        android:id="@+id/feedback_close"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@null"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/msg_ic_close"
        app:tint="?attr/messagingTelemostIconPrimaryColor"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/messagingTelemostTextPrimaryColor"
        android:id="@+id/feedback_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/call_feedback_brick_title"
        android:fontFamily="@font/ya_regular"
        app:layout_constraintBottom_toBottomOf="@+id/feedback_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feedback_close"/>
    <ImageView
        android:id="@+id/calls_small_remote_user_avatar"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/feedback_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feedback_close"/>
    <ImageView
        android:id="@+id/calls_remote_user_avatar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:contentDescription="@null"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.18"/>
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/messagingTelemostTextPrimaryColor"
        android:gravity="center_horizontal"
        android:id="@+id/calls_remote_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:fontFamily="@font/ya_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calls_remote_user_avatar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:gravity="center_horizontal"
        android:id="@+id/calls_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/call_finished"
        android:maxLines="1"
        android:lines="1"
        android:minLines="1"
        android:alpha="0.8"
        android:fontFamily="@font/ya_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calls_remote_user_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:gravity="center_horizontal"
        android:id="@+id/feedback_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:text="@string/call_feedback_hint"
        android:alpha="0.8"
        android:fontFamily="@font/ya_regular"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calls_status"/>
    <com.yandex.messaging.ui.calls.feedback.RatingView
        android:id="@+id/rating_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feedback_hint"
        app:layout_goneMarginTop="0dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="?attr/messagingCommonTextSecondaryColor"
        android:gravity="center"
        android:id="@+id/calls_feedback_warning"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/calls_feedback_warning"
        android:fontFamily="@font/ya_regular"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/calls_feedback_send"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lineHeight="20sp"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/calls_controls_color"
        android:id="@+id/calls_feedback_refuse"
        android:background="@drawable/msg_bg_calls_feedback_button_outlined"
        android:layout_width="172dp"
        android:layout_height="44dp"
        android:layout_marginBottom="24dp"
        android:text="@string/call_feedback_refuse"
        android:textAllCaps="false"
        android:fontFamily="@font/ya_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/calls_controls_color"
        android:id="@+id/calls_feedback_send"
        android:background="@drawable/msg_bg_calls_feedback_button_rounded"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="172dp"
        android:layout_height="44dp"
        android:layout_marginBottom="24dp"
        android:text="@string/call_feedback_send"
        android:textAllCaps="false"
        android:fontFamily="@font/ya_regular"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <EditText
        android:textSize="16sp"
        android:textColor="?attr/messagingTelemostTextPrimaryColor"
        android:textColorHint="?attr/messagingCommonTextPrimaryColor"
        android:id="@+id/calls_feedback_details_message"
        android:background="@drawable/msg_bg_calls_feedback_message"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/calls_feedback_message_input_hint"
        android:maxLines="6"
        android:ems="10"
        android:maxLength="1000"
        android:inputType="textMultiLine"
        android:fontFamily="@font/ya_regular"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toTopOf="@+id/calls_feedback_warning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rating_view"
        app:layout_constraintVertical_bias="0"/>
    <com.yandex.bricks.BrickSlotView
        android:id="@+id/call_feedback_reasons_brick_slot"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/calls_feedback_warning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calls_feedback_details_message"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
