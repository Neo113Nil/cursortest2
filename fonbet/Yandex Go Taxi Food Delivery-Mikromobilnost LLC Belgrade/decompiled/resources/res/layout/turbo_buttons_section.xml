<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/turbo_buttons_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/shortcuts_turbo_button_container_height"
    android:paddingVertical="4dp">
    <include
        android:id="@+id/turbo_button_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/turbo_button_2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="76dp"
        app:layout_constraintWidth_min="64dp"
        layout="@layout/turbo_button_item"/>
    <include
        android:id="@+id/turbo_button_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/turbo_button_3"
        app:layout_constraintStart_toEndOf="@+id/turbo_button_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="76dp"
        app:layout_constraintWidth_min="64dp"
        layout="@layout/turbo_button_item"/>
    <include
        android:id="@+id/turbo_button_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/turbo_button_4"
        app:layout_constraintStart_toEndOf="@+id/turbo_button_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="76dp"
        app:layout_constraintWidth_min="64dp"
        layout="@layout/turbo_button_item"/>
    <include
        android:id="@+id/turbo_button_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/turbo_button_5"
        app:layout_constraintStart_toEndOf="@+id/turbo_button_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="76dp"
        app:layout_constraintWidth_min="64dp"
        layout="@layout/turbo_button_item"/>
    <include
        android:id="@+id/turbo_button_5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/turbo_button_4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="76dp"
        app:layout_constraintWidth_min="64dp"
        layout="@layout/turbo_button_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>
