<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/scooter_image_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_title"
        android:textColor="?attr/textMain"
        android:id="@+id/error_title_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/go_design_m_space"
        app:robotoFontStyle="bold"/>
    <ru.yandex.taxi.widget.RobotoTextView
        android:textSize="@dimen/component_text_size_body"
        android:textColor="?attr/textMain"
        android:id="@+id/error_subtitle_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/go_design_m_space"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textColor="?attr/textOnControlMinor"
        android:id="@+id/close_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/go_design_m_space"
        android:layout_marginBottom="2dp"
        android:text="@string/common_close"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMinor"/>
    <ru.yandex.taxi.design.ButtonComponent
        android:textColor="?attr/textOnControl"
        android:id="@+id/find_another_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="@dimen/go_design_m_space"
        android:text="@string/scooters_find_scooter"
        android:layout_marginHorizontal="@dimen/go_design_s_space"
        app:component_background_color="?attr/controlMain"/>
</LinearLayout>
